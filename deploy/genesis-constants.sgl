;;; Print every canonical genesis value from the configured quote and timestamp.
;;;
;;; Launch-critical constants must all come from this tool. It rebuilds the
;;; mainnet, reset public-testnet, and regtest coinbases from current source and
;;; prints the serialized coinbase, merkle root, nonce, header, hash, and display
;;; id which move together whenever the generated witness changes.
;;;
;;; Run from the repository root:
;;;
;;;   cache=$(mktemp -d); trap 'rm -rf "$cache"' EXIT
;;;   nix develop /path/to/workspace -c env XDG_CACHE_HOME="$cache" \
;;;     /path/to/workspace/sigil/build/dev/bin/sigil \
;;;     deploy/genesis-constants.sgl --redirects ./dev-redirects.sgl
;;;
;;; The empty cache is deliberate: launch-critical constants must compile from
;;; current source rather than falling back to bytecode left by an older build.
;;; The inputs below come directly from `(sigil coin node chain)`;
;;; `test-node.sgl` independently rebuilds each genesis and checks the emitted
;;; header and id constants.

(import (sigil io)
        (sigil bitcoin encoding)
        (sigil bitcoin utils)
        (sigil bitcoin tx)
        (sigil bitcoin consensus)
        (sigil coin node genesis)
        (sigil coin node chain))

(define %genesis-inputs
  (list (list "mainnet" coin-genesis-quote coin-genesis-time)
        (list "testnet" coin-testnet-genesis-quote coin-testnet-genesis-time)
        (list "regtest" coin-regtest-genesis-quote coin-regtest-genesis-time)))

(define (print-genesis input)
  (let* ((name (car input))
         (quote (cadr input))
         (time (caddr input))
         (built (coin-genesis-block quote time))
         (coinbase (car (block-transactions built)))
         (header (block-header-field built))
         (hash (block-header-hash header)))
    (println "network: ~a" name)
    (println "quote: ~a" quote)
    ;; BYTES, not characters. The quote becomes coinbase graffiti verbatim via
    ;; `string->utf8`, and the graffiti cap (400 B) and block cap (16384 B)
    ;; are byte limits.
    (println "quote-bytes: ~a" (bytevector-length (string->utf8 quote)))
    (println "time: ~a" time)
    (println "coinbase-hex: ~a"
             (hex-encode (transaction-serialize coinbase)))
    (println "merkle-root: ~a"
             (hex-encode (block-header-merkle-root header)))
    (println "nonce: ~a" (block-header-nonce header))
    (println "header-hex: ~a" (hex-encode (block-header-serialize header)))
    (println "hash: ~a" (hex-encode hash))
    ;; The display id reverses the internal header hash.
    (println "id: ~a" (hex-encode (reverse-bytevector hash)))))

(let loop ((inputs %genesis-inputs) (first? #t))
  (unless (null? inputs)
    (unless first? (println ""))
    (print-genesis (car inputs))
    (loop (cdr inputs) #f)))
