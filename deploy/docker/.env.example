# Copy to .env for Docker Compose, or pass this file to deploy-remote.sh as
# ENV_FILE. Values are examples only; there are no credentials here.

# Remote deployment target. deploy-remote.sh reads these when exported; Compose
# safely ignores them. The value may be an SSH hostname or config alias.
REMOTE_HOST=host.example
REMOTE_DIR=/srv/sigilcoin

# Listener/sync use the remote login user's numeric identity. Explorer and pool
# use distinct UIDs with the same GID; neither can read the node wallet.
SIGIL_UID=1000
SIGIL_GID=1000
EXPLORER_UID=1001
POOL_UID=1002

# Testnet stays loopback-only by default. Explorer and pool mappings are always
# 127.0.0.1 and must be published only through the operator-managed TLS reverse
# proxy.
SIGIL_TESTNET_STATE_DIR=./state/testnet
SIGIL_TESTNET_POOL_STATE_DIR=./state/testnet-pool
P2P_BIND=127.0.0.1
P2P_PORT=19446
EXPLORER_PORT=8080
POOL_PORT=8082

# For a private listener allowlisted to one IPv4 peer, set all of:
#   P2P_BIND=0.0.0.0
#   TESTNET_EXPOSURE_ACK=peer-ip-allowlisted
#   REMOTE_PEER_IP=192.0.2.10
# For an intentionally public listener, set P2P_BIND=0.0.0.0 and the exact:
#   TESTNET_EXPOSURE_ACK=public-testnet-approved
# Public mode does not require REMOTE_PEER_IP. Any other acknowledgement is
# rejected. Opening TCP/19446 in provider and host firewalls is a separate,
# explicit operator action.
TESTNET_EXPOSURE_ACK=
REMOTE_PEER_IP=

# Optional outbound bootstrap override. The node's canonical testnet config
# already contains this DNS seed; community nodes may set:
#   PEER=seed.testnet.sigilcoin.lol:19446
PEER=

# Bounded sync-pass cadence and network timeouts.
SYNC_INTERVAL=60
RESOLVE_TIMEOUT_MS=1000
CONNECT_TIMEOUT_MS=3000
READ_TIMEOUT_MS=10000
ACCEPT_TIMEOUT_MS=60000
MAX_STEPS=4096
MAX_BLOCKS=256
MAX_TX=256

# Mainnet is disabled until final genesis approval; both scripts and the
# container require ALLOW_MAINNET=yes exactly. P2P stays loopback unless its
# bind is changed and the public exposure acknowledgment is also exact:
#   MAINNET_P2P_BIND=0.0.0.0
#   MAINNET_EXPOSURE_ACK=public-mainnet-approved
# The explorer host mapping is fixed at 127.0.0.1:8081 and sits behind the
# non-default mainnet-explorer profile. deploy-remote enables it only after
# validating and reloading the repository Caddy configuration.
SIGIL_MAINNET_STATE_DIR=./state/mainnet
MAINNET_P2P_BIND=127.0.0.1
MAINNET_P2P_PORT=19444
MAINNET_EXPOSURE_ACK=
ALLOW_MAINNET=no

# The mainnet-miner profile is off by default. start-mainnet-miner.sh supplies
# its fixed external payout address and exact mainnet acknowledgement.
MINE_INTERVAL=60

# Optional immutable image reference/tag, also used by rollback commands.
# SIGIL_IMAGE=sigilcoin-local:testnet
