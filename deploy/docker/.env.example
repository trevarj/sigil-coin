# Copy to .env for Docker Compose, or pass this file to deploy-remote.sh as
# ENV_FILE. Values are examples only; there are no credentials here.

# Remote deployment target. deploy-remote.sh reads these when exported; Compose
# safely ignores them. The value may be an SSH hostname or config alias.
REMOTE_HOST=your-remote-host
REMOTE_DIR=/srv/sigilcoin

# Listener/sync use the remote login user's numeric identity. Explorer uses a
# distinct UID with the same GID, so it can only read group-readable chain DBs.
SIGIL_UID=1000
SIGIL_GID=1000
EXPLORER_UID=1001

# Private testnet paths and published interfaces. Public P2P exposure fails
# closed unless the exact acknowledgement and approved IPv4 peer are set.
SIGIL_TESTNET_STATE_DIR=./state/testnet
P2P_BIND=127.0.0.1
P2P_PORT=19446
EXPLORER_PORT=8080
TESTNET_EXPOSURE_ACK=

# The one manually approved remote peer. Use IPv4:19446; there is no seed
# discovery. REMOTE_PEER_IP is also the firewall allowlist acknowledgement.
PEER=
REMOTE_PEER_IP=

# Bounded sync-pass cadence and network timeouts.
SYNC_INTERVAL=60
RESOLVE_TIMEOUT_MS=1000
CONNECT_TIMEOUT_MS=3000
READ_TIMEOUT_MS=10000
ACCEPT_TIMEOUT_MS=60000
MAX_STEPS=4096
MAX_BLOCKS=256
MAX_TX=256

# Mainnet uses separate state and host ports. It is disabled until final genesis
# is approved; both scripts and the container require the exact value `yes`.
SIGIL_MAINNET_STATE_DIR=./state/mainnet
MAINNET_P2P_BIND=0.0.0.0
MAINNET_P2P_PORT=19444
MAINNET_EXPLORER_BIND=127.0.0.1
MAINNET_EXPLORER_PORT=8081
ALLOW_MAINNET=no

# Optional immutable image reference/tag, also used by rollback commands.
# SIGIL_IMAGE=sigilcoin-local:testnet
