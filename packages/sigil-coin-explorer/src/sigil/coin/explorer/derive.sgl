;;; (sigil coin explorer derive) — presentation helpers for consensus canonical
;;;
;;; Consensus owns every wire type, codec and arithmetic rule. This module
;;; only flattens derived puzzle values for pages and reads presentation-only
;;; author tags from opaque graffiti.

(define-library (sigil coin explorer derive)
  (import (sigil math)
          (sigil bitcoin utils)
          (sigil coin puzzle)
          (sigil coin puzzle constraints)
          (sigil coin puzzle generator)
          (sigil coin consensus))
  (export
    explorer-complexity
    explorer-score
    explorer-seed
    explorer-puzzle
    explorer-puzzle-view
    explorer-example-pairs
    explorer-constraint-text
    explorer-margin
    explorer-next-complexity
    explorer-retarget-height?
    explorer-bucket
    explorer-author-tag)

  (begin

    ;;; Decode complexity `C` from a canonical bits field, or `#f` when malformed.
    (define (explorer-complexity bits)
      (: any? -> any?)
      (guard (e (#t #f))
        (let ((decoded (coin-bits-decode bits)))
          (and (coin-ok? decoded) (coin-result-value decoded)))))

    ;;; Flatten a header score as `(L MB SB Q)`, or `#f` when malformed.
    ;;; `Q` is aggregate personalized-share quality, never raw reveal count.
    (define (explorer-score nonce)
      (: any? -> any?)
      (guard (e (#t #f))
        (let ((checked (coin-score-check nonce)))
          (and (coin-ok? checked)
               (let ((score (coin-result-value checked)))
                 (list (coin-score-length score)
                       (coin-score-memory score)
                       (coin-score-steps score)
                       (coin-score-quality score)))))))

    ;;; Derive a puzzle seed as lowercase hex, or `#f` for bad input.
    (define (explorer-seed parent-hash height complexity)
      (: any? any? any? -> any?)
      (guard (e (#t #f))
        (and (bytevector? parent-hash)
             (number? height)
             (number? complexity)
             (hex-encode-bytes
               (coin-puzzle-seed parent-hash height complexity)))))

    ;;; Derive one global producer puzzle, or `#f` for bad input.
    (define (explorer-puzzle parent-hash height complexity)
      (: any? any? any? -> any?)
      (guard (e (#t #f))
        (and (bytevector? parent-hash)
             (number? height)
             (number? complexity)
             (coin-puzzle-for parent-hash height complexity))))

    ;;; Flatten canonical puzzle examples into source-text pairs.
    (define (explorer-example-pairs spec)
      (: any? -> list?)
      (guard (e (#t '()))
        (if (not (puzzle-spec? spec))
            '()
            (map (lambda (pair)
                   (cons (puzzle-print-value (car pair))
                         (puzzle-print-value (cdr pair))))
                 (puzzle-spec-examples spec)))))

    ;;; Flatten a puzzle as `(par constraint text k examples)`, or `#f`.
    (define (explorer-puzzle-view spec)
      (: any? -> any?)
      (guard (e (#t #f))
        (and (puzzle-spec? spec)
             (let ((constraint (puzzle-spec-constraint spec)))
               (list (puzzle-spec-par spec)
                     constraint
                     (explorer-constraint-text
                       constraint (coin-spec-builtin-cap spec))
                     (puzzle-spec-k spec)
                     (explorer-example-pairs spec))))))

    ;;; Describe a rotating puzzle constraint for presentation.
    (define (explorer-constraint-text constraint builtin-cap)
      (: any? any? -> string?)
      (cond
        ((not (and (number? constraint) (exact? constraint)
                   (integer? constraint)))
         "unknown")
        ((= constraint 0) "no restriction")
        ((= constraint 1) "no digit may appear anywhere in the source")
        ((= constraint 2) "no quote character, and no (quote ...) form")
        ((= constraint 3) "the program must use letrec")
        ((= constraint 4)
         (string-append "at most "
                        (if (number? builtin-cap)
                            (number->string builtin-cap)
                            "a few")
                        " distinct builtins may be used"))
        ((= constraint 5) "the program must contain exactly one lambda")
        ((= constraint 6) "every integer literal must satisfy |n| <= 9")
        ((= constraint 7) "the program must use fold")
        (else "unknown")))

    ;;; Compute producer margin in milli-units, or `#f` when unavailable.
    (define (explorer-margin par length)
      (: any? any? -> any?)
      (guard (e (#t #f))
        (and (number? par) (> par 0)
             (number? length) (> length 0)
             (coin-margin par length))))

    ;;; Compute complexity for `height`, or `#f` when inputs are incomplete.
    (define (explorer-next-complexity height parent-complexity margins)
      (: any? any? any? -> any?)
      (guard (e (#t #f))
        (coin-complexity-for height parent-complexity margins)))

    ;;; True at a canonical retarget height.
    (define (explorer-retarget-height? height)
      (: any? -> boolean?)
      (guard (e (#t #f))
        (coin-retarget-height? height)))

    ;;; Bucket a non-negative resource count, or `#f` when malformed.
    (define (explorer-bucket count)
      (: any? -> any?)
      (guard (e (#t #f))
        (and (number? count) (coin-bucket7 count))))

    ;;; Read a leading `/name/` convention from opaque graffiti bytes.
    ;;; Result stays bytes so renderers must sanitize and escape it.
    (define %max-author-bytes 64)
    (define %slash 47)

    (define (explorer-author-tag graffiti)
      (: any? -> any?)
      (guard (e (#t #f))
        (and (bytevector? graffiti)
             (> (bytevector-length graffiti) 2)
             (= %slash (bytevector-u8-ref graffiti 0))
             (let ((n (min (bytevector-length graffiti)
                           (+ %max-author-bytes 2))))
               (let loop ((i 1))
                 (cond
                   ((>= i n) #f)
                   ((= %slash (bytevector-u8-ref graffiti i))
                    (and (> i 1) (bytevector-copy graffiti 1 i)))
                   (else (loop (+ i 1)))))))))))
