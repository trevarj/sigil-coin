;;; (sigil coin explorer client) — compiled first-party dashboard JavaScript
;;;
;;; The asset is a build-time string, so serving it never depends on the
;;; current directory or on a node database being present.

(define-library (sigil coin explorer client)
  (export explorer-client-javascript)

  (begin

    ;;; JavaScript used by the live summary dashboard.
    ;;;
    ;;; It exits before installing listeners or timers unless the page has the
    ;;; summary dashboard's `data-explorer-live` hook.
    (define (explorer-client-javascript)
      (: -> string?)
      (apply string-append
             '("(() => {\n"
        "  'use strict';\n"
        "  const dashboard = document.querySelector('[data-explorer-live]');\n"
        "  if (!dashboard) return;\n"
        "\n"
        "  const pollDelay = 12000;\n"
        "  const maximumDelay = 120000;\n"
        "  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');\n"
        "  const byId = (id) => document.getElementById(id);\n"
        "  const status = byId('live-connection');\n"
        "  const waiting = byId('live-waiting');\n"
        "  const announcement = byId('live-announcement');\n"
        "  const strip = byId('live-block-strip');\n"
        "  let tipHeight = Number(dashboard.dataset.tipHeight);\n"
        "  let tipId = dashboard.dataset.tipId || '';\n"
        "  let failures = 0;\n"
        "  let timer = null;\n"
        "  let controller = null;\n"
        "  let running = false;\n"
        "  let hasSynced = false;\n"
        "\n"
        "  const validHeight = (value) => Number.isSafeInteger(value) && value >= 0;\n"
        "  const validCount = (value) => Number.isSafeInteger(value) && value >= 0;\n"
        "  const validId = (value) => typeof value === 'string' && value.length > 0;\n"
        "  const displayNumber = (value) => Number.isFinite(value) ? String(value) : 'unavailable';\n"
        "  const shortId = (value) => {\n"
        "    if (!validId(value)) return 'unknown';\n"
        "    return value.length > 18 ? value.slice(0, 10) + '…' + value.slice(-6) : value;\n"
        "  };\n"
        "  const amount = (value) => {\n"
        "    if (!Number.isSafeInteger(value) || value < 0) return '0.00000000';\n"
        "    const units = BigInt(value);\n"
        "    const whole = units / 100000000n;\n"
        "    const part = String(units % 100000000n).padStart(8, '0');\n"
        "    return String(whole) + '.' + part;\n"
        "  };\n"
        "  const utc = (value) => {\n"
        "    if (!Number.isFinite(value)) return 'unknown';\n"
        "    const date = new Date(value * 1000);\n"
        "    return Number.isNaN(date.getTime()) ? 'unknown' : date.toISOString().replace('T', ' ').replace('.000Z', ' UTC');\n"
        "  };\n"
        "\n"
        "  function setConnection(state, text) {\n"
        "    if (!status) return;\n"
        "    status.dataset.state = state;\n"
        "    status.classList.remove('badge-live', 'badge-warn', 'badge-bad');\n"
        "    status.classList.add(state === 'live' ? 'badge-live' : state === 'offline' || state === 'reorg' ? 'badge-bad' : 'badge-warn');\n"
        "    if (status.textContent !== text) status.textContent = text;\n"
        "  }\n"
        "\n"
        "  function pulse(node) {\n"
        "    const card = node && node.closest('.metric-card');\n"
        "    if (!card) return;\n"
        "    card.classList.remove('is-updated');\n"
        "    requestAnimationFrame(() => requestAnimationFrame(() => card.classList.add('is-updated')));\n"
        "    card.addEventListener('animationend', () => card.classList.remove('is-updated'), { once: true });\n"
        "  }\n"
        "\n"
        "  function setText(id, value, shouldPulse = true) {\n"
        "    const node = byId(id);\n"
        "    if (!node) return;\n"
        "    const text = String(value);\n"
        "    if (node.textContent === text) return;\n"
        "    node.textContent = text;\n"
        "    if (shouldPulse) pulse(node);\n"
        "  }\n"
        "\n"
        "  function makeSpan(className, text) {\n"
        "    const node = document.createElement('span');\n"
        "    node.className = className;\n"
        "    node.textContent = text;\n"
        "    return node;\n"
        "  }\n"
        "\n"
        "  function makeTile(block) {\n"
        "    if (!validHeight(block.height) || !validId(block.id)) return null;\n"
        "    const tile = document.createElement('a');\n"
        "    tile.className = 'block-tile is-new';\n"
        "    tile.href = '/block/' + encodeURIComponent(String(block.height));\n"
        "    tile.setAttribute('role', 'listitem');\n"
        "    tile.setAttribute('aria-label', 'Block ' + String(block.height));\n"
        "    tile.title = block.id;\n"
        "    tile.dataset.height = String(block.height);\n"
        "    tile.dataset.blockId = block.id;\n"
        "\n"
        "    const head = makeSpan('block-tile-head', '');\n"
        "    head.append(makeSpan('block-height', '#' + String(block.height)));\n"
        "    const problem = typeof block.problem === 'string' && block.problem.length > 0;\n"
        "    head.append(makeSpan('badge ' + (problem ? 'badge-bad' : 'badge-good'), problem ? block.problem : 'validated'));\n"
        "    tile.append(head, makeSpan('block-hash', shortId(block.id)));\n"
        "\n"
        "    const meta = makeSpan('block-meta', '');\n"
        "    meta.append(makeSpan('', 'TX ' + (validCount(block.transactions) ? String(block.transactions) : '—')));\n"
        "    meta.append(makeSpan('', validCount(block.size) ? String(block.size) + ' B' : 'size —'));\n"
        "    const quality = block.score && validCount(block.score.quality) ? String(block.score.quality) : '—';\n"
        "    meta.append(makeSpan('', 'Q ' + quality));\n"
        "    tile.append(meta);\n"
        "    return tile;\n"
        "  }\n"
        "\n"
        "  function prependBlocks(blocks) {\n"
        "    if (!strip) return;\n"
        "    const empty = strip.querySelector('.empty-state');\n"
        "    if (empty) empty.remove();\n"
        "    for (const block of blocks) {\n"
        "      const tile = makeTile(block);\n"
        "      if (tile) strip.prepend(tile);\n"
        "    }\n"
        "    const limitValue = Number(strip.dataset.limit);\n"
        "    const limit = validCount(limitValue) && limitValue > 0 ? limitValue : 50;\n"
        "    const tiles = strip.querySelectorAll('.block-tile');\n"
        "    for (let index = limit; index < tiles.length; index += 1) tiles[index].remove();\n"
        "  }\n"
        "\n"
        "  function markReorg(message) {\n"
        "    setConnection('reorg', 'reorg');\n"
        "    dashboard.classList.add('is-reorg');\n"
        "    if (waiting) waiting.textContent = 'Chain changed; refreshing validated state';\n"
        "    if (announcement) announcement.textContent = message;\n"
        "    window.location.reload();\n"
        "  }\n"
        "\n"
        "  function addedBlocks(data, nextHeight, nextId) {\n"
        "    const blocks = Array.isArray(data.blocks) ? data.blocks : [];\n"
        "    const anchor = blocks.find((block) => block && block.height === tipHeight);\n"
        "    if (!anchor || anchor.id !== tipId) return null;\n"
        "    const added = blocks.filter((block) => block && block.height > tipHeight && block.height <= nextHeight);\n"
        "    added.sort((left, right) => left.height - right.height);\n"
        "    if (added.length !== nextHeight - tipHeight) return null;\n"
        "    let expectedHeight = tipHeight + 1;\n"
        "    let expectedParent = tipId;\n"
        "    for (const block of added) {\n"
        "      if (!validHeight(block.height) || block.height !== expectedHeight || !validId(block.id) || block.parent_id !== expectedParent) return null;\n"
        "      expectedHeight += 1;\n"
        "      expectedParent = block.id;\n"
        "    }\n"
        "    return expectedParent === nextId ? added : null;\n"
        "  }\n"
        "\n"
        "  function updateSummary(data) {\n"
        "    const nextHeight = data.tip_height;\n"
        "    const nextId = data.tip_id;\n"
        "    if (!validHeight(nextHeight) || !validId(nextId)) throw new Error('invalid summary');\n"
        "    if (nextHeight !== tipHeight || nextId !== tipId) {\n"
        "      const reorg = nextHeight <= tipHeight;\n"
        "      setConnection(reorg ? 'reorg' : 'syncing', reorg ? 'reorg' : 'syncing');\n"
        "      if (reorg) dashboard.classList.add('is-reorg');\n"
        "      if (waiting) waiting.textContent = reorg ? 'Chain changed; refreshing validated state' : 'New block validated; refreshing';\n"
        "      if (announcement) announcement.textContent = reorg ? 'The validated chain changed. Reloading the dashboard.' : 'A new block was validated. Reloading the dashboard.';\n"
        "      window.location.reload();\n"
        "      return false;\n"
        "    }\n"
        "\n"
        "    setText('live-tip-height', '#' + String(nextHeight));\n"
        "    setText('live-next-height-detail', 'next height ' + displayNumber(data.next_height));\n"
        "    setText('live-tip-id', shortId(nextId));\n"
        "    const tipNode = byId('live-tip-id');\n"
        "    if (tipNode) tipNode.title = nextId;\n"
        "    setText('live-tip-id-detail', nextId);\n"
        "    setText('live-tip-time', utc(data.tip_time));\n"
        "    setText('live-block-count', displayNumber(data.block_count));\n"
        "    setText('live-header-detail', displayNumber(data.header_count) + ' headers to height ' + displayNumber(data.header_height));\n"
        "    setText('live-supply', amount(data.supply) + ' SGL');\n"
        "    setText('live-supply-detail', 'scheduled maximum supply ' + amount(data.max_supply) + ' SGL');\n"
        "    setText('live-reward', amount(data.next_reward) + ' SGL');\n"
        "    setText('live-halving-detail', Number.isFinite(data.next_halving_height) ? 'next halving at height ' + String(data.next_halving_height) : 'never (reward has decayed to zero)');\n"
        "    setText('live-complexity', Number.isFinite(data.complexity) ? 'C ' + String(data.complexity) : 'unavailable');\n"
        "    setText('live-retarget-detail', Number.isFinite(data.complexity) ? 'next C ' + displayNumber(data.next_complexity) + ' at height ' + displayNumber(data.next_retarget_height) : 'retarget data unavailable');\n"
        "\n"
        "    const puzzle = data.puzzle && typeof data.puzzle === 'object' ? data.puzzle : {};\n"
        "    const constraint = puzzle.constraint && typeof puzzle.constraint === 'object' ? puzzle.constraint : null;\n"
        "    setText('live-puzzle-heading', 'Puzzle for height ' + displayNumber(data.next_height), false);\n"
        "    setText('live-puzzle-par', displayNumber(puzzle.par), false);\n"
        "    setText('live-puzzle-constraint', constraint && Number.isFinite(constraint.id) ? String(constraint.id) + ' — ' + (typeof constraint.text === 'string' ? constraint.text : '') : '—', false);\n"
        "    setText('live-puzzle-k', displayNumber(puzzle.k), false);\n"
        "    setText('live-puzzle-seed', typeof puzzle.seed === 'string' ? puzzle.seed : '—', false);\n"
        "\n"
        "    if (waiting) waiting.textContent = 'Waiting for block #' + displayNumber(data.next_height);\n"
        "    return true;\n"
        "  }\n"
        "\n"
        "  function schedule(delay) {\n"
        "    if (timer !== null) window.clearTimeout(timer);\n"
        "    timer = null;\n"
        "    if (!document.hidden) timer = window.setTimeout(poll, delay);\n"
        "  }\n"
        "\n"
        "  async function poll() {\n"
        "    if (running || document.hidden) return;\n"
        "    running = true;\n"
        "    if (!hasSynced || failures > 0) setConnection('syncing', 'syncing');\n"
        "    controller = new AbortController();\n"
        "    try {\n"
        "      const response = await fetch('/api/summary', { cache: 'no-store', credentials: 'same-origin', headers: { Accept: 'application/json' }, signal: controller.signal });\n"
        "      if (!response.ok) throw new Error('summary unavailable');\n"
        "      const data = await response.json();\n"
        "      if (!updateSummary(data)) return;\n"
        "      failures = 0;\n"
        "      hasSynced = true;\n"
        "      setConnection('live', 'live');\n"
        "      schedule(pollDelay);\n"
        "    } catch (error) {\n"
        "      if (error && error.name === 'AbortError') return;\n"
        "      failures += 1;\n"
        "      setConnection('offline', 'offline');\n"
        "      if (waiting) waiting.textContent = 'Connection lost; waiting to retry';\n"
        "      if (announcement) announcement.textContent = 'Explorer connection offline. Retrying automatically.';\n"
        "      schedule(Math.min(maximumDelay, pollDelay * Math.pow(2, failures)));\n"
        "    } finally {\n"
        "      running = false;\n"
        "      controller = null;\n"
        "    }\n"
        "  }\n"
        "\n"
        "  document.addEventListener('visibilitychange', () => {\n"
        "    if (document.hidden) {\n"
        "      if (timer !== null) window.clearTimeout(timer);\n"
        "      timer = null;\n"
        "      if (controller) controller.abort();\n"
        "    } else {\n"
        "      schedule(0);\n"
        "    }\n"
        "  });\n"
        "  window.addEventListener('pagehide', () => {\n"
        "    if (timer !== null) window.clearTimeout(timer);\n"
        "    if (controller) controller.abort();\n"
        "  }, { once: true });\n"
        "\n"
        "  poll();\n"
               "})();\n")))))
