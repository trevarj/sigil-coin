;;; (sigil coin explorer store) — read-only reads from a node's database
;;;
;;; The explorer is a READER. It opens the same SQLite file a live node is
;;; writing and must never change a byte of it, so the handle is locked shut
;;; in two independent ways:
;;;
;;;   1. A database file that does not exist is NOT opened. `sqlite-open`
;;;      carries SQLite's `CREATE` flag, so opening a missing path would
;;;      create an empty database — a write, and a confusing one, because a
;;;      typo in `--data-dir` would then render an honest-looking empty
;;;      chain forever. `explorer-open` returns `#f` instead and the caller
;;;      renders the "no database" state.
;;;   2. Every handle that IS opened runs `PRAGMA query_only = ON` before
;;;      any other statement. From that point the connection refuses
;;;      `INSERT`, `UPDATE`, `DELETE`, `CREATE` and `DROP` with SQLite's
;;;      "attempt to write a readonly database". `sigil-sqlite` exposes only
;;;      `sqlite3_open()`, which has no `SQLITE_OPEN_READONLY` flag and no
;;;      URI filenames, so the pragma is the strongest lock expressible
;;;      here; `test-explorer.sgl` proves it by trying to write through an
;;;      explorer handle and by hashing the file before and after a full
;;;      sweep of every route.
;;;
;;; What the pragma does not cover: SQLite may still roll back a hot journal
;;; or checkpoint a WAL left by a crashed writer, because that is recovery
;;; performed by the file format, not a statement this module issues. No
;;; explorer code path asks for it.
;;;
;;; ## Reading a chain that is being written
;;;
;;; The node publishes its validated tip in `metadata` as
;;; `active-chain-tip-hash` / `active-chain-tip-height`, and the explorer
;;; walks backwards from there through `headers.prev_hash`. Walking the
;;; parent links rather than selecting by height is what keeps a fork
;;; sibling at the same height out of the answer.
;;;
;;; A node mid-sync has headers whose bodies have not arrived. Those still
;;; produce a block record — height, time, id, parent — with the body-derived
;;; fields left `#f`, so the list renders the gap instead of failing.
;;;
;;; ```scheme
;;; (define s (explorer-open sigilcoin-regtest-chain "/tmp/sigilcoin"))
;;; (explorer-summary-tip-height (explorer-chain-summary s))
;;; ```

(define-library (sigil coin explorer store)
  (import (sigil struct)
          (sigil fs)
          (sigil math)
          (sigil sqlite)
          (sigil bitcoin utils)
          (sigil bitcoin encoding)
          (sigil bitcoin script)
          (sigil bitcoin tx)
          (sigil bitcoin consensus)
          (sigil bitcoin node)
          (sigil coin puzzle)
          (sigil coin puzzle generator)
          (sigil coin consensus)
          (sigil coin node)
          (sigil coin explorer derive))
  (export
    ;; Addresses
    explorer-address-hrp
    explorer-script->address
    explorer-address->script

    ;; Opening
    explorer-db-path
    explorer-open
    explorer-close
    explorer-store
    explorer-store?
    explorer-store-db
    explorer-store-config

    ;; Blocks
    explorer-block
    explorer-block?
    explorer-block-height
    explorer-block-id
    explorer-block-hash-text
    explorer-block-time
    explorer-block-parent-id
    explorer-block-solution
    explorer-block-solution-source
    explorer-block-solution-length
    explorer-block-graffiti
    explorer-block-par
    explorer-block-seed
    explorer-block-reward
    explorer-block-payout-script
    explorer-block-payout-address
    explorer-block-transaction-count
    explorer-block-size
    explorer-block-problem
    explorer-block-under-par

    ;; Canonical blocks
    explorer-block-complexity
    explorer-block-constraint
    explorer-block-constraint-text
    explorer-block-k
    explorer-block-examples
    explorer-block-score-word
    explorer-block-score-length
    explorer-block-score-memory
    explorer-block-score-steps
    explorer-block-score-quality
    explorer-block-share-count
    explorer-block-shares
    explorer-block-commit-count
    explorer-block-outputs
    explorer-block-total-output
    explorer-block-author
    explorer-block-margin

    ;; Co-op shares
    explorer-share
    explorer-share?
    explorer-share-index
    explorer-share-pubkey-hex
    explorer-share-signature-hex
    explorer-share-blind-hex
    explorer-share-address
    explorer-share-solution
    explorer-share-solution-source
    explorer-share-solution-length
    explorer-share-par
    explorer-share-margin
    explorer-share-contribution
    explorer-share-steps
    explorer-share-cells
    explorer-share-memory-bucket
    explorer-share-step-bucket
    explorer-share-payout
    explorer-share-problem

    ;; Coinbase outputs
    explorer-output
    explorer-output?
    explorer-output-index
    explorer-output-role
    explorer-output-value
    explorer-output-script
    explorer-output-address
    explorer-output-expected

    ;; Chain summary
    explorer-summary
    explorer-summary?
    explorer-summary-chain-name
    explorer-summary-tip-height
    explorer-summary-tip-id
    explorer-summary-tip-time
    explorer-summary-header-height
    explorer-summary-header-count
    explorer-summary-block-count
    explorer-summary-supply
    explorer-summary-max-supply
    explorer-summary-next-height
    explorer-summary-next-reward
    explorer-summary-next-halving-height
    explorer-summary-puzzle-par
    explorer-summary-puzzle-seed
    explorer-summary-empty
    explorer-summary-complexity
    explorer-summary-next-complexity
    explorer-summary-next-retarget-height
    explorer-summary-puzzle-constraint
    explorer-summary-puzzle-constraint-text
    explorer-summary-puzzle-k
    explorer-summary-puzzle-examples

    ;; Queries
    explorer-default-page-size
    explorer-difficulty-window
    explorer-chain-summary
    explorer-recent-blocks
    explorer-block-by-height
    explorer-block-by-id
    explorer-address-blocks
    explorer-address-balance
    explorer-next-halving-height)

  (begin

    ;;; Human readable part of every SigilCoin address. Restated here rather
    ;;; than imported: `sigil-coin-cli` owns the wallet, and the explorer
    ;;; must not depend on a binary package to name an address.
    ;;;
    ;;; ```scheme
    ;;; explorer-address-hrp ; => "sgl"
    ;;; ```
    (define explorer-address-hrp "sgl")

    ;;; How many blocks a list page shows by default.
    (define explorer-default-page-size 25)

    ;;; How many blocks the difficulty history covers: four retarget
    ;;; windows, so a reader can see whether `C` is oscillating rather than
    ;;; adapting (Open Question 4).
    (define explorer-difficulty-window 64)

    ;; The most blocks any single walk of the chain will visit. An address
    ;; view has to scan the chain to find the blocks it mined, and this is
    ;; the ceiling on that scan.
    ;;
    ;; ponytail: linear scan per address view, capped. SigilCoin mines one
    ;; block a day, so 100k blocks is ~270 years of chain; add a
    ;; payout-address index (built by the explorer in its OWN database, not
    ;; the node's) if the scan ever becomes the slow part.
    (define %max-walk 100000)

    ;; ============================================================
    ;; Addresses
    ;; ============================================================

    ;;; Render a scriptPubKey as an `sgl1` address, or `#f` when it is not a
    ;;; witness program this chain has an address form for.
    ;;;
    ;;; Total: junk bytes yield `#f` rather than a raise, because the script
    ;;; comes out of a block and blocks are attacker-supplied.
    ;;;
    ;;; ```scheme
    ;;; (explorer-script->address (script-p2wpkh (make-bytevector 20 0)))
    ;;; ; => "sgl1q..."
    ;;; ```
    (define (explorer-script->address script)
      (: any? -> any?)
      (guard (e (#t #f))
        (and (bytevector? script)
             (let ((witness (script-witness-program-decode script)))
               (and witness
                    (segwit-encode explorer-address-hrp
                                   (car witness)
                                   (cadr witness)))))))

    ;;; Decode an `sgl1` address into the scriptPubKey that pays it, or `#f`.
    ;;;
    ;;; Total, and deliberately strict: the address arrives in a URL, so a
    ;;; `bc1` address, a bad checksum or a truncated program must all be a
    ;;; quiet `#f` that renders "unknown address", never a raise.
    ;;;
    ;;; ```scheme
    ;;; (explorer-address->script "sgl1qw508d6qejxtdg4y5r3zarvary0c5xw7kr43pwr")
    ;;; ; => the P2WPKH script
    ;;; (explorer-address->script "nonsense") ; => #f
    ;;; ```
    (define (explorer-address->script address)
      (: any? -> any?)
      (guard (e (#t #f))
        (and (string? address)
             (let ((decoded (segwit-decode address)))
               (and decoded
                    (string=? (car decoded) explorer-address-hrp)
                    (script-witness-program (cadr decoded)
                                            (caddr decoded)))))))

    ;; ============================================================
    ;; Opening
    ;; ============================================================

    ;;; An open, read-only handle on a node's database.
    ;;;
    ;;; The chain config is carried under `config` rather than `chain`
    ;;; because a one-element `(chain)` field spec collides with the core
    ;;; `chain` threading macro during expansion.
    (define-struct explorer-store
      (db)
      (config))

    ;;; Where a node keeps the database for `chain` under `data-dir`.
    ;;;
    ;;; Mirrors `sigil-bitcoin-node`'s own layout, which keeps the file name
    ;;; private. A test pins the two together.
    ;;;
    ;;; ```scheme
    ;;; (explorer-db-path sigilcoin-regtest-chain "/tmp/n")
    ;;; ; => "/tmp/n/sigilcoin-regtest.sqlite"
    ;;; ```
    (define (explorer-db-path chain data-dir)
      (: chain-config? string? -> string?)
      (string-append data-dir "/" (chain-config-name chain) ".sqlite"))

    ;;; Open the node database for `chain` under `data-dir`, read-only.
    ;;;
    ;;; Returns `#f` when there is no database there: `sqlite-open` would
    ;;; CREATE one, and creating a file is a write the explorer must not do.
    ;;;
    ;;; ```scheme
    ;;; (explorer-open sigilcoin-regtest-chain "/nowhere") ; => #f
    ;;; ```
    (define (explorer-open chain data-dir)
      (: chain-config? string? -> any?)
      (let ((path (explorer-db-path chain data-dir)))
        (and (file-exists? path)
             (let ((db (sqlite-open path)))
               (and db
                    (begin
                      ;; Before any other statement, and never turned off.
                      (sqlite-exec db "PRAGMA query_only = ON")
                      (explorer-store db: db config: chain)))))))

    ;;; Close a store's handle.
    ;;;
    ;;; ```scheme
    ;;; (explorer-close s) ; => #t
    ;;; ```
    (define (explorer-close store)
      (: explorer-store? -> boolean?)
      (sqlite-close (explorer-store-db store))
      #t)

    ;; ============================================================
    ;; Query helpers
    ;; ============================================================

    ;; Rows come back as alists keyed by symbol.
    (define (row-ref row key)
      (let ((pair (and (pair? row) (assq key row))))
        (and (pair? pair) (cdr pair))))

    ;; A database that exists but has no schema yet — a node killed between
    ;; `sqlite-open` and `db-create-schema` — answers every query with
    ;; "no such table". That is an empty chain, not an error.
    (define (query store sql . args)
      (guard (e (#t '()))
        (let ((rows (apply sqlite-query (explorer-store-db store) sql args)))
          (if (list? rows) rows '()))))

    (define (query-row store sql . args)
      (let ((rows (apply query store sql args)))
        (and (pair? rows) (car rows))))

    (define (count-of store sql . args)
      (let ((row (apply query-row store sql args)))
        (let ((value (row-ref row 'count)))
          (if (number? value) value 0))))

    (define (metadata store key)
      (let ((row (query-row store
                            "SELECT value FROM metadata WHERE key = ?"
                            key)))
        (row-ref row 'value)))

    (define (metadata-number store key default)
      (let* ((text (metadata store key))
             (value (and (string? text) (string->number text))))
        (if (and (number? value) (exact? value) (integer? value))
            value
            default)))

    (define %header-columns "hash, prev_hash, height, time, header_hex")

    (define (header-row store hash-text)
      (query-row store
                 (string-append "SELECT " %header-columns
                                " FROM headers WHERE hash = ?")
                 hash-text))

    (define (block-hex store hash-text)
      (let ((row (query-row store
                            "SELECT block_hex FROM blocks WHERE hash = ? AND validated = 1"
                            hash-text)))
        (let ((hex (row-ref row 'block_hex)))
          (and (string? hex) hex))))

    ;; The active tip the node published, or the chain's genesis when the
    ;; database predates that metadata or has not been written yet.
    (define (tip-hash-text store)
      (let ((text (metadata store "active-chain-tip-hash")))
        (if (and (string? text) (> (string-length text) 0))
            text
            (hex-encode (chain-config-genesis-hash
                          (explorer-store-config store))))))

    ;; ============================================================
    ;; Block records
    ;; ============================================================

    ;;; One block, flattened into what a page shows.
    ;;;
    ;;; Every body-derived field is `#f` when the body has not arrived or
    ;;; would not decode, so a mid-sync chain and a corrupt row render the
    ;;; same honest gap. `problem` names why, for the detail page.
    (define-struct explorer-block
      (height integer?)
      (id string?)
      (hash-text string?)
      (time integer?)
      (parent-id default: #f)
      (solution default: #f)
      (solution-source default: #f)
      (solution-length default: #f)
      (graffiti default: #f)
      (par default: #f)
      (seed default: #f)
      (reward default: 0)
      (payout-script default: #f)
      (payout-address default: #f)
      (transaction-count default: #f)
      (size default: #f)
      (problem default: #f)
      (complexity default: #f)
      (constraint default: #f)
      (constraint-text default: #f)
      (k default: #f)
      (examples default: '())
      (score-word default: #f)
      (score-length default: #f)
      (score-memory default: #f)
      (score-steps default: #f)
      (score-quality default: #f)
      (share-count default: #f)
      (shares default: '())
      (commit-count default: #f)
      (outputs default: '())
      (total-output default: #f)
      (author default: #f)
      (margin default: #f))

    ;;; One co-op share, as a block claims it (§6.2).
    ;;;
    ;;; `steps` and `cells` are what the share's program actually cost when
    ;;; the explorer re-ran it against the puzzle, and are only filled in on
    ;;; a block DETAIL view; a list page evaluates nothing. `problem` names
    ;;; why when they are missing.
    ;;;
    ;;; The signature is decoded but never verified: the node verified every
    ;;; share in a block it stored, and re-running ECDSA on a page load
    ;;; would spend a validator's budget re-deciding a settled question.
    (define-struct explorer-share
      (index integer?)
      (pubkey-hex string?)
      (signature-hex string?)
      (blind-hex string?)
      (address default: #f)
      (solution default: #f)
      (solution-source default: #f)
      (solution-length default: #f)
      (par default: #f)
      (margin default: #f)
      (contribution default: #f)
      (steps default: #f)
      (cells default: #f)
      (memory-bucket default: #f)
      (step-bucket default: #f)
      (payout default: #f)
      (problem default: #f))

    ;;; One coinbase output, with the role §6.5 gives it and the value that
    ;;; section says it should carry.
    ;;;
    ;;; `expected` is the split arithmetic's own answer; when it disagrees
    ;;; with `value` the page says so rather than hiding it, because a block
    ;;; whose outputs do not match the split is a block a node should have
    ;;; rejected.
    (define-struct explorer-output
      (index integer?)
      (role default: #f)
      (value default: 0)
      (script default: #f)
      (address default: #f)
      (expected default: #f))

    ;;; How many bytes under par a block's solution came in, or `#f` when
    ;;; either number is unknown. Negative means the miner published a
    ;;; longer program than the generator's own baseline.
    ;;;
    ;;; ```scheme
    ;;; (explorer-block-under-par b) ; => 3
    ;;; ```
    (define (explorer-block-under-par b)
      (: explorer-block? -> any?)
      (let ((par (explorer-block-par b))
            (used (explorer-block-solution-length b)))
        (and (number? par) (number? used) (- par used))))

    (define (hash-text->id hash-text)
      (guard (e (#t hash-text))
        (hex-encode (reverse-bytevector (hex-decode hash-text)))))

    ;; Canonical source for a solution, or #f when it does not parse. The
    ;; printer emits the shortest form the parser accepts, so this is the
    ;; expression as consensus sees it rather than as the miner spaced it.
    (define (solution-source solution)
      (let ((parsed (puzzle-parse solution)))
        (and (puzzle-ok? parsed)
             (guard (e (#t #f))
               (puzzle-print-expression (puzzle-result-value parsed))))))

    ;; The header a row carries, or #f. Complexity (`bits`) and the score
    ;; (`nonce`) live here rather than in the body, so a header-only row still
    ;; states the consensus parameters and quality claim it will have to
    ;; prove when the body arrives.
    (define (row-header hrow)
      (guard (e (#t #f))
        (let ((hex (row-ref hrow 'header_hex)))
          (and (string? hex) (block-header-parse (hex-decode hex))))))

    ;; The scriptSig of a parsed block's coinbase, or #f.
    (define (coinbase-script parsed)
      (guard (e (#t #f))
        (let ((coinbase (coin-block-coinbase parsed)))
          (and coinbase
               (txin-script-sig (car (transaction-inputs coinbase)))))))

    (define (coinbase-outputs parsed)
      (guard (e (#t '()))
        (let ((coinbase (coin-block-coinbase parsed)))
          (if coinbase (transaction-outputs coinbase) '()))))

    ;; Parse a validated block row by hash, absorbing corrupt database bytes.
    (define (stored-block store hash)
      (guard (e (#t #f))
        (and (bytevector? hash)
             (let ((hex (block-hex store (hex-encode hash))))
               (and hex (block-parse (hex-decode hex)))))))

    ;; Context for shares revealed at `height`. It derives the personalized
    ;; puzzle only; page loads deliberately do not verify commitments or ECDSA.
    (define (share-context store height parent-hash)
      (guard (e (#t #f))
        (and (> height 1)
             (let* ((row (header-row store (hex-encode parent-hash)))
                    (header (and row (row-header row)))
                    (parent-prev (and row (hex-decode (row-ref row 'prev_hash))))
                    (complexity (and header
                                     (explorer-complexity
                                       (block-header-bits header))))
                    (spec (and complexity
                               (explorer-puzzle parent-prev
                                                   (- height 1)
                                                   complexity))))
               (and spec
                    (coin-coop-context
                      parent-prev-hash: parent-prev
                      puzzle-height: (- height 1)
                      complexity: complexity
                      spec: spec
                      commits: '()))))))

    ;; One consensus share flattened for display. Signature and blind are
    ;; decoded as hex, never verified or interpreted by the explorer.
    (define (make-share index share payout context detail?)
      (let* ((pubkey (coin-share-pubkey share))
             (solution (coin-share-solution share))
             (personalized (and detail? context
                                (guard (e (#t #f))
                                  (coin-share-puzzle context pubkey))))
             (personalized-view
               (and personalized (explorer-puzzle-view personalized)))
             (par (and personalized-view (car personalized-view)))
             (length-used (bytevector-length solution))
             (margin (and par (< length-used par)
                          (guard (e (#t #f))
                            (coin-share-margin-milli par length-used))))
             (contribution (and margin
                                (guard (e (#t #f))
                                  (coin-share-contribution margin))))
             (cost (and personalized
                        (explorer-check-solution personalized solution)))
             (script (guard (e (#t #f)) (coin-share-script pubkey))))
        (explorer-share
          index: index
          pubkey-hex: (hex-encode pubkey)
          signature-hex: (hex-encode (coin-share-signature share))
          blind-hex: (hex-encode (coin-share-blind share))
          address: (explorer-script->address script)
          solution: solution
          solution-source: (solution-source solution)
          solution-length: length-used
          par: par
          margin: margin
          contribution: contribution
          steps: (and cost (car cost))
          cells: (and cost (cdr cost))
          memory-bucket: (and cost (explorer-bucket (cdr cost)))
          step-bucket: (and cost (explorer-bucket (car cost)))
          payout: payout
          problem: (cond ((not detail?) 'not-evaluated)
                         ((not personalized) 'puzzle-unknown)
                         ((not margin) 'share-not-under-par)
                         (cost #f)
                         (else 'not-a-solution)))))

    (define (output-role index share-count)
      (cond ((not (number? share-count)) 'unexpected)
            ((= index 0) 'producer)
            ((<= index share-count) 'share)
            ((and (> share-count 0) (= index (+ share-count 1))) 'carrier)
            (else 'unexpected)))

    ;; Label actual outputs against consensus's exact split plan.
    (define (make-outputs outputs shares carrier-script)
      (let* ((total (let loop ((xs outputs) (sum 0))
                      (if (null? xs)
                          sum
                          (loop (cdr xs) (+ sum (txout-value (car xs)))))))
             (share-count (and (list? shares) (length shares)))
             (plan (and (list? shares)
                        (guard (e (#t #f))
                          (coin-split-plan total shares carrier-script)))))
        (let loop ((xs outputs) (i 0) (expected plan) (out '()))
          (if (null? xs)
              (reverse out)
              (let ((script (txout-script-pubkey (car xs))))
                (loop (cdr xs)
                      (+ i 1)
                      (if (pair? expected) (cdr expected) '())
                      (cons (explorer-output
                              index: i
                              role: (output-role i share-count)
                              value: (txout-value (car xs))
                              script: script
                              address: (explorer-script->address script)
                              expected: (and (pair? expected)
                                             (car (car expected))))
                            out)))))))

    ;; Wire payloads and nested
    ;; SHARES/COMMITS fields are decoded only by consensus-owned codecs.
    (define (canonical-fields store base header parsed parent-hash detail?)
      (let* ((height (explorer-block-height base))
             (complexity (explorer-complexity (block-header-bits header)))
             (score-result (coin-score-check (block-header-nonce header)))
             (score (and (coin-ok? score-result)
                         (explorer-score (block-header-nonce header))))
             (spec (and (> height 0)
                        (explorer-puzzle parent-hash height complexity)))
             (view (explorer-puzzle-view spec))
             (decoded (and parsed
                           (coin-coinbase-payload-decode
                             (coinbase-script parsed))))
             (payload (and decoded (coin-ok? decoded)
                           (coin-result-value decoded)))
             (shares-result (and payload
                                 (coin-shares-decode
                                   (coin-coinbase-payload-shares payload))))
             (commits-result (and payload
                                  (coin-commits-decode
                                    (coin-coinbase-payload-commits payload))))
             (shares (and shares-result (coin-ok? shares-result)
                          (coin-result-value shares-result)))
             (commits (and commits-result (coin-ok? commits-result)
                           (coin-result-value commits-result)))
             (share-count (and shares (length shares)))
             (parent-block (and (pair? shares)
                                (stored-block store parent-hash)))
             (carrier-script (and parent-block
                                  (coin-carrier-script parent-block)))
             (outputs (if parsed
                          (make-outputs (coinbase-outputs parsed)
                                        shares carrier-script)
                          '()))
             (graffiti (and payload
                            (coin-coinbase-payload-graffiti payload)))
             (solution (and payload
                            (coin-coinbase-payload-solution payload)))
             (par (and view (car view)))
             (length-used (and solution (bytevector-length solution)))
             (context (and detail? (pair? shares)
                           (share-context store height parent-hash))))
        (explorer-block
          height: height
          id: (explorer-block-id base)
          hash-text: (explorer-block-hash-text base)
          time: (explorer-block-time base)
          parent-id: (explorer-block-parent-id base)
          solution: solution
          solution-source: (and solution (solution-source solution))
          solution-length: length-used
          graffiti: graffiti
          par: par
          seed: (and (> height 0)
                     (explorer-seed parent-hash height complexity))
          reward: (explorer-block-reward base)
          payout-script: (and (pair? outputs)
                              (explorer-output-script (car outputs)))
          payout-address: (and (pair? outputs)
                               (explorer-output-address (car outputs)))
          transaction-count: (and parsed
                                  (guard (e (#t #f))
                                    (length (block-transactions parsed))))
          size: (and parsed (coin-block-size parsed))
          problem: (cond
                     ((not parsed) (explorer-block-problem base))
                     ((coin-failed? score-result)
                      (coin-result-reason score-result))
                     ((and decoded (coin-failed? decoded))
                      (coin-result-reason decoded))
                     ((and payload
                           (not (= height
                                   (coin-coinbase-payload-height payload))))
                      'coinbase-height-mismatch)
                     ((and shares-result (coin-failed? shares-result))
                      (coin-result-reason shares-result))
                     ((and commits-result (coin-failed? commits-result))
                      (coin-result-reason commits-result))
                     (else #f))
          complexity: complexity
          constraint: (and view (car (cdr view)))
          constraint-text: (and view (car (cdr (cdr view))))
          k: (and view (car (cdr (cdr (cdr view)))))
          examples: (if view (car (cdr (cdr (cdr (cdr view))))) '())
          score-word: (block-header-nonce header)
          score-length: (and score (list-ref score 0))
          score-memory: (and score (list-ref score 1))
          score-steps: (and score (list-ref score 2))
          score-quality: (and score (list-ref score 3))
          share-count: share-count
          shares: (let loop ((xs (if shares shares '()))
                             (i 0)
                             (payouts (share-payouts outputs))
                             (out '()))
                    (if (null? xs)
                        (reverse out)
                        (loop (cdr xs)
                              (+ i 1)
                              (if (pair? payouts) (cdr payouts) '())
                              (cons (make-share i
                                                (car xs)
                                                (and (pair? payouts)
                                                     (car payouts))
                                                context
                                                detail?)
                                    out))))
          commit-count: (and commits (length commits))
          outputs: outputs
          total-output: (let loop ((xs outputs) (sum 0))
                          (if (null? xs)
                              (and (pair? outputs) sum)
                              (loop (cdr xs)
                                    (+ sum (explorer-output-value (car xs))))))
          author: (explorer-author-tag graffiti)
          margin: (explorer-margin par length-used))))

    ;; The values of outputs 1..R, which are the share payouts.
    (define (share-payouts outputs)
      (let loop ((xs outputs) (out '()))
        (cond ((null? xs) (reverse out))
              ((eq? 'share (explorer-output-role (car xs)))
               (loop (cdr xs)
                     (cons (explorer-output-value (car xs)) out)))
              (else (loop (cdr xs) out)))))

    ;; Build the record from the header row plus, when it has arrived, the
    ;; body. Every step is guarded: a block row is bytes a peer sent.
    ;;
    ;; `detail?` is what a block PAGE passes and a list page does not: it
    ;; re-runs each co-op share's program to report what it cost. Nothing on
    ;; a list page evaluates anything.
    (define (make-block store hrow detail?)
      (let* ((hash-text (row-ref hrow 'hash))
             (prev-text (row-ref hrow 'prev_hash))
             (height (row-ref hrow 'height))
             (time (row-ref hrow 'time))
             (header (row-header hrow))
             (hex (block-hex store hash-text))
             (parsed (and hex (guard (e (#t #f)) (block-parse (hex-decode hex)))))
             (parent-hash (guard (e (#t #f)) (hex-decode prev-text)))
             (base (explorer-block
                     height: height
                     id: (hash-text->id hash-text)
                     hash-text: hash-text
                     time: time
                     parent-id: (and (string? prev-text)
                                     (hash-text->id prev-text))
                     reward: (guard (e (#t 0)) (coin-block-reward height))
                     ;; A node stores the genesis HEADER and no genesis
                     ;; body, so genesis is permanently body-less. Saying
                     ;; so is honest; calling it "not downloaded yet" is
                     ;; not, because it never will be.
                     problem: (cond (hex #f)
                                    ((= height 0) 'genesis)
                                    (else 'body-not-downloaded)))))
        (cond
          (header
           (guard (e (#t (explorer-block-with-problem base 'block-unreadable)))
             (canonical-fields store base header parsed parent-hash detail?)))
          (hex (explorer-block-with-problem base 'block-unparsable))
          (else base))))

    ;; A copy of `b` carrying `reason` instead of its current problem.
    (define (explorer-block-with-problem b reason)
      (explorer-block
        height: (explorer-block-height b)
        id: (explorer-block-id b)
        hash-text: (explorer-block-hash-text b)
        time: (explorer-block-time b)
        parent-id: (explorer-block-parent-id b)
        reward: (explorer-block-reward b)
        problem: reason))

    ;; ============================================================
    ;; Chain summary
    ;; ============================================================

    ;;; The numbers a summary page shows.
    (define-struct explorer-summary
      (chain-name string?)
      (tip-height integer?)
      (tip-id string?)
      (tip-time integer?)
      (header-height integer?)
      (header-count integer?)
      (block-count integer?)
      (supply integer?)
      (max-supply integer?)
      (next-height integer?)
      (next-reward integer?)
      (next-halving-height default: #f)
      (puzzle-par default: #f)
      (puzzle-seed default: #f)
      (empty default: #f)
      (complexity default: #f)
      (next-complexity default: #f)
      (next-retarget-height default: #f)
      (puzzle-constraint default: #f)
      (puzzle-constraint-text default: #f)
      (puzzle-k default: #f)
      (puzzle-examples default: '()))

    ;;; The next height at which the block reward halves, or `#f` once the
    ;;; schedule has decayed to zero and no later halving changes anything.
    ;;;
    ;;; ```scheme
    ;;; (explorer-next-halving-height 1)   ; => 731
    ;;; (explorer-next-halving-height 731) ; => 1461
    ;;; ```
    (define (explorer-next-halving-height height)
      (: integer? -> any?)
      (let* ((epoch (if (< height 1)
                        0
                        (quotient (- height 1) coin-halving-interval)))
             (next (+ (* (+ epoch 1) coin-halving-interval) 1)))
        (and (> (coin-block-reward next) 0) next)))

    ;;; Read the chain summary.
    ;;;
    ;;; `empty` is `#t` when the database holds no headers at all, which is
    ;;; a node that has not run rather than a chain with no blocks.
    ;;;
    ;;; ```scheme
    ;;; (explorer-summary-tip-height (explorer-chain-summary s)) ; => 3
    ;;; ```
    (define (explorer-chain-summary store)
      (: explorer-store? -> explorer-summary?)
      (let* ((config (explorer-store-config store))
             (header-count (count-of store
                                     "SELECT COUNT(*) AS count FROM headers"))
             (tip-text (tip-hash-text store))
             (tip-row (header-row store tip-text))
             (tip-height (if tip-row
                             (row-ref tip-row 'height)
                             (metadata-number store
                                              "active-chain-tip-height" 0)))
             (tip-time (if tip-row (row-ref tip-row 'time) 0))
             (next-height (+ tip-height 1))
             (tip-hash (guard (e (#t #f)) (hex-decode tip-text)))
             (tip-header (and tip-row (row-header tip-row)))
             (complexity (and tip-header
                              (explorer-complexity
                                (block-header-bits tip-header))))
             (next-complexity
               (and complexity
                    (explorer-next-complexity
                      next-height complexity (margin-window store))))
             (spec (and tip-hash next-complexity
                        (explorer-puzzle tip-hash next-height
                                         next-complexity)))
             (view (explorer-puzzle-view spec)))
        (explorer-summary
          chain-name: (chain-config-name config)
          tip-height: tip-height
          tip-id: (hash-text->id tip-text)
          tip-time: tip-time
          header-height: (let ((row (query-row
                                      store
                                      "SELECT MAX(height) AS count FROM headers")))
                           (let ((value (row-ref row 'count)))
                             (if (number? value) value 0)))
          header-count: header-count
          block-count: (count-of
                         store
                         "SELECT COUNT(*) AS count FROM blocks WHERE validated = 1")
          supply: (guard (e (#t 0)) (coin-cumulative-supply tip-height))
          max-supply: coin-max-supply
          next-height: next-height
          next-reward: (guard (e (#t 0)) (coin-block-reward next-height))
          next-halving-height: (explorer-next-halving-height tip-height)
          puzzle-par: (and view (car view))
          puzzle-seed: (and tip-hash next-complexity
                            (explorer-seed tip-hash next-height
                                           next-complexity))
          complexity: complexity
          next-complexity: next-complexity
          next-retarget-height: (next-retarget-height next-height)
          puzzle-constraint: (and view (car (cdr view)))
          puzzle-constraint-text: (and view (car (cdr (cdr view))))
          puzzle-k: (and view (car (cdr (cdr (cdr view)))))
          puzzle-examples: (if view (car (cdr (cdr (cdr (cdr view))))) '())
          empty: (= header-count 0))))

    ;; The first height at or after `height` where a retarget fires.
    (define (next-retarget-height height)
      (let loop ((h (max height coin-retarget-window)))
        (if (explorer-retarget-height? h) h (loop (+ h 1)))))

    ;; The margins for the 16 heights below the tip, oldest first, or `'()`
    ;; when any of them is unknown. `coin-complexity-for` wants a full
    ;; window or nothing: a partial window is a different rule, and §9.4 has
    ;; none.
    (define (margin-window store)
      (let ((out '()))
        (walk-chain store
                    coin-retarget-window
                    (lambda (b)
                      (set! out (cons (explorer-block-margin b) out))
                      #t))
        (if (or (not (= coin-retarget-window (length out)))
                (let loop ((xs out))
                  (cond ((null? xs) #f)
                        ((not (number? (car xs))) #t)
                        (else (loop (cdr xs))))))
            '()
            out)))

    ;; ============================================================
    ;; Block queries
    ;; ============================================================

    ;; Walk the active chain backwards from the tip, newest first, calling
    ;; `visit` with each block. `visit` returns #t to keep walking.
    (define (walk-chain store limit visit)
      (let loop ((hash-text (tip-hash-text store)) (seen 0))
        (if (or (>= seen limit) (>= seen %max-walk) (not (string? hash-text)))
            #t
            (let ((hrow (header-row store hash-text)))
              (if (not hrow)
                  #t
                  (let ((b (make-block store hrow #f)))
                    (if (not (visit b))
                        #t
                        (loop (row-ref hrow 'prev_hash) (+ seen 1)))))))))

    ;;; The `limit` most recent blocks on the active chain, newest first.
    ;;;
    ;;; ```scheme
    ;;; (map explorer-block-height (explorer-recent-blocks s 3)) ; => (3 2 1)
    ;;; ```
    (define (explorer-recent-blocks store limit)
      (: explorer-store? integer? -> list?)
      (let ((out '()))
        (walk-chain store
                    (max limit 0)
                    (lambda (b) (set! out (cons b out)) #t))
        (reverse out)))

    ;;; The active-chain block at `height`, or `#f`.
    ;;;
    ;;; Found by walking the parent links from the tip, so a fork sibling
    ;;; stored at the same height is never returned.
    ;;;
    ;;; ```scheme
    ;;; (explorer-block-height (explorer-block-by-height s 2)) ; => 2
    ;;; ```
    (define (explorer-block-by-height store height)
      (: explorer-store? any? -> any?)
      (if (not (and (number? height) (exact? height) (integer? height)
                    (>= height 0)))
          #f
          (let ((found #f))
            (walk-chain store
                        %max-walk
                        (lambda (b)
                          (cond ((= (explorer-block-height b) height)
                                 (set! found b)
                                 #f)
                                ((< (explorer-block-height b) height) #f)
                                (else #t))))
            (and found (detail-block store found)))))

    ;; Re-read a block with the detail work done. The walk that found it
    ;; deliberately did none, so a list of 25 blocks never evaluates a
    ;; single co-op share's program.
    (define (detail-block store b)
      (let ((hrow (header-row store (explorer-block-hash-text b))))
        (if hrow (make-block store hrow #t) b)))

    ;;; The block whose display id is `id`, or `#f`.
    ;;;
    ;;; The id is the reversed hash humans quote, so it is reversed back into
    ;;; the internal order the `headers` table is keyed by. Anything that is
    ;;; not 64 hex characters is `#f` rather than a query.
    ;;;
    ;;; ```scheme
    ;;; (explorer-block-by-id s coin-regtest-genesis-id-constant)
    ;;; ```
    (define (explorer-block-by-id store id)
      (: explorer-store? any? -> any?)
      (let ((hash-text (guard (e (#t #f))
                         (and (string? id)
                              (= 64 (string-length id))
                              (hex-encode (reverse-bytevector (hex-decode id)))))))
        (and hash-text
             (let ((hrow (header-row store hash-text)))
               (and hrow (make-block store hrow #t))))))

    ;;; Blocks on the active chain whose coinbase paid `script`, newest
    ;;; first, at most `limit` of them.
    ;;;
    ;;; ```scheme
    ;;; (length (explorer-address-blocks s script 10)) ; => 2
    ;;; ```
    (define (explorer-address-blocks store script limit)
      (: explorer-store? any? integer? -> list?)
      (if (not (bytevector? script))
          '()
          (let ((out '()) (found 0))
            (walk-chain store
                        %max-walk
                        (lambda (b)
                          (when (equal? script (explorer-block-payout-script b))
                            (set! out (cons b out))
                            (set! found (+ found 1)))
                          (< found limit)))
            (reverse out))))

    ;;; Current balance of `script` in daviwils, from the node's UTXO set.
    ;;;
    ;;; Unspent outputs only; the node keeps spent rows around with
    ;;; `active = 0`.
    ;;;
    ;;; ```scheme
    ;;; (explorer-address-balance s script) ; => 10000000000
    ;;; ```
    (define (explorer-address-balance store script)
      (: explorer-store? any? -> integer?)
      (if (not (bytevector? script))
          0
          (let* ((row (query-row
                        store
                        "SELECT COALESCE(SUM(value), 0) AS count FROM utxos WHERE active = 1 AND script_pubkey = ?"
                        (hex-encode script)))
                 (value (row-ref row 'count)))
            (if (number? value) value 0))))))
