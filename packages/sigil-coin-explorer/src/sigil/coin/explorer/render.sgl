;;; (sigil coin explorer render) — HTML and JSON for chain data
;;;
;;; ## Everything from a block is hostile until it is escaped
;;;
;;; Graffiti is 400 bytes a miner chose, and a solution is 512 bytes a miner
;;; chose. Both reach this module as raw `bytevector`s, and both are printed
;;; on a page other people read. So there is exactly ONE way text from a
;;; block becomes markup, and it is two stages that always run in order:
;;;
;;;   1. SANITIZE — `explorer-safe-text` decodes bytes as STRICT UTF-8. Any
;;;      byte that is not part of a well-formed, shortest-form, non-surrogate
;;;      sequence is replaced by U+FFFD and the decoder resyncs at the next
;;;      byte. `utf8->string` is deliberately not used: it passes an invalid
;;;      byte through as a lone code point, which is exactly the shape that
;;;      later turns into a mismatched escape. Control code points (C0,
;;;      DEL, C1) are replaced too, so a raw `0x00` or `0x1b` can neither
;;;      truncate the page nor start a terminal escape in `curl` output.
;;;   2. ESCAPE — `explorer-escape` replaces `&`, `<`, `>`, `"` and `'` with
;;;      their entities. `&` goes first, so an entity this stage introduces
;;;      is never re-escaped. Quoting both quote characters means the same
;;;      procedure is correct in element text and inside an attribute value,
;;;      which removes the "which escaper did I need here" mistake entirely.
;;;
;;; `explorer-text` is the two stages composed, and it is what every page
;;; calls. Nothing here interpolates block data into a `<script>` or a
;;; `style` attribute. The first-party client reads JSON and assigns hostile
;;; strings with `textContent`, never as markup.
;;;
;;; ```scheme
;;; (explorer-text (string->utf8 "<script>alert(1)</script>"))
;;; ; => "&lt;script&gt;alert(1)&lt;/script&gt;"
;;; ```
;;;
;;; ## JSON
;;;
;;; The JSON endpoints serve `application/json`, are built from ordered
;;; alists so key order is stable for anyone diffing responses, and carry
;;; sanitized strings — `sigil-json` escapes quotes, backslashes and control
;;; characters, and a client that renders a value into a page is responsible
;;; for its own escaping, exactly as with any other API.

(define-library (sigil coin explorer render)
  (import (sigil math)
          (sigil string)
          (sigil time)
          (sigil json)
          (sigil bitcoin encoding)
          (sigil coin consensus)
          (sigil coin explorer store))
  (export
    ;; Escaping
    explorer-replacement-char
    explorer-safe-text
    explorer-escape
    explorer-text

    ;; Formatting
    explorer-sigil-amount
    explorer-format-time
    explorer-under-par-text
    explorer-margin-text
    explorer-author-tally
    explorer-author-window

    ;; Pages
    explorer-page
    explorer-summary-page
    explorer-blocks-page
    explorer-block-page
    explorer-transaction-page
    explorer-difficulty-page
    explorer-address-page
    explorer-missing-page
    explorer-no-database-page

    ;; JSON
    explorer-summary-json
    explorer-blocks-json
    explorer-block-json
    explorer-transaction-json
    explorer-difficulty-json
    explorer-address-json
    explorer-error-json)

  (begin

    ;;; The code point every ill-formed byte and every control character is
    ;;; replaced by: U+FFFD REPLACEMENT CHARACTER.
    (define explorer-replacement-char #xfffd)

    ;; ============================================================
    ;; Stage 1: bytes to a safe string
    ;; ============================================================

    ;; A code point is safe to display when it is not a C0 control, not DEL,
    ;; and not a C1 control. Tabs and newlines are excluded as well: block
    ;; text is shown inside table cells and `<pre>`, where a stray newline
    ;; is noise rather than layout the miner is entitled to.
    (define (displayable? cp)
      (and (>= cp #x20)
           (not (= cp #x7f))
           (not (and (>= cp #x80) (<= cp #x9f)))))

    (define (continuation? b)
      (and (>= b #x80) (<= b #xbf)))

    ;; Decode the UTF-8 sequence starting at `i`. Returns (code-point . next).
    ;; Rejects, by returning U+FFFD and a single-byte step:
    ;;   * a continuation byte or #xc0/#xc1/#xf5+ in leading position
    ;;   * a truncated sequence
    ;;   * a non-continuation byte where one is required
    ;;   * an overlong encoding, a UTF-16 surrogate, or a value above
    ;;     U+10FFFF
    (define (decode-at bytes n i)
      (let ((b (bytevector-u8-ref bytes i)))
        (cond
          ((< b #x80) (cons b (+ i 1)))
          ((and (>= b #xc2) (<= b #xdf))
           (if (and (< (+ i 1) n)
                    (continuation? (bytevector-u8-ref bytes (+ i 1))))
               (cons (+ (* (- b #xc0) 64)
                        (- (bytevector-u8-ref bytes (+ i 1)) #x80))
                     (+ i 2))
               (cons explorer-replacement-char (+ i 1))))
          ((and (>= b #xe0) (<= b #xef))
           (if (and (< (+ i 2) n)
                    (continuation? (bytevector-u8-ref bytes (+ i 1)))
                    (continuation? (bytevector-u8-ref bytes (+ i 2))))
               (let ((cp (+ (* (- b #xe0) 4096)
                            (* (- (bytevector-u8-ref bytes (+ i 1)) #x80) 64)
                            (- (bytevector-u8-ref bytes (+ i 2)) #x80))))
                 ;; Below U+0800 is overlong; U+D800..U+DFFF is a surrogate.
                 (if (or (< cp #x800) (and (>= cp #xd800) (<= cp #xdfff)))
                     (cons explorer-replacement-char (+ i 1))
                     (cons cp (+ i 3))))
               (cons explorer-replacement-char (+ i 1))))
          ((and (>= b #xf0) (<= b #xf4))
           (if (and (< (+ i 3) n)
                    (continuation? (bytevector-u8-ref bytes (+ i 1)))
                    (continuation? (bytevector-u8-ref bytes (+ i 2)))
                    (continuation? (bytevector-u8-ref bytes (+ i 3))))
               (let ((cp (+ (* (- b #xf0) 262144)
                            (* (- (bytevector-u8-ref bytes (+ i 1)) #x80) 4096)
                            (* (- (bytevector-u8-ref bytes (+ i 2)) #x80) 64)
                            (- (bytevector-u8-ref bytes (+ i 3)) #x80))))
                 (if (or (< cp #x10000) (> cp #x10ffff))
                     (cons explorer-replacement-char (+ i 1))
                     (cons cp (+ i 4))))
               (cons explorer-replacement-char (+ i 1))))
          (else (cons explorer-replacement-char (+ i 1))))))

    ;;; Decode attacker-supplied bytes into a string that is safe to display.
    ;;;
    ;;; Strict UTF-8: every ill-formed byte and every control character
    ;;; becomes U+FFFD. A string argument is passed through the same control
    ;;; filter, so a canonically printed solution carrying a literal `0x01`
    ;;; is cleaned as well.
    ;;;
    ;;; ```scheme
    ;;; (explorer-safe-text #u8(104 105))          ; => "hi"
    ;;; (explorer-safe-text #u8(104 #xff 105))     ; => "h\xFFFD;i"
    ;;; ```
    (define (explorer-safe-text value)
      (: any? -> string?)
      (cond
        ((string? value)
         (list->string
           (map (lambda (c)
                  (if (displayable? (char->integer c))
                      c
                      (integer->char explorer-replacement-char)))
                (string->list value))))
        ((bytevector? value)
         (let ((n (bytevector-length value)))
           (let loop ((i 0) (acc '()))
             (if (>= i n)
                 (list->string (reverse acc))
                 (let* ((step (decode-at value n i))
                        (cp (car step)))
                   (loop (cdr step)
                         (cons (integer->char
                                 (if (displayable? cp)
                                     cp
                                     explorer-replacement-char))
                               acc)))))))
        (else "")))

    ;; ============================================================
    ;; Stage 2: a safe string to markup
    ;; ============================================================

    ;;; Escape a string for HTML, in element text and in attribute values
    ;;; alike.
    ;;;
    ;;; `&` is replaced first, so the entities this introduces are not
    ;;; escaped a second time.
    ;;;
    ;;; ```scheme
    ;;; (explorer-escape "<a href='x'>&") ; => "&lt;a href=&#39;x&#39;&gt;&amp;"
    ;;; ```
    (define (explorer-escape text)
      (: any? -> string?)
      (if (not (string? text))
          ""
          (let ((n (string-length text)))
            (let loop ((i 0) (acc '()))
              (if (>= i n)
                  (apply string-append (reverse acc))
                  (let ((c (string-ref text i)))
                    (loop (+ i 1)
                          (cons (cond ((char=? c #\&) "&amp;")
                                      ((char=? c #\<) "&lt;")
                                      ((char=? c #\>) "&gt;")
                                      ((char=? c #\") "&quot;")
                                      ((char=? c #\') "&#39;")
                                      (else (string c)))
                                acc))))))))

    ;;; Sanitize then escape: the only way block data becomes markup.
    ;;;
    ;;; ```scheme
    ;;; (explorer-text (string->utf8 "<b>")) ; => "&lt;b&gt;"
    ;;; ```
    (define (explorer-text value)
      (: any? -> string?)
      (explorer-escape (explorer-safe-text value)))

    ;; ============================================================
    ;; Formatting
    ;; ============================================================

    ;;; Render daviwils as a decimal SGL amount with all eight places.
    ;;;
    ;;; ```scheme
    ;;; (explorer-sigil-amount 10000000000) ; => "100.00000000"
    ;;; ```
    (define (explorer-sigil-amount daviwils)
      (: any? -> string?)
      (if (not (and (number? daviwils) (exact? daviwils)
                    (integer? daviwils) (>= daviwils 0)))
          "0.00000000"
          (let* ((whole (quotient daviwils coin-daviwils-per-sigil))
                 (part (number->string (remainder daviwils
                                                  coin-daviwils-per-sigil)))
                 (pad (make-string (- 8 (string-length part)) #\0)))
            (string-append (number->string whole) "." pad part))))

    ;;; Render a block timestamp as UTC.
    ;;;
    ;;; ```scheme
    ;;; (explorer-format-time 1767225600) ; => "2026-01-01 00:00:00 UTC"
    ;;; ```
    (define (explorer-format-time seconds)
      (: any? -> string?)
      (if (not (number? seconds))
          "unknown"
          (guard (e (#t (number->string seconds)))
            (string-append (format-datetime seconds #t) " UTC"))))

    ;;; How a block's margin against par reads.
    ;;;
    ;;; ```scheme
    ;;; (explorer-under-par-text 3)  ; => "3 under"
    ;;; (explorer-under-par-text 0)  ; => "at par"
    ;;; (explorer-under-par-text -2) ; => "2 over"
    ;;; ```
    (define (explorer-under-par-text delta)
      (: any? -> string?)
      (cond ((not (number? delta)) "unknown")
            ((> delta 0) (string-append (number->string delta) " under"))
            ((= delta 0) "at par")
            (else (string-append (number->string (- delta)) " over"))))

    ;;; How a retarget margin reads: milli-units of par, as a percentage
    ;;; with the sign that says which way the field is going (§9.1).
    ;;;
    ;;; ```scheme
    ;;; (explorer-margin-text 100)  ; => "+10.0% (under par)"
    ;;; (explorer-margin-text -23)  ; => "-2.3% (over par)"
    ;;; (explorer-margin-text 0)    ; => "0.0% (at par)"
    ;;; ```
    (define (explorer-margin-text milli)
      (: any? -> string?)
      (if (not (and (number? milli) (exact? milli) (integer? milli)))
          "unknown"
          (let* ((magnitude (abs milli))
                 (whole (quotient magnitude 10))
                 (tenth (remainder magnitude 10)))
            (string-append (cond ((> milli 0) "+")
                                 ((< milli 0) "-")
                                 (else ""))
                           (number->string whole) "." (number->string tenth)
                           "% "
                           (cond ((> milli 0) "(under par)")
                                 ((< milli 0) "(over par)")
                                 (else "(at par)"))))))

    ;;; Seconds of history the author tally covers: one week.
    (define explorer-author-window 604800)

    ;; Bump a name's count, keeping first-seen order.
    (define (bump-author tally name)
      (cond ((null? tally) (list (cons name 1)))
            ((string=? (car (car tally)) name)
             (cons (cons name (+ 1 (cdr (car tally)))) (cdr tally)))
            (else (cons (car tally) (bump-author (cdr tally) name)))))

    ;; Insertion sort: most blocks first, then by name. The list is one
    ;; entry per distinct author in a page's worth of blocks.
    ;;
    ;; ponytail: O(n^2) on a list of a handful of names. Reach for a real
    ;; sort the day an explorer page shows thousands of authors.
    (define (sort-tally tally)
      (let insert ((rest tally) (out '()))
        (if (null? rest)
            out
            (insert (cdr rest)
                    (let place ((xs out))
                      (cond
                        ((null? xs) (list (car rest)))
                        ((or (> (cdr (car rest)) (cdr (car xs)))
                             (and (= (cdr (car rest)) (cdr (car xs)))
                                  (string<? (car (car rest)) (car (car xs)))))
                         (cons (car rest) xs))
                        (else (cons (car xs) (place (cdr xs))))))))))

    ;;; Which self-declared authors mined the given blocks, and how many
    ;;; each, most first.
    ;;;
    ;;; A block counts when its graffiti carries the `/name/` convention and
    ;;; its timestamp is at or after `since`; pass `#f` for `since` to count
    ;;; every block given. The name is SANITIZED here and nowhere else: it
    ;;; is attacker-chosen bytes, so it reaches this list already stripped of
    ;;; ill-formed sequences and control characters, and the callers escape
    ;;; it on the way into markup like any other block text.
    ;;;
    ;;; ```scheme
    ;;; (explorer-author-tally blocks #f) ; => (("opus-5" . 3) ("fable-5" . 1))
    ;;; ```
    (define (explorer-author-tally blocks since)
      (: list? any? -> list?)
      (sort-tally
        (let loop ((xs blocks) (tally '()))
          (if (null? xs)
              tally
              (let ((author (explorer-block-author (car xs)))
                    (time (explorer-block-time (car xs))))
                (if (or (not author)
                        (and (number? since)
                             (number? time)
                             (< time since)))
                    (loop (cdr xs) tally)
                    (loop (cdr xs)
                          (bump-author tally
                                       (explorer-safe-text author)))))))))

    ;; ============================================================
    ;; HTML scaffolding
    ;; ============================================================

    (define %style
      (string-append
        "@font-face{font-family:Plus Jakarta Sans;src:local('Plus Jakarta Sans'),url(/assets/plus-jakarta.woff2) format('woff2');font-display:swap;font-weight:400 800}"
        "@font-face{font-family:JetBrains Mono;src:local('JetBrains Mono'),url(/assets/jetbrains-mono.woff2) format('woff2');font-display:swap;font-weight:400 700}"
        ":root{color-scheme:dark;--bg:#090a0d;--surface:#101216;--panel:#15181d;--raised:#1b1f25;--line:#2a2e35;--line-hot:#4a3a24;--text:#f2f0eb;--muted:#9299a6;--amber:#f6a623;--orange:#f97316;--violet:#a78bfa;--cyan:#55dce8;--good:#57d38c;--bad:#ff6b6b}"
        "*{box-sizing:border-box}html{background:var(--bg);scroll-padding-top:5rem}"
        "body{margin:0;color:var(--text);background:radial-gradient(circle at 78% -10rem,rgba(167,139,250,.1),transparent 32rem),linear-gradient(rgba(255,255,255,.014) 1px,transparent 1px),var(--bg);background-size:auto,100% 3rem,auto;font-family:Plus Jakarta Sans,Inter,system-ui,sans-serif;font-size:15px;line-height:1.5}"
        ".topbar{position:sticky;z-index:20;top:0;display:flex;align-items:center;gap:1.5rem;min-height:3.5rem;padding:.55rem max(1rem,calc((100vw - 92rem)/2));border-bottom:1px solid var(--line);background:rgba(9,10,13,.94);box-shadow:0 8px 24px rgba(0,0,0,.22);backdrop-filter:blur(14px)}"
        ".wordmark{display:flex;align-items:center;gap:.65rem;color:var(--text);font-weight:800;text-decoration:none;white-space:nowrap}.wordmark-symbol{display:block;width:2rem;height:2rem;object-fit:contain}.wordmark small{color:var(--muted);font-weight:500}"
        "nav{display:flex;align-items:center;flex-wrap:wrap;gap:.2rem;margin-left:auto}nav a{padding:.35rem .62rem;border-radius:.35rem;color:var(--muted);font-size:.84rem;font-weight:650;text-decoration:none}nav a:hover{color:var(--text);background:var(--raised)}"
        ".shell{width:min(92rem,calc(100% - 2rem));margin:auto;padding:1.5rem 0 5rem}a{color:var(--cyan);text-underline-offset:.2em}a:hover{color:#a8f6fc}"
        "h1,h2{letter-spacing:-.035em}h1{margin:.25rem 0;font-size:clamp(2rem,4vw,3.4rem);line-height:1.05}h2{margin:0 0 1rem;font-size:1.15rem}p{margin:.55rem 0 1rem}.q{color:var(--muted)}.mono,code,pre,td:first-child,.metric-value{font-family:JetBrains Mono,ui-monospace,SFMono-Regular,Consolas,monospace;font-variant-numeric:tabular-nums}"
        ".badge{display:inline-flex;align-items:center;gap:.35rem;width:max-content;padding:.18rem .5rem;border:1px solid #4c515b;border-radius:999px;background:#20242a;color:#c6cbd3;font-family:JetBrains Mono,ui-monospace,monospace;font-size:.69rem;font-weight:700;letter-spacing:.04em;line-height:1.25;text-transform:uppercase}.badge:before{width:.38rem;height:.38rem;border-radius:50%;background:currentColor;content:''}.badge-live,.badge-good{border-color:rgba(87,211,140,.35);background:rgba(87,211,140,.09);color:var(--good)}.badge-warn{border-color:rgba(246,166,35,.38);background:rgba(246,166,35,.09);color:var(--amber)}.badge-bad{border-color:rgba(255,107,107,.4);background:rgba(255,107,107,.09);color:var(--bad)}.badge-violet{border-color:rgba(167,139,250,.4);background:rgba(167,139,250,.09);color:var(--violet)}.status-badge{margin-left:.1rem}"
        ".dashboard-hero,.page-head{display:flex;align-items:end;justify-content:space-between;gap:1.5rem;margin-bottom:1.2rem;padding:.35rem 0}.eyebrow{margin:0 0 .45rem;color:var(--amber);font-family:JetBrains Mono,ui-monospace,monospace;font-size:.73rem;font-weight:700;letter-spacing:.09em;text-transform:uppercase}.hero-note{max-width:36rem;margin:0;color:var(--muted);text-align:right}"
        ".metric-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.65rem;margin-bottom:1rem}.metric-card{min-width:0;min-height:7.3rem;padding:1rem;border:1px solid var(--line);border-top:2px solid var(--line-hot);border-radius:.55rem;background:linear-gradient(145deg,rgba(246,166,35,.035),transparent 45%),var(--panel);box-shadow:0 10px 26px rgba(0,0,0,.14)}.metric-card.is-updated{animation:metric-pulse .9s ease-out}.metric-label{display:block;margin-bottom:.65rem;color:var(--muted);font-size:.71rem;font-weight:750;letter-spacing:.07em;text-transform:uppercase}.metric-value{display:block;overflow:hidden;color:var(--text);font-size:clamp(1.05rem,2vw,1.5rem);font-weight:700;line-height:1.25;text-overflow:ellipsis;white-space:nowrap}.metric-value.accent,.metric-value .accent{color:var(--amber)}.metric-detail{display:block;overflow:hidden;margin-top:.42rem;color:var(--muted);font-size:.74rem;text-overflow:ellipsis;white-space:nowrap}"
        ".panel{margin:0 0 1rem;padding:1rem;border:1px solid var(--line);border-radius:.6rem;background:rgba(21,24,29,.94);box-shadow:0 14px 34px rgba(0,0,0,.14)}.panel-head{display:flex;align-items:center;justify-content:space-between;gap:1rem;margin-bottom:.75rem}.panel-head h2{margin:0}.panel h3{margin:1rem 0 .65rem;font-size:.82rem;letter-spacing:.04em;text-transform:uppercase;color:var(--muted)}.content-panel{margin-top:1rem}.content-panel>p.q{max-width:75rem}.detail-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(18rem,.6fr);gap:1rem}.stack{display:grid;gap:1rem}.stack>.panel{margin:0}"
        ".block-strip{display:flex;gap:.55rem;overflow-x:auto;padding:.1rem .05rem .55rem;scroll-snap-type:x proximity;scrollbar-color:var(--line) transparent}.block-strip>.empty-state{flex:1}.block-tile{flex:0 0 13.5rem;scroll-snap-align:start;display:grid;gap:.45rem;padding:.75rem;border:1px solid var(--line);border-left:3px solid var(--amber);border-radius:.45rem;background:var(--surface);color:var(--text);text-decoration:none;transition:border-color .15s ease,transform .15s ease}.block-tile.is-new{animation:block-arrive .85s cubic-bezier(.2,.8,.2,1)}.block-tile:hover{border-color:var(--orange);color:var(--text);transform:translateY(-2px)}.block-tile-head{display:flex;align-items:center;justify-content:space-between;gap:.5rem}.block-height{color:var(--amber);font-family:JetBrains Mono,ui-monospace,monospace;font-size:1rem;font-weight:800}.block-hash{overflow:hidden;color:var(--muted);font-family:JetBrains Mono,ui-monospace,monospace;font-size:.71rem;text-overflow:ellipsis;white-space:nowrap}.block-meta{display:flex;gap:.55rem;color:#c2c7ce;font-size:.7rem}.block-meta span+span{padding-left:.55rem;border-left:1px solid var(--line)}.live-state{display:flex;align-items:center;justify-content:flex-end;flex-wrap:wrap;gap:.5rem}.waiting-indicator{color:var(--muted);font-family:JetBrains Mono,ui-monospace,monospace;font-size:.74rem}.waiting-indicator:before{display:inline-block;width:.42rem;height:.42rem;margin-right:.45rem;border-radius:50%;background:var(--amber);content:'';animation:waiting-pulse 1.8s ease-in-out infinite}.is-reorg .waiting-indicator{color:var(--bad)}@keyframes block-arrive{0%{opacity:0;transform:translateX(-2rem);box-shadow:0 0 0 rgba(246,166,35,0)}55%{opacity:1;transform:translateX(0);box-shadow:0 0 1.5rem rgba(246,166,35,.42)}100%{box-shadow:0 0 0 rgba(246,166,35,0)}}@keyframes metric-pulse{0%,100%{border-top-color:var(--line-hot);box-shadow:0 10px 26px rgba(0,0,0,.14)}35%{border-top-color:var(--amber);box-shadow:0 0 1.25rem rgba(246,166,35,.28)}}@keyframes waiting-pulse{0%,100%{opacity:.35;transform:scale(.75)}50%{opacity:1;transform:scale(1.15)}}"
        ".table-scroll{overflow:auto;max-width:100%;border:1px solid var(--line);border-radius:.45rem}.table-scroll table{border:0}table{width:100%;border-collapse:separate;border-spacing:0;background:var(--surface);font-size:.79rem}th,td{min-width:6.5rem;padding:.52rem .65rem;border-bottom:1px solid var(--line);text-align:left;vertical-align:top}thead th{position:sticky;z-index:2;top:0;background:#20242a;color:#d9dde3;font-size:.69rem;letter-spacing:.055em;text-transform:uppercase}tbody th{background:#171a1f;color:#c6cbd3;font-size:.75rem}tbody tr:last-child>td,tbody tr:last-child>th{border-bottom:0}tbody tr{transition:background .12s ease}tbody tr:hover{background:rgba(246,166,35,.055)}td a{font-family:JetBrains Mono,ui-monospace,monospace}.hash-cell{max-width:26rem;overflow-wrap:anywhere}"
        "pre,code{font-family:JetBrains Mono,ui-monospace,SFMono-Regular,Consolas,monospace}pre{overflow:auto;max-height:32rem;margin:0;padding:.75rem;border:1px solid var(--line);border-radius:.4rem;background:#0c0e11;color:#dfe3e8;white-space:pre-wrap;word-break:break-all}"
        ".notice{margin:1rem 0;padding:.85rem 1rem;border:1px solid var(--line);border-left:3px solid var(--cyan);border-radius:.4rem;background:rgba(85,220,232,.06)}.notice-warn{border-left-color:var(--amber);background:rgba(246,166,35,.07)}.notice-error{border-color:rgba(255,107,107,.35);border-left-color:var(--bad);background:rgba(255,107,107,.07)}.empty-state{display:grid;min-height:9rem;place-items:center;padding:2rem;border:1px dashed #3b4049;border-radius:.5rem;background:rgba(16,18,22,.7);color:var(--muted);text-align:center}"
        ".sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}:focus-visible{outline:3px solid var(--cyan);outline-offset:3px}"
        "@media(max-width:1000px){.metric-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.detail-grid{grid-template-columns:1fr}}"
        "@media(max-width:680px){body{font-size:14px}.topbar{align-items:flex-start;flex-wrap:wrap;gap:.35rem .8rem;padding:.45rem .6rem}.wordmark{flex:1}.wordmark small,.status-badge{display:none}nav{order:2;width:100%;justify-content:space-between;border-top:1px solid var(--line);padding-top:.3rem}nav a{padding:.28rem}.shell{width:calc(100% - 1rem);padding-top:1rem}.dashboard-hero,.page-head{align-items:flex-start;flex-direction:column}.hero-note{text-align:left}.metric-grid{grid-template-columns:1fr 1fr;gap:.45rem}.metric-card{min-height:6.6rem;padding:.75rem}.metric-value{font-size:1rem}.panel{padding:.7rem}.block-tile{flex-basis:11.75rem}th,td{min-width:5.5rem;padding:.45rem .5rem}}"
        "@media(max-width:430px){.metric-grid{grid-template-columns:1fr}.metric-card{min-height:0}}@media(prefers-reduced-motion:reduce){*,*:before,*:after{scroll-behavior:auto!important;transition:none!important;animation:none!important}.block-tile:hover{transform:none}}"))

    (define (join parts)
      (apply string-append parts))

    (define (rows cells)
      (join (map (lambda (cell) (string-append "<td>" cell "</td>")) cells)))

    (define (headings names)
      (join (map (lambda (name)
                   (string-append "<th scope=\"col\">" name "</th>"))
                 names)))

    (define (field label value)
      (string-append "<tr><th scope=\"row\">" label "</th><td>" value
                     "</td></tr>"))

    (define (table-wrap markup)
      (string-append "<div class=\"table-scroll\">" markup "</div>"))

    (define (badge class text)
      (string-append "<span class=\"badge " class "\">" text "</span>"))

    (define (margin-badge milli)
      (badge (cond ((not (number? milli)) "")
                   ((> milli 0) "badge-good")
                   ((< milli 0) "badge-bad")
                   (else "badge-warn"))
             (explorer-escape (explorer-margin-text milli))))

    (define (under-par-badge delta)
      (badge (cond ((not (number? delta)) "")
                   ((> delta 0) "badge-good")
                   ((< delta 0) "badge-bad")
                   (else "badge-warn"))
             (explorer-escape (explorer-under-par-text delta))))

    (define (short-id id)
      (if (and (string? id) (> (string-length id) 18))
          (string-append (substring id 0 10) "…"
                         (substring id (- (string-length id) 6)
                                    (string-length id)))
          (if (string? id) id "unknown")))

    ;;; Wrap a page body in the shared shell.
    ;;;
    ;;; `title` is escaped here, so callers pass plain text.
    ;;;
    ;;; ```scheme
    ;;; (explorer-page "SigilCoin" "<p>hi</p>")
    ;;; ```
    (define (explorer-page title body)
      (: string? string? -> string?)
      (join (list
              "<!DOCTYPE html>\n<html lang=\"en\"><head>"
              "<meta charset=\"utf-8\">"
              "<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">"
              "<link rel=\"icon\" type=\"image/png\" sizes=\"64x64\" href=\"/assets/sigilcoin-favicon.png\">"
              "<title>" (explorer-escape title) "</title>"
              "<style>" %style "</style>"
              "<script src=\"/assets/explorer.js\" defer></script>"
              "</head><body>"
              "<header class=\"topbar\">"
              "<a class=\"wordmark\" href=\"/\">"
              "<img class=\"wordmark-symbol\" src=\"/assets/sigilcoin-symbol.png\" width=\"32\" height=\"32\" alt=\"\">"
              "<span>SigilCoin <small>Explorer</small></span></a>"
              "<span class=\"badge badge-live status-badge\">read only</span>"
              "<nav aria-label=\"Explorer navigation\"><a href=\"/\">Summary</a>"
              "<a href=\"/blocks\">Blocks</a>"
              "<a href=\"/difficulty\">Difficulty</a>"
              "<a href=\"/api/summary\">API</a></nav></header>"
              "<main class=\"shell\">" body "</main>"
              "</body></html>\n")))

    (define (block-link b)
      (string-append "<a href=\"/block/"
                     (explorer-escape (number->string
                                        (explorer-block-height b)))
                     "\">"
                     (explorer-escape (number->string
                                        (explorer-block-height b)))
                     "</a>"))

    (define (address-cell b)
      (let ((address (explorer-block-payout-address b)))
        (if (string? address)
            (string-append "<a href=\"/address/" (explorer-escape address)
                           "\">" (explorer-escape address) "</a>")
            "<span class=\"q\">unrecognised script</span>")))

    (define (optional-number value)
      (if (number? value) (number->string value) "&mdash;"))
    ;; Targets are uint256 values. JSON keeps them as fixed-width hex strings
    ;; so browser clients never round consensus integers through IEEE-754.
    (define (lottery-target-hex value)
      (and (number? value)
           (exact? value)
           (integer? value)
           (>= value 0)
           (let ((raw (number->string value 16)))
             (and (<= (string-length raw) 64)
                  (string-append
                    (make-string (- 64 (string-length raw)) #\0)
                    raw)))))

    (define (graffiti-cell b)
      (let ((graffiti (explorer-block-graffiti b)))
        (if (and (bytevector? graffiti)
                 (> (bytevector-length graffiti) 0))
            (string-append "<span class=\"q\">" (explorer-text graffiti)
                           "</span>")
            "<span class=\"q\">&mdash;</span>")))

    ;; The solution as consensus prints it, falling back to the raw bytes
    ;; when the miner published something that does not parse. Both are
    ;; sanitized and escaped; neither is trusted.
    (define (solution-text b)
      (let ((source (explorer-block-solution-source b))
            (raw (explorer-block-solution b)))
        (cond ((string? source) (explorer-text source))
              ((bytevector? raw) (explorer-text raw))
              (else "&mdash;"))))

    (define (block-rows blocks)
      (join (map (lambda (b)
                   (string-append
                     "<tr>"
                     (rows (list
                             (block-link b)
                             (explorer-escape
                               (explorer-format-time
                                 (explorer-block-time b)))
                             (address-cell b)
                             (optional-number
                               (explorer-block-solution-length b))
                             (optional-number (explorer-block-par b))
                             (under-par-badge
                               (explorer-block-under-par b))
                             (explorer-escape
                               (explorer-sigil-amount
                                 (explorer-block-reward b)))
                             (graffiti-cell b)))
                     "</tr>"))
                 blocks)))

    (define %block-headings
      '("height" "time" "miner" "bytes" "par" "margin"
        "scheduled subsidy" "quote"))

    (define (block-tile b)
      (let* ((id (explorer-block-id b))
             (roll (explorer-block-lottery-roll b))
             (roll-text (if (string? roll) roll id))
             (height (number->string (explorer-block-height b)))
             (nonce (explorer-block-nonce b))
             (target (lottery-target-hex
                       (explorer-block-lottery-target b)))
             (bonus (explorer-block-lottery-bonus b))
             (multiplier (explorer-block-lottery-multiplier b))
             (expected (explorer-block-lottery-expected-rolls b))
             (problem (explorer-block-problem b)))
        (join (list
                "<a class=\"block-tile\" href=\"/block/" height
                "\" role=\"listitem\" aria-label=\"Block " height
                "; nonce " (explorer-escape (optional-number nonce))
                "; bonus " (explorer-escape (optional-number bonus))
                "; multiplier "
                (explorer-escape (optional-number multiplier))
                "; expected rolls "
                (explorer-escape (optional-number expected))
                "\" data-height=\"" height "\" data-block-id=\""
                (explorer-escape id) "\" data-lottery-roll=\""
                (explorer-escape roll-text) "\" data-lottery-target=\""
                (explorer-escape (if target target "")) "\" title=\"Winning roll "
                (explorer-escape roll-text) "; target "
                (explorer-escape (if target target "unavailable")) "\">"
                "<span class=\"block-tile-head\"><span class=\"block-height\">#"
                height "</span>"
                (if problem
                    (badge "badge-bad"
                           (explorer-escape (symbol->string problem)))
                    (badge "badge-good" "qualifying"))
                "</span><span class=\"block-hash\">roll "
                (explorer-escape (short-id roll-text)) "</span>"
                "<span class=\"block-meta\"><span>N "
                (optional-number nonce) "</span><span>&times;"
                (optional-number multiplier) " (+"
                (optional-number bonus) " B)</span><span>1/"
                (optional-number expected) "</span></span></a>"))))

    (define (block-strip blocks)
      (string-append
        "<div id=\"live-block-strip\" class=\"block-strip\" role=\"list\" aria-label=\"Recent blocks\" data-limit=\""
        (number->string explorer-default-page-size) "\">"
        (if (null? blocks)
            "<div class=\"empty-state\">No blocks yet.</div>"
            (join (map block-tile blocks)))
        "</div>"))

    ;; ============================================================
    ;; Puzzle, lottery, shares and payout sections
    ;; ============================================================

    (define (hex-word n)
      (if (number? n)
          (string-append "0x" (number->string n 16))
          "&mdash;"))

    (define (amount-cell value)
      (if (number? value)
          (explorer-escape (explorer-sigil-amount value))
          "&mdash;"))

    (define (signed-amount-cell value)
      (if (not (number? value))
          "&mdash;"
          (let ((prefix (cond ((< value 0) "-")
                              ((> value 0) "+")
                              (else ""))))
            (explorer-escape
              (string-append prefix
                             (explorer-sigil-amount
                               (if (< value 0) (- value) value)))))))

    ;; The k input/output pairs, canonically printed and escaped. They come
    ;; from the generator rather than from a miner, and they still go
    ;; through `explorer-text`: the day a puzzle draws a string literal, the
    ;; difference between "trusted" and "escaped anyway" is a page.
    (define (examples-table pairs)
      (if (null? pairs)
          "<div class=\"empty-state\">No examples for this height.</div>"
          (table-wrap
            (string-append
              "<table><thead><tr>" (headings '("input" "output"))
              "</tr></thead><tbody>"
              (join (map (lambda (pair)
                           (string-append
                             "<tr><td><pre>" (explorer-text (car pair))
                             "</pre></td><td><pre>" (explorer-text (cdr pair))
                             "</pre></td></tr>"))
                         pairs))
              "</tbody></table>"))))

    (define (puzzle-section b)
      (join (list
              "<section class=\"panel content-panel\"><h2>Puzzle</h2>"
              "<p class=\"q\">A solution is a one-argument function that"
              " reproduces every pair below, under the day's constraint."
              " Nothing here is stored in the block: every node derives"
              " it from the parent hash, the height and C.</p>"
              (table-wrap
                (string-append
                  "<table><tbody>"
                  (field "complexity C"
                         (optional-number (explorer-block-complexity b)))
                  (field "constraint"
                         (let ((ci (explorer-block-constraint b))
                               (text (explorer-block-constraint-text b)))
                           (if (number? ci)
                               (string-append (number->string ci)
                                              " &mdash; "
                                              (explorer-escape
                                                (if (string? text) text "")))
                               "&mdash;")))
                  (field "examples (k)" (optional-number (explorer-block-k b)))
                  (field "par" (optional-number (explorer-block-par b)))
                  "</tbody></table>"))
              (examples-table (explorer-block-examples b))
              "</section>")))

    (define (lottery-section b)
      (let ((target (lottery-target-hex
                      (explorer-block-lottery-target b)))
            (problem (explorer-block-problem b)))
        (join
          (list
            "<section class=\"panel content-panel\"><h2>Nonce lottery</h2>"
            "<p class=\"q\">The block ID is the header's 256-bit roll. A"
            " header qualifies when that roll is at or below the effective"
            " target. The chain retargets the compact base target from block"
            " intervals; each byte saved below par doubles admission odds,"
            " up to eight bytes. Fork choice uses cumulative base work.</p>"
            (table-wrap
              (join
                (list
                  "<table><thead><tr>"
                  (headings '("field" "value" "meaning"))
                  "</tr></thead><tbody><tr>"
                  (rows
                    (list
                      "winning roll (block ID)"
                      (string-append
                        "<span class=\"hash-cell mono\">"
                        (explorer-escape
                          (explorer-block-lottery-roll b))
                        "</span>")
                      (cond
                        ((or (eq? problem 'lottery-not-qualified)
                             (eq? problem 'solution-over-par))
                         (badge "badge-bad" "not qualifying"))
                        (target (badge "badge-good" "qualifying"))
                        (else "<span class=\"q\">unavailable</span>"))))
                  "</tr><tr>"
                  (rows
                    (list
                      "target"
                      (if target
                          (string-append
                            "<span class=\"hash-cell mono\">0x"
                            (explorer-escape target) "</span>")
                          "&mdash;")
                      "<span class=\"q\">roll must be at or below this value</span>"))
                  "</tr><tr>"
                  (rows
                    (list
                      "header nonce"
                      (let ((nonce (explorer-block-nonce b)))
                        (if (number? nonce)
                            (string-append
                              (number->string nonce) " ("
                              (hex-word nonce) ")")
                            "&mdash;"))
                      "<span class=\"q\">uint32 lottery search nonce</span>"))
                  "</tr><tr>"
                  (rows
                    (list
                      "claimed length L"
                      (string-append
                        (optional-number
                          (explorer-block-claimed-length b))
                        " bytes")
                      "<span class=\"q\">encoded in header version</span>"))
                  "</tr><tr>"
                  (rows
                    (list
                      "compact base target"
                      (let ((bits (explorer-block-bits b)))
                        (if (number? bits)
                            (string-append (number->string bits) " ("
                                           (hex-word bits) ")")
                            "&mdash;"))
                      "<span class=\"q\">retargeted from canonical block intervals</span>"))
                  "</tr><tr>"
                  (rows
                    (list
                      "base target"
                      (let ((base (lottery-target-hex
                                    (explorer-block-base-target b))))
                        (if base
                            (string-append
                              "<span class=\"hash-cell mono\">0x"
                              (explorer-escape base) "</span>")
                            "&mdash;"))
                      "<span class=\"q\">determines cumulative chain work</span>"))
                  "</tr><tr>"
                  (rows
                    (list
                      "cumulative base work"
                      (optional-number (explorer-block-chain-work b))
                      "<span class=\"q\">fork-choice weight through this block</span>"))
                  "</tr><tr>"
                  (rows
                    (list
                      "savings bonus"
                      (string-append "+"
                        (optional-number
                          (explorer-block-lottery-bonus b))
                        " bytes")
                      "<span class=\"q\">capped at eight bytes below par</span>"))
                  "</tr><tr>"
                  (rows
                    (list
                      "odds multiplier"
                      (string-append
                        (optional-number
                          (explorer-block-lottery-multiplier b))
                        "&times;")
                      "<span class=\"q\">one doubling per bonus byte</span>"))
                  "</tr><tr>"
                  (rows
                    (list
                      "expected rolls"
                      (optional-number
                        (explorer-block-lottery-expected-rolls b))
                      "<span class=\"q\">exact expectation, rounded up</span>"))
                  "</tr></tbody></table>")))
            "</section>"))))

    (define (share-source-text s)
      (let ((source (explorer-share-solution-source s))
            (raw (explorer-share-solution s)))
        (cond ((string? source) (explorer-text source))
              ((bytevector? raw) (explorer-text raw))
              (else "&mdash;"))))

    (define (share-address-cell s)
      (let ((address (explorer-share-address s)))
        (if (string? address)
            (string-append "<a href=\"/address/" (explorer-escape address)
                           "\">" (explorer-escape address) "</a>")
            "<span class=\"q\">unrecognised key</span>")))

    (define (share-row s)
      (string-append
        "<tr>"
        (rows (list (number->string (explorer-share-index s))
                    (share-address-cell s)
                    (optional-number (explorer-share-solution-length s))
                    (optional-number (explorer-share-par s))
                    (margin-badge (explorer-share-margin s))
                    (badge "badge-violet"
                           (optional-number
                             (explorer-share-contribution s)))
                    (optional-number (explorer-share-steps s))
                    (optional-number (explorer-share-cells s))
                    (optional-number (explorer-share-step-bucket s))
                    (optional-number (explorer-share-memory-bucket s))
                    (amount-cell (explorer-share-payout s))
                    (let ((problem (explorer-share-problem s)))
                      (if problem
                          (badge "badge-bad"
                                 (explorer-escape
                                   (symbol->string problem)))
                          (badge "badge-good" "ok")))))
        "</tr>"
        "<tr><td colspan=\"12\"><span class=\"q\">pubkey "
        (explorer-escape (explorer-share-pubkey-hex s))
        " &middot; signature "
        (explorer-escape (explorer-share-signature-hex s))
        " &middot; blind "
        (explorer-escape (explorer-share-blind-hex s))
        "</span><pre>" (share-source-text s) "</pre></td></tr>"))

    (define %share-headings
      '("#" "miner" "bytes" "personal par" "margin" "Q+" "steps"
        "cells" "SB" "MB" "payout" "problem"))

    (define (shares-section b)
      (let ((shares (explorer-block-shares b)))
            (join (list
                    "<section class=\"panel content-panel\"><h2>Co-op shares</h2>"
                    (if (null? shares)
                        (string-append
                          "<div class=\"empty-state\">No shares. The solo"
                          " coinbase mints floor(80% of scheduled subsidy)"
                          " plus fees; the remaining subsidy is unminted.</div>")
                        (join (list
                                "<p class=\"q\">Each share solves its own"
                                " pubkey-personalized version of the parent"
                                " height's puzzle. Par, margin and Q+ come"
                                " from consensus's pure source preview."
                                " Signatures are decoded but not re-verified"
                                " on page load; node validation already settled"
                                " them.</p>"
                                "<div class=\"table-scroll\"><table><thead><tr>"
                                (headings %share-headings)
                                "</tr></thead><tbody>"
                                (join (map share-row shares))
                                "</tbody></table></div>")))
                    "<p>aggregate share quality: "
                    (optional-number (explorer-block-share-quality b))
                    " &middot; commitments carried: "
                    (optional-number (explorer-block-commit-count b))
                    "</p></section>"))))

    (define (role-text role)
      (cond ((eq? role 'producer) "producer")
            ((eq? role 'share) "share")
            ((eq? role 'carrier) "carrier (the previous producer)")
            (else "unexpected")))

    (define (output-row o)
      (let ((value (explorer-output-value o))
            (expected (explorer-output-expected o)))
        (string-append
          "<tr>"
          (rows (list (number->string (explorer-output-index o))
                      (badge "badge-violet"
                             (explorer-escape
                               (role-text (explorer-output-role o))))
                      (let ((address (explorer-output-address o)))
                        (if (string? address)
                            (string-append "<a href=\"/address/"
                                           (explorer-escape address) "\">"
                                           (explorer-escape address) "</a>")
                            "<span class=\"q\">unrecognised script</span>"))
                      (amount-cell value)
                      (amount-cell expected)
                      (if (and (number? value) (number? expected))
                          (if (= value expected)
                              (badge "badge-good" "ok")
                              (badge "badge-bad" "disagrees"))
                          "<span class=\"q\">&mdash;</span>")))
          "</tr>")))

    (define %output-headings
      '("#" "role" "paid to" "actual value" "payout preview" ""))

    (define (expected-output-total outputs)
      (let loop ((xs outputs) (sum 0))
        (cond ((null? xs) sum)
              ((number? (explorer-output-expected (car xs)))
               (loop (cdr xs)
                     (+ sum (explorer-output-expected (car xs)))))
              (else #f))))

    (define (payout-section b)
      (let ((outputs (explorer-block-outputs b)))
        (if (null? outputs)
            ""
            (join (list
                    "<section class=\"panel content-panel\"><h2>Coinbase payout</h2>"
                    (if (and (number? (explorer-block-share-count b))
                             (> (explorer-block-share-count b) 0))
                        (string-append
                          "<p class=\"q\">Cooperative blocks mint scheduled"
                          " subsidy plus fees. Shares divide floor(10% of"
                          " scheduled subsidy) by previewed contribution,"
                          " the carrier receives floor(5% of scheduled"
                          " subsidy), and the producer receives fees and every"
                          " integer remainder.</p>")
                        (string-append
                          "<p class=\"q\">Solo blocks mint floor(80% of"
                          " scheduled subsidy) plus fees. The remaining"
                          " scheduled subsidy is unminted.</p>"))
                    "<div class=\"table-scroll\"><table><thead><tr>"
                    (headings %output-headings) "</tr></thead><tbody>"
                    (join (map output-row outputs))
                    "<tr>"
                    (rows (list "" "<b>actual coinbase total</b>" ""
                                (amount-cell
                                  (explorer-block-total-output b))
                                (amount-cell
                                  (expected-output-total outputs))
                                "<span class=\"q\">minted</span>"))
                    "</tr></tbody></table></div></section>")))))

    (define (transaction-link id)
      (if (string? id)
          (let ((text (explorer-escape id)))
            (string-append
              "<a class=\"hash-cell mono\" href=\"/tx/" text "\">"
              text "</a>"))
          "<span class=\"q\">&mdash;</span>"))

    (define (transaction-address-cell address)
      (if (string? address)
          (let ((text (explorer-escape address)))
            (string-append
              "<a href=\"/address/" text "\">" text "</a>"))
          "<span class=\"q\">unrecognised script</span>"))

    (define (transaction-row tx)
      (string-append
        "<tr>"
        (rows
          (list
            (number->string (explorer-transaction-index tx))
            (if (explorer-transaction-coinbase? tx)
                (badge "badge-violet" "coinbase")
                (badge "badge-good" "transfer"))
            (transaction-link (explorer-transaction-id tx))
            (number->string (explorer-transaction-input-count tx))
            (number->string (explorer-transaction-output-count tx))
            (amount-cell (explorer-transaction-total-output tx))))
        "</tr>"))

    (define (transactions-section b)
      (let ((transactions (explorer-block-transactions b)))
        (join
          (list
            "<section class=\"panel content-panel\"><h2>Transactions</h2>"
            (if (null? transactions)
                "<div class=\"empty-state\">Transaction bodies are unavailable.</div>"
                (string-append
                  "<div class=\"table-scroll\"><table><thead><tr>"
                  (headings '("#" "type" "transaction id" "inputs" "outputs"
                              "total output"))
                  "</tr></thead><tbody>"
                  (join (map transaction-row transactions))
                  "</tbody></table></div>"))
            "</section>"))))
    (define (transaction-input-row input)
      (let ((coinbase? (explorer-transaction-input-coinbase? input)))
        (string-append
          "<tr>"
          (rows
            (list
              (number->string (explorer-transaction-input-index input))
              (if coinbase?
                  (badge "badge-violet" "coinbase input")
                  (badge "badge-good" "spend"))
              (if coinbase?
                  "<span class=\"q\">new coin issuance</span>"
                  (transaction-link
                    (explorer-transaction-input-previous-id input)))
              (if coinbase?
                  "&mdash;"
                  (optional-number
                    (explorer-transaction-input-previous-index input)))
              (if coinbase?
                  "<span class=\"q\">not applicable</span>"
                  (transaction-address-cell
                    (explorer-transaction-input-address input)))
              (amount-cell (explorer-transaction-input-value input))))
          "</tr>")))

    (define (transaction-inputs-section tx)
      (let ((inputs (explorer-transaction-inputs tx)))
        (join
          (list
            "<section class=\"panel\"><h2>Inputs</h2>"
            (if (null? inputs)
                "<div class=\"empty-state\">No decoded inputs are available.</div>"
                (table-wrap
                  (string-append
                    "<table><thead><tr>"
                    (headings
                      '("#" "type" "previous transaction" "output"
                        "address" "value"))
                    "</tr></thead><tbody>"
                    (join (map transaction-input-row inputs))
                    "</tbody></table>")))
            "</section>"))))

    (define (transaction-output-row output)
      (string-append
        "<tr>"
        (rows
          (list
            (number->string (explorer-transaction-output-index output))
            (transaction-address-cell
              (explorer-transaction-output-address output))
            (amount-cell (explorer-transaction-output-value output))))
        "</tr>"))

    (define (transaction-outputs-section tx)
      (let ((outputs (explorer-transaction-outputs tx)))
        (join
          (list
            "<section class=\"panel\"><h2>Outputs</h2>"
            (if (null? outputs)
                "<div class=\"empty-state\">No decoded outputs are available.</div>"
                (table-wrap
                  (string-append
                    "<table><thead><tr>"
                    (headings '("#" "address" "value"))
                    "</tr></thead><tbody>"
                    (join (map transaction-output-row outputs))
                    "</tbody></table>")))
            "</section>"))))

    (define (address-transaction-row tx)
      (let ((received (explorer-address-transaction-received tx))
            (spent (explorer-address-transaction-spent tx)))
        (string-append
          "<tr>"
          (rows
            (list
              (string-append
                "<a href=\"/block/"
                (explorer-escape
                  (number->string (explorer-address-transaction-height tx)))
                "\">"
                (number->string (explorer-address-transaction-height tx))
                "</a>")
              (explorer-escape
                (explorer-format-time (explorer-address-transaction-time tx)))
              (transaction-link (explorer-address-transaction-id tx))
              (amount-cell received)
              (amount-cell spent)
              (signed-amount-cell (- received spent))))
          "</tr>")))

    (define (address-transactions-section transactions)
      (join
        (list
          "<section class=\"panel\"><h2>Recent transactions</h2>"
          (if (null? transactions)
              "<div class=\"empty-state\">No transactions found on the active chain.</div>"
              (string-append
                "<div class=\"table-scroll\"><table><thead><tr>"
                (headings '("block" "time" "transaction id" "received" "spent"
                            "net"))
                "</tr></thead><tbody>"
                (join (map address-transaction-row transactions))
                "</tbody></table></div>"))
          "</section>")))

    (define %difficulty-headings
      '("height" "C" "par" "bytes" "margin" ""))

    ;; Blocks arrive newest first, so a row's "previous" complexity is the
    ;; row below it. Marking a retarget by comparing the two needs no
    ;; schedule constant and stays right if the window ever moves.
    (define (difficulty-rows blocks)
      (let loop ((xs blocks) (out '()))
        (if (null? xs)
            (join (reverse out))
            (let* ((b (car xs))
                   (current (explorer-block-complexity b))
                   (previous (and (pair? (cdr xs))
                                  (explorer-block-complexity (car (cdr xs)))))
                   (moved (and (number? current) (number? previous)
                               (not (= current previous)))))
              (loop (cdr xs)
                    (cons (string-append
                            "<tr>"
                            (rows (list
                                    (block-link b)
                                    (optional-number current)
                                    (optional-number (explorer-block-par b))
                                    (optional-number
                                      (explorer-block-solution-length b))
                                    (margin-badge
                                      (explorer-block-margin b))
                                    (if moved
                                        (string-append
                                          "retarget "
                                          (number->string previous)
                                          " &rarr; "
                                          (number->string current))
                                        "")))
                            "</tr>")
                          out))))))

    (define (author-table tally)
      (if (null? tally)
          ""
          (join (list
                  "<section class=\"panel\"><h2>Authors</h2>"
                  "<p class=\"q\">Self-declared, from the <code>/name/</code>"
                  " graffiti convention. Anyone may claim any name; this is"
                  " a signature of nothing.</p>"
                  "<div class=\"table-scroll\"><table><thead><tr>"
                  (headings '("author" "blocks")) "</tr></thead><tbody>"
                  (join (map (lambda (entry)
                               (string-append
                                 "<tr>"
                                 (rows (list (explorer-escape (car entry))
                                             (number->string (cdr entry))))
                                 "</tr>"))
                             tally))
                  "</tbody></table></div></section>"))))

    (define (block-table blocks)
      (if (null? blocks)
          "<div class=\"empty-state\">No blocks yet.</div>"
          (string-append
            "<div class=\"table-scroll\"><table><thead><tr>"
            (headings %block-headings) "</tr></thead><tbody>"
            (block-rows blocks) "</tbody></table></div>")))

    (define (metric-card label value detail)
      (join (list
              "<article class=\"metric-card\"><span class=\"metric-label\">"
              label "</span><strong class=\"metric-value\">" value
              "</strong><span class=\"metric-detail\">" detail
              "</span></article>")))

    (define (live-metric-card value-id detail-id label value detail)
      (join (list
              "<article class=\"metric-card\"><span class=\"metric-label\">" label
              "</span><strong id=\"" value-id
              "\" class=\"metric-value\">" value
              "</strong><span id=\"" detail-id
              "\" class=\"metric-detail\">" detail
              "</span></article>")))

    (define (live-field id label value)
      (string-append "<tr><th scope=\"row\">" label
                     "</th><td id=\"" id "\">" value "</td></tr>"))

    ;; ============================================================
    ;; Pages
    ;; ============================================================

    ;;; The summary page: where the chain is, what it has paid out, and the
    ;;; puzzle the next block has to solve.
    ;;;
    ;;; ```scheme
    ;;; (explorer-summary-page (explorer-chain-summary s) blocks)
    ;;; ```
    (define (explorer-summary-page summary blocks)
      (: explorer-summary? list? -> string?)
      (let ((chain (explorer-summary-chain-name summary))
            (tip-id (explorer-summary-tip-id summary))
            (complexity (explorer-summary-complexity summary)))
        (explorer-page
          (string-append chain " explorer")
          (join (list
                  "<div data-explorer-live data-tip-height=\""
                  (number->string (explorer-summary-tip-height summary))
                  "\" data-tip-id=\"" (explorer-escape tip-id) "\">"
                  "<section class=\"dashboard-hero\"><div>"
                  "<p class=\"eyebrow\">Chain dashboard</p><h1>"
                  (explorer-escape chain) "</h1></div><div class=\"live-state\">"
                  "<span id=\"live-connection\" class=\"badge badge-warn\" data-state=\"syncing\" aria-live=\"polite\">syncing</span>"
                  "<span id=\"live-waiting\" class=\"waiting-indicator\">Waiting for block #"
                  (number->string (explorer-summary-next-height summary))
                  "</span><span id=\"live-announcement\" class=\"sr-only\" aria-live=\"polite\"></span>"
                  "<p class=\"hero-note\">Validated chain state and the next"
                  " program-golf puzzle, served directly from this node.</p>"
                  "</div></section>"
                  (if (explorer-summary-empty summary)
                      "<div class=\"notice notice-warn\"><strong>Waiting for chain data.</strong> This node has no chain data yet.</div>"
                      "")
                  "<section class=\"metric-grid\" aria-label=\"Chain metrics\">"
                  (live-metric-card
                    "live-tip-height" "live-next-height-detail"
                    "tip height"
                    (string-append "<span class=\"accent\">#"
                                   (number->string
                                     (explorer-summary-tip-height summary))
                                   "</span>")
                    (string-append "next height "
                                   (number->string
                                     (explorer-summary-next-height summary))))
                  (live-metric-card
                    "live-tip-id" "live-tip-id-detail"
                    "tip block"
                    (string-append "<span title=\"" (explorer-escape tip-id)
                                   "\">" (explorer-escape (short-id tip-id))
                                   "</span>")
                    (string-append "<span class=\"mono\">"
                                   (explorer-escape tip-id) "</span>"))
                  (live-metric-card
                    "live-tip-time" "live-tip-time-detail"
                    "tip time"
                    (explorer-escape
                      (explorer-format-time
                        (explorer-summary-tip-time summary)))
                    "node-reported UTC")
                  (live-metric-card
                    "live-block-count" "live-header-detail"
                    "qualifying blocks"
                    (number->string (explorer-summary-block-count summary))
                    (string-append
                      (number->string (explorer-summary-header-count summary))
                      " headers to height "
                      (number->string
                        (explorer-summary-header-height summary))))
                  (live-metric-card
                    "live-supply" "live-supply-detail"
                    "issued supply"
                    (string-append
                      (explorer-sigil-amount
                        (explorer-summary-supply summary)) " SGL")
                    (string-append "scheduled maximum supply "
                      (explorer-sigil-amount
                        (explorer-summary-max-supply summary)) " SGL"))
                  (live-metric-card
                    "live-reward" "live-halving-detail"
                    "next scheduled subsidy"
                    (string-append
                      (explorer-sigil-amount
                        (explorer-summary-next-reward summary)) " SGL")
                    (let ((height
                            (explorer-summary-next-halving-height summary)))
                      (if (number? height)
                          (string-append "next halving at height "
                                         (number->string height))
                          "never (subsidy has decayed to zero)")))
                  (live-metric-card
                    "live-complexity" "live-retarget-detail"
                    "complexity / retarget"
                    (if (number? complexity)
                        (string-append "C " (number->string complexity))
                        "unavailable")
                    (if (number? complexity)
                        (string-append
                          "next C "
                          (optional-number
                            (explorer-summary-next-complexity summary))
                          " at height "
                          (optional-number
                            (explorer-summary-next-retarget-height summary)))
                        "retarget data unavailable"))
                  "</section>"
                  "<section class=\"panel content-panel\"><h2 id=\"live-puzzle-heading\">Puzzle for height "
                  (number->string (explorer-summary-next-height summary))
                  "</h2><p class=\"q\">Programs at or under par enter the"
                  " nonce lottery. Each byte saved doubles the chance to"
                  " qualify, up to the eight-byte bonus cap.</p>"
                  (table-wrap
                    (join (list
                            "<table><tbody>"
                            (live-field
                              "live-puzzle-par" "par"
                              (optional-number
                                (explorer-summary-puzzle-par summary)))
                            (let ((ci
                                    (explorer-summary-puzzle-constraint summary)))
                              (if (number? ci)
                                  (join (list
                                          (live-field
                                            "live-puzzle-constraint"
                                            "constraint"
                                            (string-append
                                              (number->string ci)
                                              " &mdash; "
                                              (explorer-escape
                                                (let ((text
                                                  (explorer-summary-puzzle-constraint-text
                                                    summary)))
                                                  (if (string? text)
                                                      text "")))))
                                          (live-field
                                            "live-puzzle-k" "examples (k)"
                                            (optional-number
                                              (explorer-summary-puzzle-k
                                                summary)))))
                                  ""))
                            (live-field
                              "live-puzzle-seed" "seed"
                              (let ((seed
                                      (explorer-summary-puzzle-seed summary)))
                                (if (string? seed)
                                    (explorer-escape seed)
                                    "&mdash;")))
                            "</tbody></table>")))
                  (examples-table (explorer-summary-puzzle-examples summary))
                  "</section>"
                  (author-table
                    (explorer-author-tally
                      blocks
                      (let ((tip (explorer-summary-tip-time summary)))
                        (and (number? tip)
                             (- tip explorer-author-window)))))
                  "<section class=\"panel recent-blocks-panel\">"
                  "<div class=\"panel-head\"><h2>Recent blocks</h2>"
                  (badge "badge-warn"
                         (string-append (number->string (length blocks))
                                        " shown"))
                  "</div>" (block-strip blocks)
                  "<h3>Detailed block ledger</h3>" (block-table blocks)
                  "</section></div>")))))

    ;;; The difficulty history page: complexity and achieved margin over
    ;;; time, which is the chain's own record of how fast the field is
    ;;; getting better at writing programs.
    ;;;
    ;;; ```scheme
    ;;; (explorer-difficulty-page summary blocks)
    ;;; ```
    (define (explorer-difficulty-page summary blocks)
      (: explorer-summary? list? -> string?)
      (explorer-page
        (string-append (explorer-summary-chain-name summary) " difficulty")
        (join (list
                "<section class=\"page-head\"><div><p class=\"eyebrow\">"
                "Retarget history</p><h1>Difficulty</h1></div>"
                (badge "badge-violet"
                  (string-append "C "
                    (optional-number
                      (explorer-summary-complexity summary))))
                "</section><section class=\"panel\">"
                "<p class=\"q\">C is the complexity parameter: it widens the"
                " grammar, the example count and the constraint tier, and it"
                " never touches an evaluator cap. It retargets every 16"
                " blocks on the median relative margin, aiming for the"
                " median block to come in 10.0% under par.</p>"
                (if (null? blocks)
                    "<div class=\"empty-state\">No blocks yet.</div>"
                    (string-append
                      "<div class=\"table-scroll\"><table><thead><tr>"
                      (headings %difficulty-headings) "</tr></thead><tbody>"
                      (difficulty-rows blocks)
                      "</tbody></table></div>"))
                "</section>"))))

    ;;; The block list page.
    ;;;
    ;;; ```scheme
    ;;; (explorer-blocks-page summary blocks)
    ;;; ```
    (define (explorer-blocks-page summary blocks)
      (: explorer-summary? list? -> string?)
      (explorer-page
        (string-append (explorer-summary-chain-name summary) " blocks")
        (join (list
                "<section class=\"page-head\"><div><p class=\"eyebrow\">"
                "Qualifying ledger</p><h1>Blocks</h1></div>"
                (badge "badge-warn"
                       (string-append (number->string (length blocks))
                                      " shown"))
                "</section><section class=\"panel\">"
                (block-strip blocks)
                "<h2>Block details</h2>" (block-table blocks)
                "</section>"))))

    ;;; The block detail page.
    ;;;
    ;;; ```scheme
    ;;; (explorer-block-page b)
    ;;; ```
    (define (explorer-block-page b)
      (: explorer-block? -> string?)
      (explorer-page
        (string-append "Block " (number->string (explorer-block-height b)))
        (join (list
                "<section class=\"page-head\"><div><p class=\"eyebrow\">"
                "Lottery block</p><h1>Block "
                (number->string (explorer-block-height b))
                "</h1></div>"
                (let ((problem (explorer-block-problem b)))
                  (if problem
                      (badge "badge-bad"
                             (explorer-escape (symbol->string problem)))
                      (badge "badge-good" "qualifying")))
                "</section><section class=\"panel\">"
                "<h2 class=\"sr-only\">Block data</h2>"
                "<div class=\"table-scroll\"><table><tbody>"
                (field "id"
                       (string-append "<span class=\"hash-cell mono\">"
                                      (explorer-escape (explorer-block-id b))
                                      "</span>"))
                (field "time"
                       (explorer-escape
                         (explorer-format-time (explorer-block-time b))))
                (field "parent"
                       (let ((parent (explorer-block-parent-id b))
                             (height (explorer-block-height b)))
                         (if (and (string? parent) (> height 0))
                             (string-append "<a href=\"/block/"
                                            (explorer-escape
                                              (number->string (- height 1)))
                                            "\">"
                                            (explorer-escape parent)
                                            "</a>")
                             "<span class=\"q\">none (genesis)</span>")))
                (field "miner" (address-cell b))
                (field "author"
                       (let ((author (explorer-block-author b)))
                         (if (bytevector? author)
                             (string-append "<span class=\"q\">"
                                            (explorer-text author)
                                            " (self-declared)</span>")
                             "<span class=\"q\">none declared</span>")))
                (field "scheduled subsidy"
                       (string-append
                         (explorer-sigil-amount (explorer-block-reward b))
                         " SGL"))
                (field "solution bytes"
                       (optional-number (explorer-block-solution-length b)))
                (field "par" (optional-number (explorer-block-par b)))
                (field "margin"
                       (under-par-badge
                         (explorer-block-under-par b)))
                (field "transactions"
                       (optional-number
                         (explorer-block-transaction-count b)))
                (field "size"
                       (let ((size (explorer-block-size b)))
                         (if (number? size)
                             (string-append (number->string size) " bytes")
                             "&mdash;")))
                (field "puzzle seed"
                       (let ((seed (explorer-block-seed b)))
                         (if (string? seed) (explorer-escape seed) "&mdash;")))
                (let ((problem (explorer-block-problem b)))
                  (if problem
                      (field "problem"
                             (badge "badge-bad"
                               (explorer-escape (symbol->string problem))))
                      ""))
                "</tbody></table></div></section>"
                (puzzle-section b)
                "<section class=\"panel content-panel\"><h2>Solution</h2><pre>"
                (solution-text b) "</pre></section>"
                (lottery-section b)
                (transactions-section b)
                (shares-section b)
                (payout-section b)
                "<section class=\"panel content-panel\"><h2>Quote</h2><pre>"
                (let ((graffiti (explorer-block-graffiti b)))
                  (if (and (bytevector? graffiti)
                           (> (bytevector-length graffiti) 0))
                      (explorer-text graffiti)
                      "&mdash;"))
                "</pre></section>"))))

    ;;; One confirmed transaction, including its prevouts and destinations.
    (define (explorer-transaction-page tx)
      (: explorer-transaction? -> string?)
      (let ((id (explorer-transaction-id tx))
            (height (explorer-transaction-height tx))
            (block-id (explorer-transaction-block-id tx))
            (time (explorer-transaction-time tx))
            (fee (explorer-transaction-fee tx)))
        (explorer-page
          (string-append "Transaction " id)
          (join
            (list
              "<section class=\"page-head\"><div><p class=\"eyebrow\">"
              "Confirmed transaction</p><h1>Transaction</h1></div>"
              (if (explorer-transaction-coinbase? tx)
                  (badge "badge-violet" "coinbase")
                  (badge "badge-good" "transfer"))
              "</section><section class=\"panel\">"
              "<h2 class=\"sr-only\">Transaction data</h2>"
              (table-wrap
                (join
                  (list
                    "<table><tbody>"
                    (field
                      "id"
                      (string-append
                        "<span class=\"hash-cell mono\">"
                        (explorer-escape id) "</span>"))
                    (field
                      "confirmation block"
                      (cond
                        ((and (number? height) (string? block-id))
                         (let ((height-text (number->string height))
                               (id-text (explorer-escape block-id)))
                           (string-append
                             "<a class=\"hash-cell mono\" href=\"/block/"
                             height-text "\">" id-text "</a>")))
                        ((string? block-id)
                         (string-append
                           "<span class=\"hash-cell mono\">"
                           (explorer-escape block-id) "</span>"))
                        (else "&mdash;")))
                    (field
                      "height"
                      (if (number? height)
                          (let ((text (number->string height)))
                            (string-append
                              "<a href=\"/block/" text "\">" text "</a>"))
                          "&mdash;"))
                    (field
                      "time"
                      (if (number? time)
                          (explorer-escape (explorer-format-time time))
                          "&mdash;"))
                    (field
                      "inputs"
                      (optional-number
                        (explorer-transaction-input-count tx)))
                    (field
                      "outputs"
                      (optional-number
                        (explorer-transaction-output-count tx)))
                    (field
                      "total output"
                      (if (number? (explorer-transaction-total-output tx))
                          (string-append
                            (amount-cell
                              (explorer-transaction-total-output tx))
                            " SGL")
                          "&mdash;"))
                    (if (number? fee)
                        (field
                          "fee"
                          (string-append (amount-cell fee) " SGL"))
                        "")
                    "</tbody></table>")))
              "</section>"
              (transaction-inputs-section tx)
              (transaction-outputs-section tx))))))

    ;;; The address page: what it mined and what it currently holds.
    ;;;
    ;;; ```scheme
    ;;; (explorer-address-page "sgl1..." 10000000000 '() '())
    ;;; ```
    (define (explorer-address-page address balance blocks transactions)
      (: string? integer? list? list? -> string?)
      (explorer-page
        (string-append "Address " address)
        (join (list
                "<section class=\"page-head\"><div><p class=\"eyebrow\">"
                "Address activity</p><h1>Address</h1></div>"
                (badge "badge-violet"
                       (string-append (number->string (length transactions))
                                      " recent transactions"))
                "</section><section class=\"metric-grid\">"
                (metric-card "balance"
                             (string-append
                               (explorer-sigil-amount balance) " SGL")
                             "current spendable balance")
                (metric-card "blocks mined"
                             (number->string (length blocks))
                             "validated producer blocks")
                "</section><section class=\"panel\"><h2>Address details</h2>"
                (table-wrap
                  (string-append "<table><tbody>"
                                 (field "address" (explorer-text address))
                                 "</tbody></table>"))
                "</section>"
                (address-transactions-section transactions)
                "<section class=\"panel\"><h2>Blocks mined</h2>"
                (block-table blocks) "</section>"))))

    ;;; The page for a path that names nothing.
    ;;;
    ;;; ```scheme
    ;;; (explorer-missing-page "no such block")
    ;;; ```
    (define (explorer-missing-page reason)
      (: string? -> string?)
      (explorer-page "Not found"
                     (string-append
                       "<section class=\"page-head\"><div><p class=\"eyebrow\">"
                       "Explorer error</p><h1>Not found</h1></div>"
                       (badge "badge-bad" "404") "</section>"
                       "<div class=\"notice notice-error\">"
                       (explorer-text reason) "</div>")))

    ;;; The page shown when there is no node database to read.
    ;;;
    ;;; ```scheme
    ;;; (explorer-no-database-page "/tmp/n/sigilcoin-main.sqlite")
    ;;; ```
    (define (explorer-no-database-page path)
      (: string? -> string?)
      (explorer-page "No chain data"
                     (join (list
                             "<section class=\"page-head\"><div>"
                             "<p class=\"eyebrow\">Explorer unavailable</p>"
                             "<h1>No chain data</h1></div>"
                             (badge "badge-bad" "offline") "</section>"
                             "<div class=\"notice notice-error\">"
                             "No node database at <code>"
                             (explorer-text path)
                             "</code>. Start a node there, or point the"
                             " explorer at the directory that has one.</div>"))))

    ;; ============================================================
    ;; JSON
    ;; ============================================================

    ;; JSON carries strings, so a code point the HTML side would escape is
    ;; harmless here; the SANITIZE stage still runs, because an ill-formed
    ;; byte would otherwise reach a client as broken UTF-8.
    (define (json-text value)
      (if (or (string? value) (bytevector? value))
          (explorer-safe-text value)
          'null))

    (define (json-number value)
      (if (number? value) value 'null))

    (define (block-alist b)
      (list
        (cons "height" (explorer-block-height b))
        (cons "id" (explorer-block-id b))
        (cons "time" (explorer-block-time b))
        (cons "parent_id" (or (explorer-block-parent-id b) 'null))
        (cons "miner" (or (explorer-block-payout-address b) 'null))
        (cons "reward" (explorer-block-reward b))
        (cons "solution" (json-text (or (explorer-block-solution-source b)
                                        (explorer-block-solution b))))
        (cons "solution_bytes"
              (json-number (explorer-block-solution-length b)))
        (cons "par" (json-number (explorer-block-par b)))
        (cons "under_par" (json-number (explorer-block-under-par b)))
        (cons "seed" (json-text (explorer-block-seed b)))
        (cons "graffiti" (json-text (explorer-block-graffiti b)))
        (cons "transactions"
              (json-number (explorer-block-transaction-count b)))
        (cons "transaction_details"
              (map transaction-alist (explorer-block-transactions b)))
        (cons "size" (json-number (explorer-block-size b)))
        (cons "problem"
              (let ((problem (explorer-block-problem b)))
                (if problem (symbol->string problem) 'null)))
        (cons "author" (json-text (explorer-block-author b)))
        (cons "margin" (json-number (explorer-block-margin b)))
        (cons "complexity" (json-number (explorer-block-complexity b)))
        (cons "constraint"
              (if (number? (explorer-block-constraint b))
                  (list (cons "id" (explorer-block-constraint b))
                        (cons "text"
                              (json-text
                                (explorer-block-constraint-text b))))
                  'null))
        (cons "k" (json-number (explorer-block-k b)))
        (cons "examples" (map example-alist (explorer-block-examples b)))
        (cons "lottery"
              (list
                (cons "base_bits"
                      (json-number (explorer-block-bits b)))
                (cons "base_target"
                      (or (lottery-target-hex
                            (explorer-block-base-target b))
                          'null))
                (cons "chain_work"
                      (let ((work (explorer-block-chain-work b)))
                        (if (number? work) (number->string work) 'null)))
                (cons "nonce"
                      (json-number (explorer-block-nonce b)))
                (cons "claimed_length"
                      (json-number (explorer-block-claimed-length b)))
                (cons "roll"
                      (json-text (explorer-block-lottery-roll b)))
                (cons "target"
                      (or (lottery-target-hex
                            (explorer-block-lottery-target b))
                          'null))
                (cons "bonus"
                      (json-number (explorer-block-lottery-bonus b)))
                (cons "multiplier"
                      (json-number (explorer-block-lottery-multiplier b)))
                (cons "expected_rolls"
                      (json-number
                        (explorer-block-lottery-expected-rolls b)))))
        (cons "share_quality"
              (json-number (explorer-block-share-quality b)))
        (cons "share_count" (json-number (explorer-block-share-count b)))
        (cons "shares" (map share-alist (explorer-block-shares b)))
        (cons "commitments" (json-number (explorer-block-commit-count b)))
        (cons "outputs" (map output-alist (explorer-block-outputs b)))
        (cons "total_output" (json-number (explorer-block-total-output b)))))

    (define (transaction-alist tx)
      (list
        (cons "index" (explorer-transaction-index tx))
        (cons "id" (explorer-transaction-id tx))
        (cons "coinbase" (explorer-transaction-coinbase? tx))
        (cons "inputs" (explorer-transaction-input-count tx))
        (cons "outputs" (explorer-transaction-output-count tx))
        (cons "total_output" (explorer-transaction-total-output tx))))

    (define (transaction-input-alist input)
      (list
        (cons "index"
              (json-number (explorer-transaction-input-index input)))
        (cons "coinbase" (explorer-transaction-input-coinbase? input))
        (cons "previous_id"
              (json-text
                (explorer-transaction-input-previous-id input)))
        (cons "previous_index"
              (json-number
                (explorer-transaction-input-previous-index input)))
        (cons "address"
              (json-text (explorer-transaction-input-address input)))
        (cons "value"
              (json-number (explorer-transaction-input-value input)))))

    (define (transaction-output-alist output)
      (list
        (cons "index"
              (json-number (explorer-transaction-output-index output)))
        (cons "address"
              (json-text (explorer-transaction-output-address output)))
        (cons "value"
              (json-number (explorer-transaction-output-value output)))))

    (define (transaction-detail-alist tx)
      (list
        (cons "id" (json-text (explorer-transaction-id tx)))
        (cons "height" (json-number (explorer-transaction-height tx)))
        (cons "block_id"
              (json-text (explorer-transaction-block-id tx)))
        (cons "time" (json-number (explorer-transaction-time tx)))
        (cons "coinbase" (explorer-transaction-coinbase? tx))
        (cons "input_count"
              (json-number (explorer-transaction-input-count tx)))
        (cons "output_count"
              (json-number (explorer-transaction-output-count tx)))
        (cons "total_output"
              (json-number (explorer-transaction-total-output tx)))
        (cons "fee" (json-number (explorer-transaction-fee tx)))
        (cons "inputs"
              (map transaction-input-alist
                   (explorer-transaction-inputs tx)))
        (cons "outputs"
              (map transaction-output-alist
                   (explorer-transaction-outputs tx)))))

    (define (address-transaction-alist tx)
      (list
        (cons "height" (explorer-address-transaction-height tx))
        (cons "block_id" (explorer-address-transaction-block-id tx))
        (cons "time" (explorer-address-transaction-time tx))
        (cons "id" (explorer-address-transaction-id tx))
        (cons "received" (explorer-address-transaction-received tx))
        (cons "spent" (explorer-address-transaction-spent tx))
        (cons "net" (- (explorer-address-transaction-received tx)
                       (explorer-address-transaction-spent tx)))))

    (define (example-alist pair)
      (list (cons "input" (json-text (car pair)))
            (cons "output" (json-text (cdr pair)))))

    (define (share-alist s)
      (list (cons "index" (explorer-share-index s))
            (cons "pubkey" (explorer-share-pubkey-hex s))
            (cons "signature" (explorer-share-signature-hex s))
            (cons "blind" (explorer-share-blind-hex s))
            (cons "miner" (or (explorer-share-address s) 'null))
            (cons "solution" (json-text (or (explorer-share-solution-source s)
                                            (explorer-share-solution s))))
            (cons "solution_bytes"
                  (json-number (explorer-share-solution-length s)))
            (cons "personal_par" (json-number (explorer-share-par s)))
            (cons "margin" (json-number (explorer-share-margin s)))
            (cons "contribution"
                  (json-number (explorer-share-contribution s)))
            (cons "steps" (json-number (explorer-share-steps s)))
            (cons "cells" (json-number (explorer-share-cells s)))
            (cons "step_bucket" (json-number (explorer-share-step-bucket s)))
            (cons "memory_bucket"
                  (json-number (explorer-share-memory-bucket s)))
            (cons "payout" (json-number (explorer-share-payout s)))
            (cons "problem"
                  (let ((problem (explorer-share-problem s)))
                    (if problem (symbol->string problem) 'null)))))

    (define (output-alist o)
      (list (cons "index" (explorer-output-index o))
            (cons "role"
                  (let ((role (explorer-output-role o)))
                    (if (symbol? role) (symbol->string role) 'null)))
            (cons "value" (explorer-output-value o))
            (cons "expected" (json-number (explorer-output-expected o)))
            (cons "address" (or (explorer-output-address o) 'null))))

    (define (author-alist entry)
      (list (cons "author" (car entry))
            (cons "blocks" (cdr entry))))

    (define (difficulty-alist b)
      (list (cons "height" (explorer-block-height b))
            (cons "complexity" (json-number (explorer-block-complexity b)))
            (cons "par" (json-number (explorer-block-par b)))
            (cons "solution_bytes"
                  (json-number (explorer-block-solution-length b)))
            (cons "margin" (json-number (explorer-block-margin b)))))

    (define (summary-alist summary)
      (list
        (cons "chain" (explorer-summary-chain-name summary))
        (cons "tip_height" (explorer-summary-tip-height summary))
        (cons "tip_id" (explorer-summary-tip-id summary))
        (cons "tip_time" (explorer-summary-tip-time summary))
        (cons "header_height" (explorer-summary-header-height summary))
        (cons "header_count" (explorer-summary-header-count summary))
        (cons "block_count" (explorer-summary-block-count summary))
        (cons "supply" (explorer-summary-supply summary))
        (cons "max_supply" (explorer-summary-max-supply summary))
        (cons "next_height" (explorer-summary-next-height summary))
        (cons "next_reward" (explorer-summary-next-reward summary))
        (cons "next_halving_height"
              (json-number (explorer-summary-next-halving-height summary)))
        (cons "complexity" (json-number (explorer-summary-complexity summary)))
        (cons "next_complexity"
              (json-number (explorer-summary-next-complexity summary)))
        (cons "next_retarget_height"
              (json-number (explorer-summary-next-retarget-height summary)))
        (cons "puzzle"
              (list
                (cons "par" (json-number (explorer-summary-puzzle-par summary)))
                (cons "seed" (json-text (explorer-summary-puzzle-seed summary)))
                (cons "constraint"
                      (if (number? (explorer-summary-puzzle-constraint summary))
                          (list (cons "id"
                                      (explorer-summary-puzzle-constraint
                                        summary))
                                (cons "text"
                                      (json-text
                                        (explorer-summary-puzzle-constraint-text
                                          summary))))
                          'null))
                (cons "k" (json-number (explorer-summary-puzzle-k summary)))
                (cons "examples"
                      (map example-alist
                           (explorer-summary-puzzle-examples summary)))))
        (cons "empty" (explorer-summary-empty summary))))

    ;;; The summary endpoint's body, with the recent blocks alongside it.
    ;;;
    ;;; ```scheme
    ;;; (explorer-summary-json summary blocks)
    ;;; ```
    (define (explorer-summary-json summary blocks)
      (: explorer-summary? list? -> string?)
      (json-encode
        (append (summary-alist summary)
                (list (cons "authors"
                            (map author-alist
                                 (explorer-author-tally
                                   blocks
                                   (let ((tip (explorer-summary-tip-time
                                                summary)))
                                     (and (number? tip)
                                          (- tip explorer-author-window))))))
                      (cons "blocks" (map block-alist blocks))))))

    ;;; The difficulty endpoint's body: the same rows the page shows.
    ;;;
    ;;; ```scheme
    ;;; (explorer-difficulty-json summary blocks)
    ;;; ```
    (define (explorer-difficulty-json summary blocks)
      (: explorer-summary? list? -> string?)
      (json-encode
        (list (cons "complexity"
                    (json-number (explorer-summary-complexity summary)))
              (cons "next_complexity"
                    (json-number (explorer-summary-next-complexity summary)))
              (cons "next_retarget_height"
                    (json-number
                      (explorer-summary-next-retarget-height summary)))
              (cons "history" (map difficulty-alist blocks)))))

    ;;; The block-list endpoint's body.
    ;;;
    ;;; ```scheme
    ;;; (explorer-blocks-json blocks)
    ;;; ```
    (define (explorer-blocks-json blocks)
      (: list? -> string?)
      (json-encode (list (cons "blocks" (map block-alist blocks)))))

    ;;; One block's endpoint body.
    ;;;
    ;;; ```scheme
    ;;; (explorer-block-json b)
    ;;; ```
    (define (explorer-block-json b)
      (: explorer-block? -> string?)
      (json-encode (block-alist b)))

    ;;; One transaction's endpoint body.
    (define (explorer-transaction-json tx)
      (: explorer-transaction? -> string?)
      (json-encode (transaction-detail-alist tx)))

    ;;; An address endpoint body.
    ;;;
    ;;; ```scheme
    ;;; (explorer-address-json "sgl1..." 0 '() '())
    ;;; ```
    (define (explorer-address-json address balance blocks transactions)
      (: string? integer? list? list? -> string?)
      (json-encode
        (list (cons "address" (explorer-safe-text address))
              (cons "balance" balance)
              (cons "blocks_mined" (length blocks))
              (cons "blocks" (map block-alist blocks))
              (cons "transactions"
                    (map address-transaction-alist transactions)))))

    ;;; An error body, for the endpoints that have no data to return.
    ;;;
    ;;; ```scheme
    ;;; (explorer-error-json "not-found" "no such block")
    ;;; ```
    (define (explorer-error-json code detail)
      (: string? string? -> string?)
      (json-encode (list (cons "error" code)
                         (cons "detail" (explorer-safe-text detail)))))))
