;;; (sigil coin explorer) — the read-only SigilCoin chain explorer
;;;
;;; Facade over the explorer's modules. Consensus canonical owns all wire codecs;
;;; `(sigil coin explorer derive)` contains presentation helpers only.
;;;
;;;   (sigil coin explorer store)   read-only reads from a node's database
;;;   (sigil coin explorer render)  escaping, HTML pages, JSON bodies
;;;   (sigil coin explorer server)  routing and the HTTP/1.1 front door
;;;
;;; SigilCoin producers golf a daily puzzle, then search a nonce lottery whose
;;; odds double for each byte saved below par (up to the consensus cap). The
;;; explorer shows the qualifying roll, published program, and direct co-op
;;; payouts while keeping fork choice separate from lottery odds.
;;;
;;; Two rules shape the whole package:
;;;
;;;   * IT NEVER WRITES. The database belongs to the node. See
;;;     `(sigil coin explorer store)` for the two locks and what they do
;;;     not cover.
;;;   * IT NEVER TRUSTS A BLOCK. Graffiti and solutions are bytes a miner
;;;     chose. See `(sigil coin explorer render)` for the sanitize-then-
;;;     escape path every one of them takes.
;;;
;;; ```scheme
;;; (import (sigil coin explorer) (sigil coin node))
;;; (explorer-serve sigilcoin-regtest-chain "/tmp/sigilcoin" port: 8080)
;;; ```
;;;
;;; ```sh
;;; sigil-coin-explorer --regtest --data-dir /tmp/sigilcoin --port 8080
;;; ```

(define-library (sigil coin explorer)
  (import (sigil coin explorer client)
          (sigil coin explorer store)
          (sigil coin explorer render)
          (sigil coin explorer server))
  (export
    ;; Package metadata
    explorer-package-version

    ;; Store: addresses
    explorer-address-hrp
    explorer-testnet-address-hrp
    explorer-chain-address-hrp
    explorer-script->address
    explorer-script->address-for-chain
    explorer-address->script
    explorer-address->script-for-chain

    ;; Store: opening
    explorer-db-path
    explorer-open
    explorer-close
    explorer-store
    explorer-store?
    explorer-store-db
    explorer-store-config

    ;; Store: blocks
    explorer-block
    explorer-block?
    explorer-block-height
    explorer-block-id
    explorer-block-hash-text
    explorer-block-time
    explorer-block-parent-id
    explorer-block-solution
    explorer-block-solution-source
    explorer-block-solution-length
    explorer-block-graffiti
    explorer-block-par
    explorer-block-seed
    explorer-block-reward
    explorer-block-payout-script
    explorer-block-payout-address
    explorer-block-transaction-count
    explorer-block-transactions
    explorer-block-size
    explorer-block-problem
    explorer-block-under-par

    ;; Store: blocks, canonical
    explorer-block-complexity
    explorer-block-constraint
    explorer-block-constraint-text
    explorer-block-k
    explorer-block-examples
    explorer-block-nonce
    explorer-block-claimed-length
    explorer-block-lottery-roll
    explorer-block-lottery-target
    explorer-block-lottery-bonus
    explorer-block-lottery-multiplier
    explorer-block-lottery-expected-rolls
    explorer-block-share-quality
    explorer-block-share-count
    explorer-block-shares
    explorer-block-commit-count
    explorer-block-outputs
    explorer-block-total-output
    explorer-block-author
    explorer-block-margin

    ;; Store: block transactions
    explorer-transaction
    explorer-transaction?
    explorer-transaction-index
    explorer-transaction-id
    explorer-transaction-coinbase?
    explorer-transaction-input-count
    explorer-transaction-output-count
    explorer-transaction-total-output
    explorer-transaction-height
    explorer-transaction-block-id
    explorer-transaction-time
    explorer-transaction-inputs
    explorer-transaction-outputs
    explorer-transaction-fee

    ;; Store: transaction inputs
    explorer-transaction-input
    explorer-transaction-input?
    explorer-transaction-input-index
    explorer-transaction-input-coinbase?
    explorer-transaction-input-previous-id
    explorer-transaction-input-previous-index
    explorer-transaction-input-address
    explorer-transaction-input-value

    ;; Store: transaction outputs
    explorer-transaction-output
    explorer-transaction-output?
    explorer-transaction-output-index
    explorer-transaction-output-address
    explorer-transaction-output-value

    ;; Store: address transactions
    explorer-address-transaction
    explorer-address-transaction?
    explorer-address-transaction-height
    explorer-address-transaction-block-id
    explorer-address-transaction-time
    explorer-address-transaction-id
    explorer-address-transaction-received
    explorer-address-transaction-spent

    ;; Store: co-op shares
    explorer-share
    explorer-share?
    explorer-share-index
    explorer-share-pubkey-hex
    explorer-share-signature-hex
    explorer-share-blind-hex
    explorer-share-address
    explorer-share-solution
    explorer-share-solution-source
    explorer-share-solution-length
    explorer-share-par
    explorer-share-margin
    explorer-share-contribution
    explorer-share-steps
    explorer-share-cells
    explorer-share-memory-bucket
    explorer-share-step-bucket
    explorer-share-payout
    explorer-share-problem

    ;; Store: coinbase outputs
    explorer-output
    explorer-output?
    explorer-output-index
    explorer-output-role
    explorer-output-value
    explorer-output-script
    explorer-output-address
    explorer-output-expected

    ;; Store: chain summary
    explorer-summary
    explorer-summary?
    explorer-summary-chain-name
    explorer-summary-tip-height
    explorer-summary-tip-id
    explorer-summary-tip-time
    explorer-summary-header-height
    explorer-summary-header-count
    explorer-summary-block-count
    explorer-summary-supply
    explorer-summary-max-supply
    explorer-summary-next-height
    explorer-summary-next-reward
    explorer-summary-next-halving-height
    explorer-summary-puzzle-par
    explorer-summary-puzzle-seed
    explorer-summary-empty
    explorer-summary-complexity
    explorer-summary-next-complexity
    explorer-summary-next-retarget-height
    explorer-summary-puzzle-constraint
    explorer-summary-puzzle-constraint-text
    explorer-summary-puzzle-k
    explorer-summary-puzzle-examples

    ;; Store: queries
    explorer-default-page-size
    explorer-difficulty-window
    explorer-chain-summary
    explorer-recent-blocks
    explorer-block-by-height
    explorer-transaction-by-id
    explorer-block-by-id
    explorer-address-blocks
    explorer-address-transactions
    explorer-address-balance
    explorer-next-halving-height

    ;; Render: escaping
    explorer-replacement-char
    explorer-safe-text
    explorer-escape
    explorer-text

    ;; Render: formatting
    explorer-sigil-amount
    explorer-format-time
    explorer-under-par-text
    explorer-margin-text
    explorer-author-tally
    explorer-author-window

    ;; Render: pages
    explorer-page
    explorer-summary-page
    explorer-blocks-page
    explorer-block-page
    explorer-transaction-page
    explorer-difficulty-page
    explorer-address-page
    explorer-missing-page
    explorer-no-database-page

    ;; Render: JSON
    explorer-summary-json
    explorer-blocks-json
    explorer-block-json
    explorer-transaction-json
    explorer-difficulty-json
    explorer-address-json
    explorer-error-json

    ;; Compiled client
    explorer-client-javascript

    ;; Server
    explorer-request-path
    explorer-path-segments
    explorer-route
    explorer-handle
    explorer-respond
    explorer-response-status
    explorer-response-content-type
    explorer-response-body
    explorer-http-response
    explorer-serve-connection
    explorer-serve
    explorer-chain-for-args
    explorer-main
    main)

  (begin

    ;;; Version of the explorer package.
    ;;;
    ;;; Example:
    ;;;   (explorer-package-version) ;=> "0.1.0"
    (define (explorer-package-version)
      (: -> string?)
      "0.1.0")

    ;;; The binary's entry point.
    ;;;
    ;;; ```sh
    ;;; sigil-coin-explorer --regtest --data-dir /tmp/sigilcoin
    ;;; ```
    (define (main)
      (: -> void?)
      (explorer-main))))
