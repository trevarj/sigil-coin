;;; The explorer's rendering, driven against a real chain on disk.
;;;
;;; This file opens a real regtest database, then writes headers and bodies
;;; into it as a synced node would have: packed versions committing C and L,
;;; fixed network bits, scheduled timestamps and nonce zero, plus five-push
;;; coinbases and coinbase outputs. Hostile rows are inserted directly rather
;;; than submitted as valid blocks. Everything read is real bytes on SQLite.
;;;
;;; Puzzles, linear scores, solution lengths and margins come from the
;;; CONSENSUS package's own APIs, so every assertion compares the explorer
;;; against the rules it claims to present rather than a local formula.
;;;
;;; Hostile fixtures cover genesis quotes, forbidden non-genesis graffiti,
;;; and height-20 share program, blind and signature bytes. The explorer
;;; preserves named decoding failures without trusting execution claims.

(import (sigil test)
        (sigil fs)
        (sigil io)
        (sigil math)
        (sigil array)
        (sigil string)
        (sigil sqlite)
        (sigil process)
        (sigil json)
        (sigil bitcoin utils)
        (sigil bitcoin encoding)
        (sigil bitcoin primitives)
        (sigil bitcoin script)
        (sigil bitcoin tx)
        (sigil bitcoin consensus)
        (sigil bitcoin node)
        (sigil coin puzzle)
        (sigil coin puzzle generator)
        (sigil coin consensus)
        (sigil coin node)
        (sigil coin explorer)
        (sigil coin explorer derive))

;; ============================================================
;; Helpers
;; ============================================================

(define (fresh-dir)
  (let ((dir (make-temp-directory)))
    (unless dir (error "fresh-dir: could not create a temp directory"))
    dir))

(define (remove-tree dir)
  (process-run "rm" "-rf" dir))

(define %miner-a "sgl1q70nakelv6wvuk2e63ah8lg68kq3nx7q2g3taul")
(define %miner-b "sgl1qw508d6qejxtdg4y5r3zarvary0c5xw7kr43pwr")
(define %script-a (explorer-address->script %miner-a))
(define %script-b (explorer-address->script %miner-b))
(define %testnet-miner-a
  (explorer-script->address-for-chain sigilcoin-testnet-chain %script-a))

(define %zero32 (make-bytevector 32 0))
(define %coinbase-index #xffffffff)
(define %sequence-final #xffffffff)

;; An author tag that is itself an injection, a `<script>` in the body, then
;; a NUL, an ESC and two ill-formed bytes. A naive `utf8->string` would pass
;; the tail through unchanged and both heads into the markup.
;;
;; The tag carries no `/` of its own on purpose: the convention ends the
;; name at the next slash, so `</script>` inside a tag would truncate it and
;; the test would be asserting against the truncation rather than the
;; escaping.
(define %hostile-tag "<img src=x onerror=\"y\">")

(define %hostile-graffiti
  (bytevector-append
    (string->utf8 (string-append "/" %hostile-tag
                                "/ <script>alert(1)</script> 'sq'"))
    #u8(#x00 #x1b #xff #x80)))

(define (as-bytes value)
  (if (bytevector? value) value (string->utf8 value)))


;; A share's pubkey. Compressed-looking and, with an ascending `i`, in the
;; strictly ascending order §6.2 requires.
(define (share-pubkey i)
  (bytevector-append #u8(2) (make-bytevector 32 i)))

(define %hostile-blind
  (bytevector-append (string->utf8 "<blind>&\"'") (make-bytevector 22 #xff)))
(define %hostile-share-index 3)

(define (make-share i solution)
  (coin-share
    pubkey: (share-pubkey i)
    signature: (if (= i %hostile-share-index)
                   (bytevector-append
                     (string->utf8 "<signature>&\"'")
                     (make-bytevector 50 #xff))
                   (make-bytevector 64 i))
    blind: (if (= i %hostile-share-index)
               %hostile-blind
               (make-bytevector 32 i))
    solution: (as-bytes solution)))

;; Convert consensus's payout plan into coinbase outputs. The malformed
;; synthetic shares use contribution 1 only to give their stored block a
;; deterministic actual payout; detail preview must not trust those values.
(define (payout-outputs subsidy shares producer-script carrier-script)
  (map (lambda (entry)
         (txout value: (car entry)
                script-pubkey: (or (cdr entry) producer-script)))
       (coin-payout-plan subsidy
                         0
                         shares
                         (map (lambda (share) 1) shares)
                         carrier-script)))

;; Build one block. `solution` is the producer's own program for THIS
;; height's puzzle; the shares solve the PARENT's.
(define (build-block chain parent-header height complexity solution shares
                     commits producer-script carrier-script)
  (let* ((parent-hash (block-header-hash parent-header))
         (solution-bytes (as-bytes solution))
         (spec (coin-puzzle-for parent-hash height complexity))
         (report
           (puzzle-run-examples solution-bytes (puzzle-spec-examples spec)))
         (subsidy (coin-block-reward height))
         (payload (coin-coinbase-payload
                    height: height
                    solution: solution-bytes
                    shares: (coin-shares-encode shares)
                    commits: (coin-commits-encode commits)
                    graffiti: #u8()))
         (coinbase (transaction
                     version: 1
                     inputs: (list (txin previous-output:
                                           (outpoint txid: %zero32
                                                     index: %coinbase-index)
                                         script-sig:
                                           (coin-coinbase-payload-encode
                                             payload)
                                         sequence: %sequence-final
                                         witness: '()))
                     outputs: (payout-outputs subsidy shares producer-script
                                              carrier-script)
                     lock-time: 0))
         (transactions (list coinbase))
         (template
           (block-header
             version: (coin-version-encode
                        complexity (bytevector-length solution-bytes))
             previous-block: parent-hash
             merkle-root: (merkle-root (map transaction-wtxid transactions))
             time: (+ (block-header-time parent-header)
                      (consensus-params-target-spacing
                        (chain-config-consensus-params chain)))
             bits: (block-header-bits parent-header)
             nonce: 0)))
    (unless (puzzle-report-ok? report)
      (error (string-append "build-block: solution does not solve height "
                            (number->string height))))
    (block
      header-field: template
      transactions: transactions)))

;; Recompute the merkle root after a synthetic body change.
(define (with-transactions b transactions)
  (let* ((header (block-header-field b))
         (template
           (block-header
             version: (block-header-version header)
             previous-block: (block-header-previous-block header)
             merkle-root: (merkle-root (map transaction-wtxid transactions))
             time: (block-header-time header)
             bits: (block-header-bits header)
             nonce: 0)))
    (block
      header-field: template
      transactions: transactions)))

;; Change only the length claim to exercise pending and inconsistent rows.
(define (with-claimed-length header length)
  (block-header
    version: (coin-version-encode
               (coin-result-value
                 (coin-version-decode (block-header-version header)))
               length)
    previous-block: (block-header-previous-block header)
    merkle-root: (block-header-merkle-root header)
    time: (block-header-time header)
    bits: (block-header-bits header)
    nonce: 0))

;; Replace the solo coinbase value for failure-display coverage. The resulting
;; issuance is deliberately invalid and is never submitted to a node.
(define (with-solo-coinbase-value b value)
  (let* ((coinbase (car (block-transactions b)))
         (old-output (car (transaction-outputs coinbase)))
         (replacement
           (transaction
             version: (transaction-version coinbase)
             inputs: (transaction-inputs coinbase)
             outputs: (list
                        (txout value: value
                               script-pubkey:
                                 (txout-script-pubkey old-output)))
             lock-time: (transaction-lock-time coinbase))))
    (with-transactions b (list replacement))))

(define (with-extra-transactions b extra)
  (with-transactions b (append (block-transactions b) extra)))

(define (fixture-transfer funding)
  (let* ((value (txout-value (car (transaction-outputs funding))))
         (sent 10000000))
    (transaction
      version: 2
      inputs: (list
                (txin
                  previous-output:
                    (outpoint txid: (transaction-txid funding) index: 0)
                  script-sig: #u8()
                  sequence: %sequence-final
                  witness: '()))
      outputs: (list
                 (txout value: sent script-pubkey: %script-b)
                 (txout value: (- value sent) script-pubkey: %script-a))
      lock-time: 0)))

(define (store-transaction-outputs! db tx height time hash coinbase?)
  (let ((txid (hex-encode (transaction-txid tx))))
    (let loop ((outputs (transaction-outputs tx)) (index 0))
      (unless (null? outputs)
        (sqlite-run
          db
          "INSERT OR REPLACE INTO utxos(txid, output_index, value, script_pubkey, coinbase, height, time, created_by, spent_by, spent_height, active) VALUES (?, ?, ?, ?, ?, ?, ?, ?, NULL, NULL, 1)"
          txid
          index
          (txout-value (car outputs))
          (hex-encode (txout-script-pubkey (car outputs)))
          (if coinbase? 1 0)
          height
          time
          hash)
        (loop (cdr outputs) (+ index 1))))))

(define (store-transaction-spends! db tx height hash)
  (for-each
    (lambda (input)
      (let* ((op (txin-previous-output input))
             (txid (outpoint-txid op)))
        (sqlite-run
          db
          "UPDATE utxos SET active = 0, spent_by = ?, spent_height = ? WHERE (txid = ? OR txid = ?) AND output_index = ? AND active = 1"
          hash
          height
          (hex-encode txid)
          (hex-encode (reverse-bytevector txid))
          (outpoint-index op))))
    (transaction-inputs tx)))

;; The generic work column stores a provisional base point until the body is
;; verified, then the block's full additive golf score.
(define (header-chain-score db header height verified?)
  (if (= height 0)
      0
      (let* ((parent
               (car (sqlite-query
                      db "SELECT work FROM headers WHERE hash = ?"
                      (hex-encode (block-header-previous-block header)))))
             (complexity
               (coin-result-value
                 (coin-version-decode (block-header-version header))))
             (length
               (coin-result-value
                 (coin-version-solution-length (block-header-version header))))
             (par
               (puzzle-spec-par
                 (coin-puzzle-for (block-header-previous-block header)
                                 height complexity))))
        (+ (string->number (cdr (assq 'work parent)))
           (if verified? (coin-golf-score par length) 1)))))

;; Write a block into the node's own tables, the way a synced node would.
(define (store-block! db b height)
  (let* ((header (block-header-field b))
         (hash (hex-encode (block-header-hash header)))
         (prev (hex-encode (block-header-previous-block header))))
    (sqlite-run db
                (string-append
                  "INSERT OR REPLACE INTO headers"
                  "(hash, prev_hash, height, work, header_hex, time, bits,"
                  " valid, body_known) VALUES (?,?,?,?,?,?,?,1,1)")
                hash prev height
                (number->string (header-chain-score db header height #t))
                (hex-encode (block-header-serialize header))
                (block-header-time header)
                (block-header-bits header))
    (sqlite-run db
                (string-append
                  "INSERT OR REPLACE INTO blocks"
                  "(hash, height, status, block_hex, validated, updated_at)"
                  " VALUES (?,?,'valid',?,1,0)")
                hash height (hex-encode (block-serialize b)))
    ;; Mirror the connector's UTXO transition for address balance/history.
    (let ((time (block-header-time header)))
      (let loop ((transactions (block-transactions b)) (index 0))
        (unless (null? transactions)
          (let ((tx (car transactions)))
            (unless (= index 0)
              (store-transaction-spends! db tx height hash))
            (store-transaction-outputs! db tx height time hash (= index 0))
            (loop (cdr transactions) (+ index 1)))))
    hash)))

(define (store-header-only! db header height)
  (sqlite-run db
              (string-append
                "INSERT OR REPLACE INTO headers"
                "(hash, prev_hash, height, work, header_hex, time, bits,"
                " valid, body_known) VALUES (?,?,?,?,?,?,?,1,0)")
              (hex-encode (block-header-hash header))
              (hex-encode (block-header-previous-block header))
              height (number->string (header-chain-score db header height #f))
              (hex-encode (block-header-serialize header))
              (block-header-time header)
              (block-header-bits header)))

(define (set-tip! db hash height)
  (sqlite-run db
              "INSERT OR REPLACE INTO metadata(key, value) VALUES (?, ?)"
              "active-chain-tip-hash" hash)
  (sqlite-run db
              "INSERT OR REPLACE INTO metadata(key, value) VALUES (?, ?)"
              "active-chain-tip-height" (number->string height)))

;; The generated witness exactly at the producer validity ceiling.

(define (par-solution parent-hash height complexity)
  (puzzle-spec-par-solution
    (coin-puzzle-for parent-hash height complexity)))

(define (coop-context parent-header puzzle-height complexity)
  (let ((parent-prev (block-header-hash parent-header)))
    (coin-coop-context
      parent-prev-hash: parent-prev
      puzzle-height: puzzle-height
      complexity: complexity
      spec: (coin-puzzle-for parent-prev puzzle-height complexity)
      commits: '())))

(define (personalized-shares parent-header puzzle-height complexity)
  ;; Structurally real but invalid reveals. Explorer must preserve their named
  ;; preview failures without validating signatures or trusting claimed Q.
  (list (make-share 1 "x")
        (make-share 2 "y")
        (make-share 3 "<script>x</script>")))

(define (insert-commit commitment commits)
  (cond ((null? commits) (list commitment))
        ((string<? (hex-encode commitment) (hex-encode (car commits)))
         (cons commitment commits))
        (else (cons (car commits)
                    (insert-commit commitment (cdr commits))))))

(define (sort-commits commits)
  (let loop ((xs commits) (out '()))
    (if (null? xs) out (loop (cdr xs) (insert-commit (car xs) out)))))

;; ============================================================
;; The chain
;; ============================================================
;;
;; Heights 1..31 on top of the regtest genesis header. C is 128 through
;; height 15 and 115 from height 16, so the difficulty history has a real
;; step in it and the next height (32) is a retarget height with a full
;; window of  blocks below it.

(define %early-complexity 128)
(define %late-complexity 115)
(define %tip-height 31)
(define %coop-height 20)

(define (complexity-at height)
  (if (< height 16) %early-complexity %late-complexity))

(define %dir (fresh-dir))

;; Built as side effects below: height -> block, plus height-20 reveals.
(define %blocks '())
(define %coop-shares '())
(define %coop-commits '())
(define %transfer #f)

(define (block-at height)
  (cdr (assv height %blocks)))

(define (transfer-id)
  (hex-encode (reverse-bytevector (transaction-txid %transfer))))

;; The header a block at `height` was built on: the regtest genesis at
;; height 1, and the previous block's header after that. This is the parent
;; hash a puzzle is derived from, and getting it wrong is the easiest
;; mistake in the whole file.
(define %genesis-header #f)

(define (parent-header-at height)
  (if (= height 1) %genesis-header (block-header-field (block-at (- height 1)))))

(define (parent-hash-at height)
  (block-header-hash (parent-header-at height)))

(define %built
  (let ((n (node-open sigilcoin-regtest-chain %dir)))
    (let ((genesis (node-best-header n)))
      (node-close n)
      (set! %genesis-header genesis)
      (let ((db (sqlite-open (explorer-db-path sigilcoin-regtest-chain %dir))))
        (let loop ((height 1) (parent genesis) (last-hash #f))
          (if (> height %tip-height)
              (begin
                (set-tip! db last-hash %tip-height)
                (sqlite-close db)
                #t)
              (let* ((complexity (complexity-at height))
                     (parent-hash (block-header-hash parent))
                     (coop? (= height %coop-height))
                     (commit? (= height (- %coop-height 1)))
                     ;; Height 19 commits to three shares personalized by
                     ;; pubkey; height 20 reveals those blind-bearing records.
                     (prepared
                       (when commit?
                         (set! %coop-shares
                               (personalized-shares
                                 parent height complexity))
                         (let ((context (coop-context parent height complexity)))
                           (set! %coop-commits
                                 (sort-commits
                                   (map (lambda (share)
                                          (coin-share-commitment
                                            context share))
                                        %coop-shares))))))
                     (shares (if coop? %coop-shares '()))
                     (commits (cond (commit? %coop-commits)
                                    (coop? (list (make-bytevector 32 1)
                                                 (make-bytevector 32 2)))
                                    (else '())))
                     (solution
                       (par-solution parent-hash height complexity))
                     (base (build-block
                             sigilcoin-regtest-chain parent height complexity solution
                             shares commits
                             (if (even? height) %script-b %script-a)
                             %script-a))
                     (transfer
                       (and (= height %tip-height)
                            (fixture-transfer
                              (car (block-transactions (block-at 29))))))
                     (remember-transfer
                       (when transfer (set! %transfer transfer)))
                     (b (if transfer
                            (with-extra-transactions
                              base (list transfer))
                            base)))
                (set! %blocks (cons (cons height b) %blocks))
                (loop (+ height 1)
                      (block-header-field b)
                      (store-block! db b height)))))))))

(define (with-store proc)
  (let* ((store (explorer-open sigilcoin-regtest-chain %dir))
         (value (proc store)))
    (explorer-close store)
    value))

(define (body-of path)
  (explorer-response-body
    (explorer-respond sigilcoin-regtest-chain %dir path)))

(define (status-of path)
  (explorer-response-status
    (explorer-respond sigilcoin-regtest-chain %dir path)))

(define (json-of path)
  (json-decode (body-of path)))

(define (dict-get value key)
  (dict-ref value (string->keyword key)))

(define (json-list value)
  (if (list? value) value (array->list value)))

(define (has? haystack needle)
  (string-contains? haystack needle))


(define (spec-at height)
  (coin-puzzle-for (parent-hash-at height) height (complexity-at height)))

(define %all-paths
  (list "/" "/blocks" "/difficulty" "/assets/explorer.js"
        (string-append "/block/" (number->string %coop-height))
        "/block/1" "/block/31" "/block/nope"
        (string-append "/tx/" (transfer-id)) "/tx/nope"
        (string-append "/address/" %miner-a)
        "/api/summary" "/api/blocks" "/api/difficulty"
        (string-append "/api/block/" (number->string %coop-height))
        "/api/block/nope"
        (string-append "/api/tx/" (transfer-id)) "/api/tx/nope"
        (string-append "/api/address/" %miner-a)))

;; ============================================================
;; Fixtures
;; ============================================================

(test-group "the test chain"
  (test "thirty-one  blocks are on disk"
    (assert-equal #t %built)
    (assert-equal %tip-height (length %blocks))
    (with-store
      (lambda (store)
        (assert-equal %tip-height
                      (explorer-summary-tip-height
                        (explorer-chain-summary store))))))

  (test "summary supply is the active UTXO sum, below its scheduled cap"
    (let ((issued
            (let loop ((xs %blocks) (sum 0))
              (if (null? xs)
                  sum
                  (loop (cdr xs)
                        (+ sum
                           (transaction-output-value
                             (car (block-transactions (cdr (car xs)))))))))))
      (with-store
        (lambda (store)
          (let ((summary (explorer-chain-summary store)))
            (assert-equal issued (explorer-summary-supply summary))
            (assert-equal coin-max-supply
                          (explorer-summary-max-supply summary))
            (assert-true
              (< issued (coin-cumulative-supply %tip-height))))))
      (assert-equal issued (dict-get (json-of "/api/summary") "supply"))))


  (test "the hostile blind-bearing consensus shares reached the chain"
    (let* ((b (block-at %coop-height))
           (payload-result
             (coin-block-coinbase-payload b))
           (payload (coin-result-value payload-result))
           (shares-result
             (coin-shares-decode
               (coin-coinbase-payload-shares payload)))
           (shares (coin-result-value shares-result)))
      (assert-true (coin-ok? payload-result))
      (assert-true (coin-ok? shares-result))
      (assert-equal #u8()
                    (coin-coinbase-payload-graffiti payload))
      (assert-equal 3 (length shares))
      (assert-equal %hostile-blind
                    (coin-share-blind (list-ref shares 2)))
      (assert-true (>= (bytevector-length
                         (coin-share-encode (list-ref shares 2)))
                       135))
      (assert-true
        (has? (utf8->string
                (coin-share-solution (list-ref shares 2)))
              "<script>")))))

;; ============================================================
;; Private testnet selection and addresses
;; ============================================================

(test-group "private testnet explorer"
  (test "--testnet selects only the private testnet chain"
    (assert-equal "sigilcoin-main"
                  (chain-config-name (explorer-chain-for-args '())))
    (assert-equal "sigilcoin-regtest"
                  (chain-config-name
                    (explorer-chain-for-args '("--regtest"))))
    (assert-equal "sigilcoin-testnet"
                  (chain-config-name
                    (explorer-chain-for-args '("--testnet")))))

  (test "testnet uses tsgl while main and regtest use sgl"
    (assert-equal "sgl" (explorer-chain-address-hrp sigilcoin-main-chain))
    (assert-equal "sgl" (explorer-chain-address-hrp sigilcoin-regtest-chain))
    (assert-equal "tsgl"
                  (explorer-chain-address-hrp sigilcoin-testnet-chain))
    (assert-true (string-starts-with? %testnet-miner-a "tsgl1"))
    (assert-equal %script-a
                  (explorer-address->script-for-chain
                    sigilcoin-testnet-chain %testnet-miner-a))
    (assert-equal #f
                  (explorer-address->script-for-chain
                    sigilcoin-testnet-chain %miner-a))
    (assert-equal #f
                  (explorer-address->script-for-chain
                    sigilcoin-main-chain %testnet-miner-a)))

  (test "testnet summary, address, golf, co-op, and difficulty routes answer read-only"
    (let* ((dir (fresh-dir))
           (n (node-open sigilcoin-testnet-chain dir))
           (genesis (node-best-header n)))
      (node-close n)
      (let* ((path (explorer-db-path sigilcoin-testnet-chain dir))
             (db (sqlite-open path))
             (complexity 128)
             (b1 (build-block
                   sigilcoin-testnet-chain genesis 1 complexity
                   (par-solution (block-header-hash genesis) 1 complexity)
                   '() '() %script-a %script-a))
             (shares (personalized-shares genesis 1 complexity))
             (b2 (build-block
                   sigilcoin-testnet-chain (block-header-field b1) 2 complexity
                   (par-solution (block-header-hash (block-header-field b1))
                                    2 complexity)
                   shares '() %script-a %script-a)))
        (store-block! db b1 1)
        (set-tip! db (store-block! db b2 2) 2)
        (sqlite-close db)
        (let* ((before (read-file-bytes path))
               (routes
                 (list "/" "/blocks" "/difficulty" "/block/2"
                       (string-append "/address/" %testnet-miner-a)
                       "/api/summary" "/api/blocks" "/api/difficulty"
                       "/api/block/2"
                       (string-append "/api/address/" %testnet-miner-a))))
          (for-each
            (lambda (route)
              (let ((response
                      (explorer-respond sigilcoin-testnet-chain dir route)))
                (assert-equal 200 (explorer-response-status response))))
            routes)
          (let* ((summary
                   (json-decode
                     (explorer-response-body
                       (explorer-respond sigilcoin-testnet-chain dir
                                         "/api/summary"))))
                 (block
                   (json-decode
                     (explorer-response-body
                       (explorer-respond sigilcoin-testnet-chain dir
                                         "/api/block/2"))))
                 (page (explorer-response-body
                         (explorer-respond sigilcoin-testnet-chain dir
                                           "/block/2"))))
            (assert-equal "sigilcoin-testnet" (dict-get summary "chain"))
            (assert-equal 3 (dict-get block "share_count"))
            (assert-true (number? (dict-get block "complexity")))
            (let ((golf (dict-get block "golf")))
              (assert-equal 0 (dict-get golf "savings"))
              (assert-equal 1 (dict-get golf "block_score"))
              (assert-equal 2 (dict-get golf "chain_score"))
              (assert-equal (dict-get golf "par")
                            (dict-get golf "claimed_length")))
            (assert-equal 'null (dict-get block "share_quality"))
            (assert-true (has? page "<h2>Puzzle</h2>"))
            (assert-true (has? page "<h2>Co-op shares</h2>"))
            (assert-true (has? page %testnet-miner-a))
            (assert-true (not (has? page "<script>"))))
          (assert-equal 404
                        (explorer-response-status
                          (explorer-respond sigilcoin-testnet-chain dir
                            (string-append "/address/" %miner-a))))
          (assert-equal before (read-file-bytes path)))))))

;; ============================================================
;; Read-only
;; ============================================================

(test-group "the explorer still cannot write a chain"
  (test "every write through an explorer handle is refused"
    (with-store
      (lambda (store)
        (let ((db (explorer-store-db store)))
          (assert-equal #f
                        (sqlite-run db
                                    "INSERT INTO metadata(key, value) VALUES (?, ?)"
                                    "explorer" "was here"))
          (assert-equal "attempt to write a readonly database"
                        (sqlite-errmsg db))
          (assert-equal #f (sqlite-exec db "DELETE FROM headers"))
          (assert-equal #f (sqlite-exec db "DROP TABLE blocks"))))))

  (test "query_only is on for every handle"
    (with-store
      (lambda (store)
        (assert-equal 1 (cdr (car (car (sqlite-query
                                         (explorer-store-db store)
                                         "PRAGMA query_only"))))))))

  (test "serving every  route leaves the database byte for byte identical"
    (let* ((path (explorer-db-path sigilcoin-regtest-chain %dir))
           (before (read-file-bytes path)))
      (for-each (lambda (route) (body-of route)) %all-paths)
      (assert-equal before (read-file-bytes path))))

  (test "a missing database is still never created"
    (let ((dir (fresh-dir)))
      (assert-equal 503 (explorer-response-status
                          (explorer-respond sigilcoin-regtest-chain dir
                                            "/difficulty")))
      (assert-true (not (file-exists?
                          (explorer-db-path sigilcoin-regtest-chain dir))))))

  (test "the compiled client asset works without a database"
    (let* ((dir (fresh-dir))
           (response (explorer-respond sigilcoin-regtest-chain dir
                                       "/assets/explorer.js")))
      (assert-equal 200 (explorer-response-status response))
      (assert-equal "application/javascript; charset=utf-8"
                    (explorer-response-content-type response))
      (assert-equal (explorer-client-javascript)
                    (explorer-response-body response))
      (assert-true (not (file-exists?
                          (explorer-db-path sigilcoin-regtest-chain dir)))))))

;; ============================================================
;; Puzzle rendering
;; ============================================================

(test-group "puzzle rendering"
  (test "the pairs, constraint, k and par are the generator's own"
    (with-store
      (lambda (store)
        (let* ((height 12)
               (b (explorer-block-by-height store height))
               (spec (spec-at height)))
          (assert-equal (complexity-at height) (explorer-block-complexity b))
          (assert-equal (puzzle-spec-constraint spec)
                        (explorer-block-constraint b))
          (assert-equal (puzzle-spec-k spec) (explorer-block-k b))
          (assert-equal (puzzle-spec-par spec) (explorer-block-par b))
          (assert-equal (puzzle-spec-k spec)
                        (length (explorer-block-examples b)))
          (assert-equal (map (lambda (pair)
                               (cons (puzzle-print-value (car pair))
                                     (puzzle-print-value (cdr pair))))
                             (puzzle-spec-examples spec))
                        (explorer-block-examples b))))))

  (test "the winning solution is shown as consensus prints it"
    (with-store
      (lambda (store)
        (let* ((b (explorer-block-by-height store 12))
               (parsed (puzzle-parse (explorer-block-solution b))))
          (assert-true (puzzle-ok? parsed))
          (assert-equal (puzzle-print-expression (puzzle-result-value parsed))
                        (explorer-block-solution-source b))))))

  (test "the block page carries every pair, the constraint and C"
    (let* ((height 12)
           (page (body-of (string-append "/block/" (number->string height))))
           (spec (spec-at height)))
      (assert-equal 200 (status-of (string-append "/block/"
                                                  (number->string height))))
      (assert-true (has? page "<h2>Puzzle</h2>"))
      (assert-true (has? page (string-append "<td>"
                                             (number->string
                                               (complexity-at height))
                                             "</td>")))
      (assert-true (has? page "no restriction"))
      (for-each
        (lambda (pair)
          (assert-true (has? page (explorer-escape
                                    (puzzle-print-value (car pair)))))
          (assert-true (has? page (explorer-escape
                                    (puzzle-print-value (cdr pair))))))
        (puzzle-spec-examples spec))))

  (test "the summary publishes the next height's puzzle"
    (with-store
      (lambda (store)
        (let* ((s (explorer-chain-summary store))
               (next (+ %tip-height 1))
               (complexity (explorer-summary-next-complexity s))
               (spec (coin-puzzle-for
                       (block-header-hash
                         (block-header-field (block-at %tip-height)))
                       next
                       complexity)))
          (assert-true (number? complexity))
          (assert-equal (puzzle-spec-par spec) (explorer-summary-puzzle-par s))
          (assert-equal (puzzle-spec-k spec) (explorer-summary-puzzle-k s))
          (assert-equal (puzzle-spec-constraint spec)
                        (explorer-summary-puzzle-constraint s))
          (assert-equal (puzzle-spec-k spec)
                        (length (explorer-summary-puzzle-examples s)))))))

  (test "a tier-2 constraint renders in human terms"
    ;; Its own two-block chain: tier 2 needs C >= 1024, and the main chain
    ;; is deliberately at a complexity the early chain would really run at.
    (let* ((dir (fresh-dir))
           (n (node-open sigilcoin-regtest-chain dir))
           (genesis (node-best-header n)))
      (node-close n)
      (let ((db (sqlite-open (explorer-db-path sigilcoin-regtest-chain dir))))
        (let* ((complexity 2048)
               (b (build-block sigilcoin-regtest-chain genesis 1 complexity
                                  (par-solution
                                    (block-header-hash genesis) 1 complexity)
                                  '() '()
                                  %script-a %script-a))
               (hash (store-block! db b 1)))
          (set-tip! db hash 1)
          (sqlite-close db)
          (let ((spec (coin-puzzle-for (block-header-hash genesis)
                                          1 complexity)))
            ;; Tier 2's catalogue is (1 2 4 6 7): never the empty rule.
            (assert-true (> (puzzle-spec-constraint spec) 0))
            (assert-true (>= (puzzle-spec-k spec) 3))
            (let ((store (explorer-open sigilcoin-regtest-chain dir)))
              (let ((block (explorer-block-by-height store 1)))
                (assert-equal complexity (explorer-block-complexity block))
                (assert-equal (puzzle-spec-constraint spec)
                              (explorer-block-constraint block))
                (assert-true (string? (explorer-block-constraint-text block)))
                (assert-true (> (string-length
                                  (explorer-block-constraint-text block))
                                0))
                (assert-true (not (string=? "unknown"
                                            (explorer-block-constraint-text
                                              block)))))
              (explorer-close store))
            (let ((page (explorer-response-body
                          (explorer-respond sigilcoin-regtest-chain dir
                                            "/block/1"))))
              (assert-true (has? page "<h2>Puzzle</h2>"))
              (assert-true (has? page (explorer-escape
                                        (explorer-block-constraint-text
                                          (let* ((store (explorer-open
                                                          sigilcoin-regtest-chain
                                                          dir))
                                                 (b (explorer-block-by-height
                                                      store 1)))
                                            (explorer-close store)
                                            b))))))))))))

;; ============================================================
;; Proof-of-golf rendering
;; ============================================================

(test-group "proof-of-golf rendering"
  (test "at-par blocks add one point each without changing block identity"
    (with-store
      (lambda (store)
        (let* ((height 7)
               (b (explorer-block-by-height store height))
               (header (block-header-field (block-at height)))
               (value (json-of "/api/block/7"))
               (golf (dict-get value "golf"))
               (par (puzzle-spec-par (spec-at height))))
          (assert-equal (block-header-id header) (explorer-block-id b))
          (assert-equal (block-header-id header) (dict-get value "id"))
          (assert-equal par (explorer-block-solution-length b))
          (assert-equal par (dict-get golf "claimed_length"))
          (assert-equal par (dict-get golf "par"))
          (assert-equal 0 (explorer-block-savings b))
          (assert-equal 0 (dict-get golf "savings"))
          (assert-equal 1 (explorer-block-block-score b))
          (let ((page (explorer-block-page b)))
            (assert-true (has? page "<td>block score</td><td>1</td>"))
            (assert-true (has? page "<td>chain score</td><td>7</td>")))
          (assert-true
            (has? (body-of "/") "block score 1; chain score 7"))
          (assert-equal 1 (dict-get golf "block_score"))
          (assert-equal height (explorer-block-chain-score b))
          (assert-equal height (dict-get golf "chain_score"))))))

  (test "savings cap and invalid claims never manufacture validated scores"
    (let* ((dir (fresh-dir))
           (n (node-open sigilcoin-regtest-chain dir))
           (genesis (node-best-header n))
           (spec (coin-puzzle-for (block-header-hash genesis) 1 128))
           (par (puzzle-spec-par spec))
           (b (build-block sigilcoin-regtest-chain genesis 1 128
                           (puzzle-spec-par-solution spec)
                           '() '() %script-a %script-a))
           (capped (with-claimed-length (block-header-field b) (- par 12)))
           (over-par (with-claimed-length (block-header-field b) (+ par 1))))
      (node-close n)
      (let ((db (sqlite-open (explorer-db-path sigilcoin-regtest-chain dir))))
        (store-header-only! db capped 1)
        (store-header-only! db over-par 1)
        (sqlite-close db))
      (let ((store (explorer-open sigilcoin-regtest-chain dir)))
        (let* ((pending (explorer-block-by-id store (block-header-id capped)))
               (pending-json (json-decode (explorer-block-json pending)))
               (golf (dict-get pending-json "golf"))
               (invalid (explorer-block-by-id store (block-header-id over-par)))
               (invalid-json (json-decode (explorer-block-json invalid)))
               (invalid-golf (dict-get invalid-json "golf")))
          (assert-equal (- par 12) (dict-get golf "claimed_length"))
          (assert-equal 8 (dict-get golf "savings"))
          (assert-equal 9 (dict-get golf "block_score"))
          (assert-equal 1 (dict-get golf "chain_score"))
          (assert-equal "body-not-downloaded" (dict-get pending-json "problem"))
          (assert-equal "solution-over-par" (dict-get invalid-json "problem"))
          (assert-equal (+ par 1) (dict-get invalid-golf "claimed_length"))
          (assert-equal 'null (dict-get invalid-golf "savings"))
          (assert-equal 'null (dict-get invalid-golf "block_score"))
          (assert-true
            (has? (explorer-block-page invalid)
                  "<td>block score</td><td>&mdash;</td>"))
          (assert-equal 1 (dict-get invalid-golf "chain_score"))
          (assert-true (has? (explorer-block-page invalid) "solution-over-par")))
        (explorer-close store))
      ;; A downloaded body that contradicts its header cannot erase the claim
      ;; or turn the claimed points into proof of a valid solution.
      (let ((db (sqlite-open (explorer-db-path sigilcoin-regtest-chain dir))))
        (store-block! db
                      (block header-field: capped
                             transactions: (block-transactions b))
                      1)
        (sqlite-run
          db "UPDATE headers SET work = '1' WHERE hash = ?"
          (hex-encode (block-header-hash capped)))
        (sqlite-close db))
      (let ((store (explorer-open sigilcoin-regtest-chain dir)))
        (let* ((invalid (explorer-block-by-id store (block-header-id capped)))
               (value (json-decode (explorer-block-json invalid)))
               (golf (dict-get value "golf")))
          (assert-equal "solution-length-mismatch" (dict-get value "problem"))
          (assert-equal par (dict-get value "solution_bytes"))
          (assert-equal (- par 12) (dict-get golf "claimed_length"))
          (assert-equal 8 (dict-get golf "savings"))
          (assert-equal 9 (dict-get golf "block_score"))
          (assert-equal 1 (dict-get golf "chain_score"))
          (let ((page (explorer-block-page invalid)))
            (assert-true (has? page "<td>block score</td><td>9</td>"))
            (assert-true (has? page "<td>chain score</td><td>1</td>")))
          (assert-true
            (has? (explorer-block-page invalid) "solution-length-mismatch")))
        (explorer-close store))
      ;; The node persists invalidation even when no validated body is readable.
      (let ((db (sqlite-open (explorer-db-path sigilcoin-regtest-chain dir)))
            (hash (hex-encode (block-header-hash capped))))
        (sqlite-run db "UPDATE headers SET valid = 0 WHERE hash = ?" hash)
        (sqlite-run db "UPDATE blocks SET validated = 0 WHERE hash = ?" hash)
        (sqlite-close db))
      (let ((store (explorer-open sigilcoin-regtest-chain dir)))
        (let* ((invalid (explorer-block-by-id store (block-header-id capped)))
               (value (json-decode (explorer-block-json invalid)))
               (golf (dict-get value "golf")))
          (assert-equal "invalid-header" (dict-get value "problem"))
          (assert-equal 'null (dict-get value "solution_bytes"))
          (assert-equal 9 (dict-get golf "block_score"))
          (assert-equal 1 (dict-get golf "chain_score"))
          (assert-true (has? (explorer-block-page invalid) "invalid-header")))
        (explorer-close store))
      (remove-tree dir)))

  (test "length remains body-derived and is shown against par"
    (with-store
      (lambda (store)
        (let ((b (explorer-block-by-height store 7)))
          (assert-equal (- (explorer-block-par b)
                           (explorer-block-solution-length b))
                        (explorer-block-under-par b))
          (assert-equal (coin-margin (explorer-block-par b)
                                     (explorer-block-solution-length b))
                        (explorer-block-margin b))))))

  (test "a margin reads as a signed percentage of par"
    (assert-equal "+10.0% (under par)" (explorer-margin-text 100))
    (assert-equal "-2.3% (over par)" (explorer-margin-text -23))
    (assert-equal "0.0% (at par)" (explorer-margin-text 0))
    (assert-equal "unknown" (explorer-margin-text #f))))

;; ============================================================
;; Co-op shares and coinbase payouts
;; ============================================================

(test-group "co-op shares"
  (test "list reads never preview shares or expected payouts"
    (with-store
      (lambda (store)
        (let* ((blocks
                 (explorer-recent-blocks store explorer-default-page-size))
               (b (let loop ((xs blocks))
                    (cond ((null? xs) #f)
                          ((= %coop-height
                              (explorer-block-height (car xs)))
                           (car xs))
                          (else (loop (cdr xs)))))))
          (assert-true (explorer-block? b))
          (for-each
            (lambda (share)
              (assert-equal 'not-evaluated
                            (explorer-share-problem share))
              (assert-equal #f (explorer-share-contribution share))
              (assert-equal #f (explorer-share-steps share))
              (assert-equal #f (explorer-share-cells share)))
            (explorer-block-shares b))
          (for-each
            (lambda (output)
              (assert-equal #f (explorer-output-expected output)))
            (explorer-block-outputs b))))))

  (test "malformed share previews stay named and unverified"
    (with-store
      (lambda (store)
        (let* ((b (explorer-block-by-height store %coop-height))
               (shares (explorer-block-shares b)))
          (assert-equal 3 (length shares))
          (assert-equal 3 (explorer-block-share-count b))
          (assert-equal 2 (explorer-block-commit-count b))
          (let ((context (coop-context
                           (block-header-field
                             (block-at (- %coop-height 2)))
                           (- %coop-height 1)
                           (complexity-at (- %coop-height 1)))))
            (let loop ((xs shares) (raw %coop-shares))
              (unless (null? xs)
                (let* ((s (car xs))
                       (raw-share (car raw))
                       (preview
                         (coin-check-share-solution context raw-share)))
                  (assert-true (string? (explorer-share-address s)))
                  (assert-true (number? (explorer-share-solution-length s)))
                  (assert-true (coin-failed? preview))
                  (assert-equal (coin-result-reason preview)
                                (explorer-share-problem s))
                  (assert-equal #f (explorer-share-par s))
                  (assert-equal #f (explorer-share-margin s))
                  (assert-equal #f (explorer-share-contribution s))
                  (assert-equal #f (explorer-share-steps s))
                  (assert-equal #f (explorer-share-cells s))
                  ;; Pure preview must not grant verified-cache provenance.
                  (assert-error (coin-share-quality context raw-share))
                  (loop (cdr xs) (cdr raw))))))
          (assert-equal #f (explorer-block-share-quality b))
          ;; The three programs are byte-wise distinct, as §6.4 requires.
          (assert-true (not (equal? (explorer-share-solution
                                      (list-ref shares 0))
                                    (explorer-share-solution
                                      (list-ref shares 1)))))
          (assert-true (not (equal? (explorer-share-solution
                                      (list-ref shares 1))
                                    (explorer-share-solution
                                      (list-ref shares 2)))))))))

  (test "a share's payout key derives the address it is paid at"
    (with-store
      (lambda (store)
        (let ((shares (explorer-block-shares
                        (explorer-block-by-height store %coop-height))))
          (let loop ((xs shares) (raw %coop-shares))
            (unless (null? xs)
              (let ((pubkey (coin-share-pubkey (car raw))))
                (assert-equal (explorer-script->address
                                (coin-share-script pubkey))
                              (explorer-share-address (car xs)))
                (assert-equal (hex-encode pubkey)
                              (explorer-share-pubkey-hex (car xs))))
              (loop (cdr xs) (cdr raw))))))))

  (test "failed previews omit the expected cooperative payout"
    (with-store
      (lambda (store)
        (let* ((b (explorer-block-by-height store %coop-height))
               (outputs (explorer-block-outputs b))
               (subsidy (coin-block-reward %coop-height))
               (share-pool (quotient subsidy 10))
               (share-value (quotient share-pool 3))
               (carrier-value (quotient subsidy 20)))
          ;; 1 producer + 3 shares + 1 carrier.
          (assert-equal 5 (length outputs))
          (assert-equal '(producer share share share carrier)
                        (map explorer-output-role outputs))
          (assert-equal subsidy (explorer-block-total-output b))
          (assert-equal subsidy (explorer-block-reward b))
          ;; Actual bytes carry the deterministic equal-contribution fixture.
          (assert-equal share-value
                        (explorer-output-value (list-ref outputs 1)))
          (assert-equal carrier-value
                        (explorer-output-value (list-ref outputs 4)))
          (assert-equal (- subsidy carrier-value (* 3 share-value))
                        (explorer-output-value (car outputs)))
          ;; Every pure preview failed, so no expected comparison is invented.
          (for-each (lambda (o)
                      (assert-equal #f (explorer-output-expected o)))
                    outputs)
          ;; The share payouts on the page are the actual share outputs.
          (assert-equal (map explorer-share-payout (explorer-block-shares b))
                        (list (explorer-output-value (list-ref outputs 1))
                              (explorer-output-value (list-ref outputs 2))
                              (explorer-output-value (list-ref outputs 3))))))))

  (test "a share-less block mints 80% to the producer"
    (with-store
      (lambda (store)
        (let* ((b (explorer-block-by-height store 12))
               (outputs (explorer-block-outputs b))
               (minted (quotient (* 4 (coin-block-reward 12)) 5)))
          (assert-equal '() (explorer-block-shares b))
          (assert-equal 0 (explorer-block-share-count b))
          (assert-equal 1 (length outputs))
          (assert-equal 'producer (explorer-output-role (car outputs)))
          (assert-equal minted (explorer-output-value (car outputs)))
          (assert-equal minted (explorer-output-expected (car outputs)))
          (assert-equal minted (explorer-block-total-output b))))))

  (test "negative inferred fees omit the expected payout"
    (let* ((dir (fresh-dir))
           (n (node-open sigilcoin-regtest-chain dir))
           (genesis (node-best-header n))
           (complexity coin-genesis-complexity))
      (node-close n)
      (let* ((solution
               (par-solution (block-header-hash genesis) 1 complexity))
             (valid
               (build-block sigilcoin-regtest-chain genesis 1 complexity
                            solution '() '()
                            %script-a %script-a))
             (under-minted (with-solo-coinbase-value valid 0))
             (db (sqlite-open
                   (explorer-db-path sigilcoin-regtest-chain dir)))
             (hash (store-block! db under-minted 1)))
        (set-tip! db hash 1)
        (sqlite-close db)
        (let ((store (explorer-open sigilcoin-regtest-chain dir)))
          (let* ((b (explorer-block-by-height store 1))
                 (outputs (explorer-block-outputs b)))
            (assert-equal 0 (explorer-block-total-output b))
            (assert-equal 1 (length outputs))
            (assert-equal #f (explorer-output-expected (car outputs))))
          (explorer-close store)))
      (remove-tree dir)))

  (test "the block page renders shares and actual-versus-preview payout"
    (let ((page (body-of (string-append "/block/"
                                        (number->string %coop-height)))))
      (assert-true (has? page "<h2>Co-op shares</h2>"))
      (assert-true (has? page "personal par"))
      (assert-true (has? page "aggregate share quality"))
      (assert-true (has? page "blind"))
      (assert-true (has? page "<h2>Coinbase payout</h2>"))
      (assert-true (has? page "actual coinbase total"))
      (assert-true (has? page "payout preview"))
      (assert-true (has? page "carrier (the previous producer)"))
      (assert-true (has? page "commitments carried: 2"))
      (assert-true (has? page "Shares divide floor(10%"))
      (with-store
        (lambda (store)
          (for-each
            (lambda (s)
              (assert-true (has? page (explorer-share-address s))))
            (explorer-block-shares
              (explorer-block-by-height store %coop-height)))))
      ;; The payout table shows the producer and carrier explicitly.
      (assert-true (has? page ">producer<"))
      (assert-true (has? page (explorer-sigil-amount
                                (explorer-block-total-output
                                  (with-store
                                    (lambda (store)
                                      (explorer-block-by-height
                                        store %coop-height)))))))))

  (test "the consensus payout total is exact at every share count"
    (let loop ((r 0) (shares '()))
      (when (<= r 8)
        (let* ((subsidy 10000000001)
               (fees 17)
               (ordered (reverse shares))
               (entries
                 (coin-payout-plan subsidy fees ordered
                                   (map (lambda (share) 1) ordered)
                                   %script-a))
               (minted (if (= r 0)
                           (+ (quotient (* 4 subsidy) 5) fees)
                           (+ subsidy fees))))
          (assert-equal (+ 1 r (if (> r 0) 1 0)) (length entries))
          (assert-equal minted (apply + (map car entries))))
        (loop (+ r 1)
              (cons (make-share (+ r 1) "x") shares))))
    (assert-true #t)))

;; ============================================================
;; Difficulty history
;; ============================================================

(test-group "difficulty history"
  (test "every row carries the height's own C, par and margin"
    (with-store
      (lambda (store)
        (let ((blocks (explorer-recent-blocks store explorer-difficulty-window)))
          (for-each
            (lambda (b)
              (let ((height (explorer-block-height b)))
                (when (> height 0)
                  (assert-equal (complexity-at height)
                                (explorer-block-complexity b))
                  (assert-equal (coin-margin
                                  (explorer-block-par b)
                                  (explorer-block-solution-length b))
                                (explorer-block-margin b)))))
            blocks)))))

  (test "the page marks the height where C moved"
    (let ((page (body-of "/difficulty")))
      (assert-equal 200 (status-of "/difficulty"))
      (assert-true (has? page "<h1>Difficulty</h1>"))
      (assert-true (has? page (string-append
                                "retarget "
                                (number->string %early-complexity)
                                " &rarr; "
                                (number->string %late-complexity))))
      ;; And nowhere else: C is flat on either side of height 16.
      (assert-true (has? page (number->string %early-complexity)))
      (assert-true (has? page (number->string %late-complexity)))))

  (test "the JSON history is the same rows"
    (let* ((value (json-of "/api/difficulty"))
           (history (json-list (dict-get value "history"))))
      (assert-equal %late-complexity (dict-get value "complexity"))
      (assert-true (number? (dict-get value "next_retarget_height")))
      (assert-equal 0 (modulo (dict-get value "next_retarget_height") 16))
      (with-store
        (lambda (store)
          (let ((blocks (explorer-recent-blocks store
                                                explorer-difficulty-window)))
            (assert-equal (length blocks) (length history))
            (let loop ((bs blocks) (rows history))
              (unless (null? bs)
                (assert-equal (explorer-block-height (car bs))
                              (dict-get (car rows) "height"))
                (assert-equal (or (explorer-block-complexity (car bs)) 'null)
                              (dict-get (car rows) "complexity"))
                (assert-equal (or (explorer-block-margin (car bs)) 'null)
                              (dict-get (car rows) "margin"))
                (loop (cdr bs) (cdr rows)))))))))

  (test "the first retarget includes the genesis header margin"
    (let* ((path (explorer-db-path sigilcoin-regtest-chain %dir))
           (tip-15
             (hex-encode
               (block-header-hash (block-header-field (block-at 15)))))
           (tip
             (hex-encode
               (block-header-hash
                 (block-header-field (block-at %tip-height)))))
           (db (sqlite-open path)))
      (set-tip! db tip-15 15)
      (sqlite-close db)
      (let ((summary
              (with-store
                (lambda (store) (explorer-chain-summary store)))))
        (let ((restore (sqlite-open path)))
          (set-tip! restore tip %tip-height)
          (sqlite-close restore))
        (assert-equal %late-complexity
                      (explorer-summary-next-complexity summary))
        (assert-equal 16
                      (explorer-summary-next-retarget-height summary)))))

  (test "the next complexity is the retarget rule's own answer"
    (with-store
      (lambda (store)
        (let* ((s (explorer-chain-summary store))
               (next (+ %tip-height 1))
               ;; The window is heights next-16 .. next-1, oldest first.
               (margins (let loop ((height (- next 16)) (out '()))
                          (if (>= height next)
                              (reverse out)
                              (loop (+ height 1)
                                    (cons (explorer-block-margin
                                            (explorer-block-by-height
                                              store height))
                                          out))))))
          (assert-equal 16 (length margins))
          (assert-true (coin-retarget-height? next))
          (assert-equal (coin-complexity-for next %late-complexity margins)
                        (explorer-summary-next-complexity s))
          (assert-equal next
                        (explorer-summary-next-retarget-height s)))))))


;; ============================================================
;; Hostile bytes
;; ============================================================

(test-group "hostile blocks render inert"
  (test "opaque quote bytes are sanitized before escaping"
    (let ((page (explorer-text %hostile-graffiti))
          (safe (explorer-safe-text %hostile-graffiti)))
      (assert-equal
        (make-string 4 (integer->char explorer-replacement-char))
        (substring safe (- (string-length safe) 4) (string-length safe)))
      (assert-true (has? page "&lt;script&gt;alert(1)&lt;/script&gt;"))
      (assert-true (not (has? page "<script>")))
      (assert-true (not (has? page "<script>alert")))
      (assert-true (not (has? page "<img src=x")))
      (assert-true (has? page "&lt;img src=x onerror=&quot;y&quot;&gt;"))
      (assert-true (has? page "&#39;sq&#39;"))))

  (test "bodyless genesis exposes its configured quote"
    (for-each
      (lambda (fixture)
        (let ((dir (fresh-dir))
              (chain (car fixture))
              (quote-text (cdr fixture)))
          (node-close (node-open chain dir))
          (let* ((page
                   (explorer-response-body
                     (explorer-respond chain dir "/block/0")))
                 (value
                   (json-decode
                     (explorer-response-body
                       (explorer-respond chain dir "/api/block/0")))))
            (assert-equal quote-text (dict-get value "graffiti"))
            (assert-true (has? page quote-text)))
          (remove-tree dir)))
      (list (cons sigilcoin-main-chain coin-genesis-quote)
            (cons sigilcoin-testnet-chain coin-testnet-genesis-quote)
            (cons sigilcoin-regtest-chain coin-regtest-genesis-quote))))

  (test "stored genesis quotes are escaped while retaining a zero score"
    (let* ((dir (fresh-dir))
           (quote-text (string-append "/" %hostile-tag
                                      "/ <script>alert(1)</script> 'sq'"))
           (b (coin-genesis-block quote-text coin-regtest-genesis-time
                                  coin-regtest-pow-limit-bits)))
      (node-close (node-open sigilcoin-regtest-chain dir))
      (let ((db (sqlite-open (explorer-db-path sigilcoin-regtest-chain dir))))
        (set-tip! db (store-block! db b 0) 0)
        (sqlite-close db))
      (let* ((page (explorer-response-body
                     (explorer-respond sigilcoin-regtest-chain dir "/block/0")))
             (value (json-decode
                      (explorer-response-body
                        (explorer-respond sigilcoin-regtest-chain dir
                                          "/api/block/0")))))
        (assert-equal quote-text (dict-get value "graffiti"))
        (assert-equal 0 (dict-get (dict-get value "golf") "block_score"))
        (assert-equal 0 (dict-get (dict-get value "golf") "chain_score"))
        (assert-true (has? page "&lt;script&gt;alert(1)&lt;/script&gt;"))
        (assert-true (has? page "&lt;img src=x onerror=&quot;y&quot;&gt;"))
        (assert-false (has? page "<script>"))
        (assert-false (has? page "<img src=x")))
      (remove-tree dir)))

  (test "hostile share program, blind and signature cannot inject"
    (let ((page (body-of (string-append "/block/"
                                        (number->string %coop-height)))))
      (assert-true (has? page "&lt;script&gt;x&lt;/script&gt;"))
      (assert-true (has? page (hex-encode %hostile-blind)))
      (assert-true (not (has? page "<script>")))
      (assert-true (not (has? page "<blind>")))
      (assert-true (not (has? page "<signature>")))))

  (test "no raw control byte reaches the page"
    (let ((bytes (string->utf8 (body-of (string-append
                                          "/block/"
                                          (number->string %coop-height))))))
      (let loop ((i 0))
        (when (< i (bytevector-length bytes))
          (let ((b (bytevector-u8-ref bytes i)))
            (assert-true (or (>= b #x20) (= b #x0a)))
            (loop (+ i 1)))))
      (assert-true #t)))

  (test "no HTML route anywhere leaks an inline or attacker script tag"
    (for-each
      (lambda (route)
        (let ((response (explorer-respond sigilcoin-regtest-chain %dir route)))
          (when (has? (explorer-response-content-type response) "text/html")
            (let ((page (explorer-response-body response)))
              (assert-true (not (has? page "<script>")))
              (assert-true (not (has? page "<script>alert")))
              (assert-true
                (has? page
                      "<script src=\"/assets/explorer.js\" defer></script>"))))))
      %all-paths)
    (assert-true #t))


  (test "the JSON keeps the bytes and changes the media type"
    (let* ((value (json-of (string-append "/api/block/"
                                          (number->string %coop-height))))
           (author (dict-get value "author"))
           (shares (json-list (dict-get value "shares"))))
      (assert-equal 'null author)
      (assert-equal "" (dict-get value "graffiti"))
      (assert-true (has? (dict-get (list-ref shares 2) "solution")
                         "<script>"))
      (assert-equal (hex-encode %hostile-blind)
                    (dict-get (list-ref shares 2) "blind"))
      (assert-equal "application/json; charset=utf-8"
                    (explorer-response-content-type
                      (explorer-respond sigilcoin-regtest-chain %dir
                                        "/api/blocks"))))))

;; ============================================================
;; Transaction activity
;; ============================================================

(test-group "transaction activity"
  (test "a block detail lists every transaction"
    (let* ((id (hex-encode
                 (reverse-bytevector (transaction-txid %transfer))))
           (page (body-of (string-append
                            "/block/" (number->string %tip-height))))
           (value (json-of (string-append
                             "/api/block/" (number->string %tip-height))))
           (rows (json-list (dict-get value "transaction_details"))))
      (assert-true (has? page "<h2>Transactions</h2>"))
      (assert-true (has? page id))
      (assert-true (has? page "transfer"))
      (assert-equal 2 (length rows))
      (assert-equal id (dict-get (list-ref rows 1) "id"))
      (assert-equal 1 (dict-get (list-ref rows 1) "inputs"))
      (assert-equal 2 (dict-get (list-ref rows 1) "outputs"))
      (assert-equal 80000000
                    (dict-get (list-ref rows 1) "total_output"))))

  (test "an address lists received and spent transactions"
    (let ((id (hex-encode
                (reverse-bytevector (transaction-txid %transfer)))))
      (with-store
        (lambda (store)
          (let find ((rows (explorer-address-transactions
                             store %script-a
                             explorer-default-page-size)))
            (cond
              ((null? rows)
               (error "transfer missing from address activity"))
              ((string=? id (explorer-address-transaction-id (car rows)))
               (assert-equal %tip-height
                             (explorer-address-transaction-height (car rows)))
               (assert-equal 70000000
                             (explorer-address-transaction-received (car rows)))
               (assert-equal 80000000
                             (explorer-address-transaction-spent (car rows))))
              (else (find (cdr rows)))))))
      (let* ((page (body-of (string-append "/address/" %miner-a)))
             (value (json-of (string-append "/api/address/" %miner-a)))
             (rows (json-list (dict-get value "transactions"))))
        (assert-true (has? page "<h2>Recent transactions</h2>"))
        (assert-true (has? page id))
        (assert-true (has? page "-0.10000000"))
        (let find ((xs rows))
          (cond
            ((null? xs) (error "transfer missing from address JSON"))
            ((string=? id (dict-get (car xs) "id"))
             (assert-equal 70000000 (dict-get (car xs) "received"))
             (assert-equal 80000000 (dict-get (car xs) "spent"))
             (assert-equal -10000000 (dict-get (car xs) "net")))
            (else (find (cdr xs)))))))))

(test-group "transaction navigation"
  (test "confirmed lookup resolves block, prevout, fee, and outputs"
    (with-store
      (lambda (store)
        (let* ((tx (explorer-transaction-by-id store (transfer-id)))
               (inputs (explorer-transaction-inputs tx))
               (outputs (explorer-transaction-outputs tx))
               (funding-id
                 (hex-encode
                   (reverse-bytevector
                     (transaction-txid
                       (car (block-transactions (block-at 29))))))))
          (assert-equal %tip-height (explorer-transaction-height tx))
          (assert-equal 0 (explorer-transaction-fee tx))
          (assert-equal funding-id
                        (explorer-transaction-input-previous-id
                          (car inputs)))
          (assert-equal %miner-a
                        (explorer-transaction-input-address (car inputs)))
          (assert-equal 80000000
                        (explorer-transaction-input-value (car inputs)))
          (assert-equal %miner-b
                        (explorer-transaction-output-address (car outputs)))
          (assert-equal 10000000
                        (explorer-transaction-output-value (car outputs)))
          (assert-equal %miner-a
                        (explorer-transaction-output-address
                          (list-ref outputs 1)))))))

  (test "transaction, block, address, and JSON routes cross-link"
    (let* ((id (transfer-id))
           (funding-id
             (hex-encode
               (reverse-bytevector
                 (transaction-txid
                   (car (block-transactions (block-at 29)))))))
           (tx-page (body-of (string-append "/tx/" id)))
           (block-page (body-of (string-append
                                  "/block/" (number->string %tip-height))))
           (address-page (body-of (string-append "/address/" %miner-a)))
           (value (json-of (string-append "/api/tx/" id)))
           (inputs (json-list (dict-get value "inputs")))
           (outputs (json-list (dict-get value "outputs"))))
      (assert-equal 200 (status-of (string-append "/tx/" id)))
      (assert-equal 404 (status-of "/tx/nope"))
      (assert-equal 404 (status-of "/api/tx/nope"))
      (assert-true (has? tx-page "<h1>Transaction</h1>"))
      (assert-true
        (has? tx-page
              (string-append "href=\"/block/"
                             (number->string %tip-height) "\"")))
      (assert-true
        (has? tx-page (string-append "href=\"/tx/" funding-id "\"")))
      (assert-true
        (has? tx-page (string-append "href=\"/address/" %miner-a "\"")))
      (assert-true
        (has? block-page (string-append "href=\"/tx/" id "\"")))
      (assert-true
        (has? address-page (string-append "href=\"/tx/" id "\"")))
      (assert-equal id (dict-get value "id"))
      (assert-equal %tip-height (dict-get value "height"))
      (assert-equal 1 (dict-get value "input_count"))
      (assert-equal 2 (dict-get value "output_count"))
      (assert-equal funding-id (dict-get (car inputs) "previous_id"))
      (assert-equal %miner-b (dict-get (car outputs) "address")))))


;; ============================================================
;; JSON parity
;; ============================================================

(test-group "the JSON matches the HTML"
  (test "a block's JSON carries every field the page shows"
    (with-store
      (lambda (store)
        (let ((value (json-of (string-append "/api/block/"
                                             (number->string %coop-height))))
              (b (explorer-block-by-height store %coop-height)))
          (assert-equal (explorer-block-complexity b)
                        (dict-get value "complexity"))
          (assert-equal (explorer-block-constraint b)
                        (dict-get (dict-get value "constraint") "id"))
          (assert-equal (explorer-block-constraint-text b)
                        (dict-get (dict-get value "constraint") "text"))
          (assert-equal (explorer-block-k b) (dict-get value "k"))
          (assert-equal (explorer-block-margin b) (dict-get value "margin"))
          (let ((golf (dict-get value "golf")))
            (assert-equal (puzzle-spec-par (spec-at %coop-height))
                          (dict-get golf "claimed_length"))
            (assert-equal (puzzle-spec-par (spec-at %coop-height))
                          (dict-get golf "par"))
            (assert-equal 0 (dict-get golf "savings"))
            (assert-equal 1 (dict-get golf "block_score"))
            (assert-equal %coop-height (dict-get golf "chain_score")))
          (assert-equal
            (if (number? (explorer-block-share-quality b))
                (explorer-block-share-quality b)
                'null)
            (dict-get value "share_quality"))
          (assert-equal (dict-get value "solution_bytes")
                        (dict-get (dict-get value "golf")
                                  "claimed_length"))
          (assert-equal (explorer-block-share-count b)
                        (dict-get value "share_count"))
          (assert-equal (explorer-block-total-output b)
                        (dict-get value "total_output"))
          (assert-equal (explorer-block-commit-count b)
                        (dict-get value "commitments"))))))

  (test "the JSON examples are the page's examples"
    (with-store
      (lambda (store)
        (let ((pairs (json-list
                       (dict-get (json-of "/api/block/12") "examples")))
              (b (explorer-block-by-height store 12)))
          (assert-equal (length (explorer-block-examples b)) (length pairs))
          (let loop ((xs (explorer-block-examples b)) (rows pairs))
            (unless (null? xs)
              (assert-equal (car (car xs)) (dict-get (car rows) "input"))
              (assert-equal (cdr (car xs)) (dict-get (car rows) "output"))
              (loop (cdr xs) (cdr rows))))))))

  (test "the JSON shares and outputs are the page's shares and outputs"
    (with-store
      (lambda (store)
        (let* ((value (json-of (string-append "/api/block/"
                                              (number->string %coop-height))))
               (b (explorer-block-by-height store %coop-height))
               (shares (json-list (dict-get value "shares")))
               (outputs (json-list (dict-get value "outputs"))))
          (assert-equal (length (explorer-block-shares b)) (length shares))
          (let loop ((xs (explorer-block-shares b)) (rows shares))
            (unless (null? xs)
              (assert-equal (explorer-share-address (car xs))
                            (dict-get (car rows) "miner"))
              (assert-equal (explorer-share-solution-length (car xs))
                            (dict-get (car rows) "solution_bytes"))
              (assert-equal (explorer-share-signature-hex (car xs))
                            (dict-get (car rows) "signature"))
              (assert-equal (explorer-share-blind-hex (car xs))
                            (dict-get (car rows) "blind"))
              (assert-equal (or (explorer-share-par (car xs)) 'null)
                            (dict-get (car rows) "personal_par"))
              (assert-equal (or (explorer-share-margin (car xs)) 'null)
                            (dict-get (car rows) "margin"))
              (assert-equal (or (explorer-share-contribution (car xs)) 'null)
                            (dict-get (car rows) "contribution"))
              (assert-equal (or (explorer-share-steps (car xs)) 'null)
                            (dict-get (car rows) "steps"))
              (assert-equal (explorer-share-payout (car xs))
                            (dict-get (car rows) "payout"))
              (loop (cdr xs) (cdr rows))))
          (assert-equal (length (explorer-block-outputs b)) (length outputs))
          (let loop ((xs (explorer-block-outputs b)) (rows outputs))
            (unless (null? xs)
              (assert-equal (symbol->string (explorer-output-role (car xs)))
                            (dict-get (car rows) "role"))
              (assert-equal (explorer-output-value (car xs))
                            (dict-get (car rows) "value"))
              (assert-equal (or (explorer-output-expected (car xs)) 'null)
                            (dict-get (car rows) "expected"))
              (loop (cdr xs) (cdr rows))))))))

  (test "the summary JSON carries the complexity the page shows"
    (with-store
      (lambda (store)
        (let ((value (json-of "/api/summary"))
              (s (explorer-chain-summary store)))
          (assert-equal %tip-height (dict-get value "chain_score"))
          (assert-equal %tip-height (explorer-summary-chain-score s))
          (let ((slot (+ coin-regtest-genesis-time
                         (* (+ %tip-height 1)
                            coin-regtest-target-block-spacing))))
            (assert-equal slot (dict-get value "next_slot"))
            (assert-true (has? (body-of "/") (explorer-format-time slot)))
            (assert-equal slot (explorer-summary-next-slot s)))
          (assert-equal (explorer-summary-complexity s)
                        (dict-get value "complexity"))
          (assert-equal (explorer-summary-next-complexity s)
                        (dict-get value "next_complexity"))
          (assert-equal (explorer-summary-next-retarget-height s)
                        (dict-get value "next_retarget_height"))
          (assert-equal (explorer-summary-puzzle-k s)
                        (dict-get (dict-get value "puzzle") "k"))))))

  (test "an unknown /api path still answers in JSON"
    (assert-equal 404 (status-of "/api/difficulty/nope"))
    (assert-equal "not-found"
                  (dict-get (json-of "/api/difficulty/nope") "error"))))

;; ============================================================
;; Empty and mid-sync
;; ============================================================

(test-group "an empty or mid-sync database renders honestly"
  (test "configured genesis derives next puzzle"
    (let ((dir (fresh-dir)))
      (node-close (node-open sigilcoin-regtest-chain dir))
      (let ((store (explorer-open sigilcoin-regtest-chain dir)))
        (let ((s (explorer-chain-summary store)))
          (assert-equal 0 (explorer-summary-tip-height s))
          (assert-equal 0 (explorer-summary-supply s))
          (assert-equal 0 (explorer-summary-chain-score s))
          (assert-equal (+ coin-regtest-genesis-time
                           coin-regtest-target-block-spacing)
                        (explorer-summary-next-slot s))
          (assert-equal coin-max-supply (explorer-summary-max-supply s))
          (assert-equal 128 (explorer-summary-complexity s))
          (assert-equal 128 (explorer-summary-next-complexity s))
          (assert-true (pair? (explorer-summary-puzzle-examples s))))
        (explorer-close store))
      (let* ((value (json-decode
                      (explorer-response-body
                        (explorer-respond sigilcoin-regtest-chain dir
                                          "/api/block/0"))))
             (golf (dict-get value "golf")))
        (assert-equal "genesis" (dict-get value "problem"))
        (assert-equal 'null (dict-get golf "par"))
        (assert-equal 0 (dict-get golf "savings"))
        (assert-equal 0 (dict-get golf "block_score"))
        (let ((page (explorer-response-body
                      (explorer-respond sigilcoin-regtest-chain dir "/block/0"))))
          (assert-true (has? page "<td>block score</td><td>0</td>"))
          (assert-true (has? page "<td>chain score</td><td>0</td>")))
        (assert-equal 0 (dict-get golf "chain_score")))
      (let ((page (explorer-response-body
                    (explorer-respond sigilcoin-regtest-chain dir
                                      "/difficulty"))))
        (assert-equal 200 (explorer-response-status
                            (explorer-respond sigilcoin-regtest-chain dir
                                              "/difficulty")))
        (assert-true (has? page "<h1>Difficulty</h1>"))
        (assert-true (has? page "/block/0"))
        (assert-true (has? page "128")))))

  (test "a header whose body has not arrived still says what it claims"
    (let* ((dir (fresh-dir))
           (n (node-open sigilcoin-regtest-chain dir))
           (genesis (node-best-header n)))
      (node-close n)
      (let* ((db (sqlite-open (explorer-db-path sigilcoin-regtest-chain dir)))
             (complexity 128)
             (spec (coin-puzzle-for (block-header-hash genesis) 1 complexity))
             (b (build-block sigilcoin-regtest-chain genesis 1 complexity
                                (puzzle-spec-par-solution spec)
                                '() '()
                                %script-a %script-a))
             (header
               (with-claimed-length
                 (block-header-field b)
                 (- (puzzle-spec-par spec) 3))))
        (store-header-only! db header 1)
        (sqlite-close db)
        (let ((store (explorer-open sigilcoin-regtest-chain dir)))
          (let ((pending (explorer-block-by-id store
                                               (block-header-id header))))
            (assert-equal 1 (explorer-block-height pending))
            (assert-equal 'body-not-downloaded
                          (explorer-block-problem pending))
            ;; The header carries a claimed score; cumulative chain score stays
            ;; at the provisional base point until its body validates.
            (let* ((length
                     (coin-result-value
                       (coin-version-solution-length
                         (block-header-version header))))
                   (par (explorer-block-par pending)))
              (assert-equal complexity
                            (explorer-block-complexity pending))
              (assert-equal length
                            (explorer-block-claimed-length pending))
              (assert-equal (block-header-bits header)
                            (explorer-block-bits pending))
              (assert-equal (block-header-id header)
                            (explorer-block-id pending))
              (assert-equal (- par 3) length)
              (assert-equal 3 (explorer-block-savings pending))
              (assert-equal 4 (explorer-block-block-score pending))
              (assert-equal 1 (explorer-block-chain-score pending)))
            ;; No body source, execution result, payout or share metric is
            ;; invented from those header claims.
            (assert-equal #f (explorer-block-solution pending))
            (assert-equal #f (explorer-block-solution-source pending))
            (assert-equal #f (explorer-block-solution-length pending))
            (assert-equal #f (explorer-block-margin pending))
            (assert-equal #f (explorer-block-share-quality pending))
            (assert-equal #f (explorer-block-payout-address pending))
            (assert-equal #f (explorer-block-transaction-count pending))
            (assert-equal #f (explorer-block-size pending))
            (assert-equal '() (explorer-block-outputs pending))
            (assert-equal #f (explorer-block-total-output pending))
            (assert-equal '() (explorer-block-shares pending))
            (assert-equal #f (explorer-block-commit-count pending))
            (assert-equal #f (explorer-block-author pending)))
          (explorer-close store))
        (let* ((token (block-header-id header))
               (page (explorer-response-body
                       (explorer-respond
                         sigilcoin-regtest-chain dir
                         (string-append "/block/" token))))
               (value (json-decode
                        (explorer-response-body
                          (explorer-respond
                            sigilcoin-regtest-chain dir
                            (string-append "/api/block/" token)))))
               (golf (dict-get value "golf")))
          (assert-equal token (dict-get value "id"))
          (assert-equal "body-not-downloaded" (dict-get value "problem"))
          (assert-equal 3 (dict-get golf "savings"))
          (assert-equal 4 (dict-get golf "block_score"))
          (assert-equal 1 (dict-get golf "chain_score"))
          (assert-equal 'null (dict-get value "solution"))
          (assert-equal 'null (dict-get value "solution_bytes"))
          (assert-equal 'null (dict-get value "share_quality"))
          (assert-equal 'null (dict-get value "margin"))
          (assert-true (has? page "<td>block score</td><td>4</td>"))
          (assert-true (has? page "<td>chain score</td><td>1</td>"))
          (assert-true (has? page "body-not-downloaded")))
        (assert-equal 200
                      (explorer-response-status
                        (explorer-respond
                          sigilcoin-regtest-chain dir
                          (string-append "/block/"
                                         (block-header-id header))))))))

  (test "noncanonical graffiti is a named invalid row, not displayed as data"
    (let* ((dir (fresh-dir))
           (n (node-open sigilcoin-regtest-chain dir))
           (genesis (node-best-header n)))
      (node-close n)
      (let* ((db (sqlite-open (explorer-db-path sigilcoin-regtest-chain dir)))
             ;; Assemble deliberately forbidden non-genesis graffiti without
             ;; weakening the consensus-owned encoder.
             (coinbase (transaction
                         version: 1
                         inputs: (list (txin previous-output:
                                               (outpoint txid: %zero32
                                                         index: %coinbase-index)
                                             script-sig:
                                               (script-append
                                                 (script-push-data
                                                   (script-number-encode 1))
                                                 (script-push-data
                                                   (string->utf8 "car"))
                                                 (script-push-data
                                                   coin-empty-shares)
                                                 (script-push-data
                                                   coin-empty-commits)
                                                 (script-push-data
                                                   %hostile-graffiti))
                                             sequence: %sequence-final
                                             witness: '()))
                         outputs: (list (txout value: (coin-block-reward 1)
                                               script-pubkey: %script-a))
                         lock-time: 0))
             (b (block
                  header-field:
                    (block-header
                      version: (coin-version-encode 128 3)
                      previous-block: (block-header-hash genesis)
                      merkle-root: (merkle-root
                                     (list (transaction-txid coinbase)))
                      time: (+ coin-regtest-min-block-spacing
                               (block-header-time genesis))
                      bits: (block-header-bits genesis)
                      nonce: 0)
                  transactions: (list coinbase)))
             (hash (store-block! db b 1)))
        (set-tip! db hash 1)
        (sqlite-close db)
        (let ((store (explorer-open sigilcoin-regtest-chain dir)))
          (let ((broken (explorer-block-by-height store 1)))
            (assert-equal 'non-canonical-graffiti
                          (explorer-block-problem broken))
            (assert-equal #f (explorer-block-solution broken))
            (assert-equal '() (explorer-block-shares broken))
            (assert-equal #f (explorer-block-graffiti broken))
            (assert-equal #f (explorer-block-author broken))
            (let* ((value (json-decode (explorer-block-json broken)))
                   (golf (dict-get value "golf"))
                   (page (explorer-block-page broken)))
              (assert-equal "non-canonical-graffiti" (dict-get value "problem"))
              (assert-equal 'null (dict-get value "graffiti"))
              (assert-equal 3 (dict-get golf "claimed_length"))
              (assert-equal 9 (dict-get golf "block_score"))
              (assert-equal 9 (dict-get golf "chain_score"))
              (assert-true (has? page "non-canonical-graffiti"))
              (assert-false (has? page "alert(1)")))
            ;; The outputs are still readable, and payout roles label them.
            (assert-equal 1 (length (explorer-block-outputs broken))))
          (explorer-close store))
        (assert-equal 200 (explorer-response-status
                            (explorer-respond sigilcoin-regtest-chain dir
                                              "/block/1")))))))

;; ============================================================
;; Consensus codec integration and malformed records
;; ============================================================

(test-group "consensus-owned decoding"
  (test "blind-bearing shares round-trip through consensus types"
    (let* ((shares (list (make-share 1 "cdr") (make-share 2 "car")))
           (payload (coin-coinbase-payload
                      height: 4095
                      solution: (string->utf8 "car")
                      shares: (coin-shares-encode shares)
                      commits: (coin-commits-encode
                                 (list (make-bytevector 32 1)
                                       (make-bytevector 32 9)))
                      graffiti: #u8()))
           (decoded (coin-coinbase-payload-decode
                      (coin-coinbase-payload-encode payload)))
           (back (coin-result-value decoded))
           (reveals (coin-shares-decode
                      (coin-coinbase-payload-shares back))))
      (assert-true (coin-ok? decoded))
      (assert-true (coin-ok? reveals))
      (assert-equal 4095 (coin-coinbase-payload-height back))
      (assert-equal 2 (length (coin-result-value reveals)))
      (assert-equal (make-bytevector 32 2)
                    (coin-share-blind
                      (list-ref (coin-result-value reveals) 1)))))

  (test "malformed nested shares render a named problem, never crash"
    (let* ((dir (fresh-dir))
           (n (node-open sigilcoin-regtest-chain dir))
           (genesis (node-best-header n)))
      (node-close n)
      (let* ((db (sqlite-open (explorer-db-path sigilcoin-regtest-chain dir)))
             (payload (coin-coinbase-payload
                        height: 1
                        solution: (string->utf8 "<script>x</script>")
                        shares: #u8(1 2 3)
                        commits: coin-empty-commits
                        graffiti: #u8()))
             (coinbase (transaction
                         version: 1
                         inputs: (list
                                   (txin previous-output:
                                           (outpoint txid: %zero32
                                                     index: %coinbase-index)
                                         script-sig:
                                           (coin-coinbase-payload-encode
                                             payload)
                                         sequence: %sequence-final
                                         witness: '()))
                         outputs: (list
                                    (txout value: (coin-block-reward 1)
                                           script-pubkey: %script-a))
                         lock-time: 0))
             (b (block
                  header-field:
                    (block-header
                      version: (coin-version-encode 128 18)
                      previous-block: (block-header-hash genesis)
                      merkle-root: (merkle-root
                                     (list (transaction-txid coinbase)))
                      time: (+ coin-regtest-min-block-spacing
                               (block-header-time genesis))
                      bits: (block-header-bits genesis)
                      nonce: 0)
                  transactions: (list coinbase)))
             (hash (store-block! db b 1)))
        (set-tip! db hash 1)
        (sqlite-close db)
        (let* ((html (explorer-response-body
                       (explorer-respond sigilcoin-regtest-chain dir
                                         "/block/1")))
               (json (json-decode
                       (explorer-response-body
                         (explorer-respond sigilcoin-regtest-chain dir
                                           "/api/block/1")))))
          (assert-true (has? html "shares-malformed"))
          (assert-true (has? html "&lt;script&gt;x&lt;/script&gt;"))
          (assert-true (not (has? html "<script>")))
          (assert-equal "shares-malformed" (dict-get json "problem"))
          (assert-equal "<script>x</script>" (dict-get json "solution"))
          (assert-equal 200 (explorer-response-status
                              (explorer-respond sigilcoin-regtest-chain dir
                                                "/block/1"))))))))

(test-group "dashboard presentation"

  (test "empty and error states have explicit visual semantics"
    (let ((missing (explorer-missing-page "bad <height>"))
          (offline (explorer-no-database-page "/tmp/<node>")))
      (assert-true (has? missing "class=\"notice notice-error\""))
      (assert-true (has? missing "class=\"badge badge-bad\">404"))
      (assert-true (has? missing "bad &lt;height&gt;"))
      (assert-true (has? offline "class=\"notice notice-error\""))
      (assert-true (has? offline "class=\"badge badge-bad\">offline"))
      (assert-true (has? offline "/tmp/&lt;node&gt;"))))
  )

(test-group "branded shared shell"
  (test "HTML shell keeps every branding asset same-origin"
    (let ((page (explorer-page "Test" "<p>body</p>")))
      (assert-true (has? page "class=\"wordmark\""))
      (assert-true (has? page "href=\"/\""))
      (for-each
        (lambda (name)
          (assert-true
            (has? page (string-append "url(/assets/" name ")"))))
        '("plus-jakarta.woff2"
          "jetbrains-mono.woff2"))
      (assert-true (not (has? page "https://sigilcoin.lol/assets/")))
      (assert-true (not (has? page "-v1")))
      (assert-true
        (has? page
              "<img class=\"wordmark-symbol\" src=\"/assets/sigilcoin-symbol.png\" width=\"32\" height=\"32\" alt=\"\">"))
      (assert-true
        (has? page
              "<link rel=\"icon\" type=\"image/png\" sizes=\"64x64\" href=\"/assets/sigilcoin-favicon.png\">"))
      (assert-true
        (not (has? page
                   "<span class=\"wordmark-symbol\" aria-hidden=\"true\">S</span>")))
      (assert-true (has? page "SigilCoin <small>Explorer</small>"))
      (assert-true (has? page "class=\"badge badge-live status-badge\""))
      (assert-true (has? page "<main class=\"shell\"><p>body</p></main>"))
      (assert-true (has? page "position:sticky"))
      (assert-true (has? page "overflow-x:auto"))
      (assert-true (has? page ":focus-visible"))
      (assert-true (has? page "prefers-reduced-motion:reduce"))
      (assert-true
        (has? page
              "<script src=\"/assets/explorer.js\" defer></script>"))))


  (test "CSP allows only same-origin scripts, polling, images, and fonts"
    (let ((response (explorer-http-response
                      (list 200 "text/html; charset=utf-8"
                            (explorer-page "Test" "ok")))))
      (assert-true
        (has? response
              "Content-Security-Policy: default-src 'none'; script-src 'self'; connect-src 'self'; style-src 'unsafe-inline'; img-src 'self'; font-src 'self'; base-uri 'none'; frame-ancestors 'none'"))
      (assert-true (not (has? response "unsafe-eval")))
      (assert-true (not (has? response "script-src 'unsafe-inline'")))
      (assert-true (not (has? response "https://sigilcoin.lol/assets/")))
      (assert-true (not (has? response "https://cdn"))))))

(run-tests)
