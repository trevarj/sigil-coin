;;; (sigil coin consensus score) — exact program-golf lottery arithmetic
;;;
;;; A block wins when its 256-bit header hash, interpreted as the Bitcoin
;;; little-endian work integer, is at most
;;;
;;;   min(2^255 - 1,
;;;       (floor(2^256 / (32 * C)) * 2^min(max(par - L, 0), 8)) - 1).
;;;
;;; Thus an at-par solution wins once per 32*C rolls, up to integer rounding,
;;; and every saved byte doubles its chance through the eighth saved byte.
;;; All consensus arithmetic is exact integer arithmetic.

(define-library (sigil coin consensus score)
  (import (sigil math))
  (export
    ;; Resource reporting (not header consensus).
    coin-bucket7
    coin-max-bucket

    ;; Lottery parameters and arithmetic.
    coin-lottery-work-factor
    coin-lottery-max-bonus
    coin-lottery-max-integer
    coin-lottery-target-ceiling
    coin-lottery-bonus
    coin-lottery-multiplier
    coin-lottery-target
    coin-lottery-expected-rolls
    coin-lottery-valid?)

  (begin

    ;; ============================================================
    ;; Resource reporting
    ;; ============================================================

    ;; floor(1000 * 2^(i/6)) for i in 0..5, frozen as exact integers.
    (define %thresholds '(1000 1122 1260 1414 1587 1782))

    ;;; Largest bucket index the reporting helper returns.
    (define coin-max-bucket 127)

    (define (require-count who x)
      (if (not (and (number? x) (exact? x) (integer? x) (>= x 0)))
          (error (string-append who ": expected a non-negative integer")))
      x)

    (define (bit-length x)
      (let loop ((n x) (bits 0))
        (if (= n 0)
            bits
            (loop (arithmetic-shift n -1) (+ bits 1)))))

    ;;; Bucket a resource count at six buckets per octave.
    ;;; This remains a reporting helper; no bucket is committed in a header or
    ;;; consulted by block validity or fork choice.
    (define (coin-bucket7 x)
      (: integer? -> integer?)
      (require-count "coin-bucket7" x)
      (if (= x 0)
          0
          (let* ((octave (- (bit-length x) 1))
                 (scaled (* 1000 x))
                 (passed
                   (let loop ((thresholds %thresholds) (count 0))
                     (cond
                       ((null? thresholds) count)
                       ((<= (arithmetic-shift (car thresholds) octave) scaled)
                        (loop (cdr thresholds) (+ count 1)))
                       (else count)))))
            (min coin-max-bucket
                 (+ 1 (* 6 octave) (- passed 1))))))

    ;; ============================================================
    ;; Lottery
    ;; ============================================================

    ;;; Baseline expected work per unit of puzzle complexity.
    (define coin-lottery-work-factor 32)

    ;;; Most saved bytes that improve lottery odds.
    (define coin-lottery-max-bonus 8)

    (define %lottery-outcomes (arithmetic-shift 1 256))

    ;;; Largest 256-bit unsigned header-hash roll.
    (define coin-lottery-max-integer (- %lottery-outcomes 1))

    ;;; Effective targets are capped at one half of the uint256 range.
    (define coin-lottery-target-ceiling
      (- (arithmetic-shift 1 255) 1))

    (define (require-positive who what x)
      (if (not (and (number? x) (exact? x) (integer? x) (> x 0)))
          (error (string-append who ": " what " must be a positive integer")))
      x)

    ;;; Number of solution bytes rewarded by the lottery, capped at eight.
    (define (coin-lottery-bonus par length)
      (: integer? integer? -> integer?)
      (require-positive "coin-lottery-bonus" "par" par)
      (require-positive "coin-lottery-bonus" "solution length" length)
      (min coin-lottery-max-bonus (max 0 (- par length))))

    ;;; Exact odds multiplier earned by a solution length.
    (define (coin-lottery-multiplier par length)
      (: integer? integer? -> integer?)
      (arithmetic-shift 1 (coin-lottery-bonus par length)))

    ;;; Inclusive uint256 target for `(C, par, L)`.
    (define (coin-lottery-target complexity par length)
      (: integer? integer? integer? -> integer?)
      (require-positive "coin-lottery-target" "complexity" complexity)
      (let* ((base-plus-one
               (quotient %lottery-outcomes
                         (* coin-lottery-work-factor complexity)))
             (effective
               (- (* base-plus-one
                     (coin-lottery-multiplier par length))
                  1)))
        (min coin-lottery-target-ceiling effective)))

    ;;; Expected rolls rounded up to the next integer.
    (define (coin-lottery-expected-rolls complexity par length)
      (: integer? integer? integer? -> integer?)
      (let ((winning-rolls
              (+ (coin-lottery-target complexity par length) 1)))
        (quotient (+ %lottery-outcomes winning-rolls -1)
                  winning-rolls)))

    ;;; Whether an integer uint256 hash roll wins the lottery.
    (define (coin-lottery-valid? roll complexity par length)
      (: any? integer? integer? integer? -> boolean?)
      (and (number? roll)
           (exact? roll)
           (integer? roll)
           (<= 0 roll)
           (<= roll coin-lottery-max-integer)
           (<= roll (coin-lottery-target complexity par length))))))
