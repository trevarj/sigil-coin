;;; (sigil coin consensus score) — exact additive proof-of-golf arithmetic
;;;
;;; Every valid non-genesis block earns one point plus one for each saved
;;; source byte, through eight saved bytes. Header admission separately
;;; enforces `L <= par`; body validation proves the encoded length exact.

(define-library (sigil coin consensus score)
  (import (sigil math))
  (export
    ;; Resource reporting (not header consensus).
    coin-bucket7
    coin-max-bucket

    ;; Additive proof-of-golf score.
    coin-golf-max-savings
    coin-golf-savings
    coin-golf-score)

  (begin

    ;; ============================================================
    ;; Resource reporting
    ;; ============================================================

    ;; floor(1000 * 2^(i/6)) for i in 0..5, frozen as exact integers.
    (define %thresholds '(1000 1122 1260 1414 1587 1782))

    ;;; Largest bucket index the reporting helper returns.
    (define coin-max-bucket 127)

    (define (require-count who x)
      (if (not (and (number? x) (exact? x) (integer? x) (>= x 0)))
          (error (string-append who ": expected a non-negative integer")))
      x)

    (define (bit-length x)
      (let loop ((n x) (bits 0))
        (if (= n 0)
            bits
            (loop (arithmetic-shift n -1) (+ bits 1)))))

    ;;; Bucket a resource count at six buckets per octave.
    ;;; This remains a reporting helper; no bucket is committed in a header or
    ;;; consulted by block validity or fork choice.
    (define (coin-bucket7 x)
      (: integer? -> integer?)
      (require-count "coin-bucket7" x)
      (if (= x 0)
          0
          (let* ((octave (- (bit-length x) 1))
                 (scaled (* 1000 x))
                 (passed
                   (let loop ((thresholds %thresholds) (count 0))
                     (cond
                       ((null? thresholds) count)
                       ((<= (arithmetic-shift (car thresholds) octave) scaled)
                        (loop (cdr thresholds) (+ count 1)))
                       (else count)))))
            (min coin-max-bucket
                 (+ 1 (* 6 octave) (- passed 1))))))

    ;; ============================================================
    ;; Proof of golf
    ;; ============================================================

    ;;; Most saved source bytes that contribute to a block's score.
    (define coin-golf-max-savings 8)

    (define (require-positive who what x)
      (if (not (and (number? x) (exact? x) (integer? x) (> x 0)))
          (error (string-append who ": " what " must be a positive integer")))
      x)

    ;;; Saved source bytes, clamped to the consensus scoring range.
    (define (coin-golf-savings par length)
      (: integer? integer? -> integer?)
      (require-positive "coin-golf-savings" "par" par)
      (require-positive "coin-golf-savings" "solution length" length)
      (min coin-golf-max-savings (max 0 (- par length))))

    ;;; Additive score of a valid non-genesis block.
    (define (coin-golf-score par length)
      (: integer? integer? -> integer?)
      (+ 1 (coin-golf-savings par length)))))
