;;; (sigil coin consensus shares) — co-op shares, commit-reveal, the split
;;;
;;; A block's producer solves puzzle `H` alone, but he is not the only
;;; miner who solved it. §6 lets up to eight other miners publish their own
;;; solutions to the PREVIOUS puzzle as signed "shares" inside his coinbase,
;;; and pays them for it. A losing solver is paid instead of discarding work,
;;; while aggregate quality `Q` from verified personalized tasks breaks
;;; fork-choice ties that the producer's own solution leaves (§5.3).
;;;
;;; THE PIPELINE (§7.2). Puzzle `H` is not knowable until block `H-1`
;;; exists, so a share cannot be committed and revealed in the same block:
;;;
;;;   block H    COMMITS for puzzle H      + the producer's own SOLUTION
;;;   block H+1  SHARES revealing puzzle H + the payouts for them
;;;
;;; A share revealed at height `H` therefore solves puzzle `P = H-1`, and
;;; its commitment must already be in block `P`'s COMMITS. Block `P` is the
;;; validated parent, so a validator needs no state beyond the block it is
;;; checking and its parent: at most sixteen 32-byte hashes.
;;;
;;; WHY A PRODUCER CARRIES ANYONE ELSE'S COMMITMENTS (§7.4). He is paid.
;;; The block at `H` pays weight 1 to the CARRIER — the producer of `H-1` —
;;; whenever it contains a reveal, and a reveal is only valid if its
;;; commitment was in the carrier's block. He cannot fabricate it: a
;;; commitment nobody can open earns nothing, because the opening needs a
;;; signature only the sharer can produce.
;;;
;;; WHY THE BLIND RIDES IN THE REVEAL.
;;;
;;; The commitment blind stays secret while the solution is hidden, then is
;;; published with the reveal so validators can recompute the commitment
;;; carried by the parent. Withholding it would make the carrier payment
;;; uncheckable. The record is `pubkey 33 || signature 64 || blind 32 || len 2
;;; || solution`; the blind is deliberately not signed because changing it
;;; only makes the share unincludable, never steerable. The worst-case
;;; coinbase remains below 7 KB inside the 16384-byte block cap.
;;;
;;; NOTHING HERE RAISES ON NETWORK DATA. Every check returns a
;;; `coin-result`; the encoders raise, because they are only ever handed
;;; data a local miner built.
;;;
;;; COST (§11). Validation is ordered cheapest-first ACROSS all shares, not
;;; share by share: block/codec/source membership checks, personalized source
;;; preparation, signatures, the producer solution, and only then share PBE.
;;; A malformed producer therefore rejects an eight-share sibling after eight
;;; derivations and signatures but before any share example evaluation. The
;;; ceiling is 9 x 200000 evaluator steps plus 8 ECDSA verifications.

(define-library (sigil coin consensus shares)
  (import (sigil struct)
          (sigil math)
          (sigil bitcoin utils)
          (sigil bitcoin primitives)
          (sigil bitcoin script)
          (sigil bitcoin tx)
          (sigil secp256k1)
          (sigil coin puzzle)
          (sigil coin puzzle constraints)
          (sigil coin puzzle generator)
          (sigil coin consensus result)
          (sigil coin consensus rules)
          (sigil coin consensus seed)
          (sigil coin consensus solution))
  (export
    ;; Wire sizes
    coin-share-pubkey-bytes
    coin-share-signature-bytes
    coin-share-blind-bytes
    coin-commitment-bytes
    coin-share-fixed-bytes
    coin-max-share-bytes
    coin-max-shares-bytes
    coin-max-commits-bytes
    coin-empty-shares
    coin-empty-commits

    ;; Preimages
    coin-share-tag
    coin-share-puzzle-tag
    coin-commit-tag
    coin-share-puzzle-seed
    coin-pubkey-anchor-output
    coin-anchor-output-pubkey
    coin-share-puzzle
    coin-share-preimage
    coin-commitment
    coin-share-commitment
    coin-share-script

    ;; The share record and its codec
    coin-share
    coin-share?
    coin-share-pubkey
    coin-share-signature
    coin-share-blind
    coin-share-solution
    coin-share-encode
    coin-shares-encode
    coin-shares-decode

    ;; Commitments
    coin-commits-encode
    coin-commits-decode

    ;; Validation
    coin-coop-context
    coin-coop-context?
    coin-coop-context-parent-prev-hash
    coin-coop-context-puzzle-height
    coin-coop-context-complexity
    coin-coop-context-spec
    coin-coop-context-commits
    coin-coop-context-derivation-count
    coin-coop-context-signature-count
    coin-coop-context-example-count
    coin-share-signature-ok?
    coin-share-margin-milli
    coin-share-contribution
    coin-quality
    coin-share-quality
    coin-shares-quality
    coin-check-share-solution/spec
    coin-check-share-solution
    coin-check-shares-cheap
    coin-prepare-shares
    coin-check-share-signatures
    coin-verify-prepared-shares
    coin-check-shares-expensive
    coin-check-shares

    ;; The reward split
    coin-producer-weight
    coin-split-weight-total
    coin-split-unit
    coin-split-plan
    coin-check-split)

  (begin

    ;; ============================================================
    ;; Bytes
    ;; ============================================================

    ;; The tags are ASCII by construction, so one byte per character.
    ;; Spelt out rather than taken from a string encoder because the
    ;; preimage is consensus and must not depend on a host's encoding.
    (define (ascii->bytes s)
      (let* ((n (string-length s))
             (bv (make-bytevector n 0)))
        (let loop ((i 0))
          (if (>= i n)
              bv
              (begin
                (bytevector-u8-set! bv i (char->integer (string-ref s i)))
                (loop (+ i 1)))))))

    ;; Solution source as the bytes every hash and length here measures.
    ;; A node always holds bytes; strings are accepted so a miner may hand
    ;; over source text.
    (define (solution-bytes solution)
      (if (bytevector? solution) solution (ascii->bytes solution)))

    ;; Lexicographic byte order: -1, 0 or 1. A prefix sorts before what
    ;; extends it, which is the usual definition and is only ever exercised
    ;; here on equal-length keys.
    (define (bytes-compare a b)
      (let ((na (bytevector-length a))
            (nb (bytevector-length b)))
        (let loop ((i 0))
          (cond
            ((and (>= i na) (>= i nb)) 0)
            ((>= i na) -1)
            ((>= i nb) 1)
            (else
              (let ((x (bytevector-u8-ref a i))
                    (y (bytevector-u8-ref b i)))
                (cond
                  ((< x y) -1)
                  ((> x y) 1)
                  (else (loop (+ i 1))))))))))

    ;; ============================================================
    ;; Wire sizes
    ;; ============================================================

    ;;; Bytes of a compressed secp256k1 public key in a share.
    (define coin-share-pubkey-bytes 33)

    ;;; Bytes of a fixed-width compact `r||s` ECDSA signature in a share.
    (define coin-share-signature-bytes 64)

    ;;; Bytes of the commitment blind carried in a share.
    (define coin-share-blind-bytes 32)

    ;;; Bytes of one commitment: a SHA256d digest.
    (define coin-commitment-bytes 32)

    ;; The two-byte little-endian solution length.
    (define %length-bytes 2)

    ;;; Fixed-width prefix of one share record, in bytes: 131.
    (define coin-share-fixed-bytes
      (+ coin-share-pubkey-bytes
         coin-share-signature-bytes
         coin-share-blind-bytes
         %length-bytes))

    ;;; Largest one share record can be, in bytes: 643.
    (define coin-max-share-bytes
      (+ coin-share-fixed-bytes coin-max-solution-bytes))

    ;;; Largest legal SHARES push, in bytes: 5145.
    ;;;
    ;;; The leading count byte plus eight full-size records. Derived, so the
    ;;; cap and the format cannot disagree.
    ;;;
    ;;; ```scheme
    ;;; coin-max-shares-bytes ; => 5145
    ;;; ```
    (define coin-max-shares-bytes
      (+ 1 (* coin-max-shares coin-max-share-bytes)))

    ;;; Largest legal COMMITS push, in bytes: 513.
    ;;;
    ;;; ```scheme
    ;;; coin-max-commits-bytes ; => 513
    ;;; ```
    (define coin-max-commits-bytes
      (+ 1 (* coin-max-commitments coin-commitment-bytes)))

    ;;; The SHARES push of a block carrying no reveals: `R = 0`.
    ;;;
    ;;; Never a zero-length push. The count byte is always present, which is
    ;;; what makes the coinbase canonicality re-encode unambiguous (§6.6).
    (define coin-empty-shares (make-bytevector 1 0))

    ;;; The COMMITS push of a block carrying no commitments: `K = 0`.
    (define coin-empty-commits (make-bytevector 1 0))

    ;; ============================================================
    ;; Preimages
    ;; ============================================================

    ;;; Domain tag of a share signature preimage. 18 ASCII bytes.
    (define coin-share-tag "SigilCoin/share/1")

    ;;; Domain tag of a personalized share puzzle seed.
    (define coin-share-puzzle-tag "SigilCoin/share-puzzle/1")

    ;;; Domain tag of a commitment preimage. 19 ASCII bytes.
    (define coin-commit-tag "SigilCoin/commit/1")

    (define %share-tag-bytes (ascii->bytes coin-share-tag))
    (define %share-puzzle-tag-bytes (ascii->bytes coin-share-puzzle-tag))
    (define %commit-tag-bytes (ascii->bytes coin-commit-tag))
    (define %anchor-alphabet "abcdefghijklmnop")

    (define %max-height #xffffffff)

    (define (require-height who height)
      (if (not (and (number? height) (exact? height) (integer? height)
                    (<= 0 height %max-height)))
          (error (string-append who ": height out of range")))
      height)

    (define (require-complexity who complexity)
      (if (not (and (number? complexity) (exact? complexity)
                    (integer? complexity)
                    (<= puzzle-complexity-min complexity)
                    (<= complexity puzzle-complexity-max)))
          (error (string-append who ": complexity out of range")))
      complexity)

    ;;; Derive one pubkey-personalized puzzle seed.
    ;;;
    ;;; `global-seed` is the unchanged producer puzzle seed. No including
    ;;; block field, block hash, graffiti or reveal data enters this digest.
    ;;;
    ;;; ```scheme
    ;;; (bytevector-length
    ;;;   (coin-share-puzzle-seed (make-bytevector 32 0) pubkey)) ; => 32
    ;;; ```
    (define (coin-share-puzzle-seed global-seed pubkey)
      (: bytevector? bytevector? -> bytevector?)
      (require-bytevector-length "coin-share-puzzle-seed" global-seed 32)
      (require-bytevector-length "coin-share-puzzle-seed" pubkey
                                 coin-share-pubkey-bytes)
      (hash256 (bytevector-append %share-puzzle-tag-bytes global-seed pubkey)))

    ;;; Encode a full compressed pubkey injectively as 66 `a`..`p` nibbles.
    ;;;
    ;;; The result is digit-free and self-evaluating as a string literal, so
    ;;; every rotating constraint can carry it without quote or truncation.
    (define (coin-pubkey-anchor-output pubkey)
      (: bytevector? -> string?)
      (require-bytevector-length "coin-pubkey-anchor-output" pubkey
                                 coin-share-pubkey-bytes)
      (let loop ((i 0) (out ""))
        (if (= i coin-share-pubkey-bytes)
            out
            (let ((b (bytevector-u8-ref pubkey i)))
              (loop (+ i 1)
                    (string-append
                      out
                      (substring %anchor-alphabet (quotient b 16)
                                 (+ 1 (quotient b 16)))
                      (substring %anchor-alphabet (modulo b 16)
                                 (+ 1 (modulo b 16)))))))))

    ;;; Decode the exact anchor form back to its compressed pubkey bytes.
    (define (coin-anchor-output-pubkey encoded)
      (: string? -> bytevector?)
      (if (not (puzzle-anchor-output? encoded))
          (error "coin-anchor-output-pubkey: malformed anchor output"))
      (let ((out (make-bytevector coin-share-pubkey-bytes 0)))
        (let loop ((i 0))
          (if (= i coin-share-pubkey-bytes)
              out
              (let ((hi (- (char->integer (string-ref encoded (* i 2)))
                           (char->integer #\a)))
                    (lo (- (char->integer (string-ref encoded (+ (* i 2) 1)))
                           (char->integer #\a))))
                (bytevector-u8-set! out i (+ (* hi 16) lo))
                (loop (+ i 1)))))))

    ;;; The 32 bytes a co-op share's signature covers (§6.3).
    ;;;
    ;;; `parent-prev-hash` is the hash of block `P`'s PARENT — the same
    ;;; previous hash that derived puzzle `P` — and `puzzle-height` is `P`
    ;;; itself, the puzzle the share solves, one below the height of the
    ;;; block that reveals it.
    ;;;
    ;;; What each field buys:
    ;;;
    ;;;   parent-prev-hash + P   pin the share to ONE puzzle on ONE branch,
    ;;;                          so it cannot be replayed at another height
    ;;;                          or moved to a sibling fork
    ;;;   complexity C(P)        pins the retarget epoch, so a reorg that
    ;;;                          changes `C` invalidates stale shares rather
    ;;;                          than silently repricing them
    ;;;   SHA256d(solution)      pins the program, so a producer cannot swap
    ;;;                          a different solution under a valid signature
    ;;;   pubkey                 pins the payout: the payout script is
    ;;;                          derived from this key (§6.5), so signing the
    ;;;                          key signs where the money goes
    ;;;
    ;;; What it deliberately does NOT bind is the including block. A share is
    ;;; valid in ANY block at height `P+1` on the right branch, which is what
    ;;; makes it a share rather than a block-specific artifact and lets any
    ;;; producer include it.
    ;;;
    ;;; ```scheme
    ;;; (bytevector-length
    ;;;   (coin-share-preimage (make-bytevector 32 7) 1 128 "car" pubkey))
    ;;; ; => 32
    ;;; ```
    (define (coin-share-preimage parent-prev-hash puzzle-height complexity
                                    solution pubkey)
      (: bytevector? integer? integer? any? bytevector? -> bytevector?)
      (require-bytevector-length "coin-share-preimage" parent-prev-hash 32)
      (require-bytevector-length "coin-share-preimage" pubkey
                                 coin-share-pubkey-bytes)
      (require-height "coin-share-preimage" puzzle-height)
      (require-complexity "coin-share-preimage" complexity)
      (hash256
        (bytevector-append %share-tag-bytes
                           parent-prev-hash
                           (u64-le puzzle-height)
                           (u32-le complexity)
                           (hash256 (solution-bytes solution))
                           pubkey)))

    ;;; The 32-byte commitment published for a share (§7.1).
    ;;;
    ;;; The blind is 32 bytes of the miner's own choosing. Without it the
    ;;; commitment would be a hash over public-plus-solution data and anyone
    ;;; who guessed the program could confirm the guess; with it the
    ;;; commitment is hiding for the whole block interval that matters, and
    ;;; is opened only by the reveal that publishes the program anyway.
    ;;;
    ;;; ```scheme
    ;;; (bytevector-length (coin-commitment preimage blind)) ; => 32
    ;;; ```
    (define (coin-commitment share-preimage blind)
      (: bytevector? bytevector? -> bytevector?)
      (require-bytevector-length "coin-commitment" share-preimage 32)
      (require-bytevector-length "coin-commitment" blind
                                 coin-share-blind-bytes)
      (hash256
        (bytevector-append %commit-tag-bytes share-preimage blind)))

    ;;; The P2WPKH script a share's payout must use (§6.5).
    ;;;
    ;;; Fixed form, derived from the signed pubkey, so there is no
    ;;; script-choice surface for a producer to exploit.
    ;;;
    ;;; ```scheme
    ;;; (bytevector-length (coin-share-script pubkey)) ; => 22
    ;;; ```
    (define (coin-share-script pubkey)
      (: bytevector? -> bytevector?)
      (require-bytevector-length "coin-share-script" pubkey
                                 coin-share-pubkey-bytes)
      (script-p2wpkh (hash160 pubkey)))

    ;; ============================================================
    ;; The share record
    ;; ============================================================

    ;;; One revealed co-op share.
    ;;;
    ;;; `solution` is the raw source bytes, which is also the canonical form
    ;;; for dedup (§6.4): byte comparison, never a normalized AST.
    ;;;
    ;;; ```scheme
    ;;; (bytevector-length
    ;;;   (coin-share-pubkey
    ;;;     (coin-share pubkey: pk signature: sig
    ;;;                    blind: bl solution: #u8(49))))
    ;;; ; => 33
    ;;; ```
    (define-struct coin-share
      (pubkey bytevector?)
      (signature bytevector?)
      (blind bytevector?)
      (solution bytevector?))

    (define (share-fields-ok? share)
      (and (coin-share? share)
           (= coin-share-pubkey-bytes
              (bytevector-length (coin-share-pubkey share)))
           (= coin-share-signature-bytes
              (bytevector-length (coin-share-signature share)))
           (= coin-share-blind-bytes
              (bytevector-length (coin-share-blind share)))
           (<= 1 (bytevector-length (coin-share-solution share)))
           (<= (bytevector-length (coin-share-solution share))
               coin-max-solution-bytes)))

    ;;; Encode one share record: `pubkey || signature || blind || u16le len
    ;;; || solution`.
    ;;;
    ;;; Raises on an illegal field: the encoder is only handed locally built
    ;;; data, and a silent truncation would produce an unincludable share.
    ;;;
    ;;; ```scheme
    ;;; (bytevector-length (coin-share-encode share)) ; => 134
    ;;; ```
    (define (coin-share-encode share)
      (: coin-share? -> bytevector?)
      (if (not (share-fields-ok? share))
          (error "coin-share-encode: share field out of range"))
      (let ((solution (coin-share-solution share)))
        (bytevector-append (coin-share-pubkey share)
                           (coin-share-signature share)
                           (coin-share-blind share)
                           (u16-le (bytevector-length solution))
                           solution)))

    ;;; Encode the SHARES push: `u8 R` then `R` records (§6.2).
    ;;;
    ;;; Raises unless the shares are in strictly ascending pubkey order and
    ;;; at most `coin-max-shares` of them. The ordering is canonical —
    ;;; one encoding per set — it forces distinct payout keys, and it makes
    ;;; duplicate detection a linear scan.
    ;;;
    ;;; ```scheme
    ;;; (coin-shares-encode '()) ; => #u8(0)
    ;;; ```
    (define (coin-shares-encode shares)
      (: list? -> bytevector?)
      (if (not (list? shares))
          (error "coin-shares-encode: expected a list of shares"))
      (if (> (length shares) coin-max-shares)
          (error "coin-shares-encode: more than eight shares"))
      (let loop ((xs shares) (previous #f) (out (make-bytevector 1 0)))
        (if (null? xs)
            (begin
              (bytevector-u8-set! out 0 (length shares))
              out)
            (let ((share (car xs)))
              (if (and previous
                       (>= 0 (bytes-compare (coin-share-pubkey share)
                                            previous)))
                  (error "coin-shares-encode: shares are not in ascending pubkey order"))
              (loop (cdr xs)
                    (coin-share-pubkey share)
                    (bytevector-append out (coin-share-encode share)))))))

    ;;; Decode the SHARES push.
    ;;;
    ;;; Total: any input, however hostile, yields a `coin-result`. This is
    ;;; the STRUCTURAL half only — sizes, counts, and no trailing byte.
    ;;; Ordering, keys, commitments, signatures, dedup and the programs
    ;;; themselves are `coin-check-shares`, because §6.4 orders those
    ;;; against a validation cost this decoder has no business paying.
    ;;;
    ;;; Rejection reasons are `shares-malformed` and `shares-oversize`. On
    ;;; success the value is a list of `coin-share` in wire order.
    ;;;
    ;;; ```scheme
    ;;; (coin-result-value (coin-shares-decode #u8(0))) ; => ()
    ;;; (coin-result-reason (coin-shares-decode #u8())) ; => shares-malformed
    ;;; ```
    (define (coin-shares-decode bytes)
      (: any? -> coin-result?)
      (guard (e (#t (coin-error 'internal-error "the shares decoder raised")))
        (cond
          ((not (bytevector? bytes))
           (coin-error 'shares-malformed "shares must be bytes"))
          ((= 0 (bytevector-length bytes))
           (coin-error 'shares-malformed "shares push is empty"))
          ((> (bytevector-length bytes) coin-max-shares-bytes)
           (coin-error 'shares-oversize "shares exceed the byte cap"))
          ((> (bytevector-u8-ref bytes 0) coin-max-shares)
           (coin-error 'shares-oversize "more than eight shares"))
          (else
            (let ((n (bytevector-length bytes))
                  (count (bytevector-u8-ref bytes 0)))
              (let loop ((i 0) (offset 1) (acc '()))
                (cond
                  ((= i count)
                   (if (= offset n)
                       (coin-ok (reverse acc))
                       (coin-error 'shares-malformed
                                   "trailing bytes after the last share")))
                  ((> (+ offset coin-share-fixed-bytes) n)
                   (coin-error 'shares-malformed "share record is truncated"))
                  (else
                    (let* ((pubkey-at offset)
                           (signature-at (+ pubkey-at
                                            coin-share-pubkey-bytes))
                           (blind-at (+ signature-at
                                        coin-share-signature-bytes))
                           (length-at (+ blind-at coin-share-blind-bytes))
                           (solution-at (+ length-at %length-bytes))
                           (len (read-u16-le bytes length-at
                                             "coin-shares-decode")))
                      (cond
                        ((= 0 len)
                         (coin-error 'shares-malformed
                                     "share solution is empty"))
                        ((> len coin-max-solution-bytes)
                         (coin-error 'shares-malformed
                                     "share solution exceeds the byte cap"))
                        ((> (+ solution-at len) n)
                         (coin-error 'shares-malformed
                                     "share solution is truncated"))
                        (else
                          (loop
                            (+ i 1)
                            (+ solution-at len)
                            (cons (coin-share
                                    pubkey: (bytevector-copy
                                              bytes pubkey-at signature-at)
                                    signature: (bytevector-copy
                                                 bytes signature-at blind-at)
                                    blind: (bytevector-copy
                                             bytes blind-at length-at)
                                    solution: (bytevector-copy
                                                bytes solution-at
                                                (+ solution-at len)))
                                  acc))))))))))))) 

    ;; ============================================================
    ;; Commitments
    ;; ============================================================

    ;;; Encode the COMMITS push: `u8 K` then `K` 32-byte commitments (§7.1).
    ;;;
    ;;; Raises unless the commitments are 32 bytes each, at most
    ;;; `coin-max-commitments` of them, and in strictly ascending order.
    ;;;
    ;;; ```scheme
    ;;; (coin-commits-encode '()) ; => #u8(0)
    ;;; ```
    (define (coin-commits-encode commitments)
      (: list? -> bytevector?)
      (if (not (list? commitments))
          (error "coin-commits-encode: expected a list of commitments"))
      (if (> (length commitments) coin-max-commitments)
          (error "coin-commits-encode: more than sixteen commitments"))
      (let loop ((xs commitments) (previous #f) (out (make-bytevector 1 0)))
        (if (null? xs)
            (begin
              (bytevector-u8-set! out 0 (length commitments))
              out)
            (let ((commitment (car xs)))
              (require-bytevector-length "coin-commits-encode" commitment
                                         coin-commitment-bytes)
              (if (and previous (>= 0 (bytes-compare commitment previous)))
                  (error "coin-commits-encode: commitments are not in ascending order"))
              (loop (cdr xs)
                    commitment
                    (bytevector-append out commitment))))))

    ;;; Decode the COMMITS push.
    ;;;
    ;;; Total. Rejection reasons are `commits-malformed`, `commits-oversize`
    ;;; and `commits-unordered`. On success the value is the list of 32-byte
    ;;; commitments.
    ;;;
    ;;; Ordering is checked HERE, unlike the shares' — a commitment is an
    ;;; opaque digest with no cheaper check to run first, so canonicality is
    ;;; the whole of its validation and belongs with the parse.
    ;;;
    ;;; ```scheme
    ;;; (coin-result-value (coin-commits-decode #u8(0))) ; => ()
    ;;; ```
    (define (coin-commits-decode bytes)
      (: any? -> coin-result?)
      (guard (e (#t (coin-error 'internal-error
                                "the commits decoder raised")))
        (cond
          ((not (bytevector? bytes))
           (coin-error 'commits-malformed "commits must be bytes"))
          ((= 0 (bytevector-length bytes))
           (coin-error 'commits-malformed "commits push is empty"))
          ((> (bytevector-length bytes) coin-max-commits-bytes)
           (coin-error 'commits-oversize "commits exceed the byte cap"))
          ((> (bytevector-u8-ref bytes 0) coin-max-commitments)
           (coin-error 'commits-oversize "more than sixteen commitments"))
          ((not (= (bytevector-length bytes)
                   (+ 1 (* coin-commitment-bytes
                           (bytevector-u8-ref bytes 0)))))
           (coin-error 'commits-malformed
                       "commits length does not match the count"))
          (else
            (let ((count (bytevector-u8-ref bytes 0)))
              (let loop ((i 0) (previous #f) (acc '()))
                (if (= i count)
                    (coin-ok (reverse acc))
                    (let* ((at (+ 1 (* i coin-commitment-bytes)))
                           (commitment (bytevector-copy
                                         bytes at
                                         (+ at coin-commitment-bytes))))
                      (if (and previous
                               (>= 0 (bytes-compare commitment previous)))
                          (coin-error 'commits-unordered
                                      "commitments are not in strictly ascending order")
                          (loop (+ i 1) commitment
                                (cons commitment acc))))))))))) 

    ;; ============================================================
    ;; Validation
    ;; ============================================================

    ;;; Everything a validator needs about the puzzle a block's shares
    ;;; solve, and nothing about the block itself.
    ;;;
    ;;; For a block at height `H`: `puzzle-height` is `P = H-1`,
    ;;; `parent-prev-hash` is the previous hash carried in block `P`'s
    ;;; header, `complexity` is `C(P)`, `spec` is the puzzle those three
    ;;; derive, and `commits` is block `P`'s decoded COMMITS. All of it
    ;;; comes from the validated parent, so no further state is needed.
    ;;;
    ;;; ```scheme
    ;;; (coin-coop-context-puzzle-height context) ; => 0
    ;;; ```
    (define-struct coin-coop-context
      (parent-prev-hash bytevector?)
      (puzzle-height integer?)
      (complexity integer?)
      (spec)
      (commits default: '())
      ;; Separate provenance: preparation proves source gates only; verified
      ;; entries prove commitment, signature and examples before exposing Q.
      (prepared-cache default: '() mutable: #t)
      (signature-cache default: '() mutable: #t)
      (verified-cache default: '() mutable: #t)
      (derivation-count default: 0 mutable: #t)
      (signature-count default: 0 mutable: #t)
      (example-count default: 0 mutable: #t))

    ;;; Derive one share's personalized puzzle from validated parent context.
    ;;;
    ;;; Height, complexity, `k`, grammar width and rotating constraint match
    ;;; the global producer puzzle. The personalized seed changes its examples.
    ;;; Generation stays bounded and retains a verified table solution.
    ;;;
    ;;; ```scheme
    ;;; (puzzle-spec? (coin-share-puzzle context pubkey)) ; => #t
    ;;; ```
    (define (coin-share-puzzle context pubkey)
      (: coin-coop-context? bytevector? -> puzzle-spec?)
      (if (not (coin-coop-context? context))
          (error "coin-share-puzzle: expected a co-op context"))
      (let ((global (coin-coop-context-spec context)))
        (if (not (puzzle-spec? global))
            (error "coin-share-puzzle: context has no global puzzle"))
        (if (not (and (= (puzzle-spec-height global)
                         (coin-coop-context-puzzle-height context))
                      (= (puzzle-spec-complexity global)
                         (coin-coop-context-complexity context))))
            (error "coin-share-puzzle: global puzzle does not match context"))
        (set-coin-coop-context-derivation-count!
          context (+ 1 (coin-coop-context-derivation-count context)))
        (puzzle-for/constraint/anchor
          (coin-share-puzzle-seed
            (coin-puzzle-seed
              (coin-coop-context-parent-prev-hash context)
              (coin-coop-context-puzzle-height context)
              (coin-coop-context-complexity context))
            pubkey)
          (coin-coop-context-puzzle-height context)
          (coin-coop-context-complexity context)
          (puzzle-spec-constraint global)
          (coin-pubkey-anchor-output pubkey))))

    ;;; True when `share`'s signature verifies against its §6.3 preimage.
    ;;;
    ;;; Standard ECDSA with the share's own key. libsecp256k1 rejects
    ;;; non-canonical high-`s` signatures, which is exactly §6.3's rule, so
    ;;; nothing has to be normalized here.
    ;;;
    ;;; Total: a key the caller has not already parsed, or a runtime with no
    ;;; secp256k1 module bound, yields `#f` rather than a raise.
    ;;;
    ;;; ```scheme
    ;;; (coin-share-signature-ok? context share) ; => #t
    ;;; ```
    (define (coin-share-signature-ok? context share)
      (: coin-coop-context? coin-share? -> boolean?)
      (guard (e (#t #f))
        (and (secp256k1-ecdsa-verify
               (coin-share-signature share)
               (coin-share-preimage
                 (coin-coop-context-parent-prev-hash context)
                 (coin-coop-context-puzzle-height context)
                 (coin-coop-context-complexity context)
                 (coin-share-solution share)
                 (coin-share-pubkey share))
               (coin-share-pubkey share))
             #t)))

    ;; §13 prefixes a share's solution failures so a node log distinguishes
    ;; "the producer's program is wrong" from "share three's program is
    ;; wrong". `internal-error` is not prefixed: it never describes the
    ;; block, only the validator.
    (define (share-reason reason)
      (if (eq? reason 'internal-error)
          reason
          (string->symbol
            (string-append "share-" (symbol->string reason)))))

    (define (member-bytes? needle haystack)
      (let loop ((xs haystack))
        (cond
          ((null? xs) #f)
          ((equal? needle (car xs)) #t)
          (else (loop (cdr xs))))))

    ;;; The commitment that must appear in the parent for `share` to be
    ;;; revealable in a block whose puzzle context is `context`.
    ;;;
    ;;; ```scheme
    ;;; (bytevector-length (coin-share-commitment context share)) ; => 32
    ;;; ```
    (define (coin-share-commitment context share)
      (: coin-coop-context? coin-share? -> bytevector?)
      (coin-commitment
        (coin-share-preimage
          (coin-coop-context-parent-prev-hash context)
          (coin-coop-context-puzzle-height context)
          (coin-coop-context-complexity context)
          (coin-share-solution share)
          (coin-share-pubkey share))
        (coin-share-blind share)))

    ;;; Relative improvement below personalized par, in milli-units.
    ;;;
    ;;; ```scheme
    ;;; (coin-share-margin-milli 100 95) ; => 50
    ;;; ```
    (define (coin-share-margin-milli par length)
      (: integer? integer? -> integer?)
      (if (not (and (number? par) (exact? par) (integer? par) (> par 0)
                    (number? length) (exact? length) (integer? length)
                    (> length 0) (< length par)))
          (error "coin-share-margin-milli: share must be strictly under par"))
      (quotient (* 1000 (- par length)) par))

    ;;; Contribution of one valid under-par share: 1..4.
    ;;;
    ;;; ```scheme
    ;;; (coin-share-contribution 49) ; => 1
    ;;; (coin-share-contribution 150) ; => 4
    ;;; ```
    (define (coin-share-contribution margin-milli)
      (: integer? -> integer?)
      (if (not (and (number? margin-milli) (exact? margin-milli)
                    (integer? margin-milli) (> margin-milli 0)))
          (error "coin-share-contribution: margin must be positive"))
      (+ 1 (min 3 (quotient margin-milli 50))))

    ;;; Aggregate quality `Q`, saturated at 15.
    ;;;
    ;;; ```scheme
    ;;; (coin-quality '(4 4 4 4)) ; => 15
    ;;; ```
    (define (coin-quality contributions)
      (: list? -> integer?)
      (if (not (list? contributions))
          (error "coin-quality: expected contributions"))
      (let loop ((xs contributions) (total 0))
        (if (null? xs)
            (min 15 total)
            (let ((x (car xs)))
              (if (not (and (number? x) (exact? x) (integer? x)
                            (<= 1 x 4)))
                  (error "coin-quality: contribution out of range"))
              (loop (cdr xs) (+ total x))))))

    (define (same-share? a b)
      (and (equal? (coin-share-pubkey a) (coin-share-pubkey b))
           (equal? (coin-share-signature a) (coin-share-signature b))
           (equal? (coin-share-blind a) (coin-share-blind b))
           (equal? (coin-share-solution a) (coin-share-solution b))))

    (define (cache-ref entries share)
      (let loop ((xs entries))
        (cond
          ((null? xs) #f)
          ((same-share? share (list-ref (car xs) 0)) (car xs))
          (else (loop (cdr xs))))))

    ;; Prepared entries are `(share spec arity-report contribution)`.
    (define (share-prepared-ref context share)
      (cache-ref (coin-coop-context-prepared-cache context) share))

    ;; Verified entries are `(share report contribution)`.
    (define (share-verified-ref context share)
      (cache-ref (coin-coop-context-verified-cache context) share))

    (define (share-signed? context share)
      (and (cache-ref (coin-coop-context-signature-cache context) share) #t))

    (define (reset-share-validation! context)
      (set-coin-coop-context-prepared-cache! context '())
      (set-coin-coop-context-signature-cache! context '())
      (set-coin-coop-context-verified-cache! context '())
      (set-coin-coop-context-derivation-count! context 0)
      (set-coin-coop-context-signature-count! context 0)
      (set-coin-coop-context-example-count! context 0))

    ;;; Check source against an already-derived personalized share puzzle.
    ;;;
    ;;; This pure preview does not read or populate a co-op validation cache.
    ;;; On success its value is `(report contribution)`, enough for local
    ;;; scoring without claiming commitment or signature validation.
    (define (coin-check-share-solution/spec spec solution)
      (: puzzle-spec? any? -> coin-result?)
      (guard (e (#t (coin-error 'internal-error
                                "the personalized share check raised")))
        (let ((source-size (bytevector-length (solution-bytes solution))))
          (if (>= source-size (puzzle-spec-par spec))
              (coin-error
                'share-not-under-par
                "share is not strictly below personalized par")
              (let ((checked (coin-check-solution spec solution)))
                (if (coin-failed? checked)
                    (coin-error (share-reason (coin-result-reason checked))
                                (coin-result-detail checked))
                    (coin-ok
                      (list
                        (coin-result-value checked)
                        (coin-share-contribution
                          (coin-share-margin-milli
                            (puzzle-spec-par spec) source-size))))))))))

    ;; Evaluate examples only after source preparation, signature and
    ;; commitment provenance exists. Cache report/contribution only then.
    (define (check-share-solution/verified context share)
      (let ((verified (share-verified-ref context share))
            (prepared (share-prepared-ref context share)))
        (cond
          (verified
           (coin-ok (list (list-ref verified 1) (list-ref verified 2))))
          ((not prepared)
           (coin-error 'internal-error "share source was not prepared"))
          ((not (share-signed? context share))
           (coin-error 'internal-error "share signature was not verified"))
          ((not (member-bytes?
                  (coin-share-commitment context share)
                  (coin-coop-context-commits context)))
           (coin-error 'share-uncommitted
                       "share was not committed in the parent block"))
          (else
            (set-coin-coop-context-example-count!
              context (+ 1 (coin-coop-context-example-count context)))
            (let* ((spec (list-ref prepared 1))
                   (checked
                     (coin-check-share-solution/spec
                       spec (coin-share-solution share))))
              (if (coin-failed? checked)
                  checked
                  (let* ((preview (coin-result-value checked))
                         (entry (list share
                                      (list-ref preview 0)
                                      (list-ref preview 1))))
                    (set-coin-coop-context-verified-cache!
                      context
                      (cons entry (coin-coop-context-verified-cache context)))
                    (coin-ok (cdr entry)))))))))

    ;;; Quality contribution of one already-validated share.
    ;;;
    ;;; There is deliberately no derivation fallback here. Verified cache
    ;;; provenance records the exact report and contribution only after
    ;;; signature, commitment and examples. Re-deriving on a cache miss
    ;;; both doubled validator work and made the derivation counter lie; asking
    ;;; for quality before validation is an internal caller bug, not network
    ;;; data to recover from.
    (define (coin-share-quality context share)
      (: coin-coop-context? coin-share? -> integer?)
      (let ((cached (share-verified-ref context share)))
        (if cached
            (list-ref cached 2)
            (error "coin-share-quality: share was not validated in this context"))))

    ;;; Aggregate quality of an already-validated share list.
    (define (coin-shares-quality context shares)
      (: coin-coop-context? list? -> integer?)
      (coin-quality
        (map (lambda (share) (coin-share-quality context share)) shares)))

    ;;; Preview one share's source against its personalized puzzle.
    ;;;
    ;;; This excludes commitment and signature checks and never populates the
    ;;; verified-share cache. On success its value is
    ;;; `(personalized-spec report contribution)`.
    (define (coin-check-share-solution context share)
      (: coin-coop-context? coin-share? -> coin-result?)
      (guard (e (#t (coin-error 'internal-error
                                "the personalized share check raised")))
        (let* ((personalized
                 (coin-share-puzzle context (coin-share-pubkey share)))
               (checked
                 (coin-check-share-solution/spec
                   personalized (coin-share-solution share))))
          (if (coin-failed? checked)
              checked
              (coin-ok (cons personalized (coin-result-value checked)))))))

    ;; Run `check` over each share in turn, ascending, first failure wins.
    ;; The passes are separate so the whole block clears a cheap check
    ;; before any share pays for an expensive one (§11).
    (define (each-share shares check)
      (let loop ((xs shares) (previous #f))
        (if (null? xs)
            #f
            (let ((failure (check (car xs) previous)))
              (or failure (loop (cdr xs) (car xs)))))))

    (define (failure-detail kind)
      (if (symbol? kind) (symbol->string kind) "unknown"))

    (define (share-arity-result report)
      (let ((kind (puzzle-report-error-kind report)))
        (cond
          ((eq? kind 'solution-not-a-procedure)
           (coin-error 'share-solution-not-a-procedure
                       "solution is not a 1-arity procedure"))
          ((eq? kind 'internal-error)
           (coin-error 'internal-error (failure-detail kind)))
          (else
            (coin-error 'share-solution-eval-failed
                        (failure-detail kind))))))

    ;;; Prepare every personalized source breadth-first without examples.
    ;;;
    ;;; All specs are derived once, then every source clears strict under-par,
    ;;; lexical constraint, parse, AST constraint and one-arity gates before
    ;;; any signature or example evaluation. Prepared cache entries prove only
    ;;; these source gates; they do not authorize `coin-share-quality`.
    (define (coin-prepare-shares context shares)
      (: coin-coop-context? list? -> coin-result?)
      (guard (e (#t (coin-error 'internal-error
                                "the share preparation raised")))
        (when (coin-coop-context? context)
          (set-coin-coop-context-prepared-cache! context '())
          (set-coin-coop-context-signature-cache! context '())
          (set-coin-coop-context-verified-cache! context '()))
        (cond
          ((not (coin-coop-context? context))
           (coin-error 'internal-error "expected a co-op context"))
          ((not (list? shares))
           (coin-error 'internal-error "expected a list of shares"))
          ((null? shares)
           (set-coin-coop-context-prepared-cache! context '())
           (coin-ok '()))
          ((not (puzzle-spec? (coin-coop-context-spec context)))
           (coin-error 'internal-error "co-op context has no puzzle spec"))
          (else
            (let* ((derived
                     (map
                       (lambda (share)
                         (list share
                               (coin-share-puzzle
                                 context (coin-share-pubkey share))))
                       shares))
                   (length-failure
                     (each-share
                       derived
                       (lambda (entry previous)
                         (let* ((share (list-ref entry 0))
                                (spec (list-ref entry 1))
                                (size (bytevector-length
                                        (coin-share-solution share))))
                           (and (>= size (puzzle-spec-par spec))
                                (coin-error
                                  'share-not-under-par
                                  "share is not strictly below personalized par"))))))
                   (source-failure
                     (and (not length-failure)
                          (each-share
                            derived
                            (lambda (entry previous)
                              (let* ((share (list-ref entry 0))
                                     (spec (list-ref entry 1)))
                                (and
                                  (not (puzzle-constraint-source-ok?
                                         (puzzle-spec-constraint spec)
                                         (coin-share-solution share)))
                                  (coin-error
                                    'share-constraint-violated
                                    "share violates personalized constraint"))))))))
              (cond
                (length-failure length-failure)
                (source-failure source-failure)
                (else
                  (let* ((parsed
                           (map
                             (lambda (entry)
                               (list entry
                                     (puzzle-parse/limit
                                       (coin-share-solution (list-ref entry 0))
                                       coin-max-solution-bytes)))
                             derived))
                         (parse-failure
                           (each-share
                             parsed
                             (lambda (item previous)
                               (let ((result (list-ref item 1)))
                                 (and (puzzle-failed? result)
                                      (coin-error
                                        'share-solution-parse-failed
                                        (failure-detail
                                          (puzzle-result-error-kind result)))))))))
                    (if parse-failure
                        parse-failure
                        (let ((constraint-failure
                                (each-share
                                  parsed
                                  (lambda (item previous)
                                    (let* ((entry (list-ref item 0))
                                           (spec (list-ref entry 1))
                                           (ast (puzzle-result-value
                                                  (list-ref item 1))))
                                      (and
                                        (not (puzzle-constraint-ast-ok?
                                               (puzzle-spec-constraint spec)
                                               ast
                                               (coin-spec-builtin-cap spec)))
                                        (coin-error
                                          'share-constraint-violated
                                          "share violates personalized constraint")))))))
                          (if constraint-failure
                              constraint-failure
                              (let arity-loop ((xs parsed) (prepared '()))
                                (if (null? xs)
                                    (begin
                                      (set-coin-coop-context-prepared-cache!
                                        context (reverse prepared))
                                      (coin-ok shares))
                                    (let* ((entry (list-ref (car xs) 0))
                                           (share (list-ref entry 0))
                                           (spec (list-ref entry 1))
                                           (report
                                             (puzzle-run-examples
                                               (coin-share-solution share)
                                               '())))
                                      (if (not (puzzle-report-ok? report))
                                          (share-arity-result report)
                                          (let* ((size
                                                   (bytevector-length
                                                     (coin-share-solution share)))
                                                 (contribution
                                                   (coin-share-contribution
                                                     (coin-share-margin-milli
                                                       (puzzle-spec-par spec)
                                                       size))))
                                            (arity-loop
                                              (cdr xs)
                                              (cons (list share spec report
                                                          contribution)
                                                    prepared))))))))))))))))))

    ;;; Run structural, canonical and commitment checks for all shares.
    ;;;
    ;;; This stage deliberately accepts a context whose puzzle spec is `#f`:
    ;;; node validation can reject payout shape before deriving any puzzle.
    ;;; It also resets the bounded per-block validation cache and counters.
    (define (coin-check-shares-cheap context producer-solution shares)
      (: coin-coop-context? any? list? -> coin-result?)
      (guard (e (#t (coin-error 'internal-error "the cheap share check raised")))
        (cond
          ((not (coin-coop-context? context))
           (coin-error 'internal-error "expected a co-op context"))
          ((not (list? shares))
           (coin-error 'internal-error "expected a list of shares"))
          (else
            (reset-share-validation! context)
            (cond
              ((null? shares) (coin-ok '()))
              ((> (length shares) coin-max-shares)
               (coin-error 'shares-oversize "more than eight shares"))
              ((< (coin-coop-context-puzzle-height context) 0)
               (coin-error 'shares-at-genesis "genesis carries no shares"))
              (else
                (let* ((producer (solution-bytes producer-solution))
                       (commits (coin-coop-context-commits context))
                       (failure
                         (or
                           ;; Source and fixed field widths precede curve work.
                           (each-share
                             shares
                             (lambda (share previous)
                               (and (not (share-fields-ok? share))
                                    (coin-error 'shares-malformed
                                                "share fields are malformed"))))
                           ;; Point parsing keeps every later secp call total.
                           (each-share
                             shares
                             (lambda (share previous)
                               (and (not (guard (e (#t #f))
                                           (and (secp256k1-pubkey-parse
                                                  (coin-share-pubkey share))
                                                #t)))
                                    (coin-error
                                      'share-bad-pubkey
                                      "share pubkey is not a valid compressed point"))))
                           (each-share
                             shares
                             (lambda (share previous)
                               (and previous
                                    (>= 0 (bytes-compare
                                            (coin-share-pubkey share)
                                            (coin-share-pubkey previous)))
                                    (coin-error
                                      'shares-unordered
                                      "shares are not in strictly ascending pubkey order"))))
                           (each-share
                             shares
                             (lambda (share previous)
                               (and (not (member-bytes?
                                           (coin-share-commitment context share)
                                           commits))
                                    (coin-error
                                      'share-uncommitted
                                      "share was not committed in the parent block"))))
                           ;; Raw-byte dedup is cheaper than ECDSA and PBE.
                           (let loop ((xs shares) (seen (list producer)))
                             (cond
                               ((null? xs) #f)
                               ((member-bytes?
                                  (coin-share-solution (car xs)) seen)
                                (coin-error
                                  'share-duplicate-solution
                                  "share repeats a solution already in this block"))
                               (else
                                 (loop
                                   (cdr xs)
                                   (cons (coin-share-solution (car xs))
                                         seen))))))))
                  (or failure (coin-ok shares)))))))))

    ;;; Verify every signature breadth-first after every source is prepared.
    (define (coin-check-share-signatures context shares)
      (: coin-coop-context? list? -> coin-result?)
      (guard (e (#t (coin-error 'internal-error
                                "the share signature check raised")))
        (cond
          ((not (coin-coop-context? context))
           (coin-error 'internal-error "expected a co-op context"))
          ((not (list? shares))
           (coin-error 'internal-error "expected a list of shares"))
          (else
            (set-coin-coop-context-signature-cache! context '())
            (let ((failure
                    (each-share
                      shares
                      (lambda (share previous)
                        (set-coin-coop-context-signature-count!
                          context
                          (+ 1 (coin-coop-context-signature-count context)))
                        (and (not (coin-share-signature-ok? context share))
                             (coin-error
                               'share-bad-signature
                               "share signature does not verify"))))))
              (if failure
                  failure
                  (begin
                    (set-coin-coop-context-signature-cache!
                      context (map (lambda (share) (list share)) shares))
                    (coin-ok shares))))))))

    ;;; Evaluate examples for prepared, signed shares and populate verified Q.
    (define (coin-verify-prepared-shares context shares)
      (: coin-coop-context? list? -> coin-result?)
      (guard (e (#t (coin-error 'internal-error
                                "the prepared share check raised")))
        (cond
          ((not (coin-coop-context? context))
           (coin-error 'internal-error "expected a co-op context"))
          ((not (list? shares))
           (coin-error 'internal-error "expected a list of shares"))
          (else
            (let ((failure
                    (each-share
                      shares
                      (lambda (share previous)
                        (let ((checked
                                (check-share-solution/verified context share)))
                          (and (coin-failed? checked) checked))))))
              (or failure (coin-ok shares)))))))

    ;;; Run source preparation, ECDSA, then PBE for standalone callers.
    ;;; Node body validation inserts producer validation before final PBE.
    (define (coin-check-shares-expensive context shares)
      (: coin-coop-context? list? -> coin-result?)
      (let ((prepared (coin-prepare-shares context shares)))
        (if (coin-failed? prepared)
            prepared
            (let ((signed (coin-check-share-signatures context shares)))
              (if (coin-failed? signed)
                  signed
                  (coin-verify-prepared-shares context shares))))))

    ;;; Validate a block's revealed shares in deterministic cost order.
    ;;;
    ;;; Failure order is field/source shape, count/genesis, pubkey, order,
    ;;; commitment, duplicate source, under-par, lexical constraint, parse,
    ;;; AST constraint, arity/source evaluation, signature, then examples.
    ;;; Node body validation inserts output shape before source preparation and
    ;;; producer validation between signature and examples. Total: hostile
    ;;; network values return `coin-result`.
    (define (coin-check-shares context producer-solution shares)
      (: coin-coop-context? any? list? -> coin-result?)
      (let ((cheap (coin-check-shares-cheap
                     context producer-solution shares)))
        (if (coin-failed? cheap)
            cheap
            (coin-check-shares-expensive context shares))))

    ;; ============================================================
    ;; The reward split
    ;; ============================================================

    ;;; The producer's weight in the split: 2. Each share and the carrier
    ;;; are worth 1 (§6.5).
    (define coin-producer-weight 2)

    (define (require-value who value)
      (if (not (and (number? value) (exact? value) (integer? value)
                    (>= value 0)))
          (error (string-append who ": value must be a non-negative integer")))
      value)

    (define (require-share-count who count)
      (if (not (and (number? count) (exact? count) (integer? count)
                    (<= 0 count coin-max-shares)))
          (error (string-append who ": share count out of range")))
      count)

    ;;; Total weight the block's reward is divided into: `2 + R + carrier`,
    ;;; where the carrier exists exactly when `R >= 1`.
    ;;;
    ;;; ```scheme
    ;;; (coin-split-weight-total 0) ; => 2
    ;;; (coin-split-weight-total 8) ; => 11
    ;;; ```
    (define (coin-split-weight-total share-count)
      (: integer? -> integer?)
      (require-share-count "coin-split-weight-total" share-count)
      (+ coin-producer-weight
         share-count
         (if (> share-count 0) 1 0)))

    ;;; One weight-unit of the reward: `u = floor(V / Wtot)`.
    ;;;
    ;;; ```scheme
    ;;; (coin-split-unit 5000000000 8) ; => 454545454
    ;;; ```
    (define (coin-split-unit value share-count)
      (: integer? integer? -> integer?)
      (require-value "coin-split-unit" value)
      (quotient value (coin-split-weight-total share-count)))

    ;;; The exact coinbase outputs a block owes (§6.5).
    ;;;
    ;;; Returns `1 + R + carrier` entries as `(value . script)` pairs, in
    ;;; consensus order:
    ;;;
    ;;;   0        producer, `V - R*u - carrier*u`, script `#f` because
    ;;;            consensus does not constrain where a producer pays himself
    ;;;   1 .. R   share `i`, `u`, P2WPKH of share `i`'s signed pubkey, in
    ;;;            the shares' own ascending-pubkey order
    ;;;   R+1      carrier, `u`, `carrier-script` — the scriptPubKey of
    ;;;            output 0 of block `H-1`'s coinbase, present only when
    ;;;            `R >= 1`
    ;;;
    ;;; The remainder `V mod Wtot`, at most ten daviwils, goes to the
    ;;; producer, so the outputs sum to `V` EXACTLY. Nothing burns, nothing
    ;;; leaks to fees, and Bitcoin's value-conservation check passes
    ;;; unchanged.
    ;;;
    ;;; ```scheme
    ;;; (car (car (coin-split-plan 100 '() #f))) ; => 100
    ;;; ```
    (define (coin-split-plan value shares carrier-script)
      (: integer? list? any? -> list?)
      (require-value "coin-split-plan" value)
      (let* ((count (require-share-count "coin-split-plan" (length shares)))
             (carrier (if (> count 0) 1 0))
             (unit (coin-split-unit value count))
             (producer (- value (* count unit) (* carrier unit))))
        (if (and (= 1 carrier) (not (bytevector? carrier-script)))
            (error "coin-split-plan: a block with shares needs a carrier script"))
        (cons (cons producer #f)
              (let loop ((xs shares) (acc '()))
                (if (null? xs)
                    (reverse (if (= 1 carrier)
                                 (cons (cons unit carrier-script) acc)
                                 acc))
                    (loop (cdr xs)
                          (cons (cons unit
                                      (coin-share-script
                                        (coin-share-pubkey (car xs))))
                                acc)))))))

    (define (outputs-of tx)
      (guard (e (#t #f))
        (and (transaction? tx) (transaction-outputs tx))))

    ;;; Check a coinbase transaction's outputs against the split (§6.5).
    ;;;
    ;;; `value` is `V = subsidy(H) + total_fees(H)`, which the caller
    ;;; computes; this rule only decides how `V` is divided.
    ;;;
    ;;; Total. Rejection reasons are `coinbase-output-shape` — wrong output
    ;;; count, or a share or carrier paid to the wrong script — and
    ;;; `coinbase-output-value`. On success the value is the split plan.
    ;;;
    ;;; ```scheme
    ;;; (coin-ok? (coin-check-split coinbase 5000000000 '() #f)) ; => #t
    ;;; ```
    (define (coin-check-split tx value shares carrier-script)
      (: any? integer? list? any? -> coin-result?)
      (guard (e (#t (coin-error 'internal-error "the split check raised")))
        (let ((outputs (outputs-of tx)))
          (cond
            ((not outputs)
             (coin-error 'internal-error "expected a transaction"))
            ((not (and (number? value) (exact? value) (integer? value)
                       (>= value 0)))
             (coin-error 'coinbase-output-value
                         "block value is not a non-negative integer"))
            ((> (length shares) coin-max-shares)
             (coin-error 'shares-oversize "more than eight shares"))
            ((and (pair? shares) (not (bytevector? carrier-script)))
             (coin-error 'internal-error
                         "a block with shares needs a carrier script"))
            (else
              (let ((plan (coin-split-plan value shares carrier-script)))
                (if (not (= (length outputs) (length plan)))
                    (coin-error 'coinbase-output-shape
                                "coinbase output count does not match the split")
                    (let loop ((os outputs) (ps plan))
                      (cond
                        ((null? ps) (coin-ok plan))
                        ((not (= (txout-value (car os)) (car (car ps))))
                         (coin-error 'coinbase-output-value
                                     "coinbase output pays the wrong value"))
                        ;; Output 0's script is the producer's business.
                        ;; Every other script is derived, so a mismatch is a
                        ;; producer trying to keep a payout he owes.
                        ((and (cdr (car ps))
                              (not (equal? (txout-script-pubkey (car os))
                                           (cdr (car ps)))))
                         (coin-error 'coinbase-output-shape
                                     "coinbase output pays the wrong script"))
                        (else (loop (cdr os) (cdr ps))))))))))))))
