;;; (sigil coin consensus fork-choice) — ranking siblings at one height
;;;
;;; Among valid blocks at the same height the SHORTEST solution wins. A tie
;;; on length is broken by the LOWEST block hash, comparing the internal
;;; 32-byte double-SHA256 header hash byte by byte from index 0 — the same
;;; bytes a header carries in `previous-block`, not the reversed display id.
;;; That order is frozen: comparing the display id instead would reverse
;;; roughly half of all tie-breaks.
;;;
;;; The tip rule this induces is not longest-chain alone. A strictly better
;;; sibling replaces the current tip, but only while the tip is still
;;; childless: once a child extends the tip the height is settled and normal
;;; longest-chain applies, so a late short solution cannot reorganise a chain
;;; that has already moved on.
;;;
;;; `puzzle-spec-par` plays no part. Par is an upper bound the generator
;;; happens to know, and solutions below it are legal and expected; ranking
;;; against par would reject exactly the blocks the game is trying to
;;; reward.

(define-library (sigil coin consensus fork-choice)
  (import (sigil math)
          (sigil bitcoin utils))
  (export
    coin-hash-compare
    coin-solution-compare
    coin-better-solution?
    coin-replaces-tip?)

  (begin

    ;;; Compare two internal 32-byte block hashes.
    ;;;
    ;;; Returns -1 when `a` is lower, 1 when `b` is lower, 0 when equal.
    ;;;
    ;;; ```scheme
    ;;; (coin-hash-compare (make-bytevector 32 0) (make-bytevector 32 1))
    ;;; ; => -1
    ;;; ```
    (define (coin-hash-compare a b)
      (: bytevector? bytevector? -> integer?)
      (require-bytevector-length "coin-hash-compare" a 32)
      (require-bytevector-length "coin-hash-compare" b 32)
      (let loop ((i 0))
        (if (>= i 32)
            0
            (let ((x (bytevector-u8-ref a i))
                  (y (bytevector-u8-ref b i)))
              (cond
                ((< x y) -1)
                ((> x y) 1)
                (else (loop (+ i 1))))))))

    ;;; Rank two valid blocks at the same height.
    ;;;
    ;;; Returns -1 when the first is the better block, 1 when the second is,
    ;;; and 0 only when the two are indistinguishable to fork choice, which
    ;;; for distinct valid blocks means they are the same block.
    ;;;
    ;;; ```scheme
    ;;; (coin-solution-compare #u8(1) hash-a #u8(1 2) hash-b) ; => -1
    ;;; ```
    (define (coin-solution-compare a-solution a-hash b-solution b-hash)
      (: bytevector? bytevector? bytevector? bytevector? -> integer?)
      (require-bytevector "coin-solution-compare" a-solution)
      (require-bytevector "coin-solution-compare" b-solution)
      (let ((a-len (bytevector-length a-solution))
            (b-len (bytevector-length b-solution)))
        (cond
          ((< a-len b-len) -1)
          ((> a-len b-len) 1)
          (else (coin-hash-compare a-hash b-hash)))))

    ;;; True when the first block strictly outranks the second.
    ;;;
    ;;; ```scheme
    ;;; (coin-better-solution? #u8(1) hash-a #u8(1 2) hash-b) ; => #t
    ;;; ```
    (define (coin-better-solution? a-solution a-hash b-solution b-hash)
      (: bytevector? bytevector? bytevector? bytevector? -> boolean?)
      (< (coin-solution-compare a-solution a-hash b-solution b-hash) 0))

    ;;; True when `candidate` should displace the current tip.
    ;;;
    ;;; `tip-extended?` is whether a child already builds on the tip. Once
    ;;; one does, the height is settled and no sibling displaces it however
    ;;; short its solution; before that, a strictly better sibling wins.
    ;;;
    ;;; ```scheme
    ;;; (coin-replaces-tip? #u8(1 2) tip-hash #f #u8(1) new-hash)   ; => #t
    ;;; (coin-replaces-tip? #u8(1 2) tip-hash #t #u8(1) new-hash)   ; => #f
    ;;; ```
    (define (coin-replaces-tip? tip-solution tip-hash tip-extended?
                                candidate-solution candidate-hash)
      (: bytevector? bytevector? boolean? bytevector? bytevector? -> boolean?)
      (and (not tip-extended?)
           (coin-better-solution? candidate-solution candidate-hash
                                  tip-solution tip-hash)))))
