;;; (sigil coin consensus fork-choice) — height, then first-seen
;;;
;;; Every accepted block contributes one unit. A taller chain wins; equal
;;; heights are tied and the incumbent remains selected. Neither solution
;;; length, lottery roll, nonce nor block hash breaks a sibling tie.

(define-library (sigil coin consensus fork-choice)
  (import (sigil math))
  (export
    coin-block-compare
    coin-better-block?)

  (begin

    (define (require-height who height)
      (if (not (and (number? height) (exact? height) (integer? height)
                    (>= height 0)))
          (error (string-append who ": height out of range")))
      height)

    ;;; Compare two chain heights. Lower means the first is better.
    (define (coin-block-compare a-height b-height)
      (: integer? integer? -> integer?)
      (require-height "coin-block-compare" a-height)
      (require-height "coin-block-compare" b-height)
      (cond
        ((> a-height b-height) -1)
        ((< a-height b-height) 1)
        (else 0)))

    ;;; Whether the first height strictly outranks the second.
    (define (coin-better-block? a-height b-height)
      (: integer? integer? -> boolean?)
      (< (coin-block-compare a-height b-height) 0))))
