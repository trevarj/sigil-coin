;;; (sigil coin consensus rules) — size and timestamp context
;;;
;;; SigilCoin blocks serialize to at most `coin-max-block-bytes`. The nonce
;;; lottery and its interval-retargeted base target control cadence; the
;;; one-second parent floor only keeps rapid local mining timestamps monotone.
;;;
;;; The spacing floor and future-drift allowance are chain policy. Mainnet uses
;;; `coin-min-block-spacing` and `coin-max-future-drift`; other chains pass both
;;; values to `coin-validate-header-context`.
;;;
;;; The usual Bitcoin median-time rule also applies: a header's time must exceed
;;; the median of the last `coin-median-time-span` headers.
;;;
;;; These checks live here because `sigil-bitcoin-consensus` supplies linkage,
;;; target and proof-of-work helpers but no median-time-past or future-drift
;;; policy. Every check is total and returns a `coin-result`.

(define-library (sigil coin consensus rules)
  (import (sigil math)
          (sigil list)
          (sigil coin puzzle)
          (sigil bitcoin consensus)
          (sigil coin consensus result))
  (export
    coin-max-block-bytes
    coin-max-solution-bytes
    coin-max-graffiti-bytes
    coin-max-shares
    coin-max-commitments
    coin-max-k
    coin-max-fuel
    coin-min-block-spacing
    coin-max-future-drift
    coin-median-time-span
    coin-median-time-past
    coin-block-size
    coin-validate-block-size
    coin-validate-header-context)

  (begin

    ;;; Maximum serialized block size, in bytes.
    (define coin-max-block-bytes 16384)

    ;;; Maximum source bytes accepted by consensus.
    (define coin-max-solution-bytes puzzle-max-source-bytes)

    ;;; Maximum opaque coinbase graffiti bytes.
    (define coin-max-graffiti-bytes 400)

    ;;; Maximum co-op reveals per block.
    (define coin-max-shares 8)

    ;;; Maximum commitments per block.
    (define coin-max-commitments 16)

    ;;; Maximum published example count.
    (define coin-max-k 8)

    ;;; Shared evaluator fuel cap.
    (define coin-max-fuel puzzle-max-fuel)

    ;;; Minimum seconds between a header and its parent: one second.
    ;;; Mining difficulty, not this monotonicity floor, controls cadence.
    (define coin-min-block-spacing 1)

    ;;; Maximum seconds a header's time may lead the validating clock.
    (define coin-max-future-drift 7200)

    ;;; Number of trailing headers the median-time-past window spans.
    (define coin-median-time-span 11)

    (define (last-of xs)
      (if (null? (cdr xs)) (car xs) (last-of (cdr xs))))

    (define (policy-seconds? value)
      (and (number? value) (exact? value) (integer? value) (>= value 0)))

    ;; Resolve optional spacing and drift policy. Raising here is deliberate:
    ;; both values come from the node's chain config, never from the network.
    (define (pacing-arguments args)
      (if (> (length args) 2)
          (error "coin-validate-header-context: too many arguments"))
      (let ((min-spacing (if (null? args)
                             coin-min-block-spacing
                             (car args)))
            (max-future-drift (if (or (null? args) (null? (cdr args)))
                                  coin-max-future-drift
                                  (cadr args))))
        (if (not (policy-seconds? min-spacing))
            (error "coin-validate-header-context: expected a spacing floor"))
        (if (not (policy-seconds? max-future-drift))
            (error "coin-validate-header-context: expected a future-drift allowance"))
        (cons min-spacing max-future-drift)))

    ;; The trailing `count` items of `xs`, or all of them when it is shorter.
    (define (trailing xs count)
      (let ((n (length xs)))
        (if (<= n count)
            xs
            (let loop ((ys xs) (drop (- n count)))
              (if (= drop 0) ys (loop (cdr ys) (- drop 1)))))))

    ;;; Median timestamp of the last `coin-median-time-span` headers.
    ;;;
    ;;; `headers` runs oldest to newest and must be non-empty. The median is
    ;;; the middle element of the sorted window, matching Bitcoin's
    ;;; `GetMedianTimePast`, so an even window takes the upper middle.
    ;;;
    ;;; ```scheme
    ;;; (coin-median-time-past (list h1 h2 h3)) ; => the middle timestamp
    ;;; ```
    (define (coin-median-time-past headers)
      (: list? -> integer?)
      (if (not (pair? headers))
          (error "coin-median-time-past: expected at least one header"))
      (let* ((window (trailing headers coin-median-time-span))
             (times (list-sort < (map block-header-time window))))
        (list-ref times (quotient (length times) 2))))

    ;;; Serialized size of a block, in bytes, or `#f` when it does not
    ;;; serialize at all.
    ;;;
    ;;; ```scheme
    ;;; (coin-block-size 42) ; => #f
    ;;; ```
    (define (coin-block-size b)
      (: any? -> any?)
      (guard (e (#t #f))
        (bytevector-length (block-serialize b))))

    ;;; Check a block against the size cap.
    ;;;
    ;;; Rejection reasons are `malformed-block` and `block-oversize`. On
    ;;; success the value is the serialized size.
    ;;;
    ;;; ```scheme
    ;;; (coin-result-reason (coin-validate-block-size 42)) ; => malformed-block
    ;;; ```
    (define (coin-validate-block-size b)
      (: any? -> coin-result?)
      (let ((size (coin-block-size b)))
        (cond
          ((not size)
           (coin-error 'malformed-block "block does not serialize"))
          ((> size coin-max-block-bytes)
           (coin-error 'block-oversize "block exceeds the size cap"))
          (else (coin-ok size)))))

    ;;; Check a header against the chain it claims to extend.
    ;;;
    ;;; `previous-headers` runs oldest to newest and is empty only for
    ;;; genesis, which has no parent to link to, no spacing to satisfy and no
    ;;; median to clear; the future-drift rule still applies to it. `now` is
    ;;; the validating node's clock in Unix seconds.
    ;;;
    ;;; Optional `min-spacing` and `max-future-drift` arguments carry chain
    ;;; policy in seconds. Omitting both applies the mainnet defaults; passing
    ;;; only spacing preserves the historical API and defaults drift to
    ;;; `coin-max-future-drift`. They are resolved before the guard because
    ;;; bad policy is node misconfiguration, not a malformed network header.
    ;;;
    ;;; Rejection reasons are `malformed-header`, `bad-prev-hash`,
    ;;; `insufficient-spacing`, `time-too-old` and `time-too-far-ahead`. On
    ;;; success the value is the header.
    ;;;
    ;;; ```scheme
    ;;; (coin-result-reason (coin-validate-header-context '() header now))
    ;;; ; => #f, when the header is not from the future
    ;;; (coin-ok? (coin-validate-header-context headers header now 3600 300))
    ;;; ; => #t, under a one-hour floor and five-minute drift allowance
    ;;; ```
    (define (coin-validate-header-context previous-headers header now
                                          . maybe-pacing)
      (: any? any? any? integer? ... -> coin-result?)
      (let* ((pacing (pacing-arguments maybe-pacing))
             (min-spacing (car pacing))
             (max-future-drift (cdr pacing)))
        (guard (e (#t (coin-error 'malformed-header
                                  "header context check raised")))
          (cond
            ((not (block-header? header))
             (coin-error 'malformed-header "expected a block header"))
            ((not (list? previous-headers))
             (coin-error 'malformed-header "expected a header list"))
            ((not (and (number? now) (exact? now) (integer? now)))
             (coin-error 'malformed-header "expected an integer clock"))
            (else
              (let ((time (block-header-time (validate-block-header header))))
                (cond
                  ((> time (+ now max-future-drift))
                   (coin-error 'time-too-far-ahead
                               "header time is too far in the future"))
                  ((null? previous-headers) (coin-ok header))
                  (else
                    (let ((parent (last-of previous-headers)))
                      (cond
                        ((not (block-header-links? parent header))
                         (coin-error 'bad-prev-hash
                                     "header does not link to its parent"))
                        ((< time (+ (block-header-time parent) min-spacing))
                         (coin-error 'insufficient-spacing
                                     "header is too close to its parent"))
                        ((<= time (coin-median-time-past previous-headers))
                         (coin-error 'time-too-old
                                     "header time is at or below median time past"))
                        (else (coin-ok header))))))))))))))
