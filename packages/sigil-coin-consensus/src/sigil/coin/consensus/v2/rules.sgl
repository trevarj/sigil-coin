;;; (sigil coin consensus v2 rules) — the frozen v2 caps
;;;
;;; §2 of the v2 specification, and nothing else. Three of these numbers
;;; move against v1 and each move is paid for somewhere:
;;;
;;;   * `coin-v2-max-solution-bytes` tracks `puzzle-v2-max-source-bytes`
;;;     rather than restating 512, because the two are the same rule seen
;;;     from either side: a solution the interpreter would refuse to parse
;;;     can never be accepted, and a solution consensus would refuse must
;;;     never be parsed.
;;;   * `coin-v2-max-block-bytes` grows to 16384 because the worst-case
;;;     coinbase scriptSig is 6588 bytes once co-op shares ride in it. The
;;;     bigger cap still leaves more room for transactions than v1's whole
;;;     block.
;;;   * `coin-v2-max-fuel` FALLS to 200000. Difficulty in v2 comes from
;;;     widening what a solution must express, never from tightening the
;;;     evaluator, because every node re-evaluates every solution and v2
;;;     validates up to nine of them per block.
;;;
;;; The timestamp and spacing rules are v1's, called through, not copied:
;;; §2.2 freezes `coin-min-block-spacing`, `coin-max-future-drift` and
;;; `coin-median-time-span` unchanged, so re-implementing them here would be
;;; two chances to diverge instead of one definition. The wrappers exist
;;; only so a caller may import the v1 and v2 facades side by side during
;;; the switchover without an ambiguous import.

(define-library (sigil coin consensus v2 rules)
  (import (sigil math)
          (sigil coin puzzle)
          (sigil coin consensus result)
          (sigil coin consensus rules))
  (export
    ;; Sizes
    coin-v2-max-block-bytes
    coin-v2-max-solution-bytes
    coin-v2-max-graffiti-bytes

    ;; Co-op limits (consumed by part B)
    coin-v2-max-shares
    coin-v2-max-commitments

    ;; Puzzle limits
    coin-v2-max-k
    coin-v2-max-fuel

    ;; Pacing, unchanged from v1
    coin-v2-min-block-spacing
    coin-v2-max-future-drift
    coin-v2-median-time-span
    coin-v2-median-time-past
    coin-v2-validate-header-context

    ;; Size checking
    coin-v2-block-size
    coin-v2-validate-block-size)

  (begin

    ;;; Maximum serialized block size, in bytes.
    ;;;
    ;;; ```scheme
    ;;; coin-v2-max-block-bytes ; => 16384
    ;;; ```
    (define coin-v2-max-block-bytes 16384)

    ;;; Maximum solution length, in bytes. Definitionally the interpreter's
    ;;; own v2 source cap, so the two can never drift apart.
    ;;;
    ;;; ```scheme
    ;;; coin-v2-max-solution-bytes ; => 512
    ;;; ```
    (define coin-v2-max-solution-bytes puzzle-v2-max-source-bytes)

    ;;; Maximum coinbase graffiti, in bytes. Unchanged from v1: grinding it
    ;;; is inert in v2, because the score word carries no free entropy and
    ;;; the block-hash tie-break is gone.
    (define coin-v2-max-graffiti-bytes 400)

    ;;; Maximum revealed co-op shares in one block.
    ;;;
    ;;; Sized so the worst-case coinbase scriptSig stays under 7 KB against
    ;;; the 16 KB block cap. Part B enforces it; it lives here because it is
    ;;; a frozen constant of §2, and because the score word's share field is
    ;;; four bits wide precisely because of it.
    (define coin-v2-max-shares 8)

    ;;; Maximum commitments in one block: 16 x 32 B = 513 B encoded, twice
    ;;; the reveal cap so competing candidates fit.
    (define coin-v2-max-commitments 16)

    ;;; Maximum example count `k` in a published puzzle.
    ;;;
    ;;; §8.3 was corrected after measurement: at `k = 10` under constraint 3
    ;;; the guaranteed table solution is 515 bytes and does not fit the
    ;;; 512-byte cap at all, and the tier-2 worst case leaves two bytes of
    ;;; headroom, which is not a margin. Frozen at 8, whose proven worst
    ;;; case is 415 bytes with 19% spare. Difficulty above that point grows
    ;;; through grammar width, which does not lengthen the table.
    (define coin-v2-max-k 8)

    ;;; Evaluator steps one solution may spend, across its evaluation and
    ;;; every one of its `k` applications, on one shared machine.
    (define coin-v2-max-fuel puzzle-v2-max-fuel)

    ;;; Minimum seconds between a header and its parent on mainnet.
    (define coin-v2-min-block-spacing coin-min-block-spacing)

    ;;; Maximum seconds a header's time may lead the validating clock.
    (define coin-v2-max-future-drift coin-max-future-drift)

    ;;; Number of trailing headers the median-time-past window spans.
    (define coin-v2-median-time-span coin-median-time-span)

    ;;; Median timestamp of the last `coin-v2-median-time-span` headers.
    ;;; Behaviourally identical to v1; this is v1's function.
    (define (coin-v2-median-time-past headers)
      (: list? -> integer?)
      (coin-median-time-past headers))

    ;;; Check a header against the chain it claims to extend.
    ;;;
    ;;; Behaviourally identical to v1, including the optional spacing floor
    ;;; a test chain supplies. v2 changes what `bits` and `nonce` mean, not
    ;;; when a header may be linked.
    (define (coin-v2-validate-header-context previous-headers header now
                                             . maybe-min-spacing)
      (: any? any? any? integer? ... -> coin-result?)
      (apply coin-validate-header-context
             previous-headers header now maybe-min-spacing))

    ;;; Serialized size of a block, in bytes, or `#f` when it does not
    ;;; serialize at all.
    (define (coin-v2-block-size b)
      (: any? -> any?)
      (coin-block-size b))

    ;;; Check a block against the v2 size cap.
    ;;;
    ;;; Rejection reasons are `malformed-block` and `block-oversize`. On
    ;;; success the value is the serialized size. This is the first body
    ;;; rule a node applies (§11): everything after it is bounded by the
    ;;; size it establishes.
    ;;;
    ;;; ```scheme
    ;;; (coin-result-reason (coin-v2-validate-block-size 42))
    ;;; ; => malformed-block
    ;;; ```
    (define (coin-v2-validate-block-size b)
      (: any? -> coin-result?)
      (let ((size (coin-v2-block-size b)))
        (cond
          ((not size)
           (coin-error 'malformed-block "block does not serialize"))
          ((> size coin-v2-max-block-bytes)
           (coin-error 'block-oversize "block exceeds the size cap"))
          (else (coin-ok size)))))))
