;;; (sigil coin consensus) — canonical SigilCoin consensus
;;;
;;; Pure consensus rules for puzzle derivation, solution verification, lottery
;;; targeting, retargeting, co-op shares, coinbase payloads and emission.
;;; No database, network or clock exists here beyond values supplied by callers.

(define-library (sigil coin consensus)
  (import (sigil coin consensus result)
          (sigil coin consensus emission)
          (sigil coin consensus rules)
          (sigil coin consensus seed)
          (sigil coin consensus solution)
          (sigil coin consensus score)
          (sigil coin consensus retarget)
          (sigil coin consensus shares)
          (sigil coin consensus coinbase)
          (sigil coin consensus fork-choice))
  (export
    ;; Package metadata
    consensus-package-version

    ;; Tagged results
    coin-result
    coin-result?
    coin-result-status
    coin-result-value
    coin-result-reason
    coin-result-detail
    coin-ok
    coin-error
    coin-ok?
    coin-failed?

    ;; Emission
    coin-daviwils-per-sigil
    coin-warmup-height
    coin-warmup-reward
    coin-initial-reward
    coin-halving-interval
    coin-final-reward-height
    coin-max-supply
    coin-block-reward
    coin-cumulative-supply

    ;; Frozen caps
    coin-max-block-bytes
    coin-max-solution-bytes
    coin-max-graffiti-bytes
    coin-max-shares
    coin-max-commitments
    coin-max-k
    coin-max-fuel
    coin-min-block-spacing
    coin-max-future-drift
    coin-median-time-span
    coin-median-time-past
    coin-validate-header-context
    coin-block-size
    coin-validate-block-size

    ;; Puzzle derivation
    coin-puzzle-tag
    coin-genesis-seed-tag
    coin-genesis-seed
    coin-height-encode
    coin-complexity-encode
    coin-puzzle-seed
    coin-puzzle-for
    coin-puzzle-cache
    coin-puzzle-cache?
    coin-puzzle-cache-capacity
    coin-puzzle-cache-entries
    coin-puzzle-cache-open
    coin-puzzle-cache-size
    coin-puzzle-cache-ref
    coin-puzzle-cached

    ;; Solution verification
    coin-solution-length
    coin-spec-builtin-cap
    coin-check-solution

    ;; Resource reporting and block lottery
    coin-bucket7
    coin-max-bucket
    coin-lottery-work-factor
    coin-lottery-max-bonus
    coin-lottery-max-integer
    coin-lottery-target-ceiling
    coin-lottery-bonus
    coin-lottery-multiplier
    coin-lottery-target
    coin-lottery-expected-rolls
    coin-lottery-valid?

    ;; Retargeting
    coin-retarget-window
    coin-target-margin
    coin-margin-clamp
    coin-factor-min
    coin-factor-max
    coin-complexity-min
    coin-complexity-max
    coin-complexity-genesis
    coin-margin
    coin-margin-median
    coin-retarget-height?
    coin-next-complexity
    coin-complexity-for
    coin-complexity-at
    coin-bits-prefix
    coin-bits-encode
    coin-bits-decode
    coin-bits-solution-length
    coin-check-bits

    ;; Co-op shares, commit-reveal and payouts
    coin-share-pubkey-bytes
    coin-share-signature-bytes
    coin-share-blind-bytes
    coin-commitment-bytes
    coin-share-fixed-bytes
    coin-max-share-bytes
    coin-max-shares-bytes
    coin-max-commits-bytes
    coin-empty-shares
    coin-empty-commits
    coin-share-tag
    coin-share-puzzle-tag
    coin-commit-tag
    coin-share-puzzle-seed
    coin-pubkey-anchor-output
    coin-anchor-output-pubkey
    coin-share-puzzle
    coin-share-preimage
    coin-commitment
    coin-share-commitment
    coin-share-script
    coin-share
    coin-share?
    coin-share-pubkey
    coin-share-signature
    coin-share-blind
    coin-share-solution
    coin-share-encode
    coin-shares-encode
    coin-shares-decode
    coin-commits-encode
    coin-commits-decode
    coin-coop-context
    coin-coop-context?
    coin-coop-context-parent-prev-hash
    coin-coop-context-puzzle-height
    coin-coop-context-complexity
    coin-coop-context-spec
    coin-coop-context-commits
    coin-share-signature-ok?
    coin-share-margin-milli
    coin-share-contribution
    coin-quality
    coin-share-quality
    coin-shares-quality
    coin-check-share-solution
    coin-check-shares
    coin-payout-plan
    coin-check-payout-cheap
    coin-check-payout

    ;; The coinbase payload
    coin-min-coinbase-script-bytes
    coin-max-coinbase-script-bytes
    coin-coinbase-script-bounds
    coin-coinbase-payload
    coin-coinbase-payload?
    coin-coinbase-payload-height
    coin-coinbase-payload-solution
    coin-coinbase-payload-shares
    coin-coinbase-payload-commits
    coin-coinbase-payload-graffiti
    coin-coinbase-payload-encode
    coin-coinbase-payload-decode
    coin-block-coinbase
    coin-block-coinbase-payload
    coin-carrier-script
    coin-check-coop

    ;; Fork choice
    coin-block-compare
    coin-better-block?)

  (begin

    ;;; Version of consensus package.
    (define (consensus-package-version)
      (: -> string?)
      "0.1.0")))
