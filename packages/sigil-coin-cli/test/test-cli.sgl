;;; The `sigilcoin` CLI, driven through its real entry points.
;;;
;;; Nothing here is mocked. `cli-run` is the same dispatcher the binary's
;;; `main` calls, every command opens a real node on a real SigilCoin
;;; regtest database in a temp directory, and the assertions are about what
;;; the node did and what the command printed.
;;;
;;; Groups that need a private key — deriving the wallet's own address,
;;; reading its balance, signing a spend — are gated on
;;; `%native-secp256k1?`, the same way `sigil-bitcoin`'s own suites gate
;;; theirs. A workspace-wide run has no secp256k1 native module bound and
;;; skips them; running this file on its own builds a harness that does, and
;;; exercises them for real. Everything that can avoid a key does: block
;;; payouts and send destinations are given as literal `sgl1` addresses,
;;; which only need bech32.

(import (sigil test)
        (sigil fs)
        (sigil io)
        (sigil math)
        (sigil path)
        (sigil time)
        (sigil error)
        (sigil string)
        (sigil process)
        (sigil socket)
        (sigil secp256k1)
        (sigil bitcoin utils)
        (sigil bitcoin primitives)
        (sigil bitcoin encoding)
        (sigil bitcoin keys)
        (sigil bitcoin script)
        (sigil bitcoin tx)
        (sigil bitcoin consensus)
        (sigil bitcoin node)
        (sigil coin puzzle)
        (sigil coin puzzle constraints)
        (sigil coin puzzle generator)
        (sigil coin consensus)
        (sigil coin node)
        (sigil coin cli))

;; Probe the capability by using it. Referencing an unbound native raises
;; rather than returning #f, so the guard is what makes this safe to ask on
;; a runtime that has no secp256k1 module bound.
(define %native-secp256k1?
  (guard (err (#t #f))
    (and (public-key? (private-key->public-key (make-bytevector 32 1)))
         (secp256k1-seckey-verify? (make-bytevector 32 1))
         #t)))

;; ============================================================
;; Helpers
;; ============================================================

;; An unspendable payout for blocks a test only needs for their height.
;; `OP_RETURN "sg"` keeps them out of any wallet's balance.
(define %elsewhere #u8(#x6a #x02 #x73 #x67))

;; A real SigilCoin address, checked in as text so a block can be mined to
;; it without deriving a key. Its checksum is verified below.
(define %payout-address "sgl1q70nakelv6wvuk2e63ah8lg68kq3nx7q2g3taul")

;; A second one, for send destinations and for proving a payout went
;; somewhere other than the miner's own wallet.
(define %other-address "sgl1qw508d6qejxtdg4y5r3zarvary0c5xw7kr43pwr")

(define (fresh-args)
  (let ((dir (make-temp-directory)))
    (unless dir
      (error "fresh-args: failed to create a temp directory"))
    (list "--regtest" "--data-dir" dir)))

;; Run a command through the binary's own dispatcher, swallowing the
;; `key: value` lines it prints and returning them alongside its value.
(define (run args)
  (let* ((value #f)
         (text (with-output-to-string
                 (lambda () (set! value (cli-run args))))))
    (cons value text)))

(define (run-value args) (car (run args)))
(define (run-text args) (cdr (run args)))

(define (quietly thunk)
  (let ((value #f))
    (with-output-to-string (lambda () (set! value (thunk))))
    value))

(define (message-of err)
  (let ((message (exception-message err)))
    (if (string? message) message "")))

(define (raises-message thunk)
  (guard (err (#t (message-of err)))
    (thunk)
    #f))

;; The message a command failed with, or #f when it succeeded. Output is
;; captured too, because a failing command may print before it raises.
(define (failure-message args)
  (let ((result #f))
    (with-output-to-string
      (lambda ()
        (set! result (raises-message (lambda () (cli-run args))))))
    result))

;; Build next canonical block directly for integration setup.
(define (build-next n graffiti script)
  (let* ((tip (coin-validated-tip-height n))
         (height (+ tip 1))
         (parent (coin-validated-tip-header n))
         (headers (let loop ((h 0) (out '()))
                    (if (> h tip)
                        (reverse out)
                        (loop (+ h 1)
                              (cons (coin-header-at-height n h) out)))))
         (complexity (coin-required-complexity headers height)))
    (coin-build-block parent height complexity #f graffiti script
                      (+ (block-header-time parent)
                         (coin-chain-min-block-spacing (node-config n))))))

;; Advance the chain by `count` blocks without going through the CLI, for
;; tests that only need a height. The solution is the generator's own, so
;; every block is valid.
(define (fast-forward args count)
  (quietly
    (lambda ()
      (cli-with-node args
        (lambda (n)
          (let loop ((i 0))
            (if (>= i count)
                (node-status-snapshot-best-block-height (node-status n))
                (let ((b (build-next n "fast-forward" %elsewhere)))
                  (node-ingest-headers n (list (block-header-field b)))
                  (node-store-block n b)
                  (unless (= 1 (node-validate-blocks n))
                    (error (string-append
                             "fast-forward: block did not validate: "
                             (node-status-snapshot-sync-last-error
                               (node-status n)))))
                  (loop (+ i 1))))))))))

(define (tip-height args)
  (quietly (lambda () (cli-with-node args coin-validated-tip-height))))

;; Mine one block to a literal address, so no key is needed.
(define (mine-to args address . extra)
  (run (append (list "mine" "--address" address) extra args)))

;; Two nonstandard scriptPubKeys standing in for two wallets.
;;
;; `script-classify` does not recognise either, so the connector runs no
;; input script for an output paying one, and spending it needs no
;; signature. That is what lets these groups drive REAL transactions,
;; through the real mempool, the real miner and the real block connector,
;; on a runtime with no secp256k1 module bound — which is where the bug
;; that made blocks coinbase-only had to be caught.
(define %purse-a #u8(#x6a #x02 #x61 #x61))
(define %purse-b #u8(#x6a #x02 #x62 #x62))

;; A 200-byte output script, for filling a block up against its cap.
(define %ballast (make-bytevector 200 #x6a))

;; Mine one block outside the CLI, paying `script`, and hand back the block.
;; `mine` only pays an `sgl1` address or the local wallet, and these tests
;; need a payout to a script no key belongs to.
(define (mine-block-to-script args script)
  (quietly
    (lambda ()
      (cli-with-node args
        (lambda (n)
          (let ((b (build-next n "funding" script)))
            (node-ingest-headers n (list (block-header-field b)))
            (node-store-block n b)
            (unless (= 1 (node-validate-blocks n))
              (error (string-append
                       "mine-block-to-script: block did not validate: "
                       (node-status-snapshot-sync-last-error
                         (node-status n)))))
            b))))))

(define (coinbase-outpoint b)
  (outpoint txid: (transaction-txid (car (block-transactions b)))
            index: 0))

(define (tx-outpoint tx index)
  (outpoint txid: (transaction-txid tx) index: index))

;; An unsigned spend of `op`, which is worth `value`: `amount` to
;; `to-script`, the remainder less `fee` back to `change-script`.
(define (purse-spend op value to-script amount fee change-script)
  (transaction
    version: 2
    inputs: (list (txin previous-output: op
                        script-sig: #u8()
                        sequence: #xffffffff
                        witness: '()))
    outputs: (let ((change (- value amount fee)))
               (if (> change 0)
                   (list (txout value: amount script-pubkey: to-script)
                         (txout value: change
                                script-pubkey: change-script))
                   (list (txout value: amount script-pubkey: to-script))))
    lock-time: 0))

(define (submit args tx)
  (quietly
    (lambda ()
      (cli-with-node args
        (lambda (n) (node-store-transaction n tx "test"))))))

(define (mempool-count args)
  (quietly
    (lambda ()
      (cli-with-node args
        (lambda (n) (node-status-snapshot-mempool-count (node-status n)))))))

(define (utxos-of args script)
  (quietly
    (lambda ()
      (cli-with-node args (lambda (n) (wallet-utxos n script))))))

(define (utxo-total rows)
  (let loop ((xs rows) (total 0))
    (if (null? xs) total (loop (cdr xs) (+ total (wallet-utxo-value (car xs)))))))

;; Fund `script` with one mined coinbase and age it to spendable. Returns
;; the outpoint holding `(coin-block-reward 1)`.
(define (funded-outpoint args script)
  (let ((funding (mine-block-to-script args script)))
    (fast-forward args (- coin-coinbase-maturity 1))
    (coinbase-outpoint funding)))

;; ============================================================
;; Argument parsing
;; ============================================================

(test-group "sigilcoin argument parsing"
  (test "flags are read by name"
    (assert-equal "/tmp/x"
                  (cli-arg '("--data-dir" "/tmp/x") "--data-dir" #f))
    (assert-equal #f (cli-arg '("--data-dir") "--data-dir" #f))
    (assert-equal "fallback" (cli-arg '() "--data-dir" "fallback"))
    ;; A flag name appearing as another flag's value is not a flag.
    (assert-equal "sgl1abc"
                  (cli-arg '("--to" "sgl1abc" "--amount" "1") "--to" #f)))

  (test "repeatable flags accumulate in order"
    (assert-equal '("a" "b")
                  (cli-arg-list '("--peer" "a" "--x" "1" "--peer" "b")
                                "--peer"))
    (assert-equal '() (cli-arg-list '("--peer") "--peer")))

  (test "valueless flags are detected"
    (assert-true (cli-flag? '("--regtest") "--regtest"))
    (assert-equal #f (cli-flag? '("--chain" "x") "--regtest")))

  (test "numeric flags parse or say which flag was wrong"
    (assert-equal 8 (cli-number '("--max-steps" "8") "--max-steps" "64"))
    (assert-equal 64 (cli-number '() "--max-steps" "64"))
    (assert-true (string-contains?
                   (raises-message
                     (lambda ()
                       (cli-number '("--max-steps" "soon") "--max-steps" "64")))
                   "--max-steps")))

  (test "a missing mandatory flag says what to pass"
    (let ((message (raises-message
                     (lambda ()
                       (cli-required '() "--to" "send" "a sgl1... address")))))
      (assert-true (string-contains? message "--to"))
      (assert-true (string-contains? message "sgl1"))))

  (test "the default chain is mainnet and --regtest selects the local one"
    (assert-equal "sigilcoin-main" (cli-chain-name '()))
    (assert-equal "sigilcoin-regtest" (cli-chain-name '("--regtest")))
    (assert-true (eq? sigilcoin-main-chain (cli-chain '())))
    (assert-true (eq? sigilcoin-regtest-chain (cli-chain '("--regtest"))))
    (assert-true (eq? sigilcoin-regtest-chain
                      (cli-chain '("--chain" "sigilcoin-regtest"))))
    (assert-true (eq? sigilcoin-main-chain
                      (cli-chain '("--chain" "sigilcoin-main")))))

  (test "a Bitcoin chain cannot be opened by this binary"
    ;; `chain-config-by-name` would happily hand back a Bitcoin config; the
    ;; CLI must not, because a SigilCoin data directory under Bitcoin's
    ;; rules is a corrupted node.
    (let ((message (raises-message
                     (lambda () (cli-chain '("--chain" "bitcoin-mainnet"))))))
      (assert-true (string-contains? message "bitcoin-mainnet"))
      (assert-true (string-contains? message "sigilcoin-main"))))

  (test "the data directory defaults to a dot directory"
    (assert-equal ".sigilcoin" (cli-data-dir '()))
    (assert-equal "/tmp/n" (cli-data-dir '("--data-dir" "/tmp/n")))))

;; ============================================================
;; Amounts
;; ============================================================

(test-group "sigilcoin amounts"
  (test "daviwils render as fixed-point SGL"
    (assert-equal "1.00000000" (cli-daviwils->sgl coin-daviwils-per-sigil))
    (assert-equal "0.00000001" (cli-daviwils->sgl 1))
    (assert-equal "0.00000000" (cli-daviwils->sgl 0))
    (assert-equal "143029.99991970" (cli-daviwils->sgl coin-max-supply)))

  (test "SGL parses back to the same daviwils"
    (assert-equal 100000000 (cli-sgl->daviwils "--amount" "1"))
    (assert-equal 150000000 (cli-sgl->daviwils "--amount" "1.5"))
    (assert-equal 1 (cli-sgl->daviwils "--amount" "0.00000001"))
    (assert-equal 0 (cli-sgl->daviwils "--amount" "0"))
    (assert-equal coin-max-supply
                  (cli-sgl->daviwils "--amount"
                                     (cli-daviwils->sgl coin-max-supply)))
    (assert-equal (coin-block-reward 31)
                  (cli-sgl->daviwils "--amount"
                                     (cli-daviwils->sgl
                                       (coin-block-reward 31)))))

  (test "an amount finer than a daviwil is refused, never rounded"
    (assert-true (string-contains?
                   (raises-message
                     (lambda ()
                       (cli-sgl->daviwils "--amount" "1.000000001")))
                   "8 decimal places"))
    (assert-error (cli-sgl->daviwils "--amount" ""))
    (assert-error (cli-sgl->daviwils "--amount" "1.2.3"))
    (assert-error (cli-sgl->daviwils "--amount" "1e8"))
    (assert-error (cli-sgl->daviwils "--amount" "one"))
    (assert-error (cli-sgl->daviwils "--amount" "1."))
    (assert-error (cli-sgl->daviwils "--amount" 1))))

;; ============================================================
;; Dispatch
;; ============================================================

(test-group "sigilcoin dispatch"
  (test "no arguments prints the command surface"
    (let ((text (run-text '())))
      (assert-true (string-contains? text "sigilcoin puzzle"))
      (assert-true (string-contains? text "sigilcoin mine"))
      (assert-true (string-contains? text "sigilcoin send"))
      (assert-true (string-contains? text "sigilcoin status"))
      (assert-true (string-contains? text "sigilcoin peers"))
      (assert-true (string-contains? text "sigilcoin header-sync"))
      (assert-true (string-contains? text "sigilcoin block-sync"))
      (assert-true (string-contains? text "sigilcoin sync"))
      (assert-true (string-contains? text "sigilcoin run"))
      (assert-true (string-contains? text "sigilcoin listen"))
      (assert-true (string-contains? text "sigilcoin address"))
      (assert-true (string-contains? text "sigilcoin balance"))))

  (test "help and version answer without touching a node"
    (assert-true (string-contains? (run-text '("help")) "sigilcoin puzzle"))
    (assert-true (string-contains? (run-text '("--help")) "sigilcoin mine"))
    (assert-true (string-contains? (run-text '("version"))
                                   (cli-package-version))))

  (test "an unknown command names itself and points at help"
    (let ((message (failure-message '("mien"))))
      (assert-true (string-contains? message "mien"))
      (assert-true (string-contains? message "sigilcoin help"))))

  (test "every documented command reaches its own runner"
    ;; Each is given arguments that fail INSIDE the command rather than at
    ;; dispatch, so the message proves which runner ran.
    (for-each
      (lambda (command)
        (assert-true (string-contains?
                       (failure-message (list command "--chain" "x"))
                       "--chain")))
      '("puzzle" "mine" "address" "balance" "status"
        "header-sync" "block-sync" "sync" "run" "listen"
        "commit" "reveal"))
    ;; `commit` needs a solution before it will touch a node or a key.
    (assert-true (string-contains? (failure-message '("commit" "--regtest"))
                                   "--solution"))
    (assert-true (string-contains?
                   (failure-message '("send" "--chain" "x" "--to" "a"))
                   "--chain"))
    (assert-true (string-contains? (failure-message '("send" "--regtest"))
                                   "--to"))
    (assert-true (string-contains? (failure-message '("peers"))
                                   "missing subcommand"))
    ;; An unknown `peers` subcommand is reported after the node opens, so
    ;; this one needs a data directory of its own rather than the default.
    (assert-true (string-contains?
                   (failure-message (cons "peers" (cons "fly" (fresh-args))))
                   "unknown subcommand")))

  (test "a rejected command leaves no wallet key behind"
    ;; Argument validation happens before any key material is created, so a
    ;; typo does not litter a directory with secrets.
    (let ((args (fresh-args)))
      (failure-message (append (list "mine" "--chain" "nope") args))
      (failure-message (append (list "balance" "--chain" "nope") args))
      (failure-message (append (list "send" "--to" "nope" "--amount" "1")
                               args))
      (assert-equal #f
                    (file-exists? (wallet-key-file (cli-data-dir args)))))))

;; ============================================================
;; Addresses
;; ============================================================

(test-group "sigilcoin addresses"
  (test "the checked-in addresses are well formed SigilCoin addresses"
    (assert-equal "sgl" coin-address-hrp)
    (for-each
      (lambda (address)
        (assert-true (string-starts-with? address "sgl1"))
        (let ((script (coin-address->script-pubkey "--to" address)))
          (assert-equal 22 (bytevector-length script))
          (assert-equal 'p2wpkh (script-classify script))
          ;; And the script really is the one bech32 says it is.
          (assert-equal script
                        (script-p2wpkh (caddr (segwit-decode address))))))
      (list %payout-address %other-address)))

  (test "an address round-trips through bech32 under the sgl prefix"
    (let* ((program (make-bytevector 20 42))
           (address (segwit-encode coin-address-hrp 0 program)))
      (assert-true (string-starts-with? address "sgl1"))
      (assert-equal (script-p2wpkh program)
                    (coin-address->script-pubkey "--to" address))
      ;; The same program under Bitcoin's HRP is a different string: the
      ;; HRP is data, not something baked into the encoder.
      (assert-true (not (string=? address
                                  (segwit-encode "bc" 0 program))))))

  (test "a Bitcoin address is refused, saying which chain it belongs to"
    (let ((message (raises-message
                     (lambda ()
                       (coin-address->script-pubkey
                         "--to"
                         "bc1qw508d6qejxtdg4y5r3zarvary0c5xw7kv8f3t4")))))
      (assert-true (string-contains? message "\"bc\""))
      (assert-true (string-contains? message "sgl1")))
    ;; Testnet's HRP too: any HRP but ours is refused.
    (assert-error
      (coin-address->script-pubkey
        "--to"
        "tb1qw508d6qejxtdg4y5r3zarvary0c5xw7kxpjzsx")))

  (test "malformed and unsupported addresses are refused"
    (assert-error (coin-address->script-pubkey "--to" "not-an-address"))
    (assert-error (coin-address->script-pubkey "--to" ""))
    (assert-error (coin-address->script-pubkey "--to" 42))
    ;; The right HRP with a mutated payload fails the checksum.
    (assert-error
      (coin-address->script-pubkey
        "--to"
        "sgl1q70nakelv6wvuk2e63ah8lg68kq3nx7q2g3taum"))
    ;; A canonical (Taproot) program under our HRP: valid bech32m, not spendable
    ;; by this wallet, and refused with a reason rather than a crash.
    (assert-true (string-contains?
                   (raises-message
                     (lambda ()
                       (coin-address->script-pubkey
                         "--to"
                         (segwit-encode coin-address-hrp
                                        1
                                        (make-bytevector 32 9)))))
                   "witness version 1"))
    ;; A v0 program of the wrong length is refused before it can be paid.
    (assert-true (string-contains?
                   (raises-message
                     (lambda ()
                       (coin-address->script-pubkey
                         "--to"
                         (segwit-encode coin-address-hrp
                                        0
                                        (make-bytevector 32 9)))))
                   "20-byte"))))

;; ============================================================
;; The puzzle command
;; ============================================================

;; Regtest genesis is a constant, so the puzzle at height 1 is a constant
;; too. Pinning it here is what catches a generator or seed change that
;; would silently move every miner's target.
(define %regtest-genesis-hash
  (chain-config-genesis-hash sigilcoin-regtest-chain))

;; ============================================================
;; Node operation
;; ============================================================

(test-group "sigilcoin status"
  (test "a fresh node reports genesis and SigilCoin's own numbers"
    (let* ((args (fresh-args))
           (result (run (cons "status" args)))
           (status (car result))
           (text (cdr result)))
      (assert-true (node-status-snapshot? status))
      (assert-true (string-contains? text "chain: sigilcoin-regtest"))
      (assert-true (string-contains? text "best-block-height: 0"))
      (assert-true (string-contains? text "validated-blocks: 0"))
      (assert-true (string-contains? text "next-height: 1"))
      (assert-true (string-contains? text "next-reward: 1.00000000 SGL"))
      (assert-true (string-contains? text "issued-supply: 0.00000000 SGL"))
      (assert-true (string-contains?
                     text
                     (string-append "max-supply: "
                                    (cli-daviwils->sgl coin-max-supply))))
      ;; Genesis's own 49-byte solution, recovered from the stored rank.
      (assert-true (string-contains?
                     text
                     (string-append "tip-solution-bytes: "
                       (number->string
                         (coin-score-length
                           (coin-score-decode coin-genesis-score))))))
      (assert-true (string-contains?
                     text
                     (string-append "best-hash: "
                                    (hex-encode
                                      (chain-config-genesis-hash
                                        sigilcoin-regtest-chain)))))))

  (test "status follows the chain as it is mined"
    (let ((args (fresh-args)))
      (mine-to args %payout-address "--solution" %height-one-source)
      (let ((text (run-text (cons "status" args))))
        (assert-true (string-contains? text "best-block-height: 1"))
        (assert-true (string-contains? text "validated-blocks: 1"))
        (assert-true (string-contains? text "next-height: 2"))
        ;; The tip's solution length, straight from the stored rank.
        (assert-true (string-contains?
                       text
                       (string-append "tip-solution-bytes: "
                                      (number->string
                                        (string-length %height-one-source)))))
        (assert-true (string-contains?
                       text
                       (string-append "issued-supply: "
                                      (cli-daviwils->sgl
                                        (coin-cumulative-supply 1)))))))))

(test-group "sigilcoin peers"
  (test "peers are added, listed and removed on the SigilCoin chain"
    (let ((args (fresh-args)))
      (assert-true (string-contains?
                     (run-text (cons "peers" (cons "list" args)))
                     "no peers configured"))
      (let ((text (run-text (append (list "peers" "add" "127.0.0.1:19445")
                                    args))))
        (assert-true (string-contains? text "127.0.0.1:19445"))
        (assert-true (string-contains? text "source=manual")))
      (let ((peers (run-value (cons "peers" (cons "list" args)))))
        (assert-equal 1 (length peers))
        (assert-equal "127.0.0.1" (node-peer-address (car peers)))
        (assert-equal 19445 (node-peer-port (car peers))))
      (assert-true (string-contains?
                     (run-text (append (list "peers" "remove" "127.0.0.1")
                                       args))
                     "removed 127.0.0.1:19445"))
      (assert-equal '() (run-value (cons "peers" (cons "list" args))))))

  (test "a peer with no port takes the chain's default"
    (assert-equal (cons "127.0.0.1"
                        (chain-config-default-port sigilcoin-regtest-chain))
                  (coin-parse-peer
                    "127.0.0.1"
                    (chain-config-default-port sigilcoin-regtest-chain)))
    (assert-equal 19445 (chain-config-default-port sigilcoin-regtest-chain))
    (assert-equal 19444 (chain-config-default-port sigilcoin-main-chain)))

  (test "endpoint syntax is parsed the way sigil-bitcoin parses it"
    (assert-equal (cons "seed.example" 19445)
                  (coin-parse-peer "seed.example" 19445))
    (assert-equal (cons "seed.example" 1234)
                  (coin-parse-peer "seed.example:1234" 19445))
    (assert-equal (cons "::1" 19445) (coin-parse-peer "[::1]" 19445))
    (assert-equal (cons "::1" 1234) (coin-parse-peer "[::1]:1234" 19445))
    (assert-error (coin-parse-peer "::1" 19445))
    (assert-error (coin-parse-peer "host:0" 19445))
    (assert-error (coin-parse-peer "host:70000" 19445))
    (assert-error (coin-parse-peer "host:soon" 19445)))

  (test "a peers subcommand needing an endpoint says so"
    (let ((args (fresh-args)))
      (assert-true (string-contains?
                     (failure-message (cons "peers" (cons "add" args)))
                     "missing HOST[:PORT]"))
      (assert-true (string-contains?
                     (failure-message (cons "peers" (cons "remove" args)))
                     "missing HOST[:PORT]")))))

(test-group "sigilcoin sync commands"
  (test "syncing with no peers says how to get one"
    (let ((args (fresh-args)))
      (for-each
        (lambda (command)
          (let ((message (failure-message (cons command args))))
            (assert-true (string-contains? message "no peers"))
            (assert-true (string-contains? message "sigilcoin peers add"))))
        '("header-sync" "sync" "run"))))

  (test "an unreachable --peer is reported, not retried forever"
    ;; Port 1 on loopback refuses instantly, so this exercises the real
    ;; connector and the real give-up path without a timeout wait.
    (let* ((args (fresh-args))
           (message (failure-message
                      (append (list "sync"
                                    "--peer" "127.0.0.1:1"
                                    "--connect-timeout" "200"
                                    "--resolve-timeout" "200")
                              args))))
      (assert-true (string-contains? message "every --peer failed"))
      (assert-equal 0 (tip-height args))))

  (test "listen binds a port, waits, and reports the node's status"
    ;; No client connects inside the accept timeout, so the server closes
    ;; the listener and reports rather than hanging.
    (let* ((args (fresh-args))
           (text (run-text (append (list "listen"
                                         "--port" "19571"
                                         "--max-connections" "1"
                                         "--accept-timeout" "50")
                                   args))))
      (assert-true (string-contains? text "listening: 127.0.0.1:19571"))
      (assert-true (string-contains? text "chain: sigilcoin-regtest"))))

  (test "a port already in use is refused with an actionable message"
    (let ((held (tcp-listen 19572 1 "127.0.0.1"))
          (args (fresh-args)))
      (assert-true (and held #t))
      (let ((message (failure-message (append (list "listen"
                                                    "--port" "19572"
                                                    "--accept-timeout" "50")
                                              args))))
        (socket-close held)
        (assert-true (string-contains? message "could not bind"))
        (assert-true (string-contains? message "127.0.0.1:19572"))
        (assert-true (string-contains? message "already hold that port")))))

  (test "run drains the validation backlog before asking for peers"
    ;; A stored, unvalidated block is work the node can do alone. `run` must
    ;; take it rather than failing for want of a peer.
    (let ((args (fresh-args)))
      (quietly
        (lambda ()
          (cli-with-node args
            (lambda (n)
              (let ((b (build-next n "backlog" %elsewhere)))
                (node-ingest-headers n (list (block-header-field b)))
                (node-store-block n b))))))
      (assert-equal 0 (tip-height args))
      (assert-true (string-contains? (run-text (cons "run" args))
                                     "validated-blocks: 1"))
      (assert-equal 1 (tip-height args)))))

;; ============================================================
;; The listener under attack
;; ============================================================
;;
;; A test cannot both run `sigilcoin listen` and connect to it: the accept
;; loop owns the process it runs in, and the hostile connections have to
;; arrive while it is accepting. So the listener runs as its own operating-
;; system process — `test/listen-peer.sgl`, which is the binary's real entry
;; point — and this process is the attacker.

;; Found relative to the working directory, which is the workspace root for
;; a whole-repo run and the package root for a single-file one.
(define %listen-script
  (let loop ((candidates (list "packages/sigil-coin-cli/test/listen-peer.sgl"
                               "test/listen-peer.sgl"
                               "../test/listen-peer.sgl")))
    (cond ((null? candidates)
           (error "test-cli: cannot find test/listen-peer.sgl"))
          ((file-exists? (car candidates)) (car candidates))
          (else (loop (cdr candidates))))))

;; The module search paths this process resolved its own imports through,
;; handed to the child as `-L` so it loads the same code from the same
;; checkouts. `--` separates them from the words the CLI reads.
(define %listen-command
  (let loop ((paths (library-paths)) (out '()))
    (if (null? paths)
        (append (reverse out) (list %listen-script "--"))
        (loop (cdr paths) (cons (car paths) (cons "-L" out))))))

(define (spawn-listener args)
  (let ((p (apply process-spawn
                  "sigil"
                  die-with-parent: #t
                  (append %listen-command args))))
    (unless p
      (error "test-cli: could not spawn the listener process"))
    p))

(define (listener-lines p)
  (let loop ((lines '()))
    (let ((line (read-line (process-stdout p))))
      (if (eof-object? line)
          (reverse lines)
          (loop (cons line lines))))))

(define (printed? lines text)
  (let loop ((xs lines))
    (cond ((null? xs) #f)
          ((string-contains? (car xs) text) #t)
          (else (loop (cdr xs))))))

;; Loopback ports derived from this process's id, so a second run of the
;; suite on the same machine cannot collide.
(define (listen-port offset)
  (+ 19600 offset (* 2 (modulo (process-id) 150))))

;; Connect, retrying while the child is still binding. A connect succeeds
;; as soon as the child has called listen(), so the first success also
;; proves the port is open.
(define (connect-listener port)
  (let loop ((tries 0))
    (let ((sock (guard (err (else #f)) (tcp-connect "127.0.0.1" port))))
      (cond (sock sock)
            ;; `sleep` counts SECONDS: 200 tries is twenty of them.
            ((> tries 200) #f)
            (else (sleep 0.1) (loop (+ tries 1)))))))

(test-group "sigilcoin listen under hostile connections"
  (test "a hangup, garbage and a silent client drop only themselves"
    ;; Each of the three is a connection an attacker makes for free with
    ;; one line of `nc`. All three must be dropped, and the fourth — a real
    ;; peer — must still be served by the same listener.
    (let* ((args (fresh-args))
           (port (listen-port 0)))
      (fast-forward args 2)
      (let ((child (spawn-listener
                     (append (list "listen"
                                   "--port" (number->string port)
                                   "--max-connections" "4"
                                   "--accept-timeout" "20000"
                                   "--read-timeout" "500"
                                   "--max-steps" "16")
                             args))))
        ;; 1. connect and hang up
        (let ((hangup (connect-listener port)))
          (assert-true (socket? hangup))
          (socket-close hangup))
        ;; 2. bytes that are not this chain's wire protocol
        (let ((garbage (connect-listener port)))
          (assert-true (socket? garbage))
          (socket-send-all garbage "GET / HTTP/1.1\r\n\r\nnot an envelope")
          (socket-close garbage))
        ;; 3. open, say nothing, and let --read-timeout expire
        (let ((silent (connect-listener port)))
          (assert-true (socket? silent))
          (sleep 0.9)
          (socket-close silent))
        ;; 4. a real peer. Headers only: `sigil-bitcoin` has no `getdata`
        ;; responder, so asking for bodies would time out for a reason that
        ;; has nothing to do with this test.
        (let* ((client (fresh-args))
               (status
                 (quietly
                   (lambda ()
                     (cli-with-node client
                       (lambda (n)
                         (node-sync-configured-peer
                           n
                           "127.0.0.1"
                           port
                           (coin-peer-connector '("--read-timeout" "20000"))
                           16
                           0)))))))
          (assert-equal 2 (node-status-snapshot-best-height status))
          (assert-true (not (string=? "failed"
                                      (node-status-snapshot-sync-stage
                                        status)))))
        (let ((lines (listener-lines child))
              (exit-code (process-wait child)))
          (assert-equal 0 exit-code)
          ;; The listener survived all three and served the fourth.
          (assert-true (printed? lines "connections-accepted: 4"))
          (assert-true (printed? lines "connections-served: 1"))
          (assert-true (printed? lines "connections-dropped: 3"))
          ;; And none of the noise reads as a node fault.
          (assert-true (printed? lines "sync-stage: idle"))
          (assert-true (printed? lines "peer-failures: 0"))))))

  (test "--max-connections 0 keeps serving past the accept timeout"
    (let* ((args (fresh-args))
           (port (listen-port 1))
           (child (spawn-listener
                    (append (list "listen"
                                  "--port" (number->string port)
                                  "--max-connections" "0"
                                  "--accept-timeout" "200"
                                  "--read-timeout" "500")
                            args))))
      (let ((hangup (connect-listener port)))
        (assert-true (socket? hangup))
        (socket-close hangup))
      ;; Several accept timeouts later, with no peer in between, the port
      ;; must still be open: zero means serve indefinitely.
      (sleep 1.5)
      (let ((again (guard (err (else #f)) (tcp-connect "127.0.0.1" port))))
        (assert-true (socket? again))
        (socket-close again))
      (process-kill! child)
      (assert-true #t))))

;; ============================================================
;; Canonical program-by-example commands
;; ============================================================

(define %height-one-spec
  (cli-puzzle %regtest-genesis-hash 1 coin-genesis-complexity))
(define %height-one-source (puzzle-spec-hidden-source %height-one-spec))
(define (work-args) (fresh-args))

;; Find one canonical height-one complexity drawing a requested constraint.
;; The constraint stream is cheap to inspect; each selected puzzle is generated
;; only once by the real command below.
(define (complexity-for-constraint ci)
  (let loop ((complexity (if (memv ci '(1 3 5)) 256 1024)))
    (cond
      ((> complexity coin-complexity-max)
       (error "test-cli: no complexity draws requested constraint"))
      ((= ci (puzzle-constraint-for
                (coin-puzzle-seed %regtest-genesis-hash 1 complexity)
                1
                complexity))
       complexity)
      (else (loop (+ complexity 1))))))

(define (constraint-violating-source ci)
  (cond ((= ci 1) "(lambda(x)1)")
        ((= ci 2) "(lambda(x)'x)")
        ((= ci 3) "(lambda(x)x)")
        ((= ci 4)
         "(lambda(x)(list(car x)(cdr x)(length x)(reverse x)(null? x)))")
        ((= ci 5) "(lambda(x)(map(lambda(y)y)x))")
        ((= ci 6) "(lambda(x)10)")
        (else "(lambda(x)x)")))

(test-group "sigilcoin puzzle"
  (test "report is consensus derivation"
    (let ((report (coin-puzzle-report %regtest-genesis-hash 1
                                      coin-genesis-complexity)))
      (assert-equal 1 (cdr (assq 'height report)))
      (assert-equal coin-genesis-complexity (cdr (assq 'complexity report)))
      (assert-equal (puzzle-spec-examples %height-one-spec)
                    (puzzle-spec-examples
                      (cli-puzzle %regtest-genesis-hash 1
                                  coin-genesis-complexity)))
      (assert-equal (puzzle-spec-table-solution %height-one-spec)
                    (cdr (assq 'fallback report)))))

  (test "command prints sole puzzle shape"
    (let ((text (run-text (cons "puzzle" (work-args)))))
      (assert-true (string-contains? text "complexity: 128"))
      (assert-true (string-contains? text "constraint:"))
      (assert-true (string-contains? text "examples:"))
      (assert-true (string-contains? text "ONE-ARGUMENT function"))))

  (test "complexity preview validates its input"
    (assert-true (string-contains?
                   (run-text (append (list "puzzle" "--complexity" "300")
                                     (work-args)))
                   "complexity: 300"))
    (assert-true (string-contains?
                   (failure-message
                     (append (list "puzzle" "--complexity" "x")
                             (work-args)))
                   "--complexity"))))

(test-group "sigilcoin mine"
  (test "valid function submits canonical block"
    (let* ((args (work-args))
           (result (run (append (list "mine" "--solution"
                                      %height-one-source
                                      "--address" %payout-address)
                                args)))
           (b (car result))
           (text (cdr result)))
      (assert-true (block? b))
      (assert-equal 1 (tip-height args))
      (assert-true (string-contains? text "examples-reproduced:"))
      (assert-true (string-contains? text "submitted: yes"))))

  (test "fallback submits when source omitted"
    (let ((args (work-args)))
      (assert-true (block? (run-value
                             (append (list "mine" "--address" %payout-address)
                                     args))))
      (assert-equal 1 (tip-height args))))

  (test "wrong arity and mismatch are actionable"
    (assert-true (string-contains?
                   (failure-message
                     (append (list "mine" "--solution" "(lambda(x y)x)")
                             (work-args)))
                   "one-argument procedure"))
    (assert-true (string-contains?
                   (failure-message
                     (append (list "mine" "--solution" "(lambda(x)x)")
                             (work-args)))
                   "example")))

  (test "oversize and malformed source name source error"
    (assert-true (string-contains?
                   (failure-message
                     (append (list "mine" "--solution"
                                   (make-string 513 #\x))
                             (work-args)))
                   "cap is 512 bytes"))
    (assert-true (string-contains?
                   (failure-message
                     (append (list "mine" "--solution" "(lambda(x")
                             (work-args)))
                   "does not parse")))

  (test "every active syntactic constraint is shown and rejected"
    (let ((args (work-args)))
      (for-each
        (lambda (ci)
          (let* ((complexity (number->string (complexity-for-constraint ci)))
                 (name (symbol->string (puzzle-constraint-name ci)))
                 (flags (append (list "--complexity" complexity) args))
                 (puzzle-text (run-text (cons "puzzle" flags)))
                 (message
                   (failure-message
                     (append (list "mine" "--solution"
                                   (constraint-violating-source ci))
                             flags))))
            (assert-true (string-contains?
                           puzzle-text (string-append "constraint: " name)))
            (assert-true (string-contains? message name))
            (assert-true (string-contains? message
                                           "knowable before you start"))))
        '(1 2 3 4 5 6 7)))))

;; Confirm `fanout`, then fill the following block from its independent
;; outputs. Shared by keyless workspace runs and the native wallet lifecycle,
;; so either harness pays the 100-block maturity setup only once.
(define (assert-16k-selection args fanout fan)
  (let ((size-height (+ (tip-height args) 2))
        (share (txout-value (car (transaction-outputs fanout)))))
    (assert-equal 16384 coin-max-block-bytes)
    (assert-equal "available"
                  (node-mempool-entry-status (submit args fanout)))
    (assert-equal 2
                  (length (block-transactions
                            (car (mine-to args %payout-address)))))
    (let loop ((i 0))
      (when (< i fan)
        (assert-equal
          "available"
          (node-mempool-entry-status
            (submit args
              (transaction
                version: 2
                inputs: (list
                          (txin previous-output: (tx-outpoint fanout i)
                                script-sig: #u8()
                                sequence: #xffffffff
                                witness: '()))
                outputs: (list (txout value: (- share 1000)
                                      script-pubkey: %ballast))
                lock-time: 0))))
        (loop (+ i 1))))
    (assert-equal fan (mempool-count args))
    (let* ((b (car (mine-to args %payout-address)))
           (included (- (length (block-transactions b)) 1)))
      (assert-true (<= (coin-block-size b) coin-max-block-bytes))
      (assert-true (> (coin-block-size b)
                      (- coin-max-block-bytes 500)))
      (assert-true (< 1 included fan))
      (assert-equal (- fan included) (mempool-count args))
      (assert-equal (+ (coin-block-reward size-height) (* included 1000))
                    (txout-value
                      (car (transaction-outputs
                             (car (block-transactions b)))))))))

(if (not %native-secp256k1?)
  (test-group "sigilcoin 16KiB block selection"
    (test "the miner includes only the real transactions that fit"
      (let* ((args (fresh-args))
             (op (funded-outpoint args %purse-a))
             (fan 80)
             (share (quotient (- (coin-block-reward 1) 1000) fan))
             (fanout
               (transaction
                 version: 2
                 inputs: (list (txin previous-output: op
                                     script-sig: #u8()
                                     sequence: #xffffffff
                                     witness: '()))
                 outputs: (let loop ((i 0) (out '()))
                            (if (>= i fan)
                                (reverse out)
                                (loop (+ i 1)
                                      (cons (txout value: share
                                                   script-pubkey: %purse-a)
                                            out))))
                 lock-time: 0)))
        (assert-16k-selection args fanout fan))))
  #t)

(test-group "sigilcoin private commitment store"
  (test "save atomically keeps 0600 and refuses permission drift before mutation"
    (let* ((data-dir (make-temp-directory))
           (path (cli-commit-file data-dir))
           (record
             (lambda (n)
               (cli-commit-record
                 height: 1 complexity: 128
                 parent: %regtest-genesis-hash
                 pubkey: (make-bytevector coin-share-pubkey-bytes 2)
                 blind: (make-bytevector coin-share-blind-bytes n)
                 commitment: (make-bytevector coin-commitment-bytes n)
                 solution: %height-one-source))))
      (cli-commit-save data-dir (record 1))
      (cli-commit-save data-dir (record 2))
      (assert-equal #o600
                    (bitwise-and (stat-mode (file-stat path)) #o777))
      (let ((before (read-file-string path)))
        (assert-equal 0 (process-run "chmod" "0644" path))
        (let ((message
                (raises-message
                  (lambda () (cli-commit-save data-dir (record 3))))))
          (assert-true (string-contains? message
                                         "readable by other accounts"))
          (assert-true (string-contains? message "chmod 0600")))
        (let ((after (read-file-string path)))
          (assert-equal before after)
          (assert-equal (hash256 before) (hash256 after))))))

  (test "commit rejects any height except the validated tip successor"
    (let* ((args (work-args))
           (data-dir (cli-data-dir args))
           (path (cli-commit-file data-dir)))
      (wallet-write-private-file path "existing private commitment bytes\n")
      (let* ((before (read-file-string path))
             (message
               (failure-message
                 (append (list "commit" "--height" "0"
                               "--solution" %height-one-source)
                         args)))
             (after (read-file-string path)))
        (assert-true (string-contains? message "commit-expired"))
        (assert-true (string-contains? message "next block (height 1)"))
        (assert-equal before after)
        (assert-equal (hash256 before) (hash256 after))
        ;; Height rejection happens before key generation or store pruning.
        (assert-equal #f (file-exists? (wallet-key-file data-dir)))))))

;; ============================================================
;; Everything that needs a private key
;; ============================================================
;;
;; secp256k1 is a native module. A workspace-wide `sigil test` run has no
;; harness binary and therefore no native bindings, so these groups are
;; gated the way `sigil-bitcoin` gates its own key-dependent suites. Run
;; this file on its own to exercise them.

(if %native-secp256k1?
  (begin

    ;; Fixed key 4 derives deterministic personalized work.
    (define %share-key (make-bytevector 32 4))
    (define %share-pubkey (wallet-public-key %share-key))
    (define %share-context
      (coin-coop-context
        parent-prev-hash: %regtest-genesis-hash
        puzzle-height: 1
        complexity: coin-genesis-complexity
        spec: %height-one-spec
        commits: '()))
    (define %share-spec (coin-share-puzzle %share-context %share-pubkey))
    (define %share-hidden (puzzle-spec-hidden-source %share-spec))

    ;; Remove safe spaces adjacent to parentheses. Parser sees parentheses as
    ;; delimiters, so this preserves behavior while producing under-par work.
    (define (golf-once source)
      (let ((n (string-length source)))
        (let loop ((i 1))
          (cond
            ((>= i (- n 1)) source)
            ((and (char=? #\space (string-ref source i))
                  (or (char=? #\( (string-ref source (+ i 1)))
                      (char=? #\) (string-ref source (- i 1)))))
             (string-append (substring source 0 i)
                            (substring source (+ i 1) n)))
            (else (loop (+ i 1)))))))

    (define %share-worse (golf-once %share-hidden))
    (define %share-best (golf-once %share-worse))
    (define %share-tied %share-best)
    (define %share-anchor
      (puzzle-print-value
        (cdr (car (reverse (puzzle-spec-examples %share-spec))))))

    (define (fixed-share-args)
      (let* ((args (work-args))
             (data-dir (cli-data-dir args)))
        (wallet-write-private-file
          (wallet-key-file data-dir)
          (string-append (hex-encode %share-key) "\n"))
        args))

    (define (height-one-share-context commits)
      (coin-coop-context
        parent-prev-hash: %regtest-genesis-hash
        puzzle-height: 1
        complexity: 128
        spec: (coin-puzzle-for %regtest-genesis-hash 1 128)
        commits: commits))

    (define (commit-solution args source)
      (quietly
        (lambda ()
          (cli-run (append (list "commit" "--solution" source) args)))))

    (define (decoded-share share-bytes)
      (let ((decoded (coin-shares-decode
                       (bytevector-append #u8(1) share-bytes))))
        (and (coin-ok? decoded) (car (coin-result-value decoded)))))

    (test-group "sigilcoin commit and reveal"
      (test "puzzle and mine use the wallet-personalized consensus task"
        (let* ((args (fixed-share-args))
               (puzzle-text
                 (run-text (append (list "puzzle" "--share") args)))
               (result (run (append (list "mine" "--share" "--solution"
                                          %share-best)
                                    args)))
               (score (car result))
               (mine-text (cdr result)))
          (assert-true (string-contains? puzzle-text
                                         "personalized-pubkey:"))
          (assert-true (string-contains? puzzle-text %share-anchor))
          (assert-true (string-contains? mine-text "share-eligible: yes"))
          (assert-true (> (cdr (assq 'quality score)) 0))))

      (test "consensus decodes and verifies the emitted blinded reveal"
        (let* ((args (fixed-share-args))
               (data-dir (cli-data-dir args))
               (record (commit-solution args %share-best))
               (secret-hex (hex-encode %share-key)))
          (fast-forward args 1)
          (let* ((result (run (append (list "reveal" "--height" "1") args)))
                 (share-bytes (car result))
                 (text (cdr result))
                 (share (decoded-share share-bytes))
                 (context (height-one-share-context
                            (list (cli-commit-record-commitment record))))
                 (quality (coin-share-quality context share)))
            (assert-true (coin-share? share))
            (assert-equal coin-share-blind-bytes
                          (bytevector-length (coin-share-blind share)))
            (assert-equal (+ coin-share-fixed-bytes
                             (string-length %share-best))
                          (bytevector-length share-bytes))
            (assert-equal (cli-commit-record-commitment record)
                          (coin-share-commitment context share))
            (assert-true (coin-share-signature-ok? context share))
            (assert-true (coin-ok?
                           (coin-check-share-solution context share)))
            (assert-true (<= 1 quality 4))
            (assert-true (string-contains?
                           text (string-append "quality: "
                                               (number->string quality))))
            (assert-true (not (string-contains? text "blind:")))
            (assert-true (not (string-contains? text secret-hex))))))

      (test "commit rides in H and selected reveal is included and paid in H+1"
        (let* ((args (fixed-share-args))
               (worse (commit-solution args %share-worse))
               (best (commit-solution args %share-best))
               (mined (run (append (list "mine" "--address"
                                          %payout-address)
                                    args)))
               (parent (car mined))
               (parent-payload-result (coin-block-coinbase-payload parent))
               (parent-payload (coin-result-value parent-payload-result))
               (commits-result
                 (coin-commits-decode
                   (coin-coinbase-payload-commits parent-payload)))
               (commits (coin-result-value commits-result)))
          (assert-true (block? parent))
          (assert-true (coin-ok? parent-payload-result))
          (assert-true (coin-ok? commits-result))
          (assert-true (member (cli-commit-record-commitment worse) commits))
          (assert-true (member (cli-commit-record-commitment best) commits))
          (let* ((revealed-bytes
                   (run-value (append (list "reveal" "--height" "1") args)))
                 (share (decoded-share revealed-bytes))
                 (context (height-one-share-context commits))
                 (carrier-script
                   (coin-address->script-pubkey "--address" %payout-address))
                 (recipient-script (coin-share-script %share-pubkey))
                 (producer-script
                   (coin-address->script-pubkey "--address" %other-address))
                 (child
                   (quietly
                     (lambda ()
                       (cli-with-node args
                         (lambda (n)
                           (let* ((height 2)
                                  (headers
                                    (list (coin-header-at-height n 0)
                                          (coin-header-at-height n 1)))
                                  (complexity
                                    (coin-required-complexity headers height))
                                  (b (coin-build-coop-block
                                       parent height complexity #f (list share)
                                       "selected reveal" producer-script
                                       (+ (block-header-time
                                            (block-header-field parent))
                                          (coin-chain-min-block-spacing
                                            (node-config n))))))
                             (node-ingest-headers n
                                                  (list (block-header-field b)))
                             (node-store-block n b)
                             (unless (= 1 (node-validate-blocks n))
                               (error (string-append
                                        "co-op block did not validate: "
                                        (node-status-snapshot-sync-last-error
                                          (node-status n)))))
                             b))))))
                 (child-payload-result (coin-block-coinbase-payload child))
                 (child-payload (coin-result-value child-payload-result))
                 (shares-result
                   (coin-shares-decode
                     (coin-coinbase-payload-shares child-payload)))
                 (included (coin-result-value shares-result))
                 (unit (coin-split-unit (coin-block-reward 2) 1)))
            ;; Default reveal chose the better stored candidate.
            (assert-equal (cli-commit-record-commitment best)
                          (coin-share-commitment context share))
            ;; H+1 carries that exact reveal and consensus accepted it.
            (assert-true (coin-ok? child-payload-result))
            (assert-true (coin-ok? shares-result))
            (assert-equal 1 (length included))
            (assert-equal revealed-bytes (coin-share-encode (car included)))
            (assert-equal 2 (tip-height args))
            ;; Recipient gets one split unit. H's producer gets H's reward
            ;; plus carrier unit for carrying both commitments.
            (assert-equal unit
                          (utxo-total (utxos-of args recipient-script)))
            (assert-equal (+ (coin-block-reward 1) unit)
                          (utxo-total (utxos-of args carrier-script)))
            (assert-equal 3
                          (length
                            (transaction-outputs
                              (car (block-transactions child))))))))

      (test "recommit keeps the first candidate and exact save is idempotent"
        (let* ((args (fixed-share-args))
               (data-dir (cli-data-dir args))
               (first (commit-solution args %share-worse))
               (again (cli-commit-save data-dir first))
               (second (commit-solution args %share-best))
               (records (cli-commit-records data-dir)))
          (assert-equal (cli-commit-record-commitment first)
                        (cli-commit-record-commitment again))
          (assert-equal 2 (length records))
          (assert-true (member (cli-commit-record-commitment first)
                               (map cli-commit-record-commitment records)))
          (assert-true (member (cli-commit-record-commitment second)
                               (map cli-commit-record-commitment records)))))

      (test "permission drift refuses recommit without changing store bytes"
        (let* ((args (fixed-share-args))
               (data-dir (cli-data-dir args))
               (path (cli-commit-file data-dir))
               (first (commit-solution args %share-worse))
               (before (read-file-string path))
               (before-hash (hash256 before)))
          (assert-true (cli-commit-record? first))
          (assert-equal 0 (process-run "chmod" "0644" path))
          (let ((message
                  (failure-message
                    (append (list "commit" "--solution" %share-best)
                            args))))
            (assert-true (string-contains? message
                                           "readable by other accounts"))
            (assert-true (string-contains? message "chmod 0600")))
          (let ((after (read-file-string path)))
            (assert-equal before after)
            (assert-equal before-hash (hash256 after)))))

      (test "expired commit height is refused without pruning the store"
        (let* ((args (fixed-share-args))
               (data-dir (cli-data-dir args))
               (path (cli-commit-file data-dir)))
          (commit-solution args %share-best)
          (fast-forward args 2)
          (let* ((before (read-file-string path))
                 (before-hash (hash256 before))
                 (message
                   (failure-message
                     (append (list "commit" "--height" "1"
                                   "--solution" %share-worse)
                             args)))
                 (after (read-file-string path)))
            (assert-true (string-contains? message "commit-expired"))
            (assert-true (string-contains? message "next block (height 3)"))
            (assert-equal before after)
            (assert-equal before-hash (hash256 after)))))

      (test "default picks best score while --commitment picks explicitly"
        (let* ((args (fixed-share-args))
               (worse (commit-solution args %share-worse))
               (best (commit-solution args %share-best)))
          (fast-forward args 1)
          (let* ((default-share
                   (decoded-share
                     (run-value (append (list "reveal" "--height" "1")
                                        args))))
                 (context (height-one-share-context
                            (map cli-commit-record-commitment
                                 (list worse best)))))
            (assert-equal (cli-commit-record-commitment best)
                          (coin-share-commitment context default-share))
            (let ((explicit-share
                    (decoded-share
                      (run-value
                        (append
                          (list "reveal" "--height" "1"
                                "--commitment"
                                (hex-encode
                                  (cli-commit-record-commitment worse)))
                          args)))))
              (assert-equal (cli-commit-record-commitment worse)
                            (coin-share-commitment context
                                                      explicit-share))))))

      (test "equal scores break deterministically on commitment bytes"
        (let* ((args (fixed-share-args))
               (a (commit-solution args %share-best))
               (b (commit-solution args %share-tied))
               (expected
                 (if (cli-bytes<?
                       (cli-commit-record-commitment a)
                       (cli-commit-record-commitment b))
                     a b)))
          (fast-forward args 1)
          (let* ((share (decoded-share
                          (run-value
                            (append (list "reveal" "--height" "1") args))))
                 (context (height-one-share-context
                            (map cli-commit-record-commitment (list a b)))))
            (assert-equal (cli-commit-record-commitment expected)
                          (coin-share-commitment context share)))))

      (test "missing expired and invalid commitments are refused"
        (let ((missing (fixed-share-args)))
          (fast-forward missing 1)
          (assert-true
            (string-contains?
              (failure-message
                (append (list "reveal" "--height" "1") missing))
              "nothing was committed"))
          (assert-true
            (string-contains?
              (failure-message
                (append (list "reveal" "--height" "1"
                              "--commitment" "00") missing))
              "exactly 32 bytes")))
        (let* ((expired (fixed-share-args))
               (data-dir (cli-data-dir expired)))
          (commit-solution expired %share-best)
          (fast-forward expired 2)
          (assert-true
            (string-contains?
              (failure-message
                (append (list "reveal" "--height" "1") expired))
              "expired"))
          (assert-equal '() (cli-commit-records data-dir)))
        (let* ((invalid (fixed-share-args))
               (data-dir (cli-data-dir invalid))
               (good (commit-solution invalid %share-best))
               (bad (cli-commit-record
                      height: 1 complexity: 128
                      parent: %regtest-genesis-hash
                      pubkey: (wallet-public-key %share-key)
                      blind: (make-bytevector 32 9)
                      commitment: (make-bytevector 32 0)
                      solution: %share-best)))
          ;; Keep only malformed record so default cannot fall back to good.
          (wallet-write-private-file (cli-commit-file data-dir) "")
          (cli-commit-save data-dir bad)
          (fast-forward invalid 1)
          (assert-true
            (string-contains?
              (failure-message
                (append (list "reveal" "--height" "1") invalid))
              "invalid"))))

      (test "one slot set is capped at the sixteen canonical commitments"
        (let* ((args (fixed-share-args))
               (data-dir (cli-data-dir args))
               (pubkey (wallet-public-key %share-key))
               (preimage (coin-share-preimage
                           %regtest-genesis-hash 1 128
                           %share-best pubkey)))
          (let loop ((n 1))
            (when (<= n coin-max-commitments)
              (let* ((blind (make-bytevector 32 n))
                     (commitment (coin-commitment preimage blind)))
                (cli-commit-save
                  data-dir
                  (cli-commit-record
                    height: 1 complexity: 128
                    parent: %regtest-genesis-hash pubkey: pubkey
                    blind: blind commitment: commitment
                    solution: %share-best))
                (loop (+ n 1)))))
          (assert-equal coin-max-commitments
                        (length (cli-commit-records data-dir)))
          (let* ((blind (make-bytevector 32 99))
                 (overflow (cli-commit-record
                             height: 1 complexity: 128
                             parent: %regtest-genesis-hash pubkey: pubkey
                             blind: blind
                             commitment: (coin-commitment preimage blind)
                             solution: %share-best)))
            (assert-true
              (string-contains?
                (raises-message
                  (lambda () (cli-commit-save data-dir overflow)))
                "sixteen")))))

      (test "the private store leaves the data directory traversable"
        (let* ((args (fixed-share-args))
               (data-dir (cli-data-dir args)))
          (assert-equal 0 (process-run "chmod" "0750" data-dir))
          (commit-solution args %share-best)
          (commit-solution args %share-worse)
          (assert-equal #o600
                        (bitwise-and
                          (stat-mode
                            (file-stat (cli-commit-file data-dir)))
                          #o777))
          (assert-equal #o700
                        (bitwise-and
                          (stat-mode
                            (file-stat (path-join data-dir "wallet")))
                          #o777))
          (assert-equal #o750
                        (bitwise-and (stat-mode (file-stat data-dir))
                                     #o777))))

      (test "commitment preimages bind branch height complexity and key"
        (let* ((pubkey (wallet-public-key %share-key))
               (base (coin-share-preimage %regtest-genesis-hash 1 128
                                              %share-best pubkey)))
          (assert-equal 32 (bytevector-length base))
          (assert-true
            (not (equal? base
                         (coin-share-preimage %regtest-genesis-hash 2 128
                                                 %share-best pubkey))))
          (assert-true
            (not (equal? base
                         (coin-share-preimage %regtest-genesis-hash 1 129
                                                 %share-best pubkey))))
          (assert-true
            (not (equal? base
                         (coin-share-preimage (make-bytevector 32 7) 1 128
                                                 %share-best pubkey)))))))

    (test-group "sigilcoin wallet addresses"
      (test "the wallet's address is derived from its own key"
        (let* ((args (fresh-args))
               (key (wallet-key (cli-data-dir args)))
               (public (wallet-public-key key)))
          (assert-true (public-key? public))
          (assert-true (string-starts-with? (coin-address public) "sgl1"))
          ;; The address, the script the wallet scans for, and the script
          ;; the address decodes to are all the same thing.
          (assert-equal (script-p2wpkh (hash160 public))
                        (wallet-script-pubkey key))
          (assert-equal (wallet-script-pubkey key)
                        (coin-address->script-pubkey "--to"
                                                     (coin-address public)))
          ;; Same key, Bitcoin's HRP: a different address. Only the HRP
          ;; differs, which is the whole of the SigilCoin-side change.
          (assert-true (not (string=? (coin-address public)
                                      (public-key->p2wpkh-address
                                        public
                                        bitcoin-mainnet))))))

      (test "the address command reports the wallet's own address"
        (let* ((args (fresh-args))
               (text (run-text (cons "address" args))))
          (assert-true (string-contains? text "address: sgl1"))
          (assert-true (string-contains? text "chain: sigilcoin-regtest"))
          (assert-true (string-contains?
                         text
                         (string-append
                           "address: "
                           (coin-address
                             (wallet-public-key
                               (wallet-key (cli-data-dir args)))))))
          ;; Stable across invocations: the key is persisted, not redrawn.
          (assert-equal text (run-text (cons "address" args))))))

    (test-group "sigilcoin key storage"
      (test "the key file is created private and reused"
        (let* ((args (fresh-args))
               (dir (cli-data-dir args))
               (path (wallet-key-file dir)))
          (assert-equal #f (file-exists? path))
          (let ((key (wallet-key dir)))
            (assert-true (file-exists? path))
            (assert-equal 32 (bytevector-length key))
            (assert-true (secp256k1-seckey-verify? key))
            ;; Owner-only: nothing for group or other.
            (assert-equal 0 (bitwise-and (stat-mode (file-stat path)) 63))
            ;; Two reads of the same wallet are the same key.
            (assert-equal key (wallet-key dir))
            ;; A second wallet is a different key: the entropy is real.
            (assert-true
              (not (equal? key
                           (wallet-key (cli-data-dir (fresh-args)))))))))

      (test "the key's own directory is locked down before the key file exists"
        ;; The file is created empty and chmodded a moment later, so for an
        ;; instant it exists under the umask's mode. A descriptor opened in
        ;; that instant keeps reading afterwards, because permissions are
        ;; checked at open. The 0700 directory is what makes the instant
        ;; unreachable from another account.
        (let* ((args (fresh-args))
               (dir (cli-data-dir args))
               (path (wallet-key-file dir))
               (key-dir (path-dirname path)))
          (wallet-key dir)
          (assert-equal 0 (bitwise-and (stat-mode (file-stat key-dir))
                                       #o077))
          (assert-equal 0 (bitwise-and (stat-mode (file-stat path)) #o077))
          ;; A key directory left group- or world-reachable is locked down
          ;; before the key file is created in it, not after.
          (let* ((other (cli-data-dir (fresh-args)))
                 (other-key-dir (path-dirname (wallet-key-file other))))
            (assert-equal 0 (process-run "mkdir" "-p" other-key-dir))
            (assert-equal 0 (process-run "chmod" "0755" other-key-dir))
            (wallet-key other)
            (assert-equal 0
                          (bitwise-and (stat-mode (file-stat other-key-dir))
                                       #o077)))))

      (test "writing a key leaves the data directory traversable"
        ;; The explorer reads `<data-dir>/<chain>.sqlite` through the group,
        ;; which needs group-execute on the data directory itself. Locking
        ;; the key used to lock that away: the key lives in its own 0700
        ;; subdirectory precisely so this bit survives.
        (let* ((args (fresh-args))
               (dir (cli-data-dir args)))
          (assert-equal 0 (process-run "chmod" "0750" dir))
          (wallet-key dir)
          (assert-equal #o750 (bitwise-and (stat-mode (file-stat dir))
                                           #o777))
          ;; The key is still private, and the group cannot even reach it.
          (assert-equal #o700
                        (bitwise-and (stat-mode
                                       (file-stat
                                         (path-dirname
                                           (wallet-key-file dir))))
                                     #o777))
          (assert-equal 0 (bitwise-and (stat-mode
                                         (file-stat (wallet-key-file dir)))
                                       #o077))))

      (test "a key at the old path is moved, not abandoned"
        (let* ((args (fresh-args))
               (dir (cli-data-dir args))
               (legacy (wallet-legacy-key-file dir))
               (path (wallet-key-file dir)))
          ;; A key written where an older build put it.
          (let ((key (wallet-key dir)))
            (assert-equal 0 (process-run "mv" path legacy))
            (assert-equal 0 (process-run "rmdir" (path-dirname path)))
            (assert-equal #f (file-exists? path))
            ;; Same coins, new location, old file gone.
            (assert-equal key (wallet-key dir))
            (assert-true (file-exists? path))
            (assert-equal #f (file-exists? legacy))
            (assert-equal 0 (bitwise-and (stat-mode (file-stat path))
                                         #o077))
            (assert-equal 0 (bitwise-and (stat-mode
                                           (file-stat (path-dirname path)))
                                         #o077)))))

      (test "a group-readable key at the old path is refused, not repaired"
        ;; The data directory is group-readable so the explorer can reach the
        ;; database, so a legacy key carrying group bits was readable by that
        ;; account. Migrating it quietly would repair the mode and hide the
        ;; exposure, leaving the operator believing a leaked key is private.
        (let* ((args (fresh-args))
               (dir (cli-data-dir args))
               (legacy (wallet-legacy-key-file dir))
               (path (wallet-key-file dir)))
          (wallet-key dir)
          (assert-equal 0 (process-run "mv" path legacy))
          (assert-equal 0 (process-run "rmdir" (path-dirname path)))
          (assert-equal 0 (process-run "chmod" "0640" legacy))
          (let ((message (raises-message (lambda () (wallet-key dir)))))
            (assert-true (string-contains? message "readable by other accounts"))
            (assert-true (string-contains? message legacy)))
          ;; Refused means untouched: not moved, not silently chmodded.
          (assert-true (file-exists? legacy))
          (assert-equal #f (file-exists? path))
          (assert-equal #o040 (bitwise-and (stat-mode (file-stat legacy))
                                           #o077))))

      (test "two keys are refused rather than one of them being stranded"
        (let* ((args (fresh-args))
               (dir (cli-data-dir args))
               (legacy (wallet-legacy-key-file dir))
               (path (wallet-key-file dir)))
          (wallet-key dir)
          (assert-equal 0 (process-run "cp" path legacy))
          (let ((message (raises-message (lambda () (wallet-key dir)))))
            (assert-true (string-contains? message "a key exists at both"))
            (assert-true (string-contains? message legacy))
            (assert-true (string-contains? message path)))))

      (test "a key file other accounts can read is refused"
        (let* ((args (fresh-args))
               (dir (cli-data-dir args))
               (path (wallet-key-file dir)))
          (wallet-key dir)
          (assert-equal 0 (process-run "chmod" "0644" path))
          (let ((message (raises-message (lambda () (wallet-key dir)))))
            (assert-true (string-contains? message
                                           "readable by other accounts"))
            (assert-true (string-contains? message "chmod 0600")))))

      (test "a corrupt key file says how to recover"
        (let* ((args (fresh-args))
               (dir (cli-data-dir args))
               (path (wallet-key-file dir)))
          (wallet-key dir)
          (write-file-string path "not hex\n")
          (assert-equal 0 (process-run "chmod" "0600" path))
          (assert-true (string-contains?
                         (raises-message (lambda () (wallet-key dir)))
                         "Move it aside"))
          ;; Right encoding, wrong length.
          (write-file-string path "0102030405\n")
          (assert-equal 0 (process-run "chmod" "0600" path))
          (assert-true (string-contains?
                         (raises-message (lambda () (wallet-key dir)))
                         "32-byte"))
          ;; Right length, not a valid scalar.
          (write-file-string path
                             (string-append (hex-encode
                                              (make-bytevector 32 0))
                                            "\n"))
          (assert-equal 0 (process-run "chmod" "0600" path))
          (assert-true (string-contains?
                         (raises-message (lambda () (wallet-key dir)))
                         "valid secp256k1")))))

    (test-group "sigilcoin wallet lifecycle"
      (test "balance matures, send confirms with fees, then sends again"
        (let* ((args (fresh-args))
               (key (wallet-key (cli-data-dir args)))
               (own (wallet-script-pubkey key))
               (recipient
                 (coin-address->script-pubkey "--to" %other-address))
               (first-block (run-value (cons "mine" args))))
          (assert-equal own
                        (txout-script-pubkey
                          (car (transaction-outputs
                                 (car (block-transactions first-block))))))
          (assert-equal (cons (coin-block-reward 1) 0)
                        (run-value (cons "balance" args)))
          (fast-forward args (- coin-coinbase-maturity 2))
          (assert-equal (- coin-coinbase-maturity 1) (tip-height args))
          (assert-equal (cons (coin-block-reward 1) 0)
                        (run-value (cons "balance" args)))
          (fast-forward args 1)
          (assert-equal (cons (coin-block-reward 1)
                              (coin-block-reward 1))
                        (run-value (cons "balance" args)))
          (let* ((sent (run (append (list "send"
                                          "--to" %other-address
                                          "--amount" "0.25"
                                          "--fee" "0.00001")
                                    args)))
                 (entry (car sent)))
            (assert-true (node-mempool-entry? entry))
            (assert-equal "available" (node-mempool-entry-status entry))
            (assert-true (string-contains? (cdr sent) "confirmations: 0"))
            (assert-equal 1 (mempool-count args)))
          (let* ((confirmed (car (mine-to args %payout-address)))
                 (txs (block-transactions confirmed)))
            (assert-equal 2 (length txs))
            (assert-equal 0 (mempool-count args))
            (assert-equal (+ (coin-block-reward
                               (+ coin-coinbase-maturity 1))
                             1000)
                          (txout-value
                            (car (transaction-outputs (car txs))))))
          (assert-equal 25000000
                        (utxo-total (utxos-of args recipient)))
          ;; Confirmed change is selectable by the real CLI again.
          (let ((entry
                  (run-value
                    (append (list "send"
                                  "--to" %other-address
                                  "--amount" "0.25")
                            args))))
            (assert-equal "available" (node-mempool-entry-status entry)))
          (let ((b (car (mine-to args %payout-address))))
            (assert-equal 2 (length (block-transactions b))))
          (assert-equal 0 (mempool-count args))
          (assert-equal 50000000
                        (utxo-total (utxos-of args recipient)))
          ;; Reuse this matured chain for exact 16KiB selection coverage.
          (let* ((row (car (utxos-of args own)))
                 (value (wallet-utxo-value row))
                 (fan 80)
                 (share (quotient (- value 1000) fan))
                 (unsigned
                   (transaction
                     version: 2
                     inputs: (list
                               (txin previous-output:
                                       (wallet-utxo-outpoint row)
                                     script-sig: #u8()
                                     sequence: #xffffffff
                                     witness: '()))
                     outputs: (let loop ((i 0) (out '()))
                                (if (>= i fan)
                                    (reverse out)
                                    (loop (+ i 1)
                                          (cons (txout value: share
                                                       script-pubkey: %purse-a)
                                                out))))
                     lock-time: 0))
                 (fanout (transaction-sign-p2wpkh-input
                           unsigned 0 value key)))
            (assert-16k-selection args fanout fan)))))

    #t)
  #t)

(run-tests)
