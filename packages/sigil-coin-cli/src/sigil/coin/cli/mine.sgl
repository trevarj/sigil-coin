;;; (sigil coin cli mine) — `puzzle`, `mine`, `commit` and `reveal`
;;;
;;; Canonical program-by-example mining commands and safe private commitment
;;; storage. Puzzle derivation and wire rules come directly from consensus.

(define-library (sigil coin cli mine)
  (import (sigil io)
          (sigil math)
          (sigil string)
          (sigil time)
          (sigil sqlite)
          (sigil secp256k1)
          (sigil bitcoin utils)
          (sigil bitcoin encoding)
          (sigil bitcoin primitives)
          (sigil bitcoin tx)
          (sigil bitcoin consensus)
          (sigil bitcoin node)
          (sigil coin puzzle)
          (sigil coin puzzle generator)
          (sigil coin puzzle constraints)
          (sigil coin consensus)
          (only (sigil coin consensus shares)
                coin-check-share-solution/spec
                coin-check-shares-cheap)
          (sigil coin node)
          (sigil coin cli history)
          (sigil coin cli args)
          (sigil coin cli wallet)
          (sigil coin cli relay)
          (sigil coin cli support))
  (export
    coin-validated-tip-height
    coin-validated-tip-header
    coin-header-at-height
    coin-puzzle-parent
    coin-puzzle-context
    coin-puzzle-report
    coin-print-puzzle
    coin-block-transaction-fee
    coin-select-block-transactions
    coin-select-verified-share-candidates
    coin-submit-block!
    run-puzzle
    run-mine
    run-contribute
    run-commit
    run-reveal)

  (begin

    ;; The tip a command works from is the best VALIDATED block, never the
    ;; best header. On this chain a header costs nothing and one whose body
    ;; nobody has can hold the best-header slot for a while; mining onto it
    ;; would build a block whose parent can never connect.
    ;;; Height of the last block the node validated.
    ;;;
    ;;; ```scheme
    ;;; (coin-validated-tip-height n) ; => 3
    ;;; ```
    (define (coin-validated-tip-height n)
      (: node? -> integer?)
      (node-status-snapshot-best-block-height (node-status n)))

    ;; The node exposes only its best HEADER, so the validated tip's header
    ;; is read out of the table the node persists it in.
    ;; A sqlite row is an alist whose keys may be strings or symbols
    ;; depending on the driver build, so look both up rather than assuming.
    (define (row-ref row key)
      (let ((pair (assoc key row)))
        (if pair
            (cdr pair)
            (let ((sym (assoc (string->symbol key) row)))
              (and sym (cdr sym))))))

    (define (header-row->header row)
      (block-header-parse (hex-decode (row-ref row "header_hex"))))

    (define (header-row-at n column value)
      (let ((rows (sqlite-query
                    (node-db n)
                    (string-append
                      "SELECT header_hex FROM headers WHERE "
                      column
                      " = ? AND valid = 1 ORDER BY height ASC LIMIT 1")
                    value)))
        (if (null? rows) #f (header-row->header (car rows)))))

    ;;; Header of the last block the node validated.
    ;;;
    ;;; Falls back to the chain's genesis on a node that has validated
    ;;; nothing yet, which is what height 1 is mined on.
    ;;;
    ;;; ```scheme
    ;;; (block-header? (coin-validated-tip-header n)) ; => #t
    ;;; ```
    (define (coin-validated-tip-header n)
      (: node? -> block-header?)
      (let ((hash (node-status-snapshot-best-block-hash (node-status n))))
        (if (string=? "" hash)
            (chain-config-genesis-header (node-config n))
            (or (header-row-at n "hash" hash)
                (error "the node's validated tip has no stored header")))))

    ;;; Header the node holds at `height` on its validated chain.
    ;;;
    ;;; ```scheme
    ;;; (block-header-time (coin-header-at-height n 1))
    ;;; ```
    (define (coin-header-at-height n height)
      (: node? integer? -> block-header?)
      (let loop ((header (coin-validated-tip-header n))
                 (current (coin-validated-tip-height n)))
        (cond ((= current height) header)
              ((<= current 0)
               (error (string-append "no header stored at height "
                                     (number->string height))))
              (else
               (let ((parent (header-row-at
                               n
                               "hash"
                               (hex-encode (block-header-previous-block
                                             header)))))
                 (unless parent
                   (error (string-append
                            "the chain is missing the header at height "
                            (number->string (- current 1)))))
                 (loop parent (- current 1)))))))

    ;;; The height a puzzle command works at and the header before it.
    ;;;
    ;;; Returns `(height . parent-header)`. The default height is the tip's
    ;;; successor, and `--height` may look BACK at a puzzle someone already
    ;;; solved but never forward past the tip, because the parent that
    ;;; derives a later puzzle does not exist yet.
    ;;;
    ;;; ```scheme
    ;;; (car (coin-puzzle-parent n '("--height" "1"))) ; => 1
    ;;; ```
    (define (coin-puzzle-parent n args)
      (: node? list? -> pair?)
      (let* ((tip (coin-validated-tip-height n))
             (height (cli-number args
                                 "--height"
                                 (number->string (+ tip 1)))))
        (when (< height 1)
          (error "--height: genesis has no puzzle to mine; the lowest minable height is 1."))
        (when (> height (+ tip 1))
          (error (string-append
                   "--height: "
                   (number->string height)
                   " is beyond the tip. The next block is height "
                   (number->string (+ tip 1))
                   "; sync further before asking about later ones.")))
        (cons height
              (if (= height (+ tip 1))
                  (coin-validated-tip-header n)
                  (coin-header-at-height n (- height 1))))))

    ;; ============================================================
    ;; Filling the block from the mempool
    ;; ============================================================
    ;;
    ;; The node's mempool policy is not the block's rules. It checks that a
    ;; transaction's inputs exist, are mature, are not double-spent and are
    ;; worth at least the outputs; it does NOT run the input scripts, and it
    ;; judged all of that against the height when the transaction arrived.
    ;; So a transaction sitting in the mempool is a CANDIDATE, and a block
    ;; that includes one the connector then rejects is a block the node marks
    ;; invalid — taking the miner's reward with it.
    ;;
    ;; Selection therefore re-checks every rule the connector applies to a
    ;; transaction, at THIS height, against the validated UTXO set, and skips
    ;; anything that does not pass rather than risking the block.

    ;; Bit 31 of a sequence number turns the relative-timelock rules off.
    (define %sequence-locktime-disable #x80000000)

    ;; The active UTXO row backing an outpoint, or #f when the validated
    ;; chain has no such unspent output. A mempool transaction spending
    ;; another mempool transaction's output lands here as #f, which is what
    ;; keeps unconfirmed chains out of the block.
    ;; ponytail: no in-block chaining; index the block's own new outputs if
    ;; chained spends ever need to confirm together.
    (define (active-utxo-row n op)
      (let ((rows (sqlite-query
                    (node-db n)
                    "SELECT value, script_pubkey, coinbase, height FROM utxos WHERE txid = ? AND output_index = ? AND active = 1"
                    (hex-encode (outpoint-txid op))
                    (outpoint-index op))))
        (if (null? rows) #f (car rows))))

    (define (utxo-row->txout row)
      (txout value: (row-ref row "value")
             script-pubkey: (hex-decode (row-ref row "script_pubkey"))))

    ;; The connector's coinbase maturity rule, read at the height the block
    ;; would occupy rather than the height the transaction arrived at.
    (define (utxo-row-spendable-at? n row height)
      (or (not (= 1 (row-ref row "coinbase")))
          (>= (- height (row-ref row "height"))
              (block-rules-coinbase-maturity
                (chain-config-block-rules (node-config n))))))

    ;; Whether an input opts into BIP68 relative timelocks, which SigilCoin
    ;; activates at height 0 and which this selection does not evaluate.
    (define (relative-timelock? tx input)
      (and (>= (transaction-version tx) 2)
           (= 0 (bitwise-and (txin-sequence input)
                             %sequence-locktime-disable))))

    ;; Every input's script, against the outputs it claims to spend. This is
    ;; the check the mempool never made, and the one a forged signature would
    ;; otherwise sail through into an invalid block.
    (define (input-scripts-valid? tx prevouts)
      (let loop ((xs prevouts) (index 0))
        (cond ((null? xs) #t)
              ((standard-input-script-valid? tx index (car xs) prevouts)
               (loop (cdr xs) (+ index 1)))
              (else #f))))

    ;;; The fee `tx` pays in the block at `height`, or `#f` when that block
    ;;; cannot include it.
    ;;;
    ;;; `spent` is the outpoints the block already spends, so a transaction
    ;;; conflicting with one already selected is refused here rather than
    ;;; making the whole block invalid. Duplicate inputs inside `tx` itself
    ;;; are caught by the same list.
    ;;;
    ;;; ```scheme
    ;;; (coin-block-transaction-fee n 102 tx '()) ; => 1000
    ;;; ```
    (define (coin-block-transaction-fee n height tx spent)
      (: node? integer? transaction? list? -> any?)
      (and (transaction? tx)
           (not (coinbase-transaction? tx))
           (pair? (transaction-inputs tx))
           (pair? (transaction-outputs tx))
           ;; A lock-time of zero is final at every height and time, so no
           ;; absolute timelock can turn this transaction invalid between
           ;; the mempool and the block.
           ;; ponytail: skips timelocked transactions rather than evaluating
           ;; the lock; evaluate it when something on this chain writes one.
           (= 0 (transaction-lock-time tx))
           (let loop ((inputs (transaction-inputs tx))
                      (seen spent)
                      (prevouts '())
                      (input-value 0))
             (if (null? inputs)
                 (let ((ordered (reverse prevouts))
                       (fee (- input-value (transaction-output-value tx))))
                   (and (>= fee 0)
                        (input-scripts-valid? tx ordered)
                        fee))
                 (let* ((input (car inputs))
                        (op (txin-previous-output input))
                        (row (and (not (wallet-outpoint-member? op seen))
                                  (not (relative-timelock? tx input))
                                  (active-utxo-row n op))))
                   (and row
                        (utxo-row-spendable-at? n row height)
                        (loop (cdr inputs)
                              (cons op seen)
                              (cons (utxo-row->txout row) prevouts)
                              (+ input-value (row-ref row "value")))))))))

    ;;; The mempool transactions the next block can carry, with their fees.
    ;;;
    ;;; Returns `(transactions . fees)`, ready for `coin-build-block`.
    ;;;
    ;;; `build` is called as `(build transactions fees)` and returns the
    ;;; block those arguments produce. Handing selection the real builder is
    ;;; what makes the size cap exact: the candidate block is serialized as
    ;;; it would be submitted, coinbase, solution and transaction count
    ;;; included, so nothing here has to model the encoding and then drift
    ;;; from it.
    ;;;
    ;;; DETERMINISTIC. The candidates arrive in the node's own mempool order
    ;;; and are taken greedily first-fit; a transaction that does not fit is
    ;;; skipped and smaller later ones are still considered, so the result is
    ;;; a function of the mempool and the UTXO set alone.
    ;;;
    ;;; ```scheme
    ;;; (car (coin-select-block-transactions n 102 build)) ; => (tx ...)
    ;;; ```
    (define (coin-select-block-transactions n height build)
      (: node? integer? procedure? -> pair?)
      (let loop ((candidates (wallet-mempool-transactions n))
                 (chosen '())
                 (spent '())
                 (fees 0))
        (if (null? candidates)
            (cons (reverse chosen) fees)
            (let* ((tx (car candidates))
                   (fee (coin-block-transaction-fee n height tx spent)))
              (if (not fee)
                  (loop (cdr candidates) chosen spent fees)
                  ;; ponytail: re-serializes the whole candidate block per
                  ;; transaction, so selection is O(n^2) in mempool size;
                  ;; track the size incrementally if a mempool ever grows
                  ;; enough for that to show up.
                  (let ((size (coin-block-size
                                (build (reverse (cons tx chosen))
                                       (+ fees fee)))))
                    (if (or (not size) (> size coin-max-block-bytes))
                        (loop (cdr candidates) chosen spent fees)
                        (loop (cdr candidates)
                              (cons tx chosen)
                              (append (map txin-previous-output
                                           (transaction-inputs tx))
                                      spent)
                              (+ fees fee)))))))))

    ;; Every block keeps its exact parent-derived timestamp, even when a
    ;; producer arrives late. An early producer waits rather than changing it.
    (define (require-spacing parent spacing)
      (let ((slot (+ (block-header-time parent) spacing))
            (now (exact (floor (current-second)))))
        (when (> slot now)
          (error (string-append
                   "mine: too early. The next slot is "
                   (number->string slot)
                   " — "
                   (number->string (- slot now))
                   " seconds away.")))
        slot))

    (define (report-ref report key)
      (cdr (assq key report)))

    ;; ============================================================
    ;; Program-by-example
    ;; ============================================================

    (define (hex bytes) (hex-encode bytes))

    (define (print-golf par length)
      (println "savings: ~a" (coin-golf-savings par length))
      (println "block-score: ~a" (coin-golf-score par length)))


    ;;; Everything a command needs for one puzzle height.
    (define (coin-puzzle-context n args)
      (: node? list? -> list?)
      (let* ((where (coin-puzzle-parent n args))
             (height (car where))
             (parent (cdr where))
             (parent-hash (block-header-hash parent))
             (history (coin-canonical-history n parent height))
             (override-text (cli-arg args "--complexity" #f))
             (override (and override-text
                            (or (string->number override-text)
                                (error (string-append
                                         "--complexity: expected a whole"
                                         " number, got \""
                                         override-text
                                         "\"")))))
             (complexity (if override
                             (cli-complexity (block-header-version parent)
                                             override)
                             (coin-required-complexity history height)))
             (bits
               (coin-required-bits
                 (chain-config-consensus-params (node-config n))
                 history)))
        (list (cons 'height height)
              (cons 'parent parent)
              (cons 'parent-hash parent-hash)
              (cons 'complexity complexity)
              (cons 'bits bits)
              (cons 'next-slot-time
                    (+ (block-header-time parent)
                       (coin-chain-min-block-spacing (node-config n))))
              (cons 'spec (coin-puzzle-for parent-hash height complexity)))))

    ;;; Everything `puzzle` reports about one  height, as an alist.
    ;;;
    ;;; Separated from the printing so a test can assert on the values
    ;;; rather than on a rendered block of text.
    ;;;
    ;;; ```scheme
    ;;; (cdr (assq 'k (coin-puzzle-report parent-hash 1 128 bits))) ; => 3
    ;;; ```
    (define (coin-puzzle-report/spec previous-hash height complexity bits spec)
      (let* ((ci (puzzle-spec-constraint spec))
             (d (coin-spec-builtin-cap spec))
             (par-witness (puzzle-spec-par-solution spec)))
        (list (cons 'height height)
              (cons 'parent (hex (reverse-bytevector previous-hash)))
              (cons 'seed (hex (coin-puzzle-seed previous-hash
                                                    height
                                                    complexity)))
              (cons 'complexity complexity)
              (cons 'bits bits)
              (cons 'tier (puzzle-complexity-tier complexity))
              (cons 'constraint ci)
              (cons 'constraint-name (puzzle-constraint-name ci))
              (cons 'constraint-rule (cli-constraint-rule ci d))
              (cons 'k (puzzle-spec-k spec))
              (cons 'examples (cli-example-lines spec))
              (cons 'par (puzzle-spec-par spec))
              (cons 'par-witness par-witness)
              (cons 'par-witness-length (coin-solution-length par-witness))
              (cons 'reward (coin-block-reward height)))))

    (define (coin-puzzle-report previous-hash height complexity bits)
      (: bytevector? integer? integer? integer? -> list?)
      (coin-puzzle-report/spec
        previous-hash height complexity bits
        (cli-puzzle previous-hash height complexity)))

    ;;; Print a  puzzle report in the CLI's `key: value` form.
    ;;;
    ;;; The order is the order a producer reads it in: examples, today's rule,
    ;;; the guaranteed-valid par witness, then its additive golf score.
    ;;;
    ;;; ```scheme
    ;;; (coin-print-puzzle (coin-puzzle-report parent-hash 1 128 bits))
    ;;; ```
    (define (coin-print-puzzle report)
      (: list? -> any?)
      (println "height: ~a" (report-ref report 'height))
      (println "parent: ~a" (report-ref report 'parent))
      (println "seed: ~a" (report-ref report 'seed))
      (let ((slot (assq 'next-slot-time report)))
        (when slot (println "next-slot-time: ~a" (cdr slot))))
      (let ((personalized (assq 'personalized-pubkey report)))
        (when personalized
          (println "personalized-pubkey: ~a" (cdr personalized))))
      (println "complexity: ~a (tier ~a)"
               (report-ref report 'complexity)
               (report-ref report 'tier))
      (println "constraint: ~a — ~a"
               (report-ref report 'constraint-name)
               (report-ref report 'constraint-rule))
      (println "examples: ~a" (report-ref report 'k))
      (for-each (lambda (line) (println "  ~a" line))
                (report-ref report 'examples))
      (println "par: ~a" (report-ref report 'par))
      (println "max-solution-bytes: ~a" coin-max-solution-bytes)
      (println "reward: ~a SGL"
               (cli-daviwils->sgl (report-ref report 'reward)))
      (println "par-witness-length: ~a"
               (report-ref report 'par-witness-length))
      (println "par-witness: ~a" (report-ref report 'par-witness))
      (println "par-witness-validity: guaranteed-valid")
      (println "solve: write a ONE-ARGUMENT function reproducing every pair above, then `sigilcoin mine~a --solution '<source>'`."
               (if (assq 'personalized-pubkey report) " --share" ""))
      (if (assq 'personalized-pubkey report)
          (println "share-rule: a share must be strictly shorter than its personalized par; savings determine contribution.")
          (print-golf (report-ref report 'par)
                      (report-ref report 'par-witness-length)))
      report)

    ;;; Show the  puzzle for the next block, or for `--height`.
    ;;;
    ;;; ```scheme
    ;;; (run-puzzle '("--regtest" "--"))
    ;;; ```
    (define (run-puzzle args)
      (: list? -> any?)
      (let* ((share? (cli-flag? args "--share"))
             (pubkey (and share?
                          (wallet-public-key
                            (wallet-key (cli-data-dir args))))))
        (cli-with-node args
          (lambda (n)
            (let* ((context (coin-puzzle-context n args))
                   (spec (if share?
                             (coin-share-puzzle
                               (share-context context '()) pubkey)
                             (report-ref context 'spec)))
                   (report
                     (cons
                       (cons 'next-slot-time
                             (report-ref context 'next-slot-time))
                       (coin-puzzle-report/spec
                         (report-ref context 'parent-hash)
                         (report-ref context 'height)
                         (report-ref context 'complexity)
                         (report-ref context 'bits)
                         spec))))
              (coin-print-puzzle
                (if share?
                    (cons (cons 'personalized-pubkey (hex pubkey)) report)
                    report)))))))

    ;; The one place a  rejection turns into a sentence. Every caller —
    ;; `mine`, `commit`, `reveal` — refuses the same solution for the same
    ;; reason with the same words, because a miner should not have to learn
    ;; three vocabularies for one rule.
    (define (require-solves who spec height solution report)
      (when (not (cdr (assq 'ok report)))
        (error (string-append
                 who
                 ": that solution does not solve height "
                 (number->string height)
                 " — "
                 (cli-solution-advice spec
                                      (cdr (assq 'reason report))
                                      (cdr (assq 'detail report))
                                      solution))))
      report)

    (define (print-resources report par)
      (let ((length (cdr (assq 'length report))))
        (println "solution-valid: yes")
        (println "solution-length: ~a" length)
        (println "par: ~a" par)
        (println "within-par: ~a" (if (<= length par) "yes" "no"))
        (println "memory: ~a cells" (cdr (assq 'cells report)))
        (println "steps: ~a" (cdr (assq 'steps report)))))

    (define (record-for-context? record context)
      (and (= (cli-commit-record-height record)
              (report-ref context 'height))
           (= (cli-commit-record-complexity record)
              (report-ref context 'complexity))
           (equal? (cli-commit-record-parent record)
                   (report-ref context 'parent-hash))))

    (define (context-commitments data-dir context)
      (cli-sort-bytes
        (map cli-commit-record-commitment
             (filter (lambda (record) (record-for-context? record context))
                     (cli-commit-records data-dir)))))

    (define (result-reason result)
      (string-append
        (symbol->string (coin-result-reason result))
        (let ((detail (coin-result-detail result)))
          (if (and (string? detail) (not (string=? detail "")))
              (string-append ": " detail)
              ""))))

    ;; Accept either one record (`commitment:` / `share:` output) or a whole
    ;; canonical push (`commits-push:` / `shares-push:` output).
    (define (decode-commit-input text)
      (guard (e (#t (cons '() "malformed hexadecimal")))
        (let* ((bytes (hex-decode text))
               (push (if (= coin-commitment-bytes (bytevector-length bytes))
                         (bytevector-append #u8(1) bytes)
                         bytes))
               (decoded (coin-commits-decode push)))
          (if (coin-ok? decoded)
              (cons (coin-result-value decoded) #f)
              (cons '() (result-reason decoded))))))

    (define (decode-share-input text)
      (guard (e (#t (cons '() "malformed hexadecimal")))
        (let* ((bytes (hex-decode text))
               (push-result (coin-shares-decode bytes))
               (decoded (if (coin-ok? push-result)
                            push-result
                            (coin-shares-decode
                              (bytevector-append #u8(1) bytes)))))
          (if (coin-ok? decoded)
              (cons (coin-result-value decoded) #f)
              (cons '() (result-reason decoded))))))

    ;; Return `(records . rejections)`. A rejection is `(id . reason)`.
    (define (decode-inputs texts prefix decode)
      (let loop ((xs texts) (index 1) (records '()) (rejected '()))
        (if (null? xs)
            (cons (reverse records) (reverse rejected))
            (let ((decoded (decode (car xs))))
              (if (cdr decoded)
                  (loop (cdr xs) (+ index 1) records
                        (cons (cons (string-append
                                     prefix "-input-" (number->string index))
                                    (cdr decoded))
                              rejected))
                  (loop (cdr xs) (+ index 1)
                        (append (reverse (car decoded)) records)
                        rejected))))))

    (define (bytes-member? value values)
      (cond ((null? values) #f)
            ((equal? value (car values)) #t)
            (else (bytes-member? value (cdr values)))))

    ;; Consensus order, exact dedup, then K16.
    (define (select-commitments values rejections)
      (let loop ((xs (cli-sort-bytes values)) (accepted '())
                 (rejected rejections))
        (cond
          ((null? xs) (cons (reverse accepted) (reverse rejected)))
          ((bytes-member? (car xs) accepted)
           (loop (cdr xs) accepted
                 (cons (cons (hex (car xs)) "duplicate") rejected)))
          ((>= (length accepted) coin-max-commitments)
           (loop (cdr xs) accepted
                 (cons (cons (hex (car xs)) "commitment cap is 16")
                       rejected)))
          (else (loop (cdr xs) (cons (car xs) accepted) rejected)))))

    (define (share-id share) (hex (coin-share-pubkey share)))

    ;; A validated candidate is `(share contribution)`.
    (define (candidate-share candidate) (car candidate))
    (define (candidate-contribution candidate) (list-ref candidate 1))

    ;; Group candidates by pubkey, with the strongest candidate first in each
    ;; group. Commitment and canonical record bytes make same-key ties stable.
    (define (same-pubkey-candidate<? context a b)
      (let* ((as (candidate-share a)) (bs (candidate-share b))
             (ap (coin-share-pubkey as)) (bp (coin-share-pubkey bs))
             (aq (candidate-contribution a))
             (bq (candidate-contribution b))
             (ac (coin-share-commitment context as))
             (bc (coin-share-commitment context bs)))
        (or (cli-bytes<? ap bp)
            (and (equal? ap bp)
                 (or (> aq bq)
                     (and (= aq bq)
                          (or (cli-bytes<? ac bc)
                              (and (equal? ac bc)
                                   (cli-bytes<? (coin-share-encode as)
                                                (coin-share-encode bs))))))))))

    ;; Final reveal admission is contribution-first. Pubkey is the only tie
    ;; breaker after same-pubkey candidates have been collapsed.
    (define (contribution-candidate<? a b)
      (let ((aq (candidate-contribution a))
            (bq (candidate-contribution b))
            (ap (coin-share-pubkey (candidate-share a)))
            (bp (coin-share-pubkey (candidate-share b))))
        (or (> aq bq)
            (and (= aq bq) (cli-bytes<? ap bp)))))

    (define (canonical-candidate<? a b)
      (cli-bytes<? (coin-share-pubkey (candidate-share a))
                   (coin-share-pubkey (candidate-share b))))

    (define (sort-candidates candidates less?)
      (let loop ((xs candidates) (out '()))
        (if (null? xs)
            out
            (loop
              (cdr xs)
              (let insert ((ys out))
                (cond ((null? ys) (list (car xs)))
                      ((less? (car xs) (car ys))
                       (cons (car xs) ys))
                      (else (cons (car ys) (insert (cdr ys))))))))))

    ;; Full consensus verification occurs once for every distinct raw reveal.
    ;; Capture its verified contribution immediately because the bounded
    ;; consensus cache is reset for the next independent candidate.
    (define (validate-share-candidates context producer shares rejections)
      (let loop ((xs shares) (seen '()) (valid '())
                 (rejected (reverse rejections)))
        (if (null? xs)
            (list (reverse valid) (reverse rejected))
            (let* ((share (car xs))
                   (wire (coin-share-encode share)))
              (if (bytes-member? wire seen)
                  (loop (cdr xs) seen valid
                        (cons (cons (share-id share)
                                    "duplicate pubkey (nonchosen valid candidate)")
                              rejected))
                  (let ((checked
                          (and context
                               (coin-check-shares
                                 context producer (list share)))))
                    (if (and checked (coin-ok? checked))
                        (loop
                          (cdr xs) (cons wire seen)
                          (cons
                            (list share
                                  (coin-share-quality context share))
                            valid)
                          rejected)
                        (loop
                          (cdr xs) (cons wire seen) valid
                          (cons
                            (cons
                              (share-id share)
                              (if checked
                                  (string-append
                                    (result-reason checked)
                                    (if (eq? (coin-result-reason checked)
                                             'share-uncommitted)
                                        " (expired or wrong branch)"
                                        ""))
                                  "no eligible parent commitments"))
                            rejected)))))))))

    ;; Keep one fully verified candidate per pubkey. The ordering above makes
    ;; this independent of reveal input order.
    (define (deduplicate-valid-pubkeys context candidates rejections)
      (let loop ((xs (sort-candidates
                       candidates
                       (lambda (a b)
                         (same-pubkey-candidate<? context a b))))
                 (previous #f)
                 (unique '())
                 (rejected (reverse rejections)))
        (if (null? xs)
            (list (reverse unique) (reverse rejected))
            (let* ((candidate (car xs))
                   (share (candidate-share candidate))
                   (pubkey (coin-share-pubkey share)))
              (if (and previous (equal? pubkey previous))
                  (loop
                    (cdr xs) previous unique
                    (cons
                      (cons (share-id share)
                            "duplicate pubkey (nonchosen valid candidate)")
                      rejected))
                  (loop (cdr xs) pubkey (cons candidate unique)
                        rejected))))))

    ;; Rank all distinct eligible candidates before applying R8. Duplicate
    ;; solutions are removed in that same rank order, then the winners are
    ;; canonicalized by pubkey while their contributions stay attached.
    (define (select-contribution-candidates producer candidates rejections)
      (let ((producer-bytes
              (if (bytevector? producer)
                  producer
                  (string->utf8 producer))))
        (let loop ((xs (sort-candidates
                         candidates contribution-candidate<?))
                   (solutions (list producer-bytes))
                   (accepted '())
                   (rejected (reverse rejections)))
          (if (null? xs)
              (list
                (sort-candidates (reverse accepted)
                                 canonical-candidate<?)
                (reverse rejected))
              (let* ((candidate (car xs))
                     (share (candidate-share candidate))
                     (solution (coin-share-solution share)))
                (cond
                  ((bytes-member? solution solutions)
                   (loop
                     (cdr xs) solutions accepted
                     (cons (cons (share-id share) "duplicate solution")
                           rejected)))
                  ((>= (length accepted) coin-max-shares)
                   (loop
                     (cdr xs) solutions accepted
                     (cons (cons (share-id share) "share cap is 8")
                           rejected)))
                  (else
                    (loop (cdr xs)
                          (cons solution solutions)
                          (cons candidate accepted)
                          rejected))))))))

    ;;; Select at most eight already-verified `(share contribution)` tuples.
    ;;;
    ;;; Selection is contribution descending with pubkey ascending as the tie
    ;;; break. The returned tuples are canonicalized by pubkey, retaining each
    ;;; contribution beside its share.
    (define (coin-select-verified-share-candidates producer candidates)
      (: any? list? -> list?)
      (list-ref
        (select-contribution-candidates producer candidates '())
        0))

    (define (validate-shares context producer shares rejections)
      (let* ((validated
               (validate-share-candidates
                 context producer shares rejections))
             (deduplicated
               (deduplicate-valid-pubkeys
                 context (list-ref validated 0) (list-ref validated 1)))
             (selected
               (select-contribution-candidates
                 producer (list-ref deduplicated 0)
                 (list-ref deduplicated 1)))
             (ordered (list-ref selected 0))
             (accepted (map candidate-share ordered))
             (contributions (map candidate-contribution ordered))
             ;; Recheck only aggregate cheap invariants. PBE/signature work
             ;; above is never repeated by CLI construction.
             (aggregate
               (and context
                    (coin-check-shares-cheap
                      context producer accepted))))
        (when (and aggregate (coin-failed? aggregate))
          (error (string-append
                   "mine: accepted reveal set failed consensus: "
                   (result-reason aggregate))))
        (list accepted contributions (list-ref selected 1)
              (coin-quality contributions))))

    (define (validated-parent-block n parent)
      (let ((rows (sqlite-query
                    (node-db n)
                    "SELECT block_hex FROM blocks WHERE hash = ? AND validated = 1 AND block_hex IS NOT NULL LIMIT 1"
                    (hex (block-header-hash parent)))))
        (and (pair? rows)
             (block-parse (hex-decode (row-ref (car rows) "block_hex"))))))

    ;; The exact serialized-size probe is also the complete final candidate.
    (define (build-block-prototype
              parent height complexity bits length solution shares contributions
              commitments producer-script carrier-script time
              txs fees)
      (let* ((coinbase
               (coin-mining-coinbase/coop
                 height solution shares contributions commitments #u8()
                 producer-script carrier-script fees))
             (transactions (cons coinbase txs)))
        (block
          header-field:
            (block-header
              version: (coin-version-encode complexity length)
              previous-block: (block-header-hash parent)
              merkle-root: (merkle-root
                             (map transaction-wtxid transactions))
              time: time
              bits: bits
              nonce: 0)
          transactions: transactions)))

    ;;; Submit once. A duplicate or retained side branch need not cause a new
    ;;; validation event; report pending bodies without calling them valid.
    (define (coin-submit-block! n b)
      (: node? block? -> block?)
      (let* ((header (block-header-field b))
             (hash (hex (block-header-hash header))))
        (node-ingest-headers n (list header))
        (node-store-block n b)
        (node-validate-blocks n)
        (let* ((rows
                 (sqlite-query
                   (node-db n)
                   "SELECT b.height, b.status, b.validated, h.work FROM blocks b JOIN headers h ON h.hash = b.hash WHERE b.hash = ? AND h.valid = 1 AND b.block_hex IS NOT NULL"
                   hash))
               (row (and (pair? rows) (car rows))))
          (unless (and row
                       (member (row-ref row "status") '("downloaded" "valid")))
            (error (string-append
                     "mine: node refused block — "
                     (node-status-snapshot-sync-last-error (node-status n)))))
          (println "chain-score: ~a" (row-ref row "work"))
          (println "validation: ~a"
                   (if (= 1 (row-ref row "validated")) "valid" "pending"))
          (println "active-chain: ~a"
                   (if (and (<= (row-ref row "height")
                                (coin-validated-tip-height n))
                            (string=? hash
                                      (hex (block-header-hash
                                             (coin-header-at-height
                                               n (row-ref row "height"))))))
                       "yes" "no")))
        b))


    (define (print-contributions commitments commit-rejected shares
                                    contributions share-rejected quality)
      (for-each (lambda (commitment)
                  (println "accepted-commitment: ~a" (hex commitment)))
                commitments)
      (for-each (lambda (entry)
                  (println "rejected-commitment: ~a reason=~a"
                           (car entry) (cdr entry)))
                commit-rejected)
      (let loop ((ss shares) (cs contributions))
        (unless (null? ss)
          (println "accepted-share: ~a contribution=~a"
                   (share-id (car ss)) (car cs))
          (loop (cdr ss) (cdr cs))))
      (for-each (lambda (entry)
                  (println "rejected-share: ~a reason=~a"
                           (car entry) (cdr entry)))
                share-rejected)
      (println "aggregate-q: ~a" quality))

    (define (print-payouts b height fees shares contributions)
      (let* ((coinbase (car (block-transactions b)))
             (outputs (transaction-outputs coinbase))
             (count (length shares))
             (minted (transaction-output-value coinbase))
             (subsidy (coin-block-reward height)))
        (let loop ((xs outputs) (index 0))
          (unless (null? xs)
            (let ((role (cond ((= index 0) "producer")
                              ((<= index count) "share")
                              (else "carrier"))))
              (println "payout: role=~a~a value=~a SGL"
                       role
                       (if (string=? role "share")
                           (string-append
                             " id=" (share-id
                                      (list-ref shares (- index 1)))
                             " contribution="
                             (number->string
                               (list-ref contributions (- index 1))))
                           "")
                       (cli-daviwils->sgl (txout-value (car xs))))
              (loop (cdr xs) (+ index 1)))))
        (println "minted: ~a SGL" (cli-daviwils->sgl minted))
        (println "unminted: ~a SGL"
                 (cli-daviwils->sgl (- (+ subsidy fees) minted)))))

    (define (relay-field response key)
      (let ((field (and (list? response) (assq key response))))
        (unless field
          (error "relay: malformed response"))
        (cdr field)))

    (define (canonical-hex text)
      (and (string? text)
           (guard (e (#t #f))
             (let ((bytes (hex-decode text)))
               (and (string=? text (hex bytes)) bytes)))))

    (define (require-relay-producer response chain context)
      (let* ((height (report-ref context 'height))
             (parent-id (hex (reverse-bytevector
                               (report-ref context 'parent-hash))))
             (complexity (report-ref context 'complexity))
             (version (relay-field response 'version))
             (response-chain (relay-field response 'chain))
             (response-height (relay-field response 'height))
             (response-parent (relay-field response 'parent_id))
             (response-complexity (relay-field response 'complexity))
             (commitment-texts (relay-field response 'commitments))
             (reveal-texts (relay-field response 'reveals)))
        (unless (and (number? version) (exact? version) (integer? version)
                     (= version 1)
                     (string? response-chain)
                     (string=? response-chain (chain-config-name chain))
                     (number? response-height) (exact? response-height)
                     (integer? response-height) (= response-height height)
                     (string? response-parent)
                     (string=? response-parent parent-id)
                     (number? response-complexity)
                     (exact? response-complexity)
                     (integer? response-complexity)
                     (= response-complexity complexity)
                     (list? commitment-texts)
                     (<= (length commitment-texts) coin-max-commitments)
                     (list? reveal-texts)
                     (<= (length reveal-texts) coin-max-commitments))
          (error "mine: relay producer context does not match the current puzzle"))
        (let ((commitments
                (map
                  (lambda (text)
                    (let ((bytes (canonical-hex text)))
                      (unless (and bytes
                                   (= (bytevector-length bytes)
                                      coin-commitment-bytes))
                        (error "mine: relay returned a malformed commitment"))
                      bytes))
                  commitment-texts))
              (shares
                (map
                  (lambda (text)
                    (let ((bytes (canonical-hex text)))
                      (unless (and bytes
                                   (<= (bytevector-length bytes)
                                       coin-max-share-bytes))
                        (error "mine: relay returned a malformed reveal"))
                      (let ((decoded (coin-shares-decode
                                      (bytevector-append #u8(1) bytes))))
                        (unless (and (coin-ok? decoded)
                                     (= 1 (length
                                            (coin-result-value decoded)))
                                     (equal?
                                       bytes
                                       (coin-share-encode
                                         (car (coin-result-value decoded)))))
                          (error "mine: relay returned a malformed reveal"))
                        (car (coin-result-value decoded)))))
                  reveal-texts)))
          ;; The consensus encoder checks both K16 and strict digest order.
          (guard (e (#t
                     (error
                       "mine: relay returned noncanonical commitments")))
            (coin-commits-encode commitments))
          (list commitments shares))))

    (define (require-relay-shares context shares)
      (for-each
        (lambda (share)
          (let ((checked
                  (and context
                       (coin-check-shares context #u8() (list share)))))
            (unless (and checked (coin-ok? checked))
              (error
                (string-append
                  "mine: relay returned an invalid reveal: "
                  (if checked
                      (result-reason checked)
                      "no eligible parent commitments"))))))
        shares)
      shares)

    ;;; Check a candidate, then submit canonical producer work.
    ;;; `--share` checks personalized work without publishing its source.
    (define (run-mine args)
      (: list? -> any?)
      (let* ((share? (cli-flag? args "--share"))
             (data-dir (cli-data-dir args))
             (chain (cli-chain args))
             (origin (relay-url args chain))
             (pubkey (and share?
                          (wallet-public-key (wallet-key data-dir)))))
        (when (and origin (not share?))
          (relay-require-curl "mine"))
        (cli-with-node args
          (lambda (n)
            (let* ((context (coin-puzzle-context n args))
                   (relay-values
                     (and origin
                          (not share?)
                          (require-relay-producer
                            (relay-producer origin chain)
                            chain context)))
                   (height (report-ref context 'height))
                   (coop (and share? (share-context context '())))
                   (spec (if share?
                             (coin-share-puzzle coop pubkey)
                             (report-ref context 'spec)))
                   (par-witness (puzzle-spec-par-solution spec))
                   (solution (cli-arg args "--solution" par-witness))
                   (report
                     (require-solves "mine" spec height solution
                                     (cli-solution-report spec solution)))
                   (length (report-ref report 'length))
                   (par (puzzle-spec-par spec))
                   (under-par? (< length par))
                   (preview-contribution
                     (if (and share? under-par?)
                         (list-ref
                           (require-share-solution
                             "mine" coop pubkey
                             (make-bytevector coin-share-blind-bytes 0)
                             solution spec)
                           3)
                         0)))
              (if share?
                  (begin
                    (println "height: ~a" height)
                    (println "next-slot-time: ~a"
                             (report-ref context 'next-slot-time))
                    (println "personalized-pubkey: ~a" (hex pubkey))
                    (println "complexity: ~a"
                             (report-ref context 'complexity))
                    (println "constraint: ~a"
                             (cli-constraint-detail
                               (puzzle-spec-constraint spec)
                               (coin-spec-builtin-cap spec)))
                    (println "examples-reproduced: ~a of ~a"
                             (puzzle-spec-k spec) (puzzle-spec-k spec))
                    (print-resources report par)
                    (println "contribution: ~a" preview-contribution)
                    (println "share-eligible: ~a"
                             (if under-par? "yes" "no"))
                    (println "submitted: no")
                    (cons (cons 'contribution preview-contribution) report))
                  (let* ((address (cli-arg args "--address" #f))
                         (parent (report-ref context 'parent))
                         (payout (if address
                                     (coin-address->script-pubkey
                                       "--address" address (node-config n))
                                     (wallet-script-pubkey
                                       (wallet-key data-dir))))
                         (time (require-spacing
                                 parent (coin-chain-min-block-spacing
                                          (node-config n))))
                         (complexity (report-ref context 'complexity))
                         (bits (report-ref context 'bits))
                         (decoded-commits
                           (decode-inputs
                             (cli-arg-list args "--commit")
                             "commit" decode-commit-input))
                         (commit-selection
                           (select-commitments
                             (append (context-commitments data-dir context)
                                     (if relay-values
                                         (list-ref relay-values 0)
                                         '())
                                     (car decoded-commits))
                             (cdr decoded-commits)))
                         (commitments (car commit-selection))
                         (decoded-shares
                           (decode-inputs
                             (cli-arg-list args "--reveal")
                             "reveal" decode-share-input))
                         (relay-share-values
                           (if relay-values
                               (list-ref relay-values 1)
                               '()))
                         (parent-block
                           (and (or (pair? relay-share-values)
                                    (pair? (car decoded-shares)))
                                (validated-parent-block n parent)))
                         (parent-context
                           (and parent-block
                                (coin-parent-context parent-block)))
                         (relay-shares
                           (if relay-values
                               (require-relay-shares
                                 parent-context relay-share-values)
                               relay-share-values))
                         (candidate-shares
                           (append relay-shares (car decoded-shares)))
                         (share-validation
                           (validate-shares
                             parent-context solution
                             candidate-shares (cdr decoded-shares)))
                         (shares (list-ref share-validation 0))
                         (contributions (list-ref share-validation 1))
                         (share-rejected (list-ref share-validation 2))
                         (quality (list-ref share-validation 3))
                         (carrier-script
                           (and (pair? shares)
                                (coin-carrier-script parent-block))))
                    (println "height: ~a" height)
                    (println "next-slot-time: ~a" time)
                    (println "complexity: ~a" complexity)
                    (println "constraint: ~a"
                             (cli-constraint-detail
                               (puzzle-spec-constraint spec)
                               (coin-spec-builtin-cap spec)))
                    (println "examples-reproduced: ~a of ~a"
                             (puzzle-spec-k spec) (puzzle-spec-k spec))
                    (print-resources report par)
                      (print-golf par length)
                      (when origin
                        (println "relay: ~a" origin)
                        (println "relay-commitments: ~a"
                                 (length (list-ref relay-values 0)))
                        (println "relay-reveals: ~a"
                                 (length (list-ref relay-values 1))))
                      (print-contributions
                        commitments (cdr commit-selection)
                        shares contributions share-rejected quality)
                      (flush-output-port (current-output-port))
                      (let* ((build
                               (lambda (txs fees)
                                 (build-block-prototype
                                   parent height complexity bits length solution
                                   shares contributions commitments
                                   payout carrier-script time txs fees)))
                             (selected
                               (coin-select-block-transactions n height build))
                             (prototype
                               (build (car selected) (cdr selected)))
                             (size (coin-block-size prototype)))
                        (unless (and size (<= size coin-max-block-bytes))
                          (error (string-append
                                   "mine: block is "
                                   (number->string (or size -1))
                                   " bytes; consensus cap is "
                                   (number->string coin-max-block-bytes))))
                        (let* ((b (coin-submit-block! n prototype))
                               (header (block-header-field b)))
                          (println "block-id: ~a" (block-header-id header))
                          (println "block-bytes: ~a" size)
                          (println "transactions: ~a"
                                   (length (car selected)))
                          (print-payouts b height (cdr selected)
                                         shares contributions)
                          (println "submitted: yes")
                          b)))))))))

    ;; ============================================================
    ;; Commit and reveal
    ;; ============================================================
    ;;
    ;; The pipeline is fixed by the fact that puzzle `H` is not knowable
    ;; until block `H-1` exists:
    ;;
    ;;   block H    carries COMMITS for puzzle H, and the producer's own
    ;;              solution for puzzle H
    ;;   block H+1  carries the reveals of puzzle H, and pays them
    ;;
    ;; So a commitment is a hash published one block before the program it
    ;; hides. A 32-byte blind keeps it hiding until consensus publishes that
    ;; blind with the reveal; branch, height, complexity, source and payout
    ;; key bind the signed preimage.

    (define (share-context context commits)
      (coin-coop-context
        parent-prev-hash: (report-ref context 'parent-hash)
        puzzle-height: (report-ref context 'height)
        complexity: (report-ref context 'complexity)
        spec: (report-ref context 'spec)
        commits: commits))

    (define (draft-share pubkey blind solution)
      (coin-share pubkey: pubkey
                     signature: (make-bytevector
                                  coin-share-signature-bytes 0)
                     blind: blind
                     solution: (string->utf8 solution)))

    ;; Preview personalized work without claiming commitment or signature
    ;; validation. Global producer solutions are not accepted as co-op shares.
    (define (require-share-solution who coop pubkey blind solution spec)
      (let* ((share (draft-share pubkey blind solution))
             (checked (coin-check-share-solution/spec spec solution)))
        (when (coin-failed? checked)
          (error
            (string-append
              who
              ": personalized share rejected as `"
              (symbol->string (coin-result-reason checked))
              "`"
              (let ((detail (coin-result-detail checked)))
                (if (and (string? detail) (not (string=? detail "")))
                    (string-append " (" detail ")")
                    ""))
              ". Run `sigilcoin puzzle --share` for your co-op task;"
              " co-op work must solve that pubkey-personalized puzzle and be strictly"
              " under its par.")))
        (list coop share spec (list-ref (coin-result-value checked) 1))))

    (define (commit-context args n pubkey)
      (let* ((context (coin-puzzle-context n args))
             (solution (cli-required
                         args "--solution" "commit"
                         "the personalized program source you are committing to"))
             (coop (share-context context '()))
             (spec (coin-share-puzzle coop pubkey))
             (checked (require-share-solution
                        "commit" coop pubkey
                        (make-bytevector coin-share-blind-bytes 0)
                        solution spec)))
        (list context solution checked)))

    ;;; Publish and retain one personalized solution commitment.
    (define (run-commit args)
      (: list? -> any?)
      (cli-chain args)
      (cli-required args "--solution" "commit"
                    "the personalized program source you are committing to")
      (let ((data-dir (cli-data-dir args)))
        (cli-with-node args
          (lambda (n)
            (let* ((tip (coin-validated-tip-height n))
                   (height (cli-number args "--height"
                                       (number->string (+ tip 1)))))
              ;; A commitment for puzzle H must ride in block H. Once H is
              ;; validated, accepting another local secret for it is useless.
              (unless (= height (+ tip 1))
                (error (string-append
                         "commit: puzzle height " (number->string height)
                         " is not the next block (height "
                         (number->string (+ tip 1))
                         "). Commitments must ride in their own puzzle block;"
                         (if (<= height tip)
                             " this commitment is expired (`commit-expired`)."
                             " sync through its parent before committing."))))
              (let* ((key (wallet-key data-dir))
                     (pubkey (wallet-public-key key))
                     (ignored (cli-commit-prune data-dir tip))
                     (parts (commit-context args n pubkey))
                     (context (list-ref parts 0))
                     (solution (list-ref parts 1))
                     (checked (list-ref parts 2))
                     (complexity (report-ref context 'complexity))
                     (parent-hash (report-ref context 'parent-hash))
                     (blind (wallet-entropy coin-share-blind-bytes))
                   (preimage (coin-share-preimage
                               parent-hash height complexity solution pubkey))
                   (commitment (coin-commitment preimage blind))
                   (record (cli-commit-save
                             data-dir
                             (cli-commit-record
                               height: height
                               complexity: complexity
                               parent: parent-hash
                               pubkey: pubkey
                               blind: blind
                               commitment: commitment
                               solution: solution)))
                   (records (cli-commit-records-for
                              data-dir height parent-hash complexity pubkey))
                   (commitments (cli-sort-bytes
                                  (map cli-commit-record-commitment
                                       records))))
              ;; Consensus encoder is also the local canonicality check.
              (coin-commits-encode commitments)
              (println "height: ~a" height)
              (println "complexity: ~a" complexity)
              (println "parent: ~a" (hex (reverse-bytevector parent-hash)))
              (println "personalized-par: ~a"
                       (puzzle-spec-par (list-ref checked 2)))
              (println "solution-length: ~a" (coin-solution-length solution))
              (println "contribution: ~a" (list-ref checked 3))
              (println "commitment: ~a" (hex commitment))
              (println "stored-candidates: ~a" (length records))
              (println "commits-push: ~a"
                       (hex (coin-commits-encode commitments)))
              (println "stored: ~a" (cli-commit-file data-dir))
              (println "next: include this commitment in block ~a, then reveal while block ~a is the validated tip."
                       height height)
              record))))))

    (define (parse-commitment-option args)
      (let ((text (cli-arg args "--commitment" #f)))
        (and text
             (let ((bytes (guard (e (#t #f)) (hex-decode text))))
               (unless (and bytes
                            (= coin-commitment-bytes
                               (bytevector-length bytes)))
                 (error "reveal: --commitment must be exactly 32 bytes of hexadecimal"))
               bytes))))

    ;; Return `(record share contribution)` for a valid stored candidate.
    (define (assess-record context pubkey record)
      (guard (e (#t #f))
        (and (equal? pubkey (cli-commit-record-pubkey record))
             (let* ((solution (cli-commit-record-solution record))
                    (blind (cli-commit-record-blind record))
                    (expected
                      (coin-commitment
                        (coin-share-preimage
                          (report-ref context 'parent-hash)
                          (report-ref context 'height)
                          (report-ref context 'complexity)
                          solution pubkey)
                        blind)))
               (and (equal? expected
                            (cli-commit-record-commitment record))
                    (let* ((coop (share-context context '()))
                           (spec (coin-share-puzzle coop pubkey))
                           (checked (require-share-solution
                                      "reveal" coop pubkey blind solution spec)))
                      (list record (list-ref checked 1)
                            (list-ref checked 3))))))))

    ;; Prefer the work worth the larger payout contribution. Exact ties use
    ;; canonical commitment bytes so local choice never depends on file order.
    (define (candidate-better? a b)
      (let ((ac (list-ref a 2))
            (bc (list-ref b 2)))
        (or (> ac bc)
            (and (= ac bc)
                 (cli-bytes<?
                   (cli-commit-record-commitment (car a))
                   (cli-commit-record-commitment (car b)))))))

    (define (select-candidate context pubkey records requested)
      (let ((eligible
              (if requested
                  (let loop ((xs records))
                    (cond
                      ((null? xs) '())
                      ((equal? requested
                               (cli-commit-record-commitment (car xs)))
                       (list (car xs)))
                      (else (loop (cdr xs)))))
                  records)))
        (when (and requested (null? eligible))
          (error "reveal: requested commitment is not stored for this puzzle, branch, complexity and key"))
        (let loop ((xs eligible) (best #f) (invalid? #f))
          (if (null? xs)
              (cond
                (best best)
                (invalid?
                 (error "reveal: stored commitment is invalid or no longer solves the personalized under-par puzzle"))
                (else #f))
              (let ((candidate (assess-record context pubkey (car xs))))
                (loop (cdr xs)
                      (if (and candidate
                               (or (not best)
                                   (candidate-better? candidate best)))
                          candidate
                          best)
                      (or invalid? (not candidate))))))))

    (define (exact-integer? value)
      (and (number? value) (exact? value) (integer? value)))

    (define (relay-puzzle-context response chain)
      (let* ((version (relay-field response 'version))
             (response-chain (relay-field response 'chain))
             (height (relay-field response 'height))
             (parent-id (relay-field response 'parent_id))
             (complexity (relay-field response 'complexity))
             (capacity (relay-field response 'capacity))
             (accepted (relay-field response 'accepted))
             (display-parent (canonical-hex parent-id)))
        (unless (and (exact-integer? version) (= version 1)
                     (string? response-chain)
                     (string=? response-chain (chain-config-name chain))
                     (exact-integer? height) (>= height 1)
                     display-parent
                     (= (bytevector-length display-parent) 32)
                     (exact-integer? complexity)
                     (<= coin-complexity-min complexity)
                     (<= complexity coin-complexity-max)
                     (exact-integer? capacity)
                     (<= 0 capacity)
                     (<= capacity coin-max-commitments)
                     (exact-integer? accepted)
                     (<= 0 accepted)
                     (<= accepted coin-max-commitments)
                     (= (+ capacity accepted) coin-max-commitments))
          (error "contribute: relay returned an invalid puzzle context"))
        (let ((parent-hash (reverse-bytevector display-parent)))
          (list (cons 'height height)
                (cons 'parent-hash parent-hash)
                (cons 'complexity complexity)
                (cons 'spec
                      (coin-puzzle-for parent-hash height complexity))))))

    (define (local-puzzle-context parent-hash height complexity)
      (unless (and (= 32 (bytevector-length parent-hash))
                   (exact-integer? height) (>= height 1)
                   (exact-integer? complexity)
                   (<= coin-complexity-min complexity)
                   (<= complexity coin-complexity-max))
        (error "contribute: stored commitment has an invalid puzzle context"))
      (list (cons 'height height)
            (cons 'parent-hash parent-hash)
            (cons 'complexity complexity)
            (cons 'spec (coin-puzzle-for parent-hash height complexity))))

    (define (parse-contribution-commitment text)
      (and text
           (let ((bytes (guard (e (#t #f)) (hex-decode text))))
             (unless (and bytes
                          (= coin-commitment-bytes
                             (bytevector-length bytes)))
               (error "contribute: --commitment must be exactly 32 bytes of hexadecimal"))
             bytes)))

    (define (stored-contribution-record data-dir commitment)
      (let ((matches
              (filter
                (lambda (record)
                  (equal? commitment
                          (cli-commit-record-commitment record)))
                (cli-commit-records data-dir))))
        (cond
          ((null? matches)
           (error "contribute: requested commitment is not stored locally"))
          ((not (null? (cdr matches)))
           (error "contribute: requested commitment has duplicate local records"))
          (else (car matches)))))

    ;; Return `(context checked)` only after the private record has been
    ;; reconstructed and its personalized solution has been checked locally.
    (define (prepare-stored-contribution record pubkey)
      (unless (equal? pubkey (cli-commit-record-pubkey record))
        (error "contribute: stored commitment belongs to another wallet key"))
      (let* ((height (cli-commit-record-height record))
             (complexity (cli-commit-record-complexity record))
             (parent-hash (cli-commit-record-parent record))
             (blind (cli-commit-record-blind record))
             (commitment (cli-commit-record-commitment record))
             (solution (cli-commit-record-solution record))
             (expected
               (coin-commitment
                 (coin-share-preimage
                   parent-hash height complexity solution pubkey)
                 blind)))
        (unless (equal? commitment expected)
          (error "contribute: stored commitment does not match its private record"))
        (let* ((context
                 (local-puzzle-context parent-hash height complexity))
               (coop (share-context context '()))
               (spec (coin-share-puzzle coop pubkey))
               (checked
                 (require-share-solution
                   "contribute" coop pubkey blind solution spec)))
          (list context checked))))

    (define (prompt-contribution-solution context pubkey spec)
      (coin-print-puzzle
        (cons
          (cons 'personalized-pubkey (hex pubkey))
          (coin-puzzle-report/spec
            (report-ref context 'parent-hash)
            (report-ref context 'height)
            (report-ref context 'complexity)
            #f
            spec)))
      (display "solution> ")
      (flush-output-port (current-output-port))
      (let ((line (read-line (current-input-port))))
        (and (not (eof-object? line))
             (not (string=? line ""))
             line)))

    (define (contribution-status? status)
      (and (string? status)
           (or (string=? status "waiting")
               (string=? status "stale")
               (string=? status "queued")
               (string=? status "commit-missed")
               (string=? status "revealable")
               (string=? status "reveal-queued")
               (string=? status "included")
               (string=? status "reveal-missed"))))

    (define (relay-null? value)
      (eq? value 'null))

    (define (canonical-block-id? value)
      (let ((bytes (canonical-hex value)))
        (and bytes (= 32 (bytevector-length bytes)))))

    (define (require-contribution-status
              response chain record expected-contribution)
      (let* ((height (cli-commit-record-height record))
             (parent-id
               (hex (reverse-bytevector
                      (cli-commit-record-parent record))))
             (commitment (hex (cli-commit-record-commitment record)))
             (pubkey (hex (cli-commit-record-pubkey record)))
             (version (relay-field response 'version))
             (response-chain (relay-field response 'chain))
             (response-height (relay-field response 'height))
             (response-parent (relay-field response 'parent_id))
             (response-complexity (relay-field response 'complexity))
             (response-commitment (relay-field response 'commitment))
             (response-pubkey (relay-field response 'pubkey))
             (status (relay-field response 'status))
             (tip-height (relay-field response 'tip_height))
             (commit-block (relay-field response 'commit_block_id))
             (reveal-block (relay-field response 'reveal_block_id))
             (contribution (relay-field response 'contribution))
             (payout (relay-field response 'payout_daviwils))
             (matures-at (relay-field response 'matures_at_height)))
        (unless
          (and (exact-integer? version) (= version 1)
               (string? response-chain)
               (string=? response-chain (chain-config-name chain))
               (exact-integer? response-height) (= response-height height)
               (string? response-parent)
               (string=? response-parent parent-id)
               (exact-integer? response-complexity)
               (= response-complexity
                  (cli-commit-record-complexity record))
               (string? response-commitment)
               (string=? response-commitment commitment)
               (string? response-pubkey)
               (string=? response-pubkey pubkey)
               (contribution-status? status)
               (exact-integer? tip-height) (>= tip-height 0)
               (or (relay-null? commit-block)
                   (canonical-block-id? commit-block))
               (or (relay-null? reveal-block)
                   (canonical-block-id? reveal-block))
               (or (relay-null? contribution)
                   (and (exact-integer? contribution)
                        (<= 1 contribution) (<= contribution 4)
                        (= contribution expected-contribution)))
               (or (relay-null? payout)
                   (and (exact-integer? payout) (>= payout 0)))
               (or (relay-null? matures-at)
                   (and (exact-integer? matures-at)
                        (>= matures-at 1))))
          (error "contribute: relay returned a contradictory contribution status"))
        (when (string=? status "revealable")
          (unless (and (= tip-height height)
                       (not (relay-null? commit-block)))
            (error "contribute: relay returned an unsafe revealable status")))
        (when (string=? status "included")
          (unless (and (not (relay-null? commit-block))
                       (not (relay-null? reveal-block))
                       (not (relay-null? contribution))
                       (not (relay-null? payout))
                       (not (relay-null? matures-at)))
            (error "contribute: relay returned an incomplete inclusion status")))
        response))

    (define (print-contribution-status response previous)
      (let ((status (relay-field response 'status)))
        (unless (and previous (string=? previous status))
          (println "status: ~a" status)
          (let ((commit-block (relay-field response 'commit_block_id))
                (reveal-block (relay-field response 'reveal_block_id))
                (payout (relay-field response 'payout_daviwils))
                (matures-at (relay-field response 'matures_at_height)))
            (unless (relay-null? commit-block)
              (println "commit-block: ~a" commit-block))
            (unless (relay-null? reveal-block)
              (println "reveal-block: ~a" reveal-block))
            (unless (relay-null? payout)
              (println "payout: ~a daviwils" payout))
            (unless (relay-null? matures-at)
              (println "matures-at-height: ~a" matures-at)))
          (flush-output-port (current-output-port)))))

    (define (signed-contribution key record context contribution)
      (let* ((pubkey (cli-commit-record-pubkey record))
             (solution (string->utf8
                         (cli-commit-record-solution record)))
             (preimage
               (coin-share-preimage
                 (cli-commit-record-parent record)
                 (cli-commit-record-height record)
                 (cli-commit-record-complexity record)
                 solution pubkey))
             (share
               (coin-share
                 pubkey: pubkey
                 signature: (secp256k1-ecdsa-sign key preimage)
                 blind: (cli-commit-record-blind record)
                 solution: solution))
             (share-bytes (coin-share-encode share))
             (push (coin-shares-encode (list share)))
             (decoded (coin-shares-decode push)))
        (unless (and (coin-ok? decoded)
                     (= 1 (length (coin-result-value decoded)))
                     (equal? share-bytes
                             (coin-share-encode
                               (car (coin-result-value decoded)))))
          (error "contribute: consensus rejected the canonical share encoding"))
        (let* ((back (car (coin-result-value decoded)))
               (verified-context
                 (share-context
                   context
                   (list (cli-commit-record-commitment record))))
               (verified
                 (coin-check-shares verified-context #u8() (list back))))
          (unless (coin-ok? verified)
            (error "contribute: consensus rejected the signed share"))
          (unless (= contribution
                     (coin-share-quality verified-context back))
            (error "contribute: signed share contribution changed"))
          share-bytes)))

    (define (terminal-contribution-status? status)
      (or (string=? status "commit-missed")
          (string=? status "reveal-missed")
          (string=? status "stale")))

    (define (watch-contribution
              origin chain key data-dir record context contribution initial)
      (let loop ((response initial) (previous #f))
        (let* ((checked
                 (require-contribution-status
                   response chain record contribution))
               (status (relay-field checked 'status)))
          (print-contribution-status checked previous)
          (cond
            ((string=? status "included")
             (cli-commit-remove
               data-dir (cli-commit-record-commitment record))
             checked)
            ((terminal-contribution-status? status)
             checked)
            ((string=? status "revealable")
             (loop
               (relay-submit-reveal
                 origin chain
                 (cli-commit-record-commitment record)
                 (signed-contribution key record context contribution))
               status))
            (else
              (sleep 10)
              (loop
                (relay-contribution-status
                  origin chain
                  (cli-commit-record-commitment record))
                status))))))

    ;;; Submit and watch one non-custodial relay contribution.
    (define (run-contribute args)
      (: list? -> any?)
      (let ((solution-option (cli-arg args "--solution" #f))
            (commitment-option (cli-arg args "--commitment" #f)))
        (when (and solution-option commitment-option)
          (error "contribute: --solution and --commitment are mutually exclusive"))
        (let* ((requested
                 (parse-contribution-commitment commitment-option))
               (chain (cli-chain args))
               (origin
                 (or (relay-url args chain)
                     (error
                       "contribute: missing --relay. Pass --relay with the pool URL."))))
          (relay-require-curl "contribute")
          ;; Fetch and validate public context before the wallet can be read
          ;; or created.
          (let* ((current-context
                   (relay-puzzle-context
                     (relay-context origin chain) chain))
                 (data-dir
                   (cli-arg args
                            "--data-dir"
                            cli-testnet-default-data-dir))
                 (key (wallet-key data-dir))
                 (pubkey (wallet-public-key key)))
            (println "relay: ~a" origin)
            (let ((prepared
                    (if requested
                        (let* ((record
                                 (stored-contribution-record
                                   data-dir requested))
                               (parts
                                 (prepare-stored-contribution
                                   record pubkey)))
                          (list record
                                (list-ref parts 0)
                                (list-ref parts 1)))
                        (let* ((context current-context)
                               (coop (share-context context '()))
                               (spec (coin-share-puzzle coop pubkey))
                               (solution
                                 (or solution-option
                                     (prompt-contribution-solution
                                       context pubkey spec))))
                          (and solution
                               (let* ((checked
                                        (require-share-solution
                                          "contribute" coop pubkey
                                          (make-bytevector
                                            coin-share-blind-bytes 0)
                                          solution spec))
                                      (blind
                                        (wallet-entropy
                                          coin-share-blind-bytes))
                                      (commitment
                                        (coin-commitment
                                          (coin-share-preimage
                                            (report-ref context 'parent-hash)
                                            (report-ref context 'height)
                                            (report-ref context 'complexity)
                                            solution pubkey)
                                          blind))
                                      ;; Persist every secret before the
                                      ;; relay receives the commitment.
                                      (record
                                        (cli-commit-save
                                          data-dir
                                          (cli-commit-record
                                            height:
                                              (report-ref context 'height)
                                            complexity:
                                              (report-ref context 'complexity)
                                            parent:
                                              (report-ref context 'parent-hash)
                                            pubkey: pubkey
                                            blind: blind
                                            commitment: commitment
                                            solution: solution))))
                                 (list record context checked)))))))
              (if (not prepared)
                  #f
                  (let* ((record (list-ref prepared 0))
                         (context (list-ref prepared 1))
                         (checked (list-ref prepared 2))
                         (height (cli-commit-record-height record))
                         (parent-hash
                           (cli-commit-record-parent record))
                         (complexity
                           (cli-commit-record-complexity record))
                         (commitment
                           (cli-commit-record-commitment record))
                         (contribution (list-ref checked 3)))
                    (println "height: ~a" height)
                    (println "parent: ~a"
                             (hex (reverse-bytevector parent-hash)))
                    (println "pubkey: ~a" (hex pubkey))
                    (println "personalized-par: ~a"
                             (puzzle-spec-par (list-ref checked 2)))
                    (println "solution-length: ~a"
                             (bytevector-length
                               (string->utf8
                                 (cli-commit-record-solution record))))
                    (println "contribution: ~a" contribution)
                    (println "commitment: ~a" (hex commitment))
                    (flush-output-port (current-output-port))
                    (let* ((authorization
                             (relay-commit-authorization
                               key chain parent-hash height complexity
                               pubkey commitment))
                           (initial
                             (relay-submit-commitment
                               origin chain height parent-hash complexity
                               pubkey commitment authorization)))
                      (require-contribution-status
                        initial chain record contribution)
                      (println "receipt: accepted")
                      (flush-output-port (current-output-port))
                      (watch-contribution
                        origin chain key data-dir record context
                        contribution initial)))))))))

    ;;; Open one commitment using consensus' reveal type and codec.
    (define (run-reveal args)
      (: list? -> any?)
      (cli-chain args)
      (let* ((data-dir (cli-data-dir args))
             (key (wallet-key data-dir))
             (pubkey (wallet-public-key key))
             (requested (parse-commitment-option args)))
        (cli-with-node args
          (lambda (n)
            (let* ((tip (coin-validated-tip-height n))
                   (height (cli-number args "--height"
                                       (number->string tip))))
              (cli-commit-prune data-dir tip)
              (cond
                ((< height tip)
                 (error (string-append
                          "reveal: puzzle height " (number->string height)
                          " expired when block "
                          (number->string (+ height 1)) " was accepted")))
                ((> height tip)
                 (error (string-append
                          "reveal: puzzle height " (number->string height)
                          " is not eligible until block "
                          (number->string height) " is accepted")))
                ((< height 1)
                 (error "reveal: no puzzle commitment is eligible at genesis")))
              (let* ((context (coin-puzzle-context
                                n (list "--height" (number->string height))))
                     (parent-hash (report-ref context 'parent-hash))
                     (complexity (report-ref context 'complexity))
                     (records (cli-commit-records-for
                                data-dir height parent-hash complexity pubkey))
                     (candidate (select-candidate
                                  context pubkey records requested)))
                (unless candidate
                  (error (string-append
                           "reveal: nothing was committed for puzzle height "
                           (number->string height)
                           " on this branch for this key (`share-uncommitted`)")))
                (let* ((record (list-ref candidate 0))
                       (unsigned (list-ref candidate 1))
                       (preimage (coin-share-preimage
                                   parent-hash height complexity
                                   (coin-share-solution unsigned) pubkey))
                       (share (coin-share
                                pubkey: pubkey
                                signature: (secp256k1-ecdsa-sign key preimage)
                                blind: (coin-share-blind unsigned)
                                solution: (coin-share-solution unsigned)))
                       (share-bytes (coin-share-encode share))
                       (push (coin-shares-encode (list share)))
                       (decoded (coin-shares-decode push)))
                  ;; Verify exact emitted bytes through consensus before any
                  ;; public solution is printed.
                  (unless (coin-ok? decoded)
                    (error "reveal: consensus rejected the emitted share encoding"))
                  (let* ((back (car (coin-result-value decoded)))
                         (verified-context
                           (share-context
                             context
                             (list (cli-commit-record-commitment record))))
                         (verified
                           (coin-check-shares verified-context #u8() (list back))))
                    (unless (coin-ok? verified)
                      (error "reveal: consensus rejected the emitted share"))
                    (unless (= (list-ref candidate 2)
                               (coin-share-quality verified-context back))
                      (error "reveal: emitted share contribution changed")))
                  (println "height: ~a" height)
                  (println "reveal-in: ~a" (+ height 1))
                  (println "parent: ~a" (hex (reverse-bytevector parent-hash)))
                  (println "complexity: ~a" complexity)
                  (println "committed: yes")
                  (println "commitment: ~a"
                           (hex (cli-commit-record-commitment record)))
                  (println "pubkey: ~a" (hex pubkey))
                  (println "signature: ~a" (hex (coin-share-signature share)))
                  (println "solution-length: ~a"
                           (bytevector-length (coin-share-solution share)))
                  (println "solution: ~a"
                           (cli-commit-record-solution record))
                  (println "contribution: ~a" (list-ref candidate 2))
                  (println "share: ~a" (hex share-bytes))
                  (println "shares-push: ~a" (hex push))
                  (println "next: hand this share to the producer of block ~a."
                           (+ height 1))
                  share-bytes)))))))))
