;;; (sigil coin cli mine) — `puzzle`, `mine`, `commit` and `reveal`
;;;
;;; Canonical program-by-example mining commands and safe private commitment
;;; storage. Puzzle derivation and wire rules come directly from consensus.

(define-library (sigil coin cli mine)
  (import (sigil io)
          (sigil math)
          (sigil string)
          (sigil time)
          (sigil sqlite)
          (sigil secp256k1)
          (sigil bitcoin utils)
          (sigil bitcoin encoding)
          (sigil bitcoin primitives)
          (sigil bitcoin tx)
          (sigil bitcoin consensus)
          (sigil bitcoin node)
          (sigil coin puzzle)
          (sigil coin puzzle generator)
          (sigil coin puzzle constraints)
          (sigil coin consensus)
          (only (sigil coin consensus shares)
                coin-check-share-solution/spec)
          (sigil coin node)
          (sigil coin cli history)
          (sigil coin cli args)
          (sigil coin cli wallet)
          (sigil coin cli support))
  (export
    coin-validated-tip-height
    coin-validated-tip-header
    coin-header-at-height
    coin-puzzle-parent
    coin-puzzle-context
    coin-puzzle-report
    coin-print-puzzle
    coin-block-transaction-fee
    coin-select-block-transactions
    run-puzzle
    run-mine
    run-commit
    run-reveal)

  (begin

    ;; The tip a command works from is the best VALIDATED block, never the
    ;; best header. On this chain a header costs nothing and one whose body
    ;; nobody has can hold the best-header slot for a while; mining onto it
    ;; would build a block whose parent can never connect.
    ;;; Height of the last block the node validated.
    ;;;
    ;;; ```scheme
    ;;; (coin-validated-tip-height n) ; => 3
    ;;; ```
    (define (coin-validated-tip-height n)
      (: node? -> integer?)
      (node-status-snapshot-best-block-height (node-status n)))

    ;; The node exposes only its best HEADER, so the validated tip's header
    ;; is read out of the table the node persists it in.
    ;; A sqlite row is an alist whose keys may be strings or symbols
    ;; depending on the driver build, so look both up rather than assuming.
    (define (row-ref row key)
      (let ((pair (assoc key row)))
        (if pair
            (cdr pair)
            (let ((sym (assoc (string->symbol key) row)))
              (and sym (cdr sym))))))

    (define (header-row->header row)
      (block-header-parse (hex-decode (row-ref row "header_hex"))))

    (define (header-row-at n column value)
      (let ((rows (sqlite-query
                    (node-db n)
                    (string-append
                      "SELECT header_hex FROM headers WHERE "
                      column
                      " = ? AND valid = 1 ORDER BY height ASC LIMIT 1")
                    value)))
        (if (null? rows) #f (header-row->header (car rows)))))

    ;;; Header of the last block the node validated.
    ;;;
    ;;; Falls back to the chain's genesis on a node that has validated
    ;;; nothing yet, which is what height 1 is mined on.
    ;;;
    ;;; ```scheme
    ;;; (block-header? (coin-validated-tip-header n)) ; => #t
    ;;; ```
    (define (coin-validated-tip-header n)
      (: node? -> block-header?)
      (let ((hash (node-status-snapshot-best-block-hash (node-status n))))
        (if (string=? "" hash)
            (chain-config-genesis-header (node-config n))
            (or (header-row-at n "hash" hash)
                (error "the node's validated tip has no stored header")))))

    ;;; Header the node holds at `height` on its validated chain.
    ;;;
    ;;; ```scheme
    ;;; (block-header-time (coin-header-at-height n 1))
    ;;; ```
    (define (coin-header-at-height n height)
      (: node? integer? -> block-header?)
      (let loop ((header (coin-validated-tip-header n))
                 (current (coin-validated-tip-height n)))
        (cond ((= current height) header)
              ((<= current 0)
               (error (string-append "no header stored at height "
                                     (number->string height))))
              (else
               (let ((parent (header-row-at
                               n
                               "hash"
                               (hex-encode (block-header-previous-block
                                             header)))))
                 (unless parent
                   (error (string-append
                            "the chain is missing the header at height "
                            (number->string (- current 1)))))
                 (loop parent (- current 1)))))))

    ;;; The height a puzzle command works at and the header before it.
    ;;;
    ;;; Returns `(height . parent-header)`. The default height is the tip's
    ;;; successor, and `--height` may look BACK at a puzzle someone already
    ;;; solved but never forward past the tip, because the parent that
    ;;; derives a later puzzle does not exist yet.
    ;;;
    ;;; ```scheme
    ;;; (car (coin-puzzle-parent n '("--height" "1"))) ; => 1
    ;;; ```
    (define (coin-puzzle-parent n args)
      (: node? list? -> pair?)
      (let* ((tip (coin-validated-tip-height n))
             (height (cli-number args
                                 "--height"
                                 (number->string (+ tip 1)))))
        (when (< height 1)
          (error "--height: genesis has no puzzle to mine; the lowest minable height is 1."))
        (when (> height (+ tip 1))
          (error (string-append
                   "--height: "
                   (number->string height)
                   " is beyond the tip. The next block is height "
                   (number->string (+ tip 1))
                   "; sync further before asking about later ones.")))
        (cons height
              (if (= height (+ tip 1))
                  (coin-validated-tip-header n)
                  (coin-header-at-height n (- height 1))))))

    ;; ============================================================
    ;; Filling the block from the mempool
    ;; ============================================================
    ;;
    ;; The node's mempool policy is not the block's rules. It checks that a
    ;; transaction's inputs exist, are mature, are not double-spent and are
    ;; worth at least the outputs; it does NOT run the input scripts, and it
    ;; judged all of that against the height when the transaction arrived.
    ;; So a transaction sitting in the mempool is a CANDIDATE, and a block
    ;; that includes one the connector then rejects is a block the node marks
    ;; invalid — taking the miner's reward with it.
    ;;
    ;; Selection therefore re-checks every rule the connector applies to a
    ;; transaction, at THIS height, against the validated UTXO set, and skips
    ;; anything that does not pass rather than risking the block.

    ;; Bit 31 of a sequence number turns the relative-timelock rules off.
    (define %sequence-locktime-disable #x80000000)

    ;; The active UTXO row backing an outpoint, or #f when the validated
    ;; chain has no such unspent output. A mempool transaction spending
    ;; another mempool transaction's output lands here as #f, which is what
    ;; keeps unconfirmed chains out of the block.
    ;; ponytail: no in-block chaining; index the block's own new outputs if
    ;; chained spends ever need to confirm together.
    (define (active-utxo-row n op)
      (let ((rows (sqlite-query
                    (node-db n)
                    "SELECT value, script_pubkey, coinbase, height FROM utxos WHERE txid = ? AND output_index = ? AND active = 1"
                    (hex-encode (outpoint-txid op))
                    (outpoint-index op))))
        (if (null? rows) #f (car rows))))

    (define (utxo-row->txout row)
      (txout value: (row-ref row "value")
             script-pubkey: (hex-decode (row-ref row "script_pubkey"))))

    ;; The connector's coinbase maturity rule, read at the height the block
    ;; would occupy rather than the height the transaction arrived at.
    (define (utxo-row-spendable-at? row height)
      (or (not (= 1 (row-ref row "coinbase")))
          (>= (- height (row-ref row "height")) coin-coinbase-maturity)))

    ;; Whether an input opts into BIP68 relative timelocks, which SigilCoin
    ;; activates at height 0 and which this selection does not evaluate.
    (define (relative-timelock? tx input)
      (and (>= (transaction-version tx) 2)
           (= 0 (bitwise-and (txin-sequence input)
                             %sequence-locktime-disable))))

    ;; Every input's script, against the outputs it claims to spend. This is
    ;; the check the mempool never made, and the one a forged signature would
    ;; otherwise sail through into an invalid block.
    (define (input-scripts-valid? tx prevouts)
      (let loop ((xs prevouts) (index 0))
        (cond ((null? xs) #t)
              ((standard-input-script-valid? tx index (car xs) prevouts)
               (loop (cdr xs) (+ index 1)))
              (else #f))))

    ;;; The fee `tx` pays in the block at `height`, or `#f` when that block
    ;;; cannot include it.
    ;;;
    ;;; `spent` is the outpoints the block already spends, so a transaction
    ;;; conflicting with one already selected is refused here rather than
    ;;; making the whole block invalid. Duplicate inputs inside `tx` itself
    ;;; are caught by the same list.
    ;;;
    ;;; ```scheme
    ;;; (coin-block-transaction-fee n 102 tx '()) ; => 1000
    ;;; ```
    (define (coin-block-transaction-fee n height tx spent)
      (: node? integer? transaction? list? -> any?)
      (and (transaction? tx)
           (not (coinbase-transaction? tx))
           ;; A lock-time of zero is final at every height and time, so no
           ;; absolute timelock can turn this transaction invalid between
           ;; the mempool and the block.
           ;; ponytail: skips timelocked transactions rather than evaluating
           ;; the lock; evaluate it when something on this chain writes one.
           (= 0 (transaction-lock-time tx))
           (let loop ((inputs (transaction-inputs tx))
                      (seen spent)
                      (prevouts '())
                      (input-value 0))
             (if (null? inputs)
                 (let ((ordered (reverse prevouts))
                       (fee (- input-value (transaction-output-value tx))))
                   (and (>= fee 0)
                        (input-scripts-valid? tx ordered)
                        fee))
                 (let* ((input (car inputs))
                        (op (txin-previous-output input))
                        (row (and (not (wallet-outpoint-member? op seen))
                                  (not (relative-timelock? tx input))
                                  (active-utxo-row n op))))
                   (and row
                        (utxo-row-spendable-at? row height)
                        (loop (cdr inputs)
                              (cons op seen)
                              (cons (utxo-row->txout row) prevouts)
                              (+ input-value (row-ref row "value")))))))))

    ;;; The mempool transactions the next block can carry, with their fees.
    ;;;
    ;;; Returns `(transactions . fees)`, ready for `coin-build-block`.
    ;;;
    ;;; `build` is called as `(build transactions fees)` and returns the
    ;;; block those arguments produce. Handing selection the real builder is
    ;;; what makes the size cap exact: the candidate block is serialized as
    ;;; it would be mined, coinbase, solution, graffiti and transaction count
    ;;; included, so nothing here has to model the encoding and then drift
    ;;; from it.
    ;;;
    ;;; DETERMINISTIC. The candidates arrive in the node's own mempool order
    ;;; and are taken greedily first-fit; a transaction that does not fit is
    ;;; skipped and smaller later ones are still considered, so the result is
    ;;; a function of the mempool and the UTXO set alone.
    ;;;
    ;;; ```scheme
    ;;; (car (coin-select-block-transactions n 102 build)) ; => (tx ...)
    ;;; ```
    (define (coin-select-block-transactions n height build)
      (: node? integer? procedure? -> pair?)
      (let loop ((candidates (wallet-mempool-transactions n))
                 (chosen '())
                 (spent '())
                 (fees 0))
        (if (null? candidates)
            (cons (reverse chosen) fees)
            (let* ((tx (car candidates))
                   (fee (coin-block-transaction-fee n height tx spent)))
              (if (not fee)
                  (loop (cdr candidates) chosen spent fees)
                  ;; ponytail: re-serializes the whole candidate block per
                  ;; transaction, so selection is O(n^2) in mempool size;
                  ;; track the size incrementally if a mempool ever grows
                  ;; enough for that to show up.
                  (let ((size (coin-block-size
                                (build (reverse (cons tx chosen))
                                       (+ fees fee)))))
                    (if (or (not size) (> size coin-max-block-bytes))
                        (loop (cdr candidates) chosen spent fees)
                        (loop (cdr candidates)
                              (cons tx chosen)
                              (append (map txin-previous-output
                                           (transaction-inputs tx))
                                      spent)
                              (+ fees fee)))))))))

    ;; Two header rules bracket the timestamp: it must clear the parent's
    ;; time by the chain's spacing floor, and it must not sit further ahead
    ;; of the clock than the future-drift allowance. Between them the
    ;; earliest legal stamp is the floor, so mine at the later of the floor
    ;; and now, and refuse only when the floor is past the drift limit —
    ;; which is the case a miner reads as "the next block is not due yet".
    ;; Refusing here rather than at ingest is the difference between a
    ;; sentence about the block schedule and one about header acceptance.
    (define (require-spacing parent spacing)
      (let ((earliest (+ (block-header-time parent) spacing))
            (now (exact (floor (current-second)))))
        (when (> earliest (+ now coin-max-future-drift))
          (error (string-append
                   "mine: too early. This chain mines a block every "
                   (number->string spacing)
                   " seconds, so the next one cannot be timestamped before "
                   (number->string earliest)
                   " — "
                   (number->string (- earliest now))
                   " seconds away, further ahead than the "
                   (number->string coin-max-future-drift)
                   "-second future-drift limit allows.")))
        (max earliest now)))

    (define (report-ref report key)
      (cdr (assq key report)))

    ;; ============================================================
    ;; Program-by-example
    ;; ============================================================

    (define (hex bytes) (hex-encode bytes))

    ;; A 32-bit score word, printed the way it is compared: unsigned, wide,
    ;; lower is better. Zero-padded so two words line up in a terminal.
    (define (score-word->string w)
      (let ((digits (number->string w 16)))
        (string-append "0x" (string-pad digits 8 #\0))))

    ;;; Everything a command needs for one puzzle height.
    (define (coin-puzzle-context n args)
      (: node? list? -> list?)
      (let* ((where (coin-puzzle-parent n args))
             (height (car where))
             (parent (cdr where))
             (parent-hash (block-header-hash parent))
             (override-text (cli-arg args "--complexity" #f))
             (override (and override-text
                            (or (string->number override-text)
                                (error (string-append
                                         "--complexity: expected a whole"
                                         " number, got \""
                                         override-text
                                         "\"")))))
             (complexity (if override
                             (cli-complexity (block-header-bits parent)
                                             override)
                             (coin-required-complexity
                               (coin-canonical-history n parent height)
                               height))))
        (list (cons 'height height)
              (cons 'parent parent)
              (cons 'parent-hash parent-hash)
              (cons 'complexity complexity)
              (cons 'spec (coin-puzzle-for parent-hash height complexity)))))

    ;;; Everything `puzzle` reports about one  height, as an alist.
    ;;;
    ;;; Separated from the printing so a test can assert on the values
    ;;; rather than on a rendered block of text.
    ;;;
    ;;; ```scheme
    ;;; (cdr (assq 'k (coin-puzzle-report parent-hash 1 128))) ; => 3
    ;;; ```
    (define (coin-puzzle-report/spec previous-hash height complexity spec)
      (let* ((ci (puzzle-spec-constraint spec))
             (d (coin-spec-builtin-cap spec))
             (fallback (puzzle-spec-table-solution spec))
             (score (cli-score-report spec fallback 0)))
        (list (cons 'height height)
              (cons 'parent (hex (reverse-bytevector previous-hash)))
              (cons 'seed (hex (coin-puzzle-seed previous-hash
                                                    height
                                                    complexity)))
              (cons 'complexity complexity)
              (cons 'tier (puzzle-complexity-tier complexity))
              (cons 'constraint ci)
              (cons 'constraint-name (puzzle-constraint-name ci))
              (cons 'constraint-rule (cli-constraint-rule ci d))
              (cons 'k (puzzle-spec-k spec))
              (cons 'examples (cli-example-lines spec))
              (cons 'par (puzzle-spec-par spec))
              (cons 'fallback fallback)
              (cons 'fallback-length (string-length fallback))
              (cons 'fallback-score (cdr (assq 'word score)))
              (cons 'reward (coin-block-reward height)))))

    (define (coin-puzzle-report previous-hash height complexity)
      (: bytevector? integer? integer? -> list?)
      (coin-puzzle-report/spec
        previous-hash height complexity
        (cli-puzzle previous-hash height complexity)))

    ;;; Print a  puzzle report in the CLI's `key: value` form.
    ;;;
    ;;; The order is the order a miner reads it in: what the pairs are, what
    ;;; today's rule is, what beating the field costs, and finally the
    ;;; fallback that guarantees the height is solvable at all.
    ;;;
    ;;; ```scheme
    ;;; (coin-print-puzzle (coin-puzzle-report parent-hash 1 128))
    ;;; ```
    (define (coin-print-puzzle report)
      (: list? -> any?)
      (println "height: ~a" (report-ref report 'height))
      (println "parent: ~a" (report-ref report 'parent))
      (println "seed: ~a" (report-ref report 'seed))
      (let ((personalized (assq 'personalized-pubkey report)))
        (when personalized
          (println "personalized-pubkey: ~a" (cdr personalized))))
      (println "complexity: ~a (tier ~a)"
               (report-ref report 'complexity)
               (report-ref report 'tier))
      (println "constraint: ~a — ~a"
               (report-ref report 'constraint-name)
               (report-ref report 'constraint-rule))
      (println "examples: ~a" (report-ref report 'k))
      (for-each (lambda (line) (println "  ~a" line))
                (report-ref report 'examples))
      (println "par: ~a" (report-ref report 'par))
      (println "max-solution-bytes: ~a" coin-max-solution-bytes)
      (println "reward: ~a SGL"
               (cli-daviwils->sgl (report-ref report 'reward)))
      (println "fallback-length: ~a" (report-ref report 'fallback-length))
      (println "fallback-score: ~a"
               (score-word->string (report-ref report 'fallback-score)))
      (println "fallback: ~a" (report-ref report 'fallback))
      (println "solve: write a ONE-ARGUMENT function reproducing every pair above, then `sigilcoin mine~a --solution '<source>'`."
               (if (assq 'personalized-pubkey report) " --share" ""))
      (println "rank: shorter wins; ties break on memory, then steps, then aggregate verified share quality.")
      report)

    ;;; Show the  puzzle for the next block, or for `--height`.
    ;;;
    ;;; ```scheme
    ;;; (run-puzzle '("--regtest" "--"))
    ;;; ```
    (define (run-puzzle args)
      (: list? -> any?)
      (let* ((share? (cli-flag? args "--share"))
             (pubkey (and share?
                          (wallet-public-key
                            (wallet-key (cli-data-dir args))))))
        (cli-with-node args
          (lambda (n)
            (let* ((context (coin-puzzle-context n args))
                   (spec (if share?
                             (coin-share-puzzle
                               (share-context context '()) pubkey)
                             (report-ref context 'spec)))
                   (report (coin-puzzle-report/spec
                             (report-ref context 'parent-hash)
                             (report-ref context 'height)
                             (report-ref context 'complexity)
                             spec)))
              (coin-print-puzzle
                (if share?
                    (cons (cons 'personalized-pubkey (hex pubkey)) report)
                    report)))))))

    ;; The one place a  rejection turns into a sentence. Every caller —
    ;; `mine`, `commit`, `reveal` — refuses the same solution for the same
    ;; reason with the same words, because a miner should not have to learn
    ;; three vocabularies for one rule.
    (define (require-solves who spec height solution score)
      (when (not (cdr (assq 'ok score)))
        (error (string-append
                 who
                 ": that solution does not solve height "
                 (number->string height)
                 " — "
                 (cli-solution-advice spec
                                         (cdr (assq 'reason score))
                                         (cdr (assq 'detail score))
                                         solution))))
      score)

    (define (print-score score par)
      (let ((length (cdr (assq 'length score))))
        (println "solution-length: ~a" length)
        (println "par: ~a" par)
        (println "beats-par: ~a" (if (< length par) "yes" "no"))
        (println "memory: ~a cells (bucket ~a)"
                 (cdr (assq 'cells score))
                 (cdr (assq 'memory-bucket score)))
        (println "steps: ~a (bucket ~a)"
                 (cdr (assq 'steps score))
                 (cdr (assq 'step-bucket score)))
        (println "quality: ~a" (cdr (assq 'quality score)))
        (println "score: ~a" (score-word->string (cdr (assq 'word score))))))

    (define (record-for-context? record context)
      (and (= (cli-commit-record-height record)
              (report-ref context 'height))
           (= (cli-commit-record-complexity record)
              (report-ref context 'complexity))
           (equal? (cli-commit-record-parent record)
                   (report-ref context 'parent-hash))))

    (define (context-commitments data-dir context)
      (cli-sort-bytes
        (map cli-commit-record-commitment
             (filter (lambda (record) (record-for-context? record context))
                     (cli-commit-records data-dir)))))

    (define (result-reason result)
      (string-append
        (symbol->string (coin-result-reason result))
        (let ((detail (coin-result-detail result)))
          (if (and (string? detail) (not (string=? detail "")))
              (string-append ": " detail)
              ""))))

    ;; Accept either one record (`commitment:` / `share:` output) or a whole
    ;; canonical push (`commits-push:` / `shares-push:` output).
    (define (decode-commit-input text)
      (guard (e (#t (cons '() "malformed hexadecimal")))
        (let* ((bytes (hex-decode text))
               (push (if (= coin-commitment-bytes (bytevector-length bytes))
                         (bytevector-append #u8(1) bytes)
                         bytes))
               (decoded (coin-commits-decode push)))
          (if (coin-ok? decoded)
              (cons (coin-result-value decoded) #f)
              (cons '() (result-reason decoded))))))

    (define (decode-share-input text)
      (guard (e (#t (cons '() "malformed hexadecimal")))
        (let* ((bytes (hex-decode text))
               (push-result (coin-shares-decode bytes))
               (decoded (if (coin-ok? push-result)
                            push-result
                            (coin-shares-decode
                              (bytevector-append #u8(1) bytes)))))
          (if (coin-ok? decoded)
              (cons (coin-result-value decoded) #f)
              (cons '() (result-reason decoded))))))

    ;; Return `(records . rejections)`. A rejection is `(id . reason)`.
    (define (decode-inputs texts prefix decode)
      (let loop ((xs texts) (index 1) (records '()) (rejected '()))
        (if (null? xs)
            (cons (reverse records) (reverse rejected))
            (let ((decoded (decode (car xs))))
              (if (cdr decoded)
                  (loop (cdr xs) (+ index 1) records
                        (cons (cons (string-append
                                     prefix "-input-" (number->string index))
                                    (cdr decoded))
                              rejected))
                  (loop (cdr xs) (+ index 1)
                        (append (reverse (car decoded)) records)
                        rejected))))))

    (define (bytes-member? value values)
      (cond ((null? values) #f)
            ((equal? value (car values)) #t)
            (else (bytes-member? value (cdr values)))))

    ;; Consensus order, exact dedup, then K16.
    (define (select-commitments values rejections)
      (let loop ((xs (cli-sort-bytes values)) (accepted '())
                 (rejected rejections))
        (cond
          ((null? xs) (cons (reverse accepted) (reverse rejected)))
          ((bytes-member? (car xs) accepted)
           (loop (cdr xs) accepted
                 (cons (cons (hex (car xs)) "duplicate") rejected)))
          ((>= (length accepted) coin-max-commitments)
           (loop (cdr xs) accepted
                 (cons (cons (hex (car xs)) "commitment cap is 16")
                       rejected)))
          (else (loop (cdr xs) (cons (car xs) accepted) rejected)))))

    (define (share-id share) (hex (coin-share-pubkey share)))

    ;; A validated candidate is `(share contribution)`. Higher consensus
    ;; contribution wins; commitment and canonical record bytes break ties.
    (define (valid-share<? context a b)
      (let* ((as (car a)) (bs (car b))
             (ap (coin-share-pubkey as)) (bp (coin-share-pubkey bs))
             (aq (list-ref a 1)) (bq (list-ref b 1))
             (ac (coin-share-commitment context as))
             (bc (coin-share-commitment context bs)))
        (or (cli-bytes<? ap bp)
            (and (equal? ap bp)
                 (or (> aq bq)
                     (and (= aq bq)
                          (or (cli-bytes<? ac bc)
                              (and (equal? ac bc)
                                   (cli-bytes<? (coin-share-encode as)
                                                (coin-share-encode bs))))))))))

    (define (sort-valid-shares context candidates)
      (let loop ((xs candidates) (out '()))
        (if (null? xs)
            out
            (loop
              (cdr xs)
              (let insert ((ys out))
                (cond ((null? ys) (list (car xs)))
                      ((valid-share<? context (car xs) (car ys))
                       (cons (car xs) ys))
                      (else (cons (car ys) (insert (cdr ys))))))))))

    ;; Validate every raw candidate before it can consume a pubkey or R8 slot.
    (define (validate-share-candidates context producer shares rejections)
      (let loop ((xs shares) (valid '())
                 (rejected (reverse rejections)))
        (if (null? xs)
            (cons (reverse valid) (reverse rejected))
            (let* ((share (car xs))
                   (checked (and context
                                 (coin-check-shares
                                   context producer (list share)))))
              (if (and checked (coin-ok? checked))
                  (loop (cdr xs)
                        (cons (list share
                                    (coin-share-quality context share))
                              valid)
                        rejected)
                  (loop (cdr xs) valid
                        (cons (cons (share-id share)
                                    (if checked
                                        (string-append
                                          (result-reason checked)
                                          (if (eq? (coin-result-reason checked)
                                                   'share-uncommitted)
                                              " (expired or wrong branch)"
                                              ""))
                                        "no eligible parent commitments"))
                              rejected)))))))

    ;; Choose one best validated candidate per pubkey, then enforce set-level
    ;; source uniqueness and R8 in canonical pubkey order.
    (define (select-valid-shares context producer validated)
      (let dedup ((xs (sort-valid-shares context (car validated)))
                  (previous #f) (unique '())
                  (rejected (reverse (cdr validated))))
        (if (null? xs)
            (let cap ((rest (reverse unique))
                      (solutions (list (string->utf8 producer)))
                      (accepted '()) (rejected rejected))
              (if (null? rest)
                  (cons (reverse accepted) (reverse rejected))
                  (let* ((share (car (car rest)))
                         (solution (coin-share-solution share)))
                    (cond
                      ((bytes-member? solution solutions)
                       (cap (cdr rest) solutions accepted
                            (cons (cons (share-id share)
                                        "duplicate solution")
                                  rejected)))
                      ((>= (length accepted) coin-max-shares)
                       (cap (cdr rest) solutions accepted
                            (cons (cons (share-id share)
                                        "share cap is 8")
                                  rejected)))
                      (else
                        (cap (cdr rest) (cons solution solutions)
                             (cons share accepted) rejected))))))
            (let* ((candidate (car xs))
                   (pubkey (coin-share-pubkey (car candidate))))
              (if (and previous (equal? pubkey previous))
                  (dedup (cdr xs) previous unique
                         (cons (cons (share-id (car candidate))
                                     "duplicate pubkey (nonchosen valid candidate)")
                               rejected))
                  (dedup (cdr xs) pubkey (cons candidate unique)
                         rejected))))))

    ;; Consensus rechecks the selected aggregate and remains final authority.
    (define (validate-shares context producer shares rejections)
      (let* ((validated (validate-share-candidates
                          context producer shares rejections))
             (selected (select-valid-shares context producer validated))
             (ordered (car selected)))
        (if (null? ordered)
            (list ordered (cdr selected) 0)
            (let ((checked (coin-check-shares context producer ordered)))
              (unless (coin-ok? checked)
                (error (string-append
                         "mine: accepted reveal set failed consensus: "
                         (result-reason checked))))
              (list ordered (cdr selected)
                    (coin-shares-quality context ordered))))))

    (define (validated-parent-block n parent)
      (let ((rows (sqlite-query
                    (node-db n)
                    "SELECT block_hex FROM blocks WHERE hash = ? AND validated = 1 AND block_hex IS NOT NULL LIMIT 1"
                    (hex (block-header-hash parent)))))
        (and (pair? rows)
             (block-parse (hex-decode (row-ref (car rows) "block_hex"))))))

    (define (print-contributions commitments commit-rejected shares
                                    share-rejected context quality)
      (for-each (lambda (commitment)
                  (println "accepted-commitment: ~a" (hex commitment)))
                commitments)
      (for-each (lambda (entry)
                  (println "rejected-commitment: ~a reason=~a"
                           (car entry) (cdr entry)))
                commit-rejected)
      (for-each (lambda (share)
                  (println "accepted-share: ~a quality=~a"
                           (share-id share)
                           (coin-share-quality context share)))
                shares)
      (for-each (lambda (entry)
                  (println "rejected-share: ~a reason=~a"
                           (car entry) (cdr entry)))
                share-rejected)
      (println "aggregate-q: ~a" quality))

    (define (print-payouts b shares)
      (let ((outputs (transaction-outputs (car (block-transactions b))))
            (count (length shares)))
        (let loop ((xs outputs) (index 0))
          (unless (null? xs)
            (let ((role (cond ((= index 0) "producer")
                              ((<= index count) "share")
                              (else "carrier"))))
              (println "payout: role=~a~a value=~a SGL"
                       role
                       (if (string=? role "share")
                           (string-append " id="
                             (share-id (list-ref shares (- index 1))))
                           "")
                       (cli-daviwils->sgl (txout-value (car xs))))
              (loop (cdr xs) (+ index 1)))))))

    ;;; Check a candidate, then submit canonical producer work.
    ;;; `--share` checks personalized work without publishing its source.
    (define (run-mine args)
      (: list? -> any?)
      (let* ((share? (cli-flag? args "--share"))
             (data-dir (cli-data-dir args))
             (pubkey (and share?
                          (wallet-public-key (wallet-key data-dir)))))
        (cli-with-node args
          (lambda (n)
            (let* ((context (coin-puzzle-context n args))
                   (height (report-ref context 'height))
                   (coop (and share? (share-context context '())))
                   (spec (if share?
                             (coin-share-puzzle coop pubkey)
                             (report-ref context 'spec)))
                   (fallback (puzzle-spec-table-solution spec))
                   (solution (cli-arg args "--solution" fallback))
                   (preliminary
                     (require-solves "mine" spec height solution
                                     (cli-score-report spec solution 0)))
                   (under-par? (< (cdr (assq 'length preliminary))
                                  (puzzle-spec-par spec)))
                   (preview-quality
                     (if (and share? under-par?)
                         (list-ref
                           (require-share-solution
                             "mine" coop pubkey
                             (make-bytevector coin-share-blind-bytes 0)
                             solution spec)
                           3)
                         0)))
              (if share?
                  (let ((score (if (= preview-quality 0)
                                   preliminary
                                   (cli-score-report
                                     spec solution preview-quality)))
                        (baseline (cli-score-report spec fallback 0)))
                    (println "height: ~a" height)
                    (println "personalized-pubkey: ~a" (hex pubkey))
                    (println "complexity: ~a"
                             (report-ref context 'complexity))
                    (println "constraint: ~a"
                             (cli-constraint-detail
                               (puzzle-spec-constraint spec)
                               (coin-spec-builtin-cap spec)))
                    (println "examples-reproduced: ~a of ~a"
                             (puzzle-spec-k spec) (puzzle-spec-k spec))
                    (print-score score (puzzle-spec-par spec))
                    (println "fallback-score: ~a"
                             (score-word->string
                               (cdr (assq 'word baseline))))
                    (println "outranks-fallback: ~a"
                             (if (coin-score-better?
                                   (cdr (assq 'word score))
                                   (cdr (assq 'word baseline)))
                                 "yes" "no"))
                    (println "share-eligible: ~a"
                             (if under-par? "yes" "no"))
                    (println "submitted: no")
                    score)
                  (let* ((address (cli-arg args "--address" #f))
                         (graffiti (cli-arg args "--graffiti" ""))
                         (payout (if address
                                     (coin-address->script-pubkey
                                       "--address" address)
                                     (wallet-script-pubkey
                                       (wallet-key data-dir))))
                         (parent (report-ref context 'parent))
                         (spacing (coin-chain-min-block-spacing
                                    (node-config n)))
                         (time (require-spacing parent spacing))
                         (decoded-commits
                           (decode-inputs
                             (cli-arg-list args "--commit")
                             "commit" decode-commit-input))
                         (commit-selection
                           (select-commitments
                             (append (context-commitments data-dir context)
                                     (car decoded-commits))
                             (cdr decoded-commits)))
                         (commitments (car commit-selection))
                         (decoded-shares
                           (decode-inputs
                             (cli-arg-list args "--reveal")
                             "reveal" decode-share-input))
                         (parent-block
                           (and (pair? (car decoded-shares))
                                (validated-parent-block n parent)))
                         (parent-context
                           (and parent-block
                                (coin-parent-context parent-block)))
                         (share-validation
                           (validate-shares
                             parent-context solution
                             (car decoded-shares) (cdr decoded-shares)))
                         (shares (list-ref share-validation 0))
                         (share-rejected (list-ref share-validation 1))
                         (quality (list-ref share-validation 2))
                         (score (if (= quality 0)
                                    preliminary
                                    (cli-score-report spec solution quality)))
                         (baseline (cli-score-report spec fallback 0)))
                    (when (> (bytevector-length (string->utf8 graffiti))
                             coin-max-graffiti-bytes)
                      (error "--graffiti: text exceeds consensus byte cap"))
                    (println "height: ~a" height)
                    (println "complexity: ~a"
                             (report-ref context 'complexity))
                    (println "constraint: ~a"
                             (cli-constraint-detail
                               (puzzle-spec-constraint spec)
                               (coin-spec-builtin-cap spec)))
                    (println "examples-reproduced: ~a of ~a"
                             (puzzle-spec-k spec) (puzzle-spec-k spec))
                    (print-score score (puzzle-spec-par spec))
                    (println "fallback-score: ~a"
                             (score-word->string
                               (cdr (assq 'word baseline))))
                    (println "outranks-fallback: ~a"
                             (if (coin-score-better?
                                   (cdr (assq 'word score))
                                   (cdr (assq 'word baseline)))
                                 "yes" "no"))
                    (print-contributions
                      commitments (cdr commit-selection)
                      shares share-rejected parent-context quality)
                    (let* ((build
                             (lambda (txs fees)
                               (if (null? shares)
                                   (coin-build-block
                                     parent height
                                     (report-ref context 'complexity)
                                     solution graffiti payout time
                                     txs fees commitments)
                                   (coin-build-coop-block
                                     parent-block height
                                     (report-ref context 'complexity)
                                     solution shares graffiti payout time
                                     txs fees commitments))))
                           (selected (coin-select-block-transactions
                                      n height build))
                           (b (build (car selected) (cdr selected)))
                           (size (coin-block-size b))
                           (header (block-header-field b)))
                      (unless (and size (<= size coin-max-block-bytes))
                        (error (string-append
                                 "mine: block is "
                                 (number->string (or size -1))
                                 " bytes; consensus cap is "
                                 (number->string coin-max-block-bytes))))
                      (node-ingest-headers n (list header))
                      (node-store-block n b)
                      (unless (= 1 (node-validate-blocks n))
                        (error (string-append
                                 "mine: node refused block — "
                                 (node-status-snapshot-sync-last-error
                                   (node-status n)))))
                      (println "block: ~a" (block-header-id header))
                      (println "block-bytes: ~a" size)
                      (println "transactions: ~a"
                               (length (car selected)))
                      (print-payouts b shares)
                      (println "submitted: yes")
                      b))))))))

    ;; ============================================================
    ;; Commit and reveal
    ;; ============================================================
    ;;
    ;; The pipeline is fixed by the fact that puzzle `H` is not knowable
    ;; until block `H-1` exists:
    ;;
    ;;   block H    carries COMMITS for puzzle H, and the producer's own
    ;;              solution for puzzle H
    ;;   block H+1  carries the reveals of puzzle H, and pays them
    ;;
    ;; So a commitment is a hash published one block before the program it
    ;; hides. A 32-byte blind keeps it hiding until consensus publishes that
    ;; blind with the reveal; branch, height, complexity, source and payout
    ;; key bind the signed preimage.

    (define (share-context context commits)
      (coin-coop-context
        parent-prev-hash: (report-ref context 'parent-hash)
        puzzle-height: (report-ref context 'height)
        complexity: (report-ref context 'complexity)
        spec: (report-ref context 'spec)
        commits: commits))

    (define (draft-share pubkey blind solution)
      (coin-share pubkey: pubkey
                     signature: (make-bytevector
                                  coin-share-signature-bytes 0)
                     blind: blind
                     solution: (string->utf8 solution)))

    ;; Preview personalized work without claiming commitment or signature
    ;; validation. Global producer solutions are not accepted as co-op shares.
    (define (require-share-solution who coop pubkey blind solution spec)
      (let* ((share (draft-share pubkey blind solution))
             (checked (coin-check-share-solution/spec spec solution)))
        (when (coin-failed? checked)
          (error
            (string-append
              who
              ": personalized share rejected as `"
              (symbol->string (coin-result-reason checked))
              "`"
              (let ((detail (coin-result-detail checked)))
                (if (and (string? detail) (not (string=? detail "")))
                    (string-append " (" detail ")")
                    ""))
              ". Run `sigilcoin puzzle --share` for your co-op task;"
              " co-op work must solve that pubkey-personalized puzzle and be strictly"
              " under its par.")))
        (let* ((quality (list-ref (coin-result-value checked) 1))
               (score (cli-score-report spec solution quality)))
          (list coop share spec quality score))))

    (define (commit-context args n pubkey)
      (let* ((context (coin-puzzle-context n args))
             (solution (cli-required
                         args "--solution" "commit"
                         "the personalized program source you are committing to"))
             (coop (share-context context '()))
             (spec (coin-share-puzzle coop pubkey))
             (checked (require-share-solution
                        "commit" coop pubkey
                        (make-bytevector coin-share-blind-bytes 0)
                        solution spec)))
        (list context solution checked)))

    ;;; Publish and retain one personalized solution commitment.
    (define (run-commit args)
      (: list? -> any?)
      (cli-chain args)
      (cli-required args "--solution" "commit"
                    "the personalized program source you are committing to")
      (let ((data-dir (cli-data-dir args)))
        (cli-with-node args
          (lambda (n)
            (let* ((tip (coin-validated-tip-height n))
                   (height (cli-number args "--height"
                                       (number->string (+ tip 1)))))
              ;; A commitment for puzzle H must ride in block H. Once H is
              ;; validated, accepting another local secret for it is useless.
              (unless (= height (+ tip 1))
                (error (string-append
                         "commit: puzzle height " (number->string height)
                         " is not the next block (height "
                         (number->string (+ tip 1))
                         "). Commitments must ride in their own puzzle block;"
                         (if (<= height tip)
                             " this commitment is expired (`commit-expired`)."
                             " sync through its parent before committing."))))
              (let* ((key (wallet-key data-dir))
                     (pubkey (wallet-public-key key))
                     (ignored (cli-commit-prune data-dir tip))
                     (parts (commit-context args n pubkey))
                     (context (list-ref parts 0))
                     (solution (list-ref parts 1))
                     (checked (list-ref parts 2))
                     (complexity (report-ref context 'complexity))
                     (parent-hash (report-ref context 'parent-hash))
                     (blind (wallet-entropy coin-share-blind-bytes))
                   (preimage (coin-share-preimage
                               parent-hash height complexity solution pubkey))
                   (commitment (coin-commitment preimage blind))
                   (record (cli-commit-save
                             data-dir
                             (cli-commit-record
                               height: height
                               complexity: complexity
                               parent: parent-hash
                               pubkey: pubkey
                               blind: blind
                               commitment: commitment
                               solution: solution)))
                   (records (cli-commit-records-for
                              data-dir height parent-hash complexity pubkey))
                   (commitments (cli-sort-bytes
                                  (map cli-commit-record-commitment
                                       records)))
                   (score (list-ref checked 4)))
              ;; Consensus encoder is also the local canonicality check.
              (coin-commits-encode commitments)
              (println "height: ~a" height)
              (println "complexity: ~a" complexity)
              (println "parent: ~a" (hex (reverse-bytevector parent-hash)))
              (println "personalized-par: ~a"
                       (puzzle-spec-par (list-ref checked 2)))
              (println "solution-length: ~a" (string-length solution))
              (println "quality: ~a" (list-ref checked 3))
              (println "score: ~a"
                       (score-word->string (cdr (assq 'word score))))
              (println "commitment: ~a" (hex commitment))
              (println "stored-candidates: ~a" (length records))
              (println "commits-push: ~a"
                       (hex (coin-commits-encode commitments)))
              (println "stored: ~a" (cli-commit-file data-dir))
              (println "next: include this commitment in block ~a, then reveal while block ~a is the validated tip."
                       height height)
              record))))))

    (define (parse-commitment-option args)
      (let ((text (cli-arg args "--commitment" #f)))
        (and text
             (let ((bytes (guard (e (#t #f)) (hex-decode text))))
               (unless (and bytes
                            (= coin-commitment-bytes
                               (bytevector-length bytes)))
                 (error "reveal: --commitment must be exactly 32 bytes of hexadecimal"))
               bytes))))

    ;; Return `(record share score quality)` for a valid stored candidate.
    (define (assess-record context pubkey record)
      (guard (e (#t #f))
        (and (equal? pubkey (cli-commit-record-pubkey record))
             (let* ((solution (cli-commit-record-solution record))
                    (blind (cli-commit-record-blind record))
                    (expected
                      (coin-commitment
                        (coin-share-preimage
                          (report-ref context 'parent-hash)
                          (report-ref context 'height)
                          (report-ref context 'complexity)
                          solution pubkey)
                        blind)))
               (and (equal? expected
                            (cli-commit-record-commitment record))
                    (let* ((coop (share-context context '()))
                           (spec (coin-share-puzzle coop pubkey))
                           (checked (require-share-solution
                                      "reveal" coop pubkey blind solution spec))
                           (share (list-ref checked 1))
                           (quality (list-ref checked 3))
                           (score (list-ref checked 4)))
                      (list record share score quality)))))))

    (define (candidate-better? a b)
      (let ((aw (cdr (assq 'word (list-ref a 2))))
            (bw (cdr (assq 'word (list-ref b 2)))))
        (or (coin-score-better? aw bw)
            (and (= aw bw)
                 (cli-bytes<?
                   (cli-commit-record-commitment (car a))
                   (cli-commit-record-commitment (car b)))))))

    (define (select-candidate context pubkey records requested)
      (let ((eligible
              (if requested
                  (let loop ((xs records))
                    (cond
                      ((null? xs) '())
                      ((equal? requested
                               (cli-commit-record-commitment (car xs)))
                       (list (car xs)))
                      (else (loop (cdr xs)))))
                  records)))
        (when (and requested (null? eligible))
          (error "reveal: requested commitment is not stored for this puzzle, branch, complexity and key"))
        (let loop ((xs eligible) (best #f) (invalid? #f))
          (if (null? xs)
              (cond
                (best best)
                (invalid?
                 (error "reveal: stored commitment is invalid or no longer solves the personalized under-par puzzle"))
                (else #f))
              (let ((candidate (assess-record context pubkey (car xs))))
                (loop (cdr xs)
                      (if (and candidate
                               (or (not best)
                                   (candidate-better? candidate best)))
                          candidate
                          best)
                      (or invalid? (not candidate))))))))

    ;;; Open one commitment using consensus' reveal type and codec.
    (define (run-reveal args)
      (: list? -> any?)
      (cli-chain args)
      (let* ((data-dir (cli-data-dir args))
             (key (wallet-key data-dir))
             (pubkey (wallet-public-key key))
             (requested (parse-commitment-option args)))
        (cli-with-node args
          (lambda (n)
            (let* ((tip (coin-validated-tip-height n))
                   (height (cli-number args "--height"
                                       (number->string tip))))
              (cli-commit-prune data-dir tip)
              (cond
                ((< height tip)
                 (error (string-append
                          "reveal: puzzle height " (number->string height)
                          " expired when block "
                          (number->string (+ height 1)) " was accepted")))
                ((> height tip)
                 (error (string-append
                          "reveal: puzzle height " (number->string height)
                          " is not eligible until block "
                          (number->string height) " is accepted")))
                ((< height 1)
                 (error "reveal: no puzzle commitment is eligible at genesis")))
              (let* ((context (coin-puzzle-context
                                n (list "--height" (number->string height))))
                     (parent-hash (report-ref context 'parent-hash))
                     (complexity (report-ref context 'complexity))
                     (records (cli-commit-records-for
                                data-dir height parent-hash complexity pubkey))
                     (candidate (select-candidate
                                  context pubkey records requested)))
                (unless candidate
                  (error (string-append
                           "reveal: nothing was committed for puzzle height "
                           (number->string height)
                           " on this branch for this key (`share-uncommitted`)")))
                (let* ((record (list-ref candidate 0))
                       (unsigned (list-ref candidate 1))
                       (preimage (coin-share-preimage
                                   parent-hash height complexity
                                   (coin-share-solution unsigned) pubkey))
                       (share (coin-share
                                pubkey: pubkey
                                signature: (secp256k1-ecdsa-sign key preimage)
                                blind: (coin-share-blind unsigned)
                                solution: (coin-share-solution unsigned)))
                       (share-bytes (coin-share-encode share))
                       (push (coin-shares-encode (list share)))
                       (decoded (coin-shares-decode push)))
                  ;; Verify exact emitted bytes through consensus before any
                  ;; public solution is printed.
                  (unless (coin-ok? decoded)
                    (error "reveal: consensus rejected the emitted share encoding"))
                  (let* ((back (car (coin-result-value decoded)))
                         (verified-context
                           (share-context
                             context
                             (list (cli-commit-record-commitment record))))
                         (verified
                           (coin-check-shares verified-context #u8() (list back))))
                    (unless (coin-ok? verified)
                      (error "reveal: consensus rejected the emitted share"))
                    (unless (= (list-ref candidate 3)
                               (coin-share-quality verified-context back))
                      (error "reveal: emitted share quality changed")))
                  (println "height: ~a" height)
                  (println "reveal-in: ~a" (+ height 1))
                  (println "parent: ~a" (hex (reverse-bytevector parent-hash)))
                  (println "complexity: ~a" complexity)
                  (println "committed: yes")
                  (println "commitment: ~a"
                           (hex (cli-commit-record-commitment record)))
                  (println "pubkey: ~a" (hex pubkey))
                  (println "signature: ~a" (hex (coin-share-signature share)))
                  (println "solution-length: ~a"
                           (bytevector-length (coin-share-solution share)))
                  (println "solution: ~a"
                           (cli-commit-record-solution record))
                  (println "quality: ~a" (list-ref candidate 3))
                  (println "score: ~a"
                           (score-word->string
                             (cdr (assq 'word (list-ref candidate 2)))))
                  (println "share: ~a" (hex share-bytes))
                  (println "shares-push: ~a" (hex push))
                  (println "next: hand this share to the producer of block ~a."
                           (+ height 1))
                  share-bytes)))))))))
