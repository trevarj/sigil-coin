;;; (sigil coin cli support) — CLI presentation and private commitment storage
;;;
;;; Consensus owns puzzle derivation, personalized shares, preimages,
;;; commitments and wire codecs. This module presents those APIs and stores
;;; unrevealed local commitments beside the wallet key.
;;;
;;; ```scheme
;;; (define spec (cli-puzzle parent-hash 1 128))
;;; (cli-solution-report spec "car")
;;; ```

(define-library (sigil coin cli support)
  (import (sigil fs)
          (sigil io)
          (sigil math)
          (sigil path)
          (sigil process)
          (sigil string)
          (sigil struct)
          (sigil bitcoin node)
          (sigil bitcoin encoding)
          (sigil coin puzzle)
          (sigil coin puzzle constraints)
          (sigil coin puzzle generator)
          (sigil coin consensus)
          (sigil coin cli wallet))
  (export
    cli-complexity
    cli-puzzle

    ;; Explaining a puzzle
    cli-constraint-rule
    cli-constraint-detail
    cli-example-lines

    ;; Checking a candidate
    cli-solution-report
    cli-mismatch-actual
    cli-solution-advice

    ;; The miner's own commitment store
    cli-commit-file
    cli-commit-record
    cli-commit-record?
    cli-commit-record-height
    cli-commit-record-complexity
    cli-commit-record-parent
    cli-commit-record-pubkey
    cli-commit-record-blind
    cli-commit-record-commitment
    cli-commit-record-solution
    cli-commit-records
    cli-commit-records-for
    cli-commit-save
    cli-commit-prune
    cli-commit-remove
    cli-bytes<?
    cli-sort-bytes)

  (begin

    ;;; The complexity `C` a puzzle at `height` is generated at.
    ;;;
    ;;; `C` is read from the parent header's canonical `bits` field.
    ;;; `override` is only for previewing another configured complexity.
    ;;;
    ;;; ```scheme
    ;;; (cli-complexity parent #f) ; => 128
    ;;; ```
    (define (cli-complexity parent-bits override)
      (: any? any? -> integer?)
      (if override
          (begin
            (unless (and (number? override)
                         (exact? override)
                         (integer? override)
                         (<= coin-complexity-min override)
                         (<= override coin-complexity-max))
              (error (string-append
                       "--complexity: expected a whole number in ["
                       (number->string coin-complexity-min)
                       ", "
                       (number->string coin-complexity-max)
                       "].")))
            override)
          (let ((decoded (coin-bits-decode parent-bits)))
            (if (coin-ok? decoded)
                (coin-result-value decoded)
                (error "puzzle: parent header has invalid complexity bits")))))

    ;;; Derive the program-by-example puzzle for a height.
    ;;;
    ;;; This is `coin-puzzle-for` with nothing added.
    ;;;
    ;;; ```scheme
    ;;; (puzzle-spec-k (cli-puzzle parent-hash 1 128)) ; => 3
    ;;; ```
    (define (cli-puzzle previous-hash height complexity)
      (: bytevector? integer? integer? -> puzzle-spec?)
      (coin-puzzle-for previous-hash height complexity))

    ;; ============================================================
    ;; Explaining the day's rule
    ;; ============================================================

    ;; One sentence per constraint, in the terms a miner is thinking in
    ;; while golfing rather than the terms the walker checks. `D` is only
    ;; used by `builtin-cap` and is threaded through for that one line.
    ;;; The day's constraint as an English rule.
    ;;;
    ;;; ```scheme
    ;;; (cli-constraint-rule 1 6)
    ;;; ; => "no digit (0-9) may appear anywhere in the source"
    ;;; ```
    (define (cli-constraint-rule ci d)
      (: integer? integer? -> string?)
      (cond
        ((= ci 0) "anything goes; there is no syntactic rule today")
        ((= ci 1) "no digit (0-9) may appear anywhere in the source")
        ((= ci 2)
         "no ' character and no (quote ...) form; build literals with (list ...) instead")
        ((= ci 3) "the program must contain at least one (letrec ...) form")
        ((= ci 4)
         (string-append
           "at most "
           (number->string d)
           " distinct builtins may be used free; a name you bind yourself with let or lambda does not count"))
        ((= ci 5) "exactly one (lambda ...) form, no more and no fewer")
        ((= ci 6)
         "every integer literal, including inside quoted data, must satisfy |n| <= 9")
        ((= ci 7)
         "the program must call the builtin `fold` at least once")
        (else "unknown constraint")))

    ;;; The constraint's consensus name and its rule, as one line.
    ;;;
    ;;; ```scheme
    ;;; (cli-constraint-detail 0 6) ; => "none — anything goes; ..."
    ;;; ```
    (define (cli-constraint-detail ci d)
      (: integer? integer? -> string?)
      (string-append (symbol->string (puzzle-constraint-name ci))
                     " — "
                     (cli-constraint-rule ci d)))

    ;;; The puzzle's example pairs, rendered one line each.
    ;;;
    ;;; ```scheme
    ;;; (car (cli-example-lines spec)) ; => "0: 3 -> 9"
    ;;; ```
    (define (cli-example-lines spec)
      (: puzzle-spec? -> list?)
      (let loop ((pairs (puzzle-spec-examples spec)) (i 0) (out '()))
        (if (null? pairs)
            (reverse out)
            (loop (cdr pairs)
                  (+ i 1)
                  (cons (string-append (number->string i)
                                       ": "
                                       (puzzle-print-value (caar pairs))
                                       " -> "
                                       (puzzle-print-value (cdar pairs)))
                        out)))))

    ;; ============================================================
    ;; Checking a candidate
    ;; ============================================================

    ;;; Check a candidate and report its validity and resource use.
    ;;;
    ;;; On success the alist carries the exact source `length`, evaluator
    ;;; `cells`, and evaluator `steps`. These are useful diagnostics, not a
    ;;; block rank: only solution length changes the nonce lottery odds.
    ;;;
    ;;; ```scheme
    ;;; (cdr (assq 'ok (cli-solution-report spec "car"))) ; => #f
    ;;; ```
    (define (cli-solution-report spec solution)
      (: puzzle-spec? any? -> list?)
      (let ((checked (coin-check-solution spec solution)))
        (if (coin-failed? checked)
            (list (cons 'ok #f)
                  (cons 'reason (coin-result-reason checked))
                  (cons 'detail (coin-result-detail checked)))
            (let ((report (coin-result-value checked)))
              (list (cons 'ok #t)
                    (cons 'length (coin-solution-length solution))
                    (cons 'cells (puzzle-report-cells report))
                    (cons 'steps (puzzle-report-steps report)))))))

    ;;; What a mismatching solution actually produced for one example.
    ;;;
    ;;; Diagnostic only, and deliberately outside the consensus path: it
    ;;; re-runs one application on a fresh machine so the failure message
    ;;; can print the wrong value next to the right one. Returns the printed
    ;;; value, or `#f` when the application itself failed.
    ;;;
    ;;; ```scheme
    ;;; (cli-mismatch-actual "car" '(1 2 3)) ; => "1"
    ;;; ```
    (define (cli-mismatch-actual solution input)
      (: any? any? -> any?)
      (let ((parsed (puzzle-parse/limit solution coin-max-solution-bytes)))
        (and (puzzle-ok? parsed)
             (let ((ran (puzzle-eval (list (puzzle-result-value parsed)
                                           (list 'quote input)))))
               (and (puzzle-ok? ran)
                    (guard (e (#t #f))
                      (puzzle-print-value (puzzle-result-value ran))))))))

    ;; The example a `solution-mismatch` detail points at. The detail is
    ;; advisory by §4.3, so it is parsed defensively and a failure to read
    ;; it costs the miner a sharper message and nothing else.
    (define (detail-index detail)
      (and (string? detail)
           (let loop ((i 0) (digits ""))
             (if (>= i (string-length detail))
                 (and (> (string-length digits) 0) (string->number digits))
                 (let ((c (string-ref detail i)))
                   (cond ((char-numeric? c)
                          (loop (+ i 1) (string-append digits (string c))))
                         ((> (string-length digits) 0)
                          (string->number digits))
                         (else (loop (+ i 1) digits))))))))

    (define (nth-pair pairs index)
      (cond ((not (number? index)) #f)
            ((null? pairs) #f)
            ((= index 0) (car pairs))
            (else (nth-pair (cdr pairs) (- index 1)))))

    ;;; Turn a canonical rejection into a sentence naming the next move.
    ;;;
    ;;; The consensus layer answers in reason symbols, which are exactly
    ;;; right for a validator and useless to someone golfing at 2am. Every
    ;;; branch here names the thing to change: which example pair did not
    ;;; come back right and what it should have been, which rule the source
    ;;; broke and what that rule says, or which cap it went over.
    ;;;
    ;;; ```scheme
    ;;; (cli-solution-advice spec 'solution-oversize "" "x")
    ;;; ; => "it is 1 byte, and the cap is 512 bytes. ..."
    ;;; ```
    (define (cli-solution-advice spec reason detail solution)
      (: puzzle-spec? any? any? any? -> string?)
      (let ((extra (if (and (string? detail) (not (string=? "" detail)))
                       (string-append " (" detail ")")
                       "")))
        (cond
          ((eq? reason 'solution-mismatch)
           (let* ((index (detail-index detail))
                  (pair (nth-pair (puzzle-spec-examples spec) index)))
             (if (not pair)
                 (string-append
                   "it does not reproduce every published example"
                   extra
                   ". Run `sigilcoin puzzle` to see the pairs.")
                 (let ((actual (cli-mismatch-actual solution (car pair))))
                   (string-append
                     "example "
                     (number->string index)
                     " came back wrong: on input "
                     (puzzle-print-value (car pair))
                     " it must return "
                     (puzzle-print-value (cdr pair))
                     (if actual
                         (string-append ", and it returned " actual)
                         ", and the application itself failed")
                     ". A solution has to reproduce ALL "
                     (number->string (puzzle-spec-k spec))
                     " pairs, not just the first ones.")))))
          ((eq? reason 'solution-not-a-procedure)
           "it does not evaluate to a one-argument procedure. A canonical solution is a FUNCTION of the puzzle's input — `(lambda(x) ...)` or a bare builtin such as `car` — not the answer itself, and a lambda taking two arguments or none is refused for the same reason.")
          ((eq? reason 'constraint-violated)
           (string-append
             "it breaks today's constraint, `"
             (symbol->string (puzzle-constraint-name
                               (puzzle-spec-constraint spec)))
             "`: "
             (cli-constraint-rule (puzzle-spec-constraint spec)
                                     (coin-spec-builtin-cap spec))
             ". The constraint rotates with the seed, so it is the same for"
             " everyone at this height and is knowable before you start."))
          ((eq? reason 'solution-over-par)
           (string-append
             "it is "
             (number->string (or (coin-solution-length solution) 0))
             " bytes, but this puzzle's par is "
             (number->string (puzzle-spec-par spec))
             " bytes (`solution-over-par`). Producer solutions cannot exceed"
             " par. Omit --solution to submit the guaranteed par witness, or"
             " shorten the program."))
          ((eq? reason 'solution-oversize)
           (string-append
             "it is "
             (number->string (or (coin-solution-length solution) 0))
             " bytes, and the cap is "
             (number->string coin-max-solution-bytes)
             " bytes. The cap is consensus, not policy; the guaranteed par"
             " witness in `sigilcoin puzzle` always fits inside it."))
          ((eq? reason 'solution-malformed)
           "it is empty or not text. Pass the program source with --solution.")
          ((eq? reason 'solution-parse-failed)
           (string-append
             "it does not parse as puzzle-lang canonical"
             extra
             ". Check the parentheses and that every name is in"
             " `puzzle-builtin-names`."))
          ((eq? reason 'solution-eval-failed)
           (string-append
             "it did not finish inside the canonical limits"
             extra
             ". One machine runs the program and all "
             (number->string (puzzle-spec-k spec))
             " applications on a shared "
             (number->string puzzle-max-fuel)
             "-step budget, so a loop that is fine on one input can still"
             " run the block out of fuel across the whole set."))
          (else
           (string-append "the check failed with "
                          (if (symbol? reason) (symbol->string reason) "an error")
                          extra
                          ".")))))

    ;; ============================================================
    ;; The miner's private commitment store
    ;; ============================================================
    ;;
    ;; One record per line. Blinds and source stay under wallet/ at mode 0600.
    ;; Records remain until their reveal height expires. Whole-file rewrites
    ;; are bounded by consensus's sixteen slots per puzzle and key.

    (define-struct cli-commit-record
      (height)
      (complexity)
      (parent)
      (pubkey)
      (blind)
      (commitment)
      (solution))

    ;;; Where a data directory keeps unrevealed commitments.
    (define (cli-commit-file data-dir)
      (: string? -> string?)
      (path-join data-dir "wallet" "commitments"))

    (define (solution-bytes solution)
      (if (bytevector? solution) solution (string->utf8 solution)))

    ;;; Lexicographic byte comparison used by canonical consensus encoders.
    (define (cli-bytes<? a b)
      (: bytevector? bytevector? -> boolean?)
      (let ((na (bytevector-length a)) (nb (bytevector-length b)))
        (let loop ((i 0))
          (cond
            ((>= i na) (< na nb))
            ((>= i nb) #f)
            ((< (bytevector-u8-ref a i) (bytevector-u8-ref b i)) #t)
            ((> (bytevector-u8-ref a i) (bytevector-u8-ref b i)) #f)
            (else (loop (+ i 1)))))))

    ;;; Sort bytevectors for consensus' strictly ascending wire order.
    (define (cli-sort-bytes values)
      (: list? -> list?)
      (let loop ((xs values) (out '()))
        (if (null? xs)
            out
            (loop
              (cdr xs)
              (let insert ((ys out))
                (cond
                  ((null? ys) (list (car xs)))
                  ((cli-bytes<? (car xs) (car ys)) (cons (car xs) ys))
                  (else (cons (car ys) (insert (cdr ys))))))))))

    (define (record->line record)
      (string-append
        (number->string (cli-commit-record-height record)) " "
        (number->string (cli-commit-record-complexity record)) " "
        (hex-encode (cli-commit-record-parent record)) " "
        (hex-encode (cli-commit-record-pubkey record)) " "
        (hex-encode (cli-commit-record-blind record)) " "
        (hex-encode (cli-commit-record-commitment record)) " "
        (hex-encode (solution-bytes
                      (cli-commit-record-solution record)))))

    (define (line->record line)
      (let ((fields (string-split (string-trim line) " ")))
        (and (= 7 (length fields))
             (guard (e (#t #f))
               (let* ((height (string->number (list-ref fields 0)))
                      (complexity (string->number (list-ref fields 1)))
                      (parent (hex-decode (list-ref fields 2)))
                      (pubkey (hex-decode (list-ref fields 3)))
                      (blind (hex-decode (list-ref fields 4)))
                      (commitment (hex-decode (list-ref fields 5)))
                      (solution (utf8->string
                                  (hex-decode (list-ref fields 6)))))
                 (and (number? height) (exact? height) (integer? height)
                      (>= height 0)
                      (number? complexity) (exact? complexity)
                      (integer? complexity)
                      (= 32 (bytevector-length parent))
                      (= coin-share-pubkey-bytes
                         (bytevector-length pubkey))
                      (= coin-share-blind-bytes
                         (bytevector-length blind))
                      (= coin-commitment-bytes
                         (bytevector-length commitment))
                      (<= 1 (bytevector-length (solution-bytes solution)))
                      (<= (bytevector-length (solution-bytes solution))
                          coin-max-solution-bytes)
                      (cli-commit-record
                        height: height
                        complexity: complexity
                        parent: parent
                        pubkey: pubkey
                        blind: blind
                        commitment: commitment
                        solution: solution)))))))

    ;;; Every parseable stored commitment, oldest first.
    (define (cli-commit-records data-dir)
      (: string? -> list?)
      (let ((path (cli-commit-file data-dir)))
        (if (not (file-exists? path))
            '()
            (let loop ((lines (string-split
                                (wallet-read-private-file path) "\n"))
                       (out '()))
              (cond
                ((null? lines) (reverse out))
                ((string=? "" (string-trim (car lines)))
                 (loop (cdr lines) out))
                (else
                  (let ((record (line->record (car lines))))
                    (loop (cdr lines)
                          (if record (cons record out) out)))))))))

    (define (same-slot? a b)
      (and (= (cli-commit-record-height a)
              (cli-commit-record-height b))
           (= (cli-commit-record-complexity a)
              (cli-commit-record-complexity b))
           (equal? (cli-commit-record-parent a)
                   (cli-commit-record-parent b))
           (equal? (cli-commit-record-pubkey a)
                   (cli-commit-record-pubkey b))))

    (define (write-records data-dir records)
      (wallet-write-private-file
        (cli-commit-file data-dir)
        (if (null? records)
            ""
            (string-append (string-join (map record->line records) "\n")
                           "\n"))))

    ;;; Stored candidates for one `(height,parent,C,pubkey)` slot set.
    (define (cli-commit-records-for data-dir height parent complexity
                                       pubkey)
      (: string? integer? bytevector? integer? bytevector? -> list?)
      (let ((wanted (cli-commit-record
                      height: height complexity: complexity parent: parent
                      pubkey: pubkey blind: #u8() commitment: #u8()
                      solution: "")))
        (let loop ((xs (cli-commit-records data-dir)) (out '()))
          (cond
            ((null? xs) (reverse out))
            ((same-slot? (car xs) wanted)
             (loop (cdr xs) (cons (car xs) out)))
            (else (loop (cdr xs) out))))))

    (define (commit-lock-owner-alive? owner)
      (and (file-exists? owner)
           (guard (e (#t #f))
             (let ((pid (string-trim (read-file-string owner))))
               (= 0 (process-run "kill" "-0" pid))))))

    (define (release-commit-lock lock)
      (when (and lock (directory-exists? lock))
        (let ((owner (path-join lock "owner")))
          (when (file-exists? owner)
            (guard (e (#t #t)) (delete-file owner))))
        (guard (e (#t #t)) (delete-directory lock))))

    (define (acquire-commit-lock data-dir)
      (let* ((path (cli-commit-file data-dir))
             (dir (path-dirname path))
             (lock (string-append path ".lock"))
             (owner (path-join lock "owner")))
        (ensure-directory dir)
        (unless (= 0 (process-run "chmod" "0700" dir))
          (error (string-append
                   "commit: could not restrict permissions on " dir)))
        (let loop ((owner-missing-polls 0))
          (if (= 0 (process-run
                     "sh" "-c" "mkdir -- \"$1\" 2>/dev/null" "sh" lock))
              (guard (err
                       (else
                         (release-commit-lock lock)
                         (raise err)))
                (write-file-string owner (number->string (process-id)))
                lock)
              (begin
                (cond
                  ((commit-lock-owner-alive? owner) #t)
                  ((file-exists? owner)
                   (guard (e (#t #t)) (delete-file owner))
                   (guard (e (#t #t)) (delete-directory lock)))
                  ((>= owner-missing-polls 40)
                   (guard (e (#t #t)) (delete-directory lock))))
                (run! "sleep" "0.05")
                (loop (if (file-exists? owner)
                          0
                          (+ owner-missing-polls 1))))))))

    (define (with-commit-lock data-dir thunk)
      (let ((lock #f))
        (dynamic-wind
          (lambda () (set! lock (acquire-commit-lock data-dir)))
          thunk
          (lambda ()
            (release-commit-lock lock)))))

    ;;; Save one candidate without replacing another still-live candidate.
    ;;; Re-saving an identical commitment is idempotent.
    (define (cli-commit-save data-dir record)
      (: string? cli-commit-record? -> cli-commit-record?)
      (with-commit-lock
        data-dir
        (lambda ()
          (let* ((records (cli-commit-records data-dir))
                 (same (let loop ((xs records))
                         (cond
                           ((null? xs) #f)
                           ((and
                              (same-slot? (car xs) record)
                              (equal?
                                (cli-commit-record-commitment (car xs))
                                (cli-commit-record-commitment record)))
                            (car xs))
                           (else (loop (cdr xs)))))))
            (if same
                same
                (begin
                  (when
                    (>= (length (filter
                                  (lambda (stored)
                                    (same-slot? stored record))
                                  records))
                        coin-max-commitments)
                    (error "commit: all sixteen canonical commitment slots are already stored for this puzzle and key"))
                  (write-records data-dir (append records (list record)))
                  record))))))

    ;;; Atomically remove every stored record with this exact commitment.
    ;;; Returns the number removed.
    (define (cli-commit-remove data-dir commitment)
      (: string? bytevector? -> integer?)
      (with-commit-lock
        data-dir
        (lambda ()
          (let* ((records (cli-commit-records data-dir))
                 (kept (filter
                         (lambda (record)
                           (not (equal?
                                  commitment
                                  (cli-commit-record-commitment record))))
                         records))
                 (removed (- (length records) (length kept))))
            (when (> removed 0)
              (write-records data-dir kept))
            removed))))

    ;;; Drop commitments whose one-block reveal window has closed.
    (define (cli-commit-prune data-dir tip-height)
      (: string? integer? -> list?)
      (with-commit-lock
        data-dir
        (lambda ()
          (let* ((records (cli-commit-records data-dir))
                 (kept (let loop ((xs records) (out '()))
                         (cond
                           ((null? xs) (reverse out))
                           ((< (cli-commit-record-height (car xs)) tip-height)
                            (loop (cdr xs) out))
                           (else
                             (loop (cdr xs) (cons (car xs) out)))))))
            (when (not (= (length records) (length kept)))
              (write-records data-dir kept))
            kept))))))
