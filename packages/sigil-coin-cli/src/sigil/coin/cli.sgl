;;; (sigil coin cli) — `sigilcoin` command line

(define-library (sigil coin cli)
  (import (sigil process)
          (sigil string)
          (sigil coin cli args)
          (sigil coin cli wallet)
          (sigil coin cli support)
          (sigil coin cli mine)
          (sigil coin cli relay)
          (sigil coin cli operate)
  )
  (export
    cli-package-version
    cli-usage
    cli-run
    main
    cli-default-data-dir
    cli-testnet-default-data-dir
    cli-arg
    cli-arg-list
    cli-flag?
    cli-number
    cli-required
    cli-chain-name
    cli-chain
    cli-data-dir
    cli-with-node
    cli-daviwils->sgl
    cli-sgl->daviwils
    cli-error-message
    coin-address-hrp
    coin-address
    coin-address->script-pubkey
    wallet-key-file
    wallet-legacy-key-file
    wallet-key
    wallet-entropy
    wallet-write-private-file
    wallet-read-private-file
    wallet-public-key
    wallet-script-pubkey
    wallet-utxos
    wallet-utxo-value
    wallet-utxo-outpoint
    wallet-utxo-mature?
    wallet-balance
    wallet-outpoint=?
    wallet-outpoint-member?
    wallet-mempool-transactions
    wallet-mempool-spent-outpoints
    wallet-select-inputs
    wallet-build-transfer
    coin-dust-threshold
    coin-default-fee
    run-address
    run-balance
    run-send
    cli-complexity
    cli-puzzle
    cli-constraint-rule
    cli-constraint-detail
    cli-example-lines
    cli-solution-report
    cli-mismatch-actual
    cli-solution-advice
    cli-commit-file
    cli-commit-record
    cli-commit-record?
    cli-commit-record-height
    cli-commit-record-complexity
    cli-commit-record-parent
    cli-commit-record-pubkey
    cli-commit-record-blind
    cli-commit-record-commitment
    cli-commit-record-solution
    cli-commit-records
    cli-commit-records-for
    cli-commit-save
    cli-commit-prune
    cli-commit-remove
    cli-bytes<?
    cli-sort-bytes
    coin-validated-tip-height
    coin-validated-tip-header
    coin-header-at-height
    coin-puzzle-parent
    coin-puzzle-context
    coin-puzzle-report
    coin-print-puzzle
    coin-block-transaction-fee
    coin-select-block-transactions
    run-puzzle
    run-mine
    run-commit
    run-reveal
    run-contribute
    relay-url
    relay-require-curl
    relay-context
    relay-producer
    relay-submit-commitment
    relay-contribution-status
    relay-submit-reveal
    relay-commit-authorization
    relay-authorization-hash
    run-relay
    coin-parse-peer
    coin-print-status
    coin-peer-connector
    run-status
    run-peers
    run-header-sync
    run-block-sync
    run-sync
    run-node
    run-listen
  )

  (begin

    ;;; Version of the CLI package.
    ;;;
    ;;; ```scheme
    ;;; (cli-package-version) ; => "0.1.0"
    ;;; ```
    (define (cli-package-version)
      (: -> string?)
      "0.1.0")

    ;;; Print the command surface.
    ;;;
    ;;; ```scheme
    ;;; (cli-usage)
    ;;; ```
    (define (cli-usage)
      (: -> any?)
      (println "sigilcoin — mine with program golf and an automatic nonce lottery")
      (println "")
      (println "mining:")
      (println "  sigilcoin puzzle [--height N] [--share] [--complexity C] [CHAIN] [--data-dir DIR]")
      (println "  sigilcoin mine [--solution EXPR] [--commit HEX]... [--reveal HEX]... [--relay URL] [--graffiti TEXT] [--address ADDR] [--share] [--complexity C] [CHAIN] [--data-dir DIR]")
      (println "  sigilcoin commit --solution EXPR [--height N] [--complexity C] [CHAIN] [--data-dir DIR]")
      (println "  sigilcoin reveal [--height N] [--commitment HEX] [CHAIN] [--data-dir DIR]")
      (println "  sigilcoin contribute --relay URL [--solution EXPR | --commitment HEX] [--data-dir DIR] [--testnet]")
      (println "  sigilcoin relay serve --testnet [--state-dir DIR] [--data-dir DIR] [--host HOST] [--port N]")
      (println "  sigilcoin relay health --relay URL --testnet")
      (println "")
      (println "how mining works:")
      (println "  A puzzle is k input/output pairs plus one syntactic constraint, both")
      (println "  derived from the parent block, so every miner sees the same puzzle and")
      (println "  nothing about it is stored on chain. A valid solution is puzzle-lang")
      (println "  source that evaluates to a ONE-ARGUMENT function reproducing every pair")
      (println "  and obeying today's constraint. `sigilcoin puzzle` prints the pairs, the")
      (println "  constraint in plain words, and a guaranteed par witness whose source")
      (println "  is exactly par bytes. It always solves the height, but valid work at")
      (println "  par is still lottery-gated: mining searches uint32 nonces automatically.")
      (println "")
      (println "  Every byte saved below par doubles the chance that each nonce qualifies,")
      (println "  up to an eight-byte (256x) bonus. Memory and evaluator steps are reported")
      (println "  as resource diagnostics, not ranking fields. Each accepted block adds one")
      (println "  unit of chain work; equal-height siblings remain first-seen.")
      (println "")
      (println "  commit/reveal is the two-phase way to be paid for a solution you did")
      (println "  not mine yourself. `commit` publishes a hash of your solution for")
      (println "  puzzle H, which rides in block H; `reveal` publishes the solution")
      (println "  itself, which rides in block H+1 and pays your key out of that block's")
      (println "  coinbase. Revealing with no prior commitment is worth nothing and")
      (println "  costs you the program: an uncommitted share is rejected, and the source")
      (println "  is then public for anyone else to submit as their own.")
      (println "")
      (println "wallet:")
      (println "  sigilcoin address [CHAIN] [--data-dir DIR]")
      (println "  sigilcoin balance [CHAIN] [--data-dir DIR]")
      (println "  sigilcoin send --to ADDR --amount SGL [--fee SGL] [CHAIN] [--data-dir DIR]")
      (println "")
      (println "node:")
      (println "  sigilcoin status [CHAIN] [--data-dir DIR]")
      (println "  sigilcoin peers add|list|remove|test [HOST[:PORT]] [CHAIN] [--data-dir DIR]")
      (println "  sigilcoin header-sync [--peer HOST[:PORT]] [--max-steps N] [--iterations N|0] [--max-peers N] [--max-retries N] [--retry-delay N] [CHAIN] [--data-dir DIR]")
      (println "  sigilcoin block-sync [--peer HOST[:PORT]] [--max-steps N] [--max-blocks N] [--iterations N|0] [--max-retries N] [--retry-delay N] [CHAIN] [--data-dir DIR]")
      (println "  sigilcoin sync [--peer HOST[:PORT]] [--max-steps N] [--max-blocks N] [--iterations N|0] [--max-peers N] [--max-retries N] [--retry-delay N] [CHAIN] [--data-dir DIR]")
      (println "  sigilcoin run [--iterations N|0] [--retry-delay N] [--validation-blocks N] [--max-blocks N] [CHAIN] [--data-dir DIR]")
      (println "  sigilcoin listen [--bind HOST] [--port N] [--backlog N] [--max-connections N|0] [--accept-timeout N] [--read-timeout N] [--max-steps N] [--max-tx N] [CHAIN] [--data-dir DIR]")
      (println "")
      (println "CHAIN is --testnet, --regtest, or --chain sigilcoin-main|sigilcoin-testnet|sigilcoin-regtest.")
      (println "Use only one shortcut flag; an explicit --chain selects the network when wrappers supply shortcuts.")
      (println "--complexity C previews a puzzle at a difficulty the chain has not reached.")
      (println "--share derives and checks the wallet pubkey's personalized co-op puzzle.")
      (println "mine --commit accepts a commitment or canonical COMMITS push; --reveal accepts a share or canonical SHARES push. Both repeat.")
      (println "Default chain: sigilcoin-main. Main/regtest data dir: ~a. Testnet data dir: ~a."
               cli-default-data-dir
               cli-testnet-default-data-dir)
      (println "--data-dir DIR explicitly overrides the selected chain's default; use it to choose any separate operator layout.")
      (println "Amounts are SGL: 1 SGL = 100000000 daviwils.")
      (println "Timeouts: --resolve-timeout, --connect-timeout, --read-timeout, in ms."))

    ;;; Dispatch one already-parsed argument list.
    ;;;
    ;;; Separated from `main` so tests can drive the real command surface
    ;;; without a subprocess.
    ;;;
    ;;; ```scheme
    ;;; (cli-run '("puzzle" "--regtest" "--data-dir" "/tmp/node"))
    ;;; ```
    (define (cli-run args)
      (: list? -> any?)
      (if (null? args)
          (cli-usage)
          (let ((command (car args))
                (rest (cdr args)))
            (cond ((or (string=? command "help")
                       (string=? command "--help")
                       (string=? command "-h"))
                   (cli-usage))
                  ((string=? command "version")
                   (println "sigilcoin ~a" (cli-package-version)))
                  ((string=? command "puzzle") (run-puzzle rest))
                  ((string=? command "mine") (run-mine rest))
                  ((string=? command "commit") (run-commit rest))
                  ((string=? command "reveal") (run-reveal rest))
                  ((string=? command "contribute") (run-contribute rest))
                  ((string=? command "relay") (run-relay rest))
                  ((string=? command "address") (run-address rest))
                  ((string=? command "balance") (run-balance rest))
                  ((string=? command "send") (run-send rest))
                  ((string=? command "status") (run-status rest))
                  ((string=? command "peers") (run-peers rest))
                  ((string=? command "header-sync") (run-header-sync rest))
                  ((string=? command "block-sync") (run-block-sync rest))
                  ((string=? command "sync") (run-sync rest))
                  ((string=? command "run") (run-node rest))
                  ((string=? command "listen") (run-listen rest))
                  (else
                   (cli-usage)
                   (error (string-append "unknown command \""
                                         command
                                         "\". Run `sigilcoin help`.")))))))

    ;; `sigil run <pkg> -- args` leaves the toolchain's own words in front of
    ;; a bare `--`. Strip through the separator when there is one, and
    ;; otherwise pass everything through: `sigilcoin run` is itself a
    ;; subcommand, so keying the strip on the word `run` would make the
    ;; long-running node unreachable from the installed binary.
    (define (application-args raw)
      (let loop ((xs raw))
        (cond ((null? xs) raw)
              ((string=? (car xs) "--") (cdr xs))
              (else (loop (cdr xs))))))

    ;;; Entry point of the `sigilcoin` binary.
    ;;;
    ;;; A failed command prints one `sigilcoin: <message>` line and exits
    ;;; non-zero, so a shell script can branch on it and a human gets a
    ;;; sentence rather than a stack trace.
    ;;;
    ;;; ```scheme
    ;;; (main)
    ;;; ```
    (define (main)
      (: -> void?)
      (guard (err
              (else
               (println "sigilcoin: ~a"
                        (cli-error-message err "the command failed"))
               (exit 1)))
        (cli-run (application-args (cdr (command-line))))))))
