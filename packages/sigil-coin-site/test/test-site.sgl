;;; Behavioral tests for deterministic, non-destructive static site generation.

(import (sigil test)
        (sigil fs)
        (sigil path)
        (sigil coin site))


(define (fresh-dir)
  (let ((dir (make-temp-directory)))
    (unless dir (error "test-site: could not create temporary directory"))
    dir))

(define (generated-bytes dir name)
  (read-file-bytes (path-join dir name)))

(define %a (fresh-dir))
(define %b (fresh-dir))
(site-generate %a)
(site-generate %b)
(test-group "static artifact"
  (test "two runs are byte-for-byte deterministic"
    (for-each
      (lambda (name)
        (assert-equal (generated-bytes %a name) (generated-bytes %b name)))
      (append '("index.html" "robots.txt" "sitemap.xml")
              (map (lambda (name) (path-join "assets" name))
                   site-asset-files))))

  (test "regeneration replaces owned artifacts without deleting unrelated files"
    (let ((notes (path-join %a "operator-notes.txt")))
      (write-file-string notes "Keep this independent operator file.")
      (write-file-string (path-join %a "index.html") "stale page")
      (write-file-string (path-join %a "assets/site.js") "stale script")
      (site-generate %a)
      (assert-equal (read-file-string notes)
                    "Keep this independent operator file.")
      (for-each
        (lambda (name)
          (assert-equal (generated-bytes %a name) (generated-bytes %b name)))
        '("index.html" "assets/site.js")))))


(run-tests)
