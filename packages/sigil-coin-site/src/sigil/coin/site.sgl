;;; (sigil coin site) — deterministic static landing site generator
;;;
;;; The page is SXML rendered directly by `sigil-sxml`. CSS, JavaScript and
;;; diagrams are ordinary versioned files copied beside it; nothing is fetched
;;; at runtime except when a visitor deliberately follows an external link.

(define-library (sigil coin site)
  (import (sigil fs)
          (sigil path)
          (sigil io)
          (sigil process)
          (sigil sxml))
  (export site-document
          site-render
          site-asset-files
          site-generate
          site-usage
          site-main
          main)

  (begin
    (define %github "https://github.com/trevarj/sigil-coin")
    (define %whitepaper
      "https://github.com/trevarj/sigil-coin/blob/HEAD/docs/whitepaper.md")
    (define %consensus
      "https://github.com/trevarj/sigil-coin/blob/HEAD/docs/consensus.md")
    (define %explorer "https://explorer.sigilcoin.lol")
    (define %pool "https://pool.testnet.sigilcoin.lol")
    (define %release "https://github.com/trevarj/sigil-coin/releases")

    ;;; Versioned files copied into the generated `assets` directory.
    ;;;
    ;;; The selected S1A2 Tight Apex symbol ships as its preserved source and
    ;;; optimized site exports. The hero raster remains pending, so its named
    ;;; `sigilcoin-hero.webp` slot keeps the CSS fallback.
    ;;;
    ;;; ```scheme
    ;;; (member "site.css" site-asset-files) ; => pair
    ;;; ```
    (define site-asset-files
      '("site.css"
        "site.js"
        "plus-jakarta.woff2"
        "plus-jakarta-OFL.txt"
        "jetbrains-mono.woff2"
        "jetbrains-mono-OFL.txt"
        "S1A2-tight-apex-2048.png"
        "sigilcoin-symbol.png"
        "sigilcoin-favicon.png"
        "sigilcoin-symbol-SOURCES.txt"
        "mining.svg"
        "score-fork.svg"
        "ecosystem.svg"
        "spark.svg"))

    (define (attrs . values) (cons '@ values))

    (define (link href label . class)
      (list 'a
            (attrs (list 'href href)
                   (list 'class (if (null? class) "text-link" (car class))))
            label))

    (define (fact value label)
      (list 'li (attrs '(class "fact reveal"))
            (list 'strong value)
            (list 'span label)))

    (define (layer number title body)
      (list 'article (attrs '(class "layer reveal"))
            (list 'span (attrs '(class "layer-number")) number)
            (list 'div (list 'h3 title) (list 'p body))))

    (define (command-row code)
      (list 'div (attrs '(class "command-row"))
            (list 'code code)
            (list 'button
                  (attrs '(type "button")
                         '(class "copy-button")
                         (list 'data-copy code)
                         (list 'aria-label
                               (string-append "Copy command: " code)))
                  "Copy")))

    (define (step number title body commands)
      (list 'article (attrs '(class "path-step reveal"))
            (list 'span (attrs '(class "step-number")) number)
            (list 'div (attrs '(class "step-body"))
                  (list 'h3 title)
                  (list 'p body)
                  (if (pair? commands)
                      (cons 'div
                            (cons (attrs '(class "step-commands"))
                                  (map command-row commands)))
                      ""))))

    ;;; Build the complete landing-page SXML tree.
    ;;;
    ;;; The ordering is the product flow: premise, mechanism, fundamentals,
    ;;; consensus, ecosystem, then the numbered path to participate.
    ;;;
    ;;; ```scheme
    ;;; (car (site-document)) ; => html
    ;;; ```
    (define (site-document)
      (: -> list?)
      (list
        'html (attrs '(lang "en"))
        (list 'head
              (list 'meta (attrs '(charset "utf-8")))
              (list 'meta (attrs '(name "viewport")
                                 '(content "width=device-width,initial-scale=1")))
              (list 'meta (attrs '(name "theme-color") '(content "#080910")))
              (list 'meta
                    (attrs '(name "description")
                           '(content "SigilCoin is a hobby proof-of-golf chain: exact daily slots, longest-height forks, and hardcoded release checkpoints.")))
              (list 'meta (attrs '(property "og:title")
                                 '(content "SigilCoin — Short programs. Daily slots.")))
              (list 'meta
                    (attrs '(property "og:description")
                           '(content "Solve deterministic puzzles. Golf score measures competition quality, not fork weight. Release checkpoints bound reorgs; no settlement-grade security.")))
              (list 'meta (attrs '(property "og:url")
                                 '(content "https://sigilcoin.lol/")))
              (list 'meta (attrs '(property "og:type") '(content "website")))
              (list 'title "SigilCoin — short programs, daily slots")
              (list 'link (attrs '(rel "canonical")
                                 '(href "https://sigilcoin.lol/")))
              (list 'link
                    (attrs '(rel "icon")
                           '(type "image/png")
                           '(sizes "64x64")
                           '(href "assets/sigilcoin-favicon.png")))
              (list 'link (attrs '(rel "stylesheet")
                                 '(href "assets/site.css")))
              (list 'script (attrs '(src "assets/site.js") '(defer "defer")) ""))
        (list
          'body
          (list 'a (attrs '(class "skip-link") '(href "#main")) "Skip to content")
          (list
            'header (attrs '(class "site-header"))
            (list 'a (attrs '(class "brand") '(href "#top")
                               '(aria-label "SigilCoin home"))
                  (list 'img
                        (attrs '(class "brand-symbol")
                               '(src "assets/sigilcoin-symbol.png")
                               '(width "32")
                               '(height "32")
                               '(alt "")))
                  (list 'span "SigilCoin"))
            (list 'nav (attrs '(aria-label "Primary navigation"))
                  (link "#how" "How it works" "nav-link")
                  (link "#fundamentals" "Fundamentals" "nav-link")
                  (link "#consensus" "Consensus" "nav-link")
                  (link "#ecosystem" "Ecosystem" "nav-link")
                  (link "#start" "Start" "nav-link")))
          (list
            'main (attrs '(id "main"))
            (list
              'section (attrs '(id "top") '(class "hero section-shell"))
              (list 'div (attrs '(class "hero-copy"))
                    (list 'p (attrs '(class "eyebrow")) "Scheduled proof-of-golf")
                    (list 'h1 "Short programs. Daily slots.")
                    (list 'p (attrs '(class "hero-lead"))
                          "Solve the puzzle. Golf quality scores 1–9 points; strictly taller valid branches win. No nonce grinding.")
                    (list 'div (attrs '(class "hero-actions"))
                          (link %explorer "Open Explorer" "button button-primary")
                          (link %whitepaper "Read the whitepaper" "button button-secondary"))
                    (list 'p (attrs '(class "microcopy"))
                          "A hobby chain built in Sigil. Not settlement-grade security."))
              (list 'div (attrs '(class "hero-visual reveal")
                                 '(data-parallax "0.06"))
                    (list 'div
                          (attrs '(class "hero-raster raster-slot")
                                 '(role "img")
                                 '(aria-label "A valid program five bytes below par scores six golf points for competition quality, not fork choice")
                                 '(data-raster-src "assets/sigilcoin-hero.webp"))
                          (list 'span "(lambda(x) …)")
                          (list 'strong "par − 5")
                          (list 'span "6 GOLF POINTS"))
                    (list 'img (attrs '(src "assets/mining.svg")
                                      '(alt "Proof-of-golf flow: derive a puzzle, verify a program at or below par, then submit a zero-nonce block when its exact slot is due")))))
            (list
              'section (attrs '(id "how") '(class "section-shell section-block"))
              (list 'div (attrs '(class "section-heading reveal"))
                    (list 'p (attrs '(class "eyebrow")) "How it works")
                    (list 'h2 "A daily slot for a short program.")
                    (list 'p "Every node derives the same input/output examples and syntactic constraint. Models and synthesis scripts search for short programs. The generated par witness is a valid fallback; block production does not require hash search."))
              (list 'div (attrs '(class "flow-grid"))
                    (list 'article (attrs '(class "flow-card reveal"))
                          (list 'b "01") (list 'h3 "Derive")
                          (list 'p "The parent hash, height and complexity deterministically produce the puzzle."))
                    (list 'article (attrs '(class "flow-card reveal"))
                          (list 'b "02") (list 'h3 "Synthesize")
                          (list 'p "Models, scripts and humans search the frozen puzzle language for a short function."))
                    (list 'article (attrs '(class "flow-card reveal"))
                          (list 'b "03") (list 'h3 "Verify")
                          (list 'p "Nodes rerun the program under fixed fuel, memory, string and depth caps."))
                    (list 'article (attrs '(class "flow-card reveal"))
                          (list 'b "04") (list 'h3 "Submit")
                          (list 'p "When the next exact slot is due, build and submit one complete block with nonce and coinbase locktime set to zero."))))
            (list
              'section (attrs '(id "fundamentals")
                              '(class "section-shell section-block"))
              (list 'div (attrs '(class "section-heading reveal"))
                    (list 'p (attrs '(class "eyebrow")) "Fundamentals")
                    (list 'h2 "Small programs. Fixed rules.")
                    (list 'p "One compact chain. Every headline number comes from the protocol, not a market feed."))
              (list 'ul (attrs '(class "facts")
                               '(aria-label "SigilCoin fundamentals"))
                    (fact "1–9 points" "competition quality only")
                    (fact "86400 seconds" "exact mainnet slots")
                    (fact "512 bytes" "solution cap")
                    (fact "Zero" "premine")
                    (fact "143029.99991970 SGL" "scheduled maximum")
                    (fact "8" "maximum co-op shares")))
            (list
              'section (attrs '(id "consensus") '(class "section-shell section-block consensus"))
              (list 'div (attrs '(class "section-heading reveal"))
                    (list 'p (attrs '(class "eyebrow")) "Layered consensus")
                    (list 'h2 "Longest height. Release checkpoints.")
                    (list 'p "Bounded evaluation establishes a program's validity and byte length. Golf score displays competition quality only: it neither selects canonical branches nor currently alters subsidy."))
              (list 'div (attrs '(class "consensus-layout"))
                    (list 'div (attrs '(class "layers"))
                          (layer "01" "Bitcoin foundation"
                                 "80-byte headers, transactions, UTXOs, script, P2WPKH, headers-first sync and block relay.")
                          (layer "02" "Frozen puzzle machine"
                                 "A small Scheme subset with no I/O, mutation, floating point or host eval; one bounded machine checks every example.")
                          (layer "03" "Scheduled proof-of-golf"
                                 "Version commits producer length and puzzle complexity. Bits stays fixed for header compatibility. Nonce and coinbase locktime are zero; non-genesis graffiti is empty.")
                          (layer "04" "Puzzle-complexity retarget"
                                 "Every 16 blocks, median golf margin moves puzzle complexity C. Mainnet slots stay exactly 86400 seconds apart; no hash difficulty is searched or retargeted.")
                          (layer "05" "Co-op commit–reveal"
                                 "Producers require L ≤ par; up to 8 signed personalized shares require L < personalized par and split a 10% contribution pool."))
                    (list 'figure (attrs '(class "diagram reveal"))
                          (list 'img (attrs '(src "assets/score-fork.svg")
                                            '(alt "A valid height-two branch beats height one regardless of golf score; equal height keeps the durable active incumbent, and hardcoded release checkpoints bound reorgs")))
                          (list 'figcaption "Switch only to a strictly taller valid branch that matches release checkpoints. Equal height retains the durable active incumbent. Mainnet pins H0 and H1 on the replacement slogan chain; public testnet and regtest remain H0-only.")))
              (list 'div (attrs '(class "exact-grid reveal"))
                    (list 'details
                          (list 'summary "Header and golf score")
                          (list 'p "Version uses prefix 0x20600000 under mask 0xffe00000, with L−1 in bits 20..12 and C in bits 11..0. Valid producer programs satisfy L ≤ par. Savings are min(8, max(0, par − L)); block score is 1 + savings, from 1 through 9. Genesis contributes zero. The 80-byte header keeps fixed per-network bits and nonce zero; non-genesis coinbase locktime is zero, graffiti is empty, and transaction version and sequence remain canonical. There is no hash admission target."))
                    (list 'details
                          (list 'summary "Fork choice")
                          (list 'p "A valid candidate branch must be strictly taller to replace the active chain. Equal height retains the durable active incumbent, including after restart; golf score, hash and arrival metadata never displace it. Chain configs publish hardcoded (height . internal-hash) checkpoints: incompatible branches cannot cross them. Checkpoints advance only in reviewed software releases, and nodes must upgrade to share newer checkpoints. Mainnet currently pins H0 and H1 on the replacement slogan chain; public testnet and regtest remain H0-only, protecting genesis but no later history. Reorgs remain possible above H1 on mainnet and above H0 on testnet and regtest."))
                    (list 'details
                          (list 'summary "Exact slots and puzzle retarget")
                          (list 'p "Header time must equal parent time plus the configured spacing: exactly 86400 seconds on mainnet, shorter on test networks. No network allows a future slot. Missed slots can be filled late, so this is not a guarantee of daily block arrival. Every 16 blocks, median relative golf margin adjusts C, changing grammar width, examples and constraint tier. Bits and validator caps never move.")))
                    (list 'details
                          (list 'summary "Payout and issuance")
                          (list 'p "Solo pays floor(4S/5)+fees and leaves the reserve unminted. With shares, canonical outputs divide floor(S/10) by verified contributions 1–4, pay the parent floor(S/20), retain zero-value required outputs, and send fees and integer residuals to the producer."))))
            (list
              'section (attrs '(id "limits") '(class "section-shell section-block"))
              (list 'div (attrs '(class "section-heading reveal"))
                    (list 'p (attrs '(class "eyebrow")) "Limits, plainly")
                    (list 'h2 "A hobby chain, not financial settlement.")
                    (list 'p "Valid equal-height branches are cheap to construct and can remain local to different nodes. A missed slot gives a rival an opportunity to become strictly taller; partitions can leave competing incumbents. Reorgs remain possible above the latest release checkpoint: H1 on mainnet, H0 on testnet and regtest. Fixing nonce and coinbase fields does not prevent parent-template manipulation through remaining valid block choices. There is no settlement-grade security."))
              (list 'p "The earlier nonce-PoW genesis was retired before height 1 because sustained compute burn contradicted the project's intent. Archive that retired state; never reuse its database. The authorized mainnet reset restores the exact genesis quote Sigil - Practical Symbolic Power at unchanged timestamp 1789228800. The mistaken marker-quote mainnet H0/H1 and its H1 checkpoint are abandoned; archive their chain and relay state and start fresh. Mainnet transport magic is SGM4 (last byte 0x34). Testnet and regtest retain their genesis identities, timestamps and SGT3/SGR3 magic (last byte 0x33); only their existing proof-of-golf H0 state may be reused.")
              (list 'p "Mainnet H0 internal hash: d15ecce0c8a3e4dc07c8136eb68770c2e59683cbad4bd268c420ec24ae040d3a. Reversed display ID: 3a0d04ae24ec20c468d24badcb8396e5c27087b66e13c807dce4a3c8e0cc5ed1.")
              (list 'p "The replacement slogan-chain H1 is produced and pinned. H1 internal hash: ec3ef647e87a3b54e832b10f0788e2494ac7934096b7357576b263504281637d. Reversed display ID: 7d6381425063b2767535b7964093c74a49e288070fb132e8543b7ae847f63eec.")
              (list 'p "SGL is intended to have no monetary value. There is no sale, bridge or promise of future value. Commit–reveal binds contributions and payouts, not finality. Checkpoints are hardcoded release policy, not automatic or signed finality."))
            (list
              'section (attrs '(id "ecosystem") '(class "section-shell section-block"))
              (list 'div (attrs '(class "section-heading reveal"))
                    (list 'p (attrs '(class "eyebrow")) "Ecosystem")
                    (list 'h2 "Inspect every layer.")
                    (list 'p "The language, implementation, protocol documents and chain view stay open and directly linked."))
              (list 'div (attrs '(class "ecosystem-grid"))
                    (list 'figure (attrs '(class "diagram reveal"))
                          (list 'img (attrs '(src "assets/ecosystem.svg")
                                            '(alt "Sigil language, SigilCoin source, consensus, explorer and community ecosystem"))))
                    (list 'div (attrs '(class "link-grid reveal"))
                          (link "https://usesigil.org" "Sigil language ↗" "ecosystem-link")
                          (link %github "Source code ↗" "ecosystem-link")
                          (link %whitepaper "Whitepaper ↗" "ecosystem-link")
                          (link %consensus "Consensus specification ↗" "ecosystem-link")
                          (link %explorer "Block explorer ↗" "ecosystem-link")
                          (link "https://web.libera.chat/#systemcrafters" "Libera #systemcrafters ↗" "ecosystem-link"))))
            (list
              'section (attrs '(id "start") '(class "section-shell section-block start"))
              (list 'div (attrs '(class "section-heading reveal"))
                    (list 'p (attrs '(class "eyebrow")) "Get started")
                    (list 'h2 "Download. Run a node or contribute.")
                    (list 'p "Use the CLI as a full node, wallet and scheduled producer, or contribute to the public testnet pool without running a node. Read each command before running it."))
              (list 'div (attrs '(class "path"))
                    (step "1" "Download"
                          "Published builds appear on Releases. If none matches your system, build the source with the repository's pinned Nix environment. Upgrade for the mainnet slogan reset and its reviewed H0 and H1 checkpoints; public testnet and regtest remain H0-only."
                          #f)
                    (list 'div (attrs '(class "step-links reveal"))
                          (link %release "Latest release" "button button-primary")
                          (link %github "Source fallback" "button button-secondary"))
                    (step "2" "Create and back up your wallet"
                          "Start mainnet with a fresh state directory; do not reuse abandoned marker-quote H0/H1 or retired nonce-PoW databases. Back up state/mainnet-proof-of-golf/wallet/wallet.key before receiving SGL. Losing that file loses access; never share it."
                          '("sigilcoin address --chain sigilcoin-main --data-dir ./state/mainnet-proof-of-golf"))
                    (step "3" "Sync the chain"
                          "Use upgraded software to download and validate headers and blocks from the configured public seed; abandoned mainnet peers use incompatible transport magic."
                          '("sigilcoin sync --chain sigilcoin-main --data-dir ./state/mainnet-proof-of-golf"))
                    (step "4" "Solve and submit"
                          "Inspect the puzzle and next slot time. Once due, mine builds and submits one candidate using the valid at-par fallback. Pass --solution with your own shorter program to improve displayed golf quality, not fork weight or subsidy."
                          '("sigilcoin puzzle --chain sigilcoin-main --data-dir ./state/mainnet-proof-of-golf"
                            "sigilcoin mine --chain sigilcoin-main --data-dir ./state/mainnet-proof-of-golf"))
                    (list 'article (attrs '(class "prompt-card reveal"))
                          (list 'h3 "Contribute without a node")
                          (list 'p "On public testnet, the contributor watcher derives your personalized puzzle and requires a solution strictly below its personalized par. It keeps your wallet key local; your blind and source remain local until your commitment appears in a canonical block, then submits the signed reveal.")
                          (command-row "sigilcoin contribute --relay https://pool.testnet.sigilcoin.lol --testnet --data-dir ./state/testnet-contributor-proof-of-golf")
                          (list 'p "Keep the watcher running through the following block, or resume it from the saved commitment. If included, the reward is a direct coinbase payout to your wallet and becomes spendable in the block after it is paid. Inclusion is not guaranteed: the relay or producer can delay, omit or censor work, but cannot redirect a valid signed payout.")
                          (list 'p (link (string-append %pool "/v1/context")
                                         "View current pool context ↗")))
                    (list 'article (attrs '(class "prompt-card reveal"))
                          (list 'div (attrs '(class "prompt-heading"))
                                (list 'h3 "Compact LLM prompt")
                                (list 'button
                                      (attrs '(type "button")
                                             '(class "copy-button")
                                             '(data-copy "Write the shortest valid SigilCoin puzzle-language one-argument function that reproduces every given input/output pair, obeys the stated syntactic constraint, and fits in 512 source bytes. Return source only.")
                                             '(aria-label "Copy compact LLM prompt"))
                                      "Copy"))
                          (list 'pre (list 'code "Write the shortest valid SigilCoin puzzle-language one-argument function that reproduces every given input/output pair, obeys the stated syntactic constraint, and fits in 512 source bytes. Return source only.")))))
            (list 'section (attrs '(class "final-cta section-shell reveal"))
                  (list 'img (attrs '(src "assets/spark.svg") '(alt "")))
                  (list 'h2 "The next block is a program waiting to be shortened.")
                  (link %explorer "See the current puzzle" "button button-primary")))
          (list
            'footer (attrs '(class "site-footer section-shell"))
            (list 'a (attrs '(class "brand") '(href "#top"))
                  (list 'img
                        (attrs '(class "brand-symbol")
                               '(src "assets/sigilcoin-symbol.png")
                               '(width "32")
                               '(height "32")
                               '(alt "")))
                  (list 'span "SigilCoin"))
            (list 'p "Built with Sigil. No analytics. No trackers.")
            (list 'div (attrs '(class "footer-links"))
                  (link %github "Source")
                  (link %whitepaper "Whitepaper")
                  (link %consensus "Consensus")
                  (link %explorer "Explorer")))))

    ;;; Render the deterministic HTML document.
    ;;;
    ;;; ```scheme
    ;;; (string-prefix? "<!DOCTYPE html>" (site-render)) ; => #t
    ;;; ```
    (define (site-render)
      (: -> string?)
      (string-append "<!DOCTYPE html>\n" (sxml->html (site-document)) "\n"))

    (define (asset-source-directory)
      (let loop ((candidates '("packages/sigil-coin-site/assets"
                               "assets"
                               "../assets")))
        (cond ((null? candidates)
               (error "site-generate: cannot find package assets"))
              ((directory? (car candidates)) (car candidates))
              (else (loop (cdr candidates))))))

    (define (copy-assets source output)
      (: string? string? -> void?)
      (for-each
        (lambda (name)
          (copy-file (path-join source name)
                     (path-join output name)))
        site-asset-files))

    ;;; Generate the complete static site under `output`.
    ;;;
    ;;; Existing generated files are replaced byte-for-byte, making repeated
    ;;; runs deterministic. Unrelated files are left alone.
    ;;;
    ;;; ```scheme
    ;;; (site-generate "build/site")
    ;;; ```
    (define (site-generate output)
      (: string? -> void?)
      (let ((assets-output (path-join output "assets")))
        (ensure-directory assets-output)
        (write-file-string (path-join output "index.html") (site-render))
        (write-file-string
          (path-join output "robots.txt")
          "User-agent: *\nAllow: /\nSitemap: https://sigilcoin.lol/sitemap.xml\n")
        (write-file-string
          (path-join output "sitemap.xml")
          (string-append
            "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
            "<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\">"
            "<url><loc>https://sigilcoin.lol/</loc></url></urlset>\n"))
        (copy-assets (asset-source-directory) assets-output)))

    (define (application-args raw)
      (let loop ((xs raw))
        (cond ((null? xs) raw)
              ((string=? (car xs) "--") (cdr xs))
              (else (loop (cdr xs))))))

    (define (option args name fallback)
      (let loop ((xs args))
        (cond ((null? xs) fallback)
              ((and (string=? (car xs) name) (pair? (cdr xs))) (car (cdr xs)))
              (else (loop (cdr xs))))))

    (define (flag? args name)
      (let loop ((xs args))
        (cond ((null? xs) #f)
              ((string=? (car xs) name) #t)
              (else (loop (cdr xs))))))

    ;;; Command help for the static generator.
    ;;;
    ;;; ```scheme
    ;;; (display (site-usage))
    ;;; ```
    (define (site-usage)
      (: -> string?)
      (string-append
        "sigilcoin-site — generate the static SigilCoin website\n\n"
        "usage: sigilcoin-site [--output DIR]\n\n"
        "  --output DIR  output directory (default: build/site)\n"
        "  -h, --help    print this help\n"))

    ;;; Parse command arguments and generate the static site.
    ;;;
    ;;; ```sh
    ;;; sigilcoin-site --output build/site
    ;;; ```
    (define (site-main)
      (: -> void?)
      (let ((args (application-args (cdr (command-line)))))
        (if (or (flag? args "--help") (flag? args "-h"))
            (display (site-usage))
            (let ((output (option args "--output" "build/site")))
              (site-generate output)
              (display (string-append "site: wrote " output "\n"))))))

    ;;; Bundle entry point.
    ;;;
    ;;; ```sh
    ;;; sigilcoin-site
    ;;; ```
    (define (main)
      (: -> void?)
      (site-main))))
