;;; Golden vectors for the canonical program-by-example puzzle generator.
;;;
;;; A puzzle is a pure function of the block seed, the height and `C`. Every
;;; expectation here freezes that function — a drifting hidden function,
;;; table, par or retry count is a chain split, so these tests must fail
;;; loudly rather than be updated.
;;;
;;; The liveness tests are the load-bearing ones: they show the generator
;;; rejecting puzzles whose table solution would not work, which is the only
;;; thing standing between a bad draw and a chain that stalls forever.

(import (sigil test)
        (sigil math)
        (sigil coin puzzle)
        (sigil coin puzzle constraints)
        (sigil coin puzzle generator)
        (sigil coin puzzle prng))

;; ============================================================
;; Helpers
;; ============================================================

;; Deterministic test seed: 32 bytes derived from a small index.
(define (seed-of k)
  (let ((bv (make-bytevector puzzle-seed-bytes 0)))
    (let loop ((i 0))
      (if (>= i puzzle-seed-bytes)
          bv
          (begin
            (bytevector-u8-set! bv i (modulo (+ (* i 7) (* k 31) 11) 256))
            (loop (+ i 1)))))))

(define (ast-of source)
  (puzzle-result-value (puzzle-parse/limit source puzzle-max-source-bytes)))

;; Does `source` satisfy the puzzle's constraint and reproduce every pair
;; under the real consensus caps?
(define (solves? spec source)
  (let ((d (puzzle-constraint-builtin-cap
             (puzzle-complexity-tier (puzzle-spec-complexity spec)))))
    (and (<= (string-length source) puzzle-max-source-bytes)
         (puzzle-ok? (puzzle-parse/limit source puzzle-max-source-bytes))
         (puzzle-constraint-ok? (puzzle-spec-constraint spec) source
                                (ast-of source) d)
         (puzzle-report-ok? (puzzle-run-examples source
                                                 (puzzle-spec-examples spec))))))

(define (inputs-of spec) (map car (puzzle-spec-examples spec)))
(define (outputs-of spec) (map cdr (puzzle-spec-examples spec)))

(define (distinct? values)
  (let loop ((vs values))
    (cond
      ((null? vs) #t)
      ((let inner ((rest (cdr vs)))
         (cond
           ((null? rest) #f)
           ((puzzle-value=? (car vs) (car rest)) #t)
           (else (inner (cdr rest)))))
       #f)
      (else (loop (cdr vs))))))

(define (all-equal? values)
  (let loop ((vs (cdr values)))
    (cond
      ((null? vs) #t)
      ((puzzle-value=? (car values) (car vs)) (loop (cdr vs)))
      (else #f))))

;; The first accepted attempt for an explicit constraint, or #f.
(define (first-spec seed height c ci)
  (let loop ((retry 0))
    (if (>= retry puzzle-max-generator-retries)
        #f
        (let ((out (puzzle-attempt/constraint seed height c ci retry)))
          (if (puzzle-spec? out) out (loop (+ retry 1)))))))

;; Synthetic pairs at exactly the literal caps: an 8-byte input symbol and a
;; 24-byte output symbol, which is the worst case the table sizing assumes.
(define (worst-pairs k)
  (let loop ((i 0) (acc '()))
    (if (>= i k)
        (reverse acc)
        (loop (+ i 1)
              (cons (cons (string->symbol
                            (string-append "abcdefg" (number->string i)))
                          (string->symbol
                            (string-append "abcdefghijklmnopqrstuv"
                                           (number->string (+ 10 i)))))
                    acc)))))

(define %max-anchor-output (make-string puzzle-anchor-output-bytes #\p))

;; Seven cap-sized ordinary pairs plus final exact key anchor: k remains 8.
(define %worst-anchored-pairs
  (append (worst-pairs 7)
          (list (cons puzzle-anchor-input %max-anchor-output))))

;; The sweep: every puzzle generated once, then asserted over from several
;; angles. 20 seeds x 2 heights x 4 complexities = 160 puzzles.
(define %sweep-seeds 20)
(define %sweep-heights '(0 4096))
(define %sweep-complexities '(16 512 1024 4095))

(define %sweep
  (let loop ((k 0) (acc '()))
    (if (>= k %sweep-seeds)
        (reverse acc)
        (loop (+ k 1)
              (let heights ((hs %sweep-heights) (acc acc))
                (if (null? hs)
                    acc
                    (heights
                      (cdr hs)
                      (let complexities ((cs %sweep-complexities) (acc acc))
                        (if (null? cs)
                            acc
                            (complexities
                              (cdr cs)
                              (cons (puzzle-for (seed-of k) (car hs) (car cs))
                                    acc)))))))))))

(define %sweep-size (length %sweep))

(define (sweep-count pred)
  (let loop ((specs %sweep) (n 0))
    (if (null? specs)
        n
        (loop (cdr specs) (if (pred (car specs)) (+ n 1) n)))))

(define (sweep-all? pred)
  (= %sweep-size (sweep-count pred)))

;; ============================================================
;; Constants
;; ============================================================

(test-group "puzzle generator constants"
  (test "the generator constants are frozen"
    (assert-equal 20000 puzzle-generator-max-fuel)
    (assert-equal 8 puzzle-max-input-literal-bytes)
    (assert-equal 24 puzzle-max-output-literal-bytes)
    (assert-equal 16 puzzle-complexity-min)
    (assert-equal 4095 puzzle-complexity-max)
    (assert-equal 128 puzzle-complexity-genesis)
    (assert-equal 24 puzzle-production-count)
    (assert-equal "@" puzzle-anchor-input)
    (assert-equal 66 puzzle-anchor-output-bytes)
    (assert-true (puzzle-anchor-output? %max-anchor-output))
    (assert-false (puzzle-anchor-output? (make-string 65 #\p)))
    (assert-false (puzzle-anchor-output? (make-string 66 #\q))))

  (test "the interpreter caps are frozen"
    (assert-equal 512 puzzle-max-source-bytes)
    (assert-equal 200000 puzzle-max-fuel))

  (test "the par floor and retry bound are frozen"
    (assert-equal 24 puzzle-min-par-bytes)
    (assert-equal 64 puzzle-max-generator-retries)))

;; ============================================================
;; Complexity knobs
;; ============================================================

(test-group "pbe complexity knobs"
  (test "the tier boundaries are frozen"
    (assert-equal 0 (puzzle-complexity-tier 16))
    (assert-equal 0 (puzzle-complexity-tier 255))
    (assert-equal 1 (puzzle-complexity-tier 256))
    (assert-equal 1 (puzzle-complexity-tier 1023))
    (assert-equal 2 (puzzle-complexity-tier 1024))
    (assert-equal 2 (puzzle-complexity-tier 4095)))

  (test "k grows slowly and clamps at 8"
    (assert-equal 3 (puzzle-complexity-k 16))
    (assert-equal 3 (puzzle-complexity-k 128))
    (assert-equal 3 (puzzle-complexity-k 511))
    (assert-equal 4 (puzzle-complexity-k 512))
    (assert-equal 5 (puzzle-complexity-k 1024))
    ;; The ceiling binds from 2560 up. It is 8 rather than 10 because the
    ;; table solution at 10 does not fit the source cap: see the module docs
    ;; and `puzzle-max-k`.
    (assert-equal 7 (puzzle-complexity-k 2559))
    (assert-equal 8 (puzzle-complexity-k 2560))
    (assert-equal 8 (puzzle-complexity-k 3584))
    (assert-equal 8 (puzzle-complexity-k 4095))
    (assert-equal puzzle-max-k (puzzle-complexity-k puzzle-complexity-max)))

  (test "w is the enabled production prefix"
    (assert-equal 6 (puzzle-complexity-width 16))
    (assert-equal 6 (puzzle-complexity-width 128))
    (assert-equal 6 (puzzle-complexity-width 204))
    (assert-equal 7 (puzzle-complexity-width 205))
    (assert-equal 10 (puzzle-complexity-width 1024))
    (assert-equal 24 (puzzle-complexity-width 3690))
    (assert-equal 24 (puzzle-complexity-width 4095)))

  (test "genesis is a gentle launch"
    (assert-equal 0 (puzzle-complexity-tier puzzle-complexity-genesis))
    (assert-equal 3 (puzzle-complexity-k puzzle-complexity-genesis))
    (assert-equal 6 (puzzle-complexity-width puzzle-complexity-genesis)))

  (test "a complexity outside the 12-bit range is rejected"
    (assert-error (puzzle-complexity-k 15))
    (assert-error (puzzle-complexity-k 4096))
    (assert-error (puzzle-complexity-tier -1))
    (assert-error (puzzle-for (seed-of 0) 0 15))))

;; ============================================================
;; Constraint selection
;; ============================================================

(test-group "pbe constraint selection"
  (test "the constraint comes from the tier catalogue"
    (let loop ((c '(16 128 300 900 1024 2048 4095)))
      (if (null? c)
          (assert-true #t)
          (begin
            (let ((ci (puzzle-constraint-for (seed-of 4) 12 (car c))))
              (assert-true
                (memv ci (puzzle-constraint-tier-catalogue
                           (puzzle-complexity-tier (car c))))))
            (loop (cdr c))))))

  (test "tier 0 is always unconstrained"
    (assert-equal 0 (puzzle-constraint-for (seed-of 1) 5 16))
    (assert-equal 0 (puzzle-constraint-for (seed-of 2) 9 255)))

  (test "the constraint does not move with a retry"
    ;; It is drawn from a dedicated stream, so a miner knows the rule before
    ;; the generator has settled on a puzzle.
    (let ((ci (puzzle-constraint-for (seed-of 9) 3 4095)))
      (assert-equal ci (puzzle-spec-constraint (puzzle-for (seed-of 9) 3 4095)))
      (assert-true (> (puzzle-spec-retries (puzzle-for (seed-of 9) 3 4095)) 0))))

  (test "the seed, the height and C all move the constraint"
    (assert-equal (puzzle-constraint-for (seed-of 5) 7 4095)
                  (puzzle-constraint-for (seed-of 5) 7 4095))
    (assert-true (memv (puzzle-constraint-for (seed-of 6) 7 4095) '(1 2 4 6 7)))))

;; ============================================================
;; Determinism and golden vectors
;; ============================================================

(test-group "pbe determinism"
  (test "the same inputs give a byte-identical puzzle"
    (let ((a (puzzle-for (seed-of 5) 42 1024))
          (b (puzzle-for (seed-of 5) 42 1024)))
      (assert-equal (puzzle-spec-hidden-source a) (puzzle-spec-hidden-source b))
      (assert-equal (puzzle-spec-table-solution a) (puzzle-spec-table-solution b))
      (assert-equal (puzzle-spec-par a) (puzzle-spec-par b))
      (assert-equal (puzzle-spec-constraint a) (puzzle-spec-constraint b))
      (assert-equal (puzzle-spec-retries a) (puzzle-spec-retries b))
      (assert-true (equal? (puzzle-spec-examples a) (puzzle-spec-examples b)))))

  (test "the seed, the height and C each change the puzzle"
    (let ((base (puzzle-for (seed-of 5) 42 1024)))
      (assert-false (equal? (puzzle-spec-examples base)
                            (puzzle-spec-examples (puzzle-for (seed-of 6) 42 1024))))
      (assert-false (equal? (puzzle-spec-examples base)
                            (puzzle-spec-examples (puzzle-for (seed-of 5) 43 1024))))
      ;; `C` moves k, w and the constraint. On chain it also moves the seed
      ;; (it is folded into the preimage), so a retarget always repuzzles;
      ;; here the seed is held fixed to isolate the knobs.
      (assert-false (equal? (puzzle-spec-examples base)
                            (puzzle-spec-examples
                              (puzzle-for (seed-of 5) 42 4095))))))

  ;; Golden vectors. Any drift here changes which blocks nodes accept.
  (test "golden puzzle 0 (tier 0, genesis complexity)"
    (let ((spec (puzzle-for (seed-of 0) 0 128)))
      (assert-equal 0 (puzzle-spec-constraint spec))
      (assert-equal 3 (puzzle-spec-k spec))
      (assert-equal 0 (puzzle-spec-retries spec))
      (assert-equal "(lambda(x)(list x (* x x)))"
                    (puzzle-spec-hidden-source spec))
      (assert-equal
        (string-append "(lambda(x)(if(equal? x '662)'(662 438244) "
                       "(if(equal? x '312)'(312 97344) '(579 335241))))")
        (puzzle-spec-table-solution spec))
      (assert-true (equal? '((662 662 438244) (312 312 97344)
                             (579 579 335241))
                           (puzzle-spec-examples spec)))
      (assert-equal 27 (puzzle-spec-par spec))))

  (test "golden puzzle 1 (tier 1)"
    (let ((spec (puzzle-for (seed-of 1) 7 900)))
      (assert-equal 0 (puzzle-spec-constraint spec))
      (assert-equal 4 (puzzle-spec-k spec))
      (assert-equal "(lambda(x)(modulo (* x x) 5))"
                    (puzzle-spec-hidden-source spec))
      (assert-equal
        (string-append "(lambda(x)(if(equal? x '990)'0 (if(equal? x '904)'1 "
                       "(if(equal? x '57)'4 '1))))")
        (puzzle-spec-table-solution spec))
      (assert-true (equal? '((990 . 0) (904 . 1) (57 . 4) (259 . 1))
                           (puzzle-spec-examples spec)))
      (assert-equal 29 (puzzle-spec-par spec))
      (assert-equal 0 (puzzle-spec-retries spec))))

  (test "golden puzzle 2 (tier 2, no-quote, k = 8)"
    (let ((spec (puzzle-for (seed-of 2) 4096 4095)))
      (assert-equal 2 (puzzle-spec-constraint spec))
      (assert-equal 8 (puzzle-spec-k spec))
      (assert-equal "(lambda(x)(filter (lambda (y) (< y x)) (list 46 81 94)))"
                    (puzzle-spec-hidden-source spec))
      (assert-equal 56 (puzzle-spec-par spec))
      (assert-equal 257 (string-length (puzzle-spec-table-solution spec)))
      ;; no-quote is respected by the whole published puzzle
      (assert-true (puzzle-constraint-source-ok?
                     2 (puzzle-spec-table-solution spec)))
      (assert-true (equal? '((994 46 81 94) (75 46) (482 46 81 94)
                             (350 46 81 94) (415 46 81 94) (480 46 81 94)
                             (499 46 81 94) (750 46 81 94))
                           (puzzle-spec-examples spec)))))

  (test "golden puzzle 3 (tier 2, small-literals)"
    (let ((spec (puzzle-for (seed-of 3) 129 1024)))
      (assert-equal 6 (puzzle-spec-constraint spec))
      (assert-equal 5 (puzzle-spec-k spec))
      (assert-equal "(lambda(x)(list x 'coin x))"
                    (puzzle-spec-hidden-source spec))
      (assert-equal 27 (puzzle-spec-par spec))
      (assert-equal 0 (puzzle-spec-retries spec)))))

;; ============================================================
;; The liveness guarantee
;; ============================================================

(test-group "pbe liveness"
  (test "the sweep really generated puzzles"
    (assert-equal 160 %sweep-size))

  (test "the table solution solves every generated puzzle"
    ;; Under the real caps, against the real constraint, on a real machine.
    (assert-true (sweep-all? (lambda (spec)
                               (solves? spec (puzzle-spec-table-solution spec))))))

  (test "the hidden function solves every generated puzzle"
    (assert-true (sweep-all? (lambda (spec)
                               (solves? spec
                                        (puzzle-spec-hidden-source spec))))))

  (test "the table is the printed table for the puzzle's own examples"
    (assert-true
      (sweep-all? (lambda (spec)
                    (string=? (puzzle-spec-table-solution spec)
                              (puzzle-table-solution (puzzle-spec-constraint spec)
                                                  (puzzle-spec-examples spec)))))))

  (test "no solution the generator publishes exceeds the source cap"
    (assert-true
      (sweep-all? (lambda (spec)
                    (and (<= (string-length (puzzle-spec-table-solution spec))
                             puzzle-max-source-bytes)
                         (<= (string-length (puzzle-spec-hidden-source spec))
                             puzzle-max-source-bytes))))))

  (test "par is the shorter of the two, and never below the floor"
    (assert-true
      (sweep-all?
        (lambda (spec)
          (and (= (puzzle-spec-par spec)
                  (min (string-length (puzzle-spec-hidden-source spec))
                       (string-length (puzzle-spec-table-solution spec))))
               (>= (puzzle-spec-par spec) puzzle-min-par-bytes)))))
    ;; The hidden function is what par tracks in practice; the table is the
    ;; ceiling nobody would submit.
    (assert-true
      (sweep-all? (lambda (spec)
                    (< (string-length (puzzle-spec-hidden-source spec))
                       (string-length (puzzle-spec-table-solution spec)))))))

  (test "the examples are well formed"
    (assert-true
      (sweep-all?
        (lambda (spec)
          (and (= (puzzle-spec-k spec) (length (puzzle-spec-examples spec)))
               (= (puzzle-spec-k spec)
                  (puzzle-complexity-k (puzzle-spec-complexity spec)))
               (distinct? (inputs-of spec))
               (not (all-equal? (outputs-of spec))))))))

  (test "every literal stays inside its cap"
    (assert-true
      (sweep-all?
        (lambda (spec)
          (let loop ((ps (puzzle-spec-examples spec)))
            (cond
              ((null? ps) #t)
              ((> (string-length (puzzle-print-value (car (car ps))))
                  puzzle-max-input-literal-bytes)
               #f)
              ((> (string-length (puzzle-print-value (cdr (car ps))))
                  puzzle-max-output-literal-bytes)
               #f)
              (else (loop (cdr ps)))))))))

  (test "no puzzle needed the fallback"
    (assert-true (sweep-all? (lambda (spec)
                               (< (puzzle-spec-retries spec)
                                  puzzle-max-generator-retries))))))

;; ============================================================
;; The liveness check is load-bearing
;; ============================================================

(test-group "pbe liveness rejection"
  ;; Each case below would be accepted by arithmetic reasoning about literal
  ;; sizes, and is caught only because the generator builds the table and
  ;; runs it.

  (test "conflicting examples are caught by running the table"
    ;; Two identical inputs with different outputs: the table's first
    ;; matching branch wins, so it cannot reproduce the second pair.
    (assert-equal 'table-mismatch
                  (puzzle-compose 1 128 0 '((1 . 2) (1 . 3) (2 . 5))
                               "(lambda(x)(list x x x x x x))" 0
                               (puzzle-budget-open))))

  (test "the k ceiling is what keeps the table inside the source cap"
    ;; This is why `puzzle-max-k` is 8. A ten-pair table under
    ;; `letrec-required` is the case section 8.3's arithmetic claimed fits,
    ;; and measuring the actual string is what disproved it. `k` can no
    ;; longer reach 10, so `puzzle-compose` now rejects such a call on arity
    ;; before it ever builds the table: the size check behind it is defence
    ;; in depth, not a reachable path.
    (assert-true (> (string-length (puzzle-table-solution 3 (worst-pairs 10)))
                    (string-length (puzzle-table-solution 3 (worst-pairs 8)))))
    (assert-equal 'k-mismatch
                  (puzzle-compose 1 4095 3 (worst-pairs 10)
                               "(lambda(x)(letrec((f(lambda(y)y)))(f x)))" 0
                               (puzzle-budget-open)))
    ;; At the frozen ceiling the worst table fits with real headroom.
    (assert-true (<= (string-length (puzzle-table-solution 3 (worst-pairs 8)))
                     puzzle-max-source-bytes)))

  (test "a table that violates the day's constraint is rejected"
    ;; Integer examples under `no-digits`: the hidden function is clean, the
    ;; table cannot be.
    (assert-equal 'table-constraint
                  (puzzle-compose 1 128 1 '((1 . 2) (2 . 3) (3 . 4))
                               "(lambda(x)(list x x x x x x))" 0
                               (puzzle-budget-open))))

  (test "a table with no legal spelling is rejected"
    ;; `no-quote` has no quote-free form for a symbol.
    (assert-false (puzzle-table-solution 2 '((1 . a) (2 . b) (3 . c))))
    (assert-equal 'table-unprintable
                  (puzzle-compose 1 128 2 '((1 . a) (2 . b) (3 . c))
                               "(lambda(x)(list x x x x x x))" 0
                               (puzzle-budget-open))))

  (test "a hidden function that does not solve its own puzzle is rejected"
    (assert-equal 'hidden-mismatch
                  (puzzle-compose 1 128 0 '((1 . 2) (2 . 4) (3 . 6))
                               "(lambda(x)(list x x x x x x))" 0
                               (puzzle-budget-open))))

  (test "a fallback that failed a check would raise, not publish"
    ;; The fallback is the one puzzle no attempt vetted, so it re-checks
    ;; everything; a failure there is a bug in the module, not a bad block.
    (assert-true (puzzle-spec? (puzzle-fallback 5 128)))
    (assert-error (puzzle-fallback 5 4096))))

;; ============================================================
;; Non-degeneracy
;; ============================================================

(test-group "pbe non-degeneracy"
  (test "a constant function is never the answer"
    (assert-equal 'constant-outputs
                  (puzzle-compose 1 128 0 '((1 . 7) (2 . 7) (3 . 7))
                               "(lambda(x)(list x x x x x x))" 0
                               (puzzle-budget-open))))

  (test "a puzzle a bare builtin solves is rejected"
    ;; `car` is a three-byte solution; a height it wins is a race every
    ;; miner wins at once.
    (assert-equal 'builtin-trivial
                  (puzzle-compose 1 128 0 '(((1 2) . 1) ((3 4) . 3)
                                         ((5 6) . 5))
                               "(lambda(x)(list x x x x x x))" 0
                               (puzzle-budget-open)))
    ;; the probe reaches past `car`: this one is `reverse`
    (assert-equal 'builtin-trivial
                  (puzzle-compose 1 128 0 '(((1 2) . (2 1)) ((3 4) . (4 3))
                                         ((5 6) . (6 5)))
                               "(lambda(x)(list x x x x x x))" 0
                               (puzzle-budget-open))))

  (test "a puzzle the generator can solve in a handful of bytes is rejected"
    (assert-equal 'par-floor
                  (puzzle-compose 1 128 0 '((1 . 2) (2 . 4) (3 . 6))
                               "(lambda(x)(* x 2))" 0 (puzzle-budget-open))))

  (test "the mismatched example count is caught"
    (assert-equal 'k-mismatch
                  (puzzle-compose 1 128 0 '((1 . 2) (2 . 4))
                               "(lambda(x)(* x 2))" 0 (puzzle-budget-open))))

  (test "an oversize literal is caught"
    (assert-equal 'input-oversize
                  (puzzle-compose 1 128 0 '((123456789 . 2) (2 . 4) (3 . 6))
                               "(lambda(x)(list x x x x x x))" 0
                               (puzzle-budget-open)))
    (assert-equal 'output-oversize
                  (puzzle-compose 1 128 0 '((1 . 1234567890123456789012345)
                                         (2 . 4) (3 . 6))
                               "(lambda(x)(list x x x x x x))" 0
                               (puzzle-budget-open)))))

;; ============================================================
;; Every constraint, end to end
;; ============================================================

(define %forced
  (let loop ((ci 0) (acc '()))
    (if (> ci 7)
        (reverse acc)
        (loop (+ ci 1) (cons (first-spec (seed-of 5) 11 4095 ci) acc)))))

(test-group "pbe constraints end to end"
  (test "every constraint yields a puzzle"
    (let loop ((specs %forced))
      (if (null? specs)
          (assert-true #t)
          (begin
            (assert-true (puzzle-spec? (car specs)))
            (loop (cdr specs))))))

  (test "bounded public generation preserves every explicit constraint"
    (let loop ((ci 0))
      (if (> ci 7)
          (assert-true #t)
          (let ((spec (puzzle-for/constraint (seed-of ci) 11 4095 ci)))
            (assert-equal ci (puzzle-spec-constraint spec))
            (assert-true (< (puzzle-spec-retries spec)
                            puzzle-max-generator-retries))
            (loop (+ ci 1))))))

  (test "every constrained fallback preserves liveness"
    (let loop ((ci 0))
      (if (> ci 7)
          (assert-true #t)
          (let ((spec (puzzle-fallback/constraint (seed-of ci) 11 4095 ci)))
            (assert-equal ci (puzzle-spec-constraint spec))
            (assert-equal puzzle-max-generator-retries
                          (puzzle-spec-retries spec))
            (assert-true (solves? spec (puzzle-spec-table-solution spec)))
            (assert-true (solves? spec (puzzle-spec-hidden-source spec)))
            (loop (+ ci 1))))))

  (test "personalized constrained fallbacks retain seed-specific examples"
    (assert-true
      (let loop ((n 0) (seen '()))
        (if (> n 7)
            #t
            (let ((examples
                    (puzzle-spec-examples
                      (puzzle-fallback/constraint (seed-of n) 11 4095 0))))
              (and (not (member examples seen))
                   (loop (+ n 1) (cons examples seen))))))))

  (test "both published solutions satisfy the constraint and run"
    (let loop ((specs %forced))
      (if (null? specs)
          (assert-true #t)
          (begin
            (assert-true (solves? (car specs)
                                  (puzzle-spec-table-solution (car specs))))
            (assert-true (solves? (car specs)
                                  (puzzle-spec-hidden-source (car specs))))
            (loop (cdr specs))))))

  (test "the repair transform is present where the rule needs it"
    (let ((letrec-spec (list-ref %forced 3))
          (fold-spec (list-ref %forced 7)))
      (assert-true (puzzle-facts-letrec-seen
                     (puzzle-constraint-walk
                       (ast-of (puzzle-spec-table-solution letrec-spec)))))
      (assert-true (puzzle-facts-letrec-seen
                     (puzzle-constraint-walk
                       (ast-of (puzzle-spec-hidden-source letrec-spec)))))
      (assert-true (memq 'fold (puzzle-facts-free-builtins
                                 (puzzle-constraint-walk
                                   (ast-of (puzzle-spec-table-solution
                                             fold-spec))))))
      (assert-true (memq 'fold (puzzle-facts-free-builtins
                                 (puzzle-constraint-walk
                                   (ast-of (puzzle-spec-hidden-source
                                             fold-spec))))))))

  (test "no-digits keeps digits out of the whole puzzle"
    (let ((spec (list-ref %forced 1)))
      (assert-true (puzzle-constraint-source-ok?
                     1 (puzzle-spec-table-solution spec)))
      (assert-true (puzzle-constraint-source-ok?
                     1 (puzzle-spec-hidden-source spec)))))

  (test "small-literals keeps every integer at or under nine"
    (let ((spec (list-ref %forced 6)))
      (assert-true (>= 9 (puzzle-facts-max-integer
                           (puzzle-constraint-walk
                             (ast-of (puzzle-spec-table-solution spec)))))))))

;; ============================================================
;; Retries and the fallback
;; ============================================================

(test-group "pbe retries"
  (test "a rejected attempt names the check that rejected it"
    ;; Seed 18 at height 3 is rejected on its first draw and accepted on the
    ;; second, which is what its retry count of 1 records.
    (assert-equal 'output-oversize (puzzle-attempt (seed-of 18) 3 4095 0))
    (assert-true (puzzle-spec? (puzzle-attempt (seed-of 18) 3 4095 1)))
    (assert-equal 1 (puzzle-spec-retries (puzzle-for (seed-of 18) 3 4095)))
    ;; and a different seed is rejected for a different reason
    (assert-equal 'constant-outputs (puzzle-attempt (seed-of 9) 3 4095 0)))

  (test "a re-roll is the accepted attempt, unchanged"
    (let ((spec (puzzle-for (seed-of 9) 3 4095))
          (attempt (puzzle-attempt (seed-of 9) 3 4095 1)))
      (assert-equal (puzzle-spec-hidden-source attempt)
                    (puzzle-spec-hidden-source spec))
      (assert-equal (puzzle-spec-table-solution attempt)
                    (puzzle-spec-table-solution spec))))

  (test "the sweep exercises the retry path"
    (assert-true (> (sweep-count (lambda (spec)
                                   (> (puzzle-spec-retries spec) 0)))
                    0)))

  (test "the fallback puzzle passes every acceptance check"
    (let ((spec (puzzle-fallback 5 4095)))
      (assert-equal 5 (puzzle-spec-height spec))
      (assert-equal 0 (puzzle-spec-constraint spec))
      (assert-equal 8 (puzzle-spec-k spec))
      (assert-equal "(lambda(x)(list x (* x x)))"
                    (puzzle-spec-hidden-source spec))
      (assert-equal puzzle-max-generator-retries (puzzle-spec-retries spec))
      (assert-true (solves? spec (puzzle-spec-table-solution spec)))
      (assert-true (solves? spec (puzzle-spec-hidden-source spec)))
      (assert-true (>= (puzzle-spec-par spec) puzzle-min-par-bytes))))

  (test "the fallback tracks k, so it works at any complexity"
    (assert-equal 3 (puzzle-spec-k (puzzle-fallback 1 128)))
    (assert-equal 4 (puzzle-spec-k (puzzle-fallback 1 512))))

  (test "malformed generator inputs are rejected"
    (assert-error (puzzle-for (make-bytevector 16 0) 0 128))
    (assert-error (puzzle-for (seed-of 0) -1 128))
    (assert-error (puzzle-attempt (seed-of 0) 0 128 -1))
    (assert-error (puzzle-constraint-for (seed-of 0) 0 4096))
    (assert-error (puzzle-for/constraint (seed-of 0) 0 128 8))
    (assert-error (puzzle-fallback/constraint (seed-of 0) 0 128 -1))
    (assert-error
      (puzzle-for/constraint/anchor (seed-of 0) 0 128 0 "short"))))

;; ============================================================
;; Table sizing
;; ============================================================

(test-group "pbe table sizing"
  ;; These are the numbers behind the choice of `k`: the worst case is `k`
  ;; branches at the literal caps plus the widest repair wrapper.
  (test "the worst-case table at each k"
    (assert-equal 136 (string-length (puzzle-table-solution 0 (worst-pairs 3))))
    (assert-equal 386 (string-length (puzzle-table-solution 0 (worst-pairs 8))))
    (assert-equal 436 (string-length (puzzle-table-solution 0 (worst-pairs 9))))
    (assert-equal 486 (string-length (puzzle-table-solution 0 (worst-pairs 10)))))

  (test "the repair wrappers eat the headroom"
    ;; At k = 10 the fold wrapper leaves two bytes and the letrec wrapper
    ;; does not fit at all. k = 8 leaves 97 bytes under the worst wrapper.
    (assert-equal 510 (string-length (puzzle-table-solution 7 (worst-pairs 10))))
    (assert-equal 515 (string-length (puzzle-table-solution 3 (worst-pairs 10))))
    (assert-equal 415 (string-length (puzzle-table-solution 3 (worst-pairs 8))))
    (assert-true (> (- puzzle-max-source-bytes
                       (string-length (puzzle-table-solution 3 (worst-pairs 8))))
                    96)))

  (test "the tier catalogues keep letrec away from a wide k"
    ;; `letrec-required` is tier 1 only, where k never exceeds 4, so the
    ;; 515-byte case above cannot be drawn.
    (assert-false (memv 3 (puzzle-constraint-tier-catalogue 2)))
    (assert-equal 4 (puzzle-complexity-k 1023))
    (assert-equal 215 (string-length (puzzle-table-solution 3 (worst-pairs 4)))))

  (test "the anchored k=8 bound is exact"
    ;; 40-byte letrec wrapper/base + seven 50-byte ordinary branches +
    ;; 68-byte self-evaluating full-key output = 458.
    (let ((table (puzzle-table-solution 3 %worst-anchored-pairs)))
      (assert-equal 458 (string-length table))
      (assert-equal 54 (- puzzle-max-source-bytes (string-length table)))
      (assert-true (solves?
                     (puzzle-spec height: 1 complexity: 4095 constraint: 3 k: 8
                               examples: %worst-anchored-pairs
                               hidden-source: table table-solution: table
                               par: 458 retries: 0)
                     table))))

  (test "real anchored fallbacks pass every constraint at k=8"
    (assert-true
      (let loop ((ci 0))
        (if (> ci 7)
            #t
            (let* ((spec (puzzle-fallback/constraint/anchor
                           (seed-of ci) 11 4095 ci %max-anchor-output))
                   (pairs (puzzle-spec-examples spec))
                   (anchor (list-ref pairs 7)))
              (and (= 8 (puzzle-spec-k spec))
                   (= 8 (length pairs))
                   (string=? puzzle-anchor-input (car anchor))
                   (string=? %max-anchor-output (cdr anchor))
                   (not (member puzzle-anchor-input (map car
                                                       (reverse (cdr (reverse pairs))))))
                   (solves? spec (puzzle-spec-hidden-source spec))
                   (solves? spec (puzzle-spec-table-solution spec))
                   (<= (string-length (puzzle-spec-table-solution spec))
                       puzzle-max-source-bytes)
                   (loop (+ ci 1)))))))))

;; ============================================================
;; The program-by-example interpreter entry point
;; ============================================================

(test-group "puzzle-run-examples"
  (test "a solution that reproduces every pair is ok"
    (let ((report (puzzle-run-examples "(lambda(x)(* x x))"
                                       '((2 . 4) (3 . 9)))))
      (assert-true (puzzle-report-ok? report))
      (assert-true (puzzle-procedure? (puzzle-report-value report)))
      (assert-true (> (puzzle-report-steps report) 0))
      (assert-true (>= (puzzle-report-cells report) 0))))

  (test "a bare builtin is a legal solution"
    (assert-true (puzzle-report-ok? (puzzle-run-examples "car"
                                                         '(((1 2) . 1))))))

  (test "a mismatch reports the failing index"
    (let ((report (puzzle-run-examples "(lambda(x)x)" '((1 . 1) (2 . 3)))))
      (assert-false (puzzle-report-ok? report))
      (assert-equal 'solution-mismatch (puzzle-report-error-kind report))
      (assert-equal 1 (puzzle-report-index report))))

  (test "a non-procedure result is refused"
    (assert-equal 'solution-not-a-procedure
                  (puzzle-report-error-kind
                    (puzzle-run-examples "42" '((1 . 1)))))
    (assert-equal 'solution-not-a-procedure
                  (puzzle-report-error-kind
                    (puzzle-run-examples "(lambda(x y)x)" '((1 . 1)))))
    (assert-equal 'solution-not-a-procedure
                  (puzzle-report-error-kind
                    (puzzle-run-examples "cons" '((1 . 1))))))

  (test "a procedure result for an example is refused"
    (assert-equal 'solution-mismatch
                  (puzzle-report-error-kind
                    (puzzle-run-examples "(lambda(x)(lambda(y)y))"
                                         '((1 . 1))))))

  (test "the source cap applies"
    (let ((mid (string-append "(lambda(x)(list x " (make-string 300 #\x)
                              "))"))
          (huge (string-append "(lambda(x)(list x " (make-string 600 #\x)
                               "))")))
      (assert-true (< (string-length mid) puzzle-max-source-bytes))
      (assert-equal 'ok (puzzle-result-status (puzzle-parse mid)))
      (assert-equal 'unbound-variable
                    (puzzle-report-error-kind
                      (puzzle-run-examples mid '((1 . 1)))))
      (assert-equal 'parse-oversize
                    (puzzle-report-error-kind
                      (puzzle-run-examples huge '((1 . 1)))))))

  (test "errors are reported, never raised"
    (assert-equal 'unbound-variable
                  (puzzle-report-error-kind
                    (puzzle-run-examples "zz" '((1 . 1)))))
    (assert-equal 'parse-syntax
                  (puzzle-report-error-kind
                    (puzzle-run-examples "(" '((1 . 1)))))
    (assert-equal 'type-error
                  (puzzle-report-error-kind
                    (puzzle-run-examples "(lambda(x)(car x))" '((1 . 1))))))

  (test "one machine serves the whole check"
    ;; Cost is bounded by one fuel budget regardless of k, which is what
    ;; keeps raising k from raising node cost.
    (let ((one (puzzle-run-examples "(lambda(x)(* x x))" '((2 . 4))))
          (four (puzzle-run-examples "(lambda(x)(* x x))"
                                     '((2 . 4) (3 . 9) (4 . 16) (5 . 25)))))
      (assert-true (> (puzzle-report-steps four)
                      (puzzle-report-steps one)))
      (assert-true (< (puzzle-report-steps four) puzzle-max-fuel)))))
