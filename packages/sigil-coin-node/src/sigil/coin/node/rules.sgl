;;; (sigil coin node rules) — header acceptance and fork choice
;;;
;;; Header `version` commits chain-derived puzzle complexity and producer
;;; length. `bits` is the chain-retargeted compact base target and `nonce` is
;;; lottery entropy. Acceptance verifies linkage/timestamps, exact required
;;; complexity and target, `L <= par`, then the golf-weighted full-header roll.
;;;
;;; Fork choice follows cumulative base work. The golf bonus substitutes
;;; verified program work for hashes when admitting one block; it does not
;;; discount that block's chain work. Exact accumulated-work and height ties
;;; remain first-seen.

(define-library (sigil coin node rules)
  (import (sigil math)
          (sigil time)
          (sigil bitcoin consensus)
          (sigil coin puzzle generator)
          (sigil coin consensus))
  (export
    ;; Header fields
    coin-header-complexity
    coin-header-solution-length

    ;; The puzzle cache
    coin-node-puzzle-cache
    coin-node-puzzle
    coin-node-puzzle-cache-size

    ;; Chain-derived complexity
    coin-header-height
    coin-window-margins
    coin-required-complexity
    coin-required-bits

    ;; Cumulative base-work chain selection
    coin-chain-work
    coin-better-chain?

    ;; Acceptance
    coin-accept-header?
    coin-header-rules)

  (begin

    ;; ============================================================
    ;; Header fields
    ;; ============================================================

    ;;; The producer solution length a header claims in `version`.
    (define (coin-header-solution-length header)
      (: any? -> coin-result?)
      (if (not (block-header? header))
          (coin-error 'malformed-header "expected a block header")
          (coin-version-solution-length (block-header-version header))))

    ;;; The puzzle complexity a header claims in `version`.
    (define (coin-header-complexity header)
      (: any? -> coin-result?)
      (if (not (block-header? header))
          (coin-error 'malformed-header "expected a block header")
          (coin-version-decode (block-header-version header))))

    ;; ============================================================
    ;; The puzzle cache
    ;; ============================================================

    ;;; The node's puzzle cache: one per process, bounded, and read by both
    ;;; the retarget signal and body validation.
    ;;;
    ;;; ponytail: one process-wide cache, because `connect` and `accept?` are
    ;;; both fixed seam signatures with nowhere to thread a handle through.
    ;;; Give the node a per-chain handle if one process ever serves two
    ;;; chains at once; it is correctness-neutral either way, since the key
    ;;; is the seed and the seed already separates chains.
    (define coin-node-puzzle-cache (coin-puzzle-cache-open))

    ;;; Number of puzzles the node currently holds.
    (define (coin-node-puzzle-cache-size)
      (: -> integer?)
      (coin-puzzle-cache-size coin-node-puzzle-cache))

    ;;; The puzzle for a block, derived once per height and reused after.
    ;;;
    ;;; Indistinguishable from `coin-puzzle-for` in its result; see the
    ;;; module header for why that is by construction rather than by care.
    ;;;
    ;;; ```scheme
    ;;; (equal? (puzzle-spec-par (coin-node-puzzle parent 1 128))
    ;;;         (puzzle-spec-par (coin-puzzle-for parent 1 128)))
    ;;; ; => #t
    ;;; ```
    (define (coin-node-puzzle previous-hash height complexity)
      (: bytevector? integer? integer? -> puzzle-spec?)
      (coin-puzzle-cached coin-node-puzzle-cache
                             previous-hash
                             height
                             complexity))

    ;; ============================================================
    ;; Chain-derived complexity
    ;; ============================================================

    (define (list-length xs)
      (let loop ((ys xs) (n 0)) (if (null? ys) n (loop (cdr ys) (+ n 1)))))

    (define (last-of xs)
      (let loop ((ys xs))
        (if (null? (cdr ys)) (car ys) (loop (cdr ys)))))

    (define (drop-n xs n)
      (let loop ((ys xs) (i n))
        (if (or (<= i 0) (null? ys)) ys (loop (cdr ys) (- i 1)))))

    ;; The complexity a stored header carries, or a raise. Every header in
    ;; `previous-headers` has already passed `accept?`, so an undecodable
    ;; `version` there is a node bug rather than a bad block.
    (define (stored-complexity header)
      (let ((decoded (coin-header-complexity header)))
        (if (coin-failed? decoded)
            (error "coin-required-complexity: a stored header has illegal version")
            (coin-result-value decoded))))

    ;; The accepted solution length a stored header commits to.
    (define (stored-length header)
      (let ((decoded (coin-header-solution-length header)))
        (if (coin-failed? decoded)
            (error "coin-required-complexity: a stored header has illegal version")
            (coin-result-value decoded))))

    ;;; The height of the header that would extend `previous-headers`.
    ;;;
    ;;; The seam hands over the whole chain from genesis, oldest first, so
    ;;; the height is the count: an empty history is genesis.
    ;;;
    ;;; ```scheme
    ;;; (coin-header-height '())          ; => 0
    ;;; (coin-header-height (list genesis)) ; => 1
    ;;; ```
    (define (coin-header-height previous-headers)
      (: list? -> integer?)
      (if (not (list? previous-headers))
          (error "coin-header-height: expected a header list"))
      (list-length previous-headers))

    ;;; The 16 margins of the retarget window ending at `height`, oldest
    ;;; first: one per height in `height-16 .. height-1`.
    ;;;
    ;;; `par_i` is derived through the cache and `L_i` is decoded from header
    ;;; `i`'s version. Both are pure functions of the branch, so a reorg
    ;;; recomputes `C` from that branch's own blocks.
    ;;;
    ;;; ```scheme
    ;;; (length (coin-window-margins headers 16)) ; => 16
    ;;; ```
    (define (coin-window-margins previous-headers height)
      (: list? integer? -> list?)
      (let ((available (list-length previous-headers)))
        ;; The history is indexed BY HEIGHT: entry `i` is the header at
        ;; height `i`, which is only true when it runs from genesis to the
        ;; parent and nowhere else. Requiring the exact length is what makes
        ;; that contract checkable rather than assumed.
        (if (or (< height coin-retarget-window)
                (not (= available height)))
            (error "coin-window-margins: the history is not the chain to this height"))
        (let loop ((xs (drop-n previous-headers
                               (- height coin-retarget-window)))
                   (h (- height coin-retarget-window))
                   (acc '()))
          (if (or (>= h height) (null? xs))
              (reverse acc)
              (let* ((header (car xs))
                     (complexity (stored-complexity header))
                     (spec (coin-node-puzzle
                             (block-header-previous-block header)
                             h
                             complexity)))
                (loop (cdr xs)
                      (+ h 1)
                      (cons (coin-margin (puzzle-spec-par spec)
                                            (stored-length header))
                            acc)))))))

    ;;; The complexity a header at `height` MUST carry, derived from the
    ;;; parent chain.
    ;;;
    ;;; Genesis is the frozen `coin-complexity-genesis`. Every other
    ;;; height inherits its parent's `C` except at a retarget height, where
    ;;; the full 16-block window decides. Raises when the history cannot
    ;;; support the derivation, which for the node seam means never.
    ;;;
    ;;; ```scheme
    ;;; (coin-required-complexity '() 0)          ; => 128
    ;;; (coin-required-complexity (list genesis) 1) ; => 128
    ;;; ```
    (define (coin-required-complexity previous-headers height)
      (: list? integer? -> integer?)
      (if (= 0 height)
          coin-complexity-genesis
          (let ((parent-complexity (stored-complexity
                                     (last-of previous-headers))))
            (coin-complexity-for
              height
              parent-complexity
              (and (coin-retarget-height? height)
                   (coin-window-margins previous-headers height))))))

    ;;; Compact base target required for the next header.
    (define (coin-required-bits params previous-headers)
      (: consensus-params? list? -> integer?)
      (next-required-bits params previous-headers))

    ;; ============================================================
    ;; Cumulative base-work chain selection
    ;; ============================================================

    ;;; Accumulated base work of the chain ending at `header`.
    ;;;
    ;;; A shorter solution widens admission odds, but every admitted block
    ;;; contributes the work represented by its chain-required base target.
    (define (coin-chain-work header b previous-work)
      (: block-header? any? integer? -> integer?)
      (+ previous-work (block-header-chain-work header)))

    ;;; Whether `candidate` strictly outranks the incumbent chain tip.
    ;;;
    ;;; Greater accumulated base work wins; equal work prefers greater height.
    ;;; An exact work-and-height tie retains the first-seen incumbent.
    (define (coin-better-chain? candidate incumbent)
      (: chain-candidate? chain-candidate? -> boolean?)
      (let ((candidate-work (chain-candidate-work candidate))
            (incumbent-work (chain-candidate-work incumbent)))
        (or (> candidate-work incumbent-work)
            (and (= candidate-work incumbent-work)
                 (> (chain-candidate-height candidate)
                    (chain-candidate-height incumbent))))))

    ;; ============================================================
    ;; Header acceptance
    ;; ============================================================

    (define (current-unix-second)
      (exact (floor (current-second))))

    ;;; Whether `header` may extend `previous-headers` under chain policy.
    ;;;
    ;;; The order is cost: version shape, linkage/timestamps, required
    ;;; complexity and compact base target, then puzzle derivation and one
    ;;; full-header hash. The body later proves the encoded length claim exact.
    ;;;
    ;;; Total: any argument, however hostile, yields a boolean.
    (define (policy-seconds? value)
      (and (number? value) (exact? value) (integer? value) (>= value 0)))

    (define (drift-argument who args)
      (cond
        ((null? args) coin-max-future-drift)
        ((not (null? (cdr args)))
         (error (string-append who ": too many arguments")))
        ((policy-seconds? (car args)) (car args))
        (else
          (error (string-append who
                                ": expected a future-drift allowance in seconds")))))

    (define (coin-accept-header? params previous-headers header min-spacing
                                 . maybe-max-future-drift)
      (: any? list? any? integer? integer? ... -> boolean?)
      (guard (e (#t #f))
        (let ((max-future-drift
                (drift-argument "coin-accept-header?"
                                maybe-max-future-drift)))
          (and (policy-seconds? min-spacing)
               (block-header? header)
               (list? previous-headers)
               (coin-ok?
                 (coin-version-decode (block-header-version header)))
               (coin-ok? (coin-validate-header-context previous-headers
                                                          header
                                                          (current-unix-second)
                                                          min-spacing
                                                          max-future-drift))
               (let* ((height (coin-header-height previous-headers))
                      (required-complexity
                        (coin-required-complexity previous-headers height))
                      (complexity
                        (coin-check-version
                          (block-header-version header)
                          required-complexity))
                      (length (coin-header-solution-length header))
                      (required-bits
                        (coin-required-bits params previous-headers)))
                 (and (coin-ok? complexity)
                      (coin-ok? length)
                      (= required-bits (block-header-bits header))
                      (let* ((c (coin-result-value complexity))
                             (l (coin-result-value length))
                             (par
                               (puzzle-spec-par
                                 (coin-node-puzzle
                                   (block-header-previous-block header)
                                   height
                                   c))))
                        (and (<= l par)
                             (coin-lottery-valid?
                               (block-header-work-value header)
                               required-bits
                               par
                               l)))))))))

    ;;; Build canonical header rules for a chain's timestamp policy.
    ;;;
    ;;; Omitting `max-future-drift` applies the mainnet default.
    ;;;
    ;;; ```scheme
    ;;; (header-rules? (coin-header-rules 1 7200)) ; => #t
    ;;; ```
    (define (coin-header-rules min-spacing . maybe-max-future-drift)
      (: integer? integer? ... -> header-rules?)
      (if (not (policy-seconds? min-spacing))
          (error "coin-header-rules: expected a spacing floor in seconds"))
      (let ((max-future-drift
              (drift-argument "coin-header-rules" maybe-max-future-drift)))
        (header-rules
          accept?: (lambda (params previous-headers header)
                     (coin-accept-header? params
                                          previous-headers
                                          header
                                          min-spacing
                                          max-future-drift))
          chain-work: coin-chain-work
          better-chain?: coin-better-chain?)))))
