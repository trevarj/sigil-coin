;;; (sigil coin node chain) — live SigilCoin chain configs
;;;
;;; Mainnet, public testnet, and regtest run canonical program-by-example
;;; consensus. Mainnet's timestamp remains placeholder data until operator
;;; chooses launch day; changing it requires regenerating genesis constants.

(define-library (sigil coin node chain)
  (import (sigil bitcoin consensus)
          (sigil bitcoin node)
          (sigil coin consensus)
          (sigil coin node rules)
          (sigil coin node body)
          (sigil coin node genesis))
  (export
    coin-target-block-spacing
    coin-testnet-network-magic
    coin-testnet-min-block-spacing
    coin-regtest-min-block-spacing
    coin-testnet-max-future-drift
    coin-main-wallet-coinbase-maturity
    coin-chain-min-block-spacing
    coin-chain-max-future-drift
    coin-chain-address-hrp
    coin-chain-wallet-coinbase-maturity
    coin-irc-channel
    coin-genesis-quote
    coin-genesis-time
    coin-testnet-genesis-quote
    coin-testnet-genesis-time
    coin-regtest-genesis-quote
    coin-regtest-genesis-time
    sigilcoin-consensus-params
    sigilcoin-main-chain
    sigilcoin-testnet-chain
    sigilcoin-regtest-chain
    sigilcoin-chain-by-name)

  (begin

    ;;; Intended seconds between blocks: one day.
    (define coin-target-block-spacing 86400)

    ;;; Public testnet transport magic. Retained across the genesis reset so
    ;;; the pending public-testnet connection boundary remains unchanged.
    (define coin-testnet-network-magic #u8(#xd3 #x7a #x91 #xc5))

    ;;; Public testnet spacing floor: one hour.
    (define coin-testnet-min-block-spacing 3600)

    ;;; Regtest spacing floor.
    (define coin-regtest-min-block-spacing 1)

    ;;; Public testnet future-drift allowance: five minutes.
    (define coin-testnet-max-future-drift 300)

    ;;; Mainnet wallet policy waits six confirmations before selecting a
    ;;; coinbase, while consensus still permits spending it in the next block.
    (define coin-main-wallet-coinbase-maturity 6)

    ;;; Miner community channel.
    (define coin-irc-channel "#systemcrafters")

    ;;; Mainnet genesis quote.
    (define coin-genesis-quote
      "Sigil - Practical Symbolic Power")

    ;;; Placeholder mainnet timestamp. Non-final until launch operator chooses
    ;;; launch day and regenerates canonical genesis constants.
    (define coin-genesis-time 1785542400)

    ;;; Canonical reset public-testnet genesis quote.
    (define coin-testnet-genesis-quote
      "SigilCoin public testnet reset - 2026-09-02")

    ;;; Fixed testnet genesis timestamp: 2026-09-02T00:00:00Z.
    (define coin-testnet-genesis-time 1788307200)

    ;;; Regtest genesis quote.
    (define coin-regtest-genesis-quote
      "SigilCoin regtest: worthless on purpose")

    ;;; Fixed regtest genesis timestamp: 2026-01-01T00:00:00Z.
    (define coin-regtest-genesis-time 1767225600)

    ;;; Bitcoin-shaped parameters used by shared transaction validation.
    (define sigilcoin-consensus-params
      (consensus-params
        pow-limit-bits: (coin-bits-encode
                          coin-complexity-max
                          coin-max-solution-bytes)
                        target-spacing: coin-target-block-spacing
                        target-timespan: coin-target-block-spacing
                        retarget-interval: #xffffffff
                        bip34-height: 0
                        bip66-height: 0
                        bip65-height: 0
                        csv-height: 0
                        segwit-height: 0
                        taproot-height: 0))

    ;;; Read enforced spacing floor from chain policy.
    (define (coin-chain-min-block-spacing chain)
      (: chain-config? -> integer?)
      (let ((entry (assq 'min-block-spacing
                         (chain-config-extension chain 'policy '()))))
        (if (not (pair? entry))
            (error "coin-chain-min-block-spacing: chain publishes no spacing floor"))
        (cdr entry)))

    ;;; Read enforced future-drift allowance from chain policy.
    (define (coin-chain-max-future-drift chain)
      (: chain-config? -> integer?)
      (let ((entry (assq 'max-future-drift
                         (chain-config-extension chain 'policy '()))))
        (if (not (pair? entry))
            (error "coin-chain-max-future-drift: chain publishes no drift allowance"))
        (cdr entry)))

    ;;; Read the wallet's coinbase selection depth from chain policy.
    (define (coin-chain-wallet-coinbase-maturity chain)
      (: chain-config? -> integer?)
      (let ((entry (assq 'wallet-coinbase-maturity
                         (chain-config-extension chain 'policy '()))))
        (if (not (and (pair? entry)
                      (number? (cdr entry))
                      (integer? (cdr entry))
                      (> (cdr entry) 0)))
            (error
              "coin-chain-wallet-coinbase-maturity: chain publishes no valid depth"))
        (cdr entry)))

    ;;; Read the SegWit address human-readable prefix from a chain config.
    ;;;
    ;;; ```scheme
    ;;; (coin-chain-address-hrp sigilcoin-testnet-chain) ; => "tsgl"
    ;;; ```
    (define (coin-chain-address-hrp chain)
      (: chain-config? -> string?)
      (let ((entry (assq 'hrp
                         (chain-config-extension chain 'address '()))))
        (if (not (and (pair? entry) (string? (cdr entry))))
            (error "coin-chain-address-hrp: chain publishes no address HRP"))
        (cdr entry)))

    (define (extensions min-spacing max-future-drift genesis hrp
                        wallet-coinbase-maturity)
      (list
        (cons 'address (list (cons 'hrp hrp)))
        (cons 'consensus
              (list (cons 'rules (coin-header-rules min-spacing
                                                     max-future-drift))
                    ;; Shared node passes durable validated parents after H1;
                    ;; trusted configured genesis supplies H1's parent body.
                    (cons 'block-rules
                          (coin-block-rules-for-genesis genesis))))
        (cons 'mining
              (list (cons 'rule 'program-by-example)
                    (cons 'irc-channel coin-irc-channel)))
        (cons 'policy
              (list (cons 'min-block-spacing min-spacing)
                    (cons 'target-block-spacing coin-target-block-spacing)
                    (cons 'max-future-drift max-future-drift)
                    (cons 'wallet-coinbase-maturity
                          wallet-coinbase-maturity)
                    (cons 'median-time-span coin-median-time-span)
                    (cons 'max-block-bytes coin-max-block-bytes)
                    (cons 'max-solution-bytes coin-max-solution-bytes)
                    (cons 'max-graffiti-bytes coin-max-graffiti-bytes)
                    (cons 'max-supply coin-max-supply)
                    (cons 'max-coinbase-script-bytes
                          coin-max-coinbase-script-bytes)))))

    (define (config name network-id magic port seeds min-spacing
                    max-future-drift genesis hrp wallet-coinbase-maturity)
      (let ((header (block-header-field genesis)))
        (chain-config name: name
                      network-id: network-id
                      magic: magic
                      default-port: port
                      seed-peers: seeds
                      protocol-version: 70015
                      services: 1
                      user-agent: "/sigilcoin-node:0.1.0/"
                      genesis-header: header
                      genesis-hash: (block-header-hash header)
                      consensus-params: sigilcoin-consensus-params
                      extensions: (extensions
                                    min-spacing max-future-drift genesis hrp
                                    wallet-coinbase-maturity))))

    (define %main-genesis
      (coin-genesis-block coin-genesis-quote coin-genesis-time))

    (define %testnet-genesis
      (coin-genesis-block coin-testnet-genesis-quote
                          coin-testnet-genesis-time))

    (define %regtest-genesis
      (coin-genesis-block coin-regtest-genesis-quote
                          coin-regtest-genesis-time))

    ;;; Main SigilCoin network. Genesis timestamp remains non-final.
    (define sigilcoin-main-chain
      (config "sigilcoin-main"
              "sigilcoin-main"
              #u8(#x8f #xd1 #xc0 #xa5)
              19444
              '(("seed.sigilcoin.lol" . 19444))
              coin-min-block-spacing
              coin-max-future-drift
              %main-genesis
              "sgl"
              coin-main-wallet-coinbase-maturity))

    ;;; Public test network with canonical validation.
    (define sigilcoin-testnet-chain
      (config "sigilcoin-testnet"
              "sigilcoin-test"
              coin-testnet-network-magic
              19446
              '(("seed.testnet.sigilcoin.lol" . 19446))
              coin-testnet-min-block-spacing
              coin-testnet-max-future-drift
              %testnet-genesis
              "tsgl"
              1))

    ;;; Local development chain.
    (define sigilcoin-regtest-chain
      (config "sigilcoin-regtest"
              "sigilcoin-regtest"
              #u8(#xa5 #xc0 #xd1 #x8f)
              19445
              '()
              coin-regtest-min-block-spacing
              coin-max-future-drift
              %regtest-genesis
              "sgl"
              1))

    ;;; Return a SigilCoin chain config by canonical or short name.
    ;;;
    ;;; ```scheme
    ;;; (sigilcoin-chain-by-name "testnet") ; => sigilcoin-testnet-chain
    ;;; ```
    (define (sigilcoin-chain-by-name name)
      (: string? -> chain-config?)
      (cond ((or (string=? name "sigilcoin-main")
                 (string=? name "sigilcoin")
                 (string=? name "main")
                 (string=? name "mainnet"))
             sigilcoin-main-chain)
            ((or (string=? name "sigilcoin-testnet")
                 (string=? name "sigilcoin-test")
                 (string=? name "testnet"))
             sigilcoin-testnet-chain)
            ((or (string=? name "sigilcoin-regtest")
                 (string=? name "regtest"))
             sigilcoin-regtest-chain)
            (else
             (error (string-append
                      "sigilcoin-chain-by-name: unknown chain " name)))))))
