;;; (sigil coin node chain) — live SigilCoin chain configs
;;;
;;; Mainnet, public testnet, and regtest start fresh proof-of-golf chains.
;;; Fixed timestamp slots and additive program savings replace hash search.

(define-library (sigil coin node chain)
  (import (sigil bitcoin consensus)
          (sigil bitcoin node)
          (sigil coin consensus)
          (sigil coin node rules)
          (sigil coin node body)
          (sigil coin node genesis))
  (export
    coin-target-block-spacing
    coin-testnet-target-block-spacing
    coin-regtest-target-block-spacing
    coin-main-pow-limit-bits
    coin-testnet-pow-limit-bits
    coin-regtest-pow-limit-bits
    coin-testnet-network-magic
    coin-main-checkpoint-one-hash
    coin-testnet-min-block-spacing
    coin-regtest-min-block-spacing
    coin-testnet-max-future-drift
    coin-main-wallet-coinbase-maturity
    coin-chain-min-block-spacing
    coin-chain-max-future-drift
    coin-chain-address-hrp
    coin-chain-wallet-coinbase-maturity
    coin-irc-channel
    coin-genesis-quote
    coin-genesis-time
    coin-testnet-genesis-quote
    coin-testnet-genesis-time
    coin-regtest-genesis-quote
    coin-regtest-genesis-time
    sigilcoin-main-consensus-params
    sigilcoin-testnet-consensus-params
    sigilcoin-regtest-consensus-params
    sigilcoin-main-chain
    sigilcoin-testnet-chain
    sigilcoin-regtest-chain
    sigilcoin-chain-by-name)

  (begin

    ;;; Mainnet slot spacing: one day.
    (define coin-target-block-spacing 86400)

    ;;; Public testnet slot spacing: one hour.
    (define coin-testnet-target-block-spacing 3600)

    ;;; Regtest slot spacing: one second.
    (define coin-regtest-target-block-spacing 1)

    ;;; Fixed per-network compact bits, retained in the 80-byte header.
    (define coin-main-pow-limit-bits #x1c2bcf04)
    (define coin-testnet-pow-limit-bits #x1f00ffff)
    (define coin-regtest-pow-limit-bits #x2000ffff)

    ;;; Longest-chain/checkpoint public-testnet transport magic: "SGT3".
    (define coin-testnet-network-magic #u8(#x53 #x47 #x54 #x33))

    ;;; Internal hash pinned by the first post-genesis mainnet checkpoint.
    (define coin-main-checkpoint-one-hash
      #u8(#x24 #xf2 #xcb #xbf #x4a #x5d #xbb #xce
          #x67 #xab #xbc #xc0 #x47 #xe3 #x00 #xcd
          #xa1 #x7c #x60 #x0e #x7a #xb3 #x56 #x58
          #x46 #xd2 #x7a #x0e #xb6 #xb0 #x41 #xd2))

    ;;; Exact timestamp spacing on the smaller networks.
    (define coin-testnet-min-block-spacing 3600)
    (define coin-regtest-min-block-spacing 1)

    ;;; No network admits a future production slot.
    (define coin-testnet-max-future-drift 0)

    ;;; Mainnet wallet policy waits six confirmations before selecting a
    ;;; coinbase, while consensus still permits spending it in the next block.
    (define coin-main-wallet-coinbase-maturity 6)

    ;;; Miner community channel.
    (define coin-irc-channel "#systemcrafters")

    ;;; Mainnet genesis quote.
    (define coin-genesis-quote
      "SigilCoin proof-of-golf mainnet")

    ;;; Mainnet timestamp: 2026-09-12T16:00:00Z.
    (define coin-genesis-time 1789228800)

    ;;; Replacement public-testnet genesis marker.
    (define coin-testnet-genesis-quote
      "SigilCoin proof-of-golf testnet")

    ;;; Fixed testnet genesis timestamp: 2026-09-02T00:00:00Z.
    (define coin-testnet-genesis-time 1788307200)

    ;;; Regtest genesis quote.
    (define coin-regtest-genesis-quote
      "SigilCoin proof-of-golf regtest")

    ;;; Fixed regtest genesis timestamp: 2026-01-01T00:00:00Z.
    (define coin-regtest-genesis-time 1767225600)

    ;; Retain the shared parameter shape; only puzzle complexity retargets.
    (define (coin-params pow-limit-bits target-spacing)
      (consensus-params
        pow-limit-bits: pow-limit-bits
        target-spacing: target-spacing
        target-timespan: (* (- coin-retarget-window 1) target-spacing)
        retarget-interval: coin-retarget-window
        bip34-height: 0
        bip66-height: 0
        bip65-height: 0
        csv-height: 0
        segwit-height: 0
        taproot-height: 0))

    (define sigilcoin-main-consensus-params
      (coin-params coin-main-pow-limit-bits coin-target-block-spacing))

    (define sigilcoin-testnet-consensus-params
      (coin-params coin-testnet-pow-limit-bits
                   coin-testnet-target-block-spacing))

    (define sigilcoin-regtest-consensus-params
      (coin-params coin-regtest-pow-limit-bits
                   coin-regtest-target-block-spacing))

    ;;; Read exact slot spacing from chain policy.
    (define (coin-chain-min-block-spacing chain)
      (: chain-config? -> integer?)
      (let ((entry (assq 'min-block-spacing
                         (chain-config-extension chain 'policy '()))))
        (if (not (pair? entry))
            (error "coin-chain-min-block-spacing: chain publishes no slot spacing"))
        (cdr entry)))

    ;;; Read enforced future-drift allowance from chain policy.
    (define (coin-chain-max-future-drift chain)
      (: chain-config? -> integer?)
      (let ((entry (assq 'max-future-drift
                         (chain-config-extension chain 'policy '()))))
        (if (not (pair? entry))
            (error "coin-chain-max-future-drift: chain publishes no drift allowance"))
        (cdr entry)))

    ;;; Read the wallet's coinbase selection depth from chain policy.
    (define (coin-chain-wallet-coinbase-maturity chain)
      (: chain-config? -> integer?)
      (let ((entry (assq 'wallet-coinbase-maturity
                         (chain-config-extension chain 'policy '()))))
        (if (not (and (pair? entry)
                      (number? (cdr entry))
                      (integer? (cdr entry))
                      (> (cdr entry) 0)))
            (error
              "coin-chain-wallet-coinbase-maturity: chain publishes no valid depth"))
        (cdr entry)))

    ;;; Read the SegWit address human-readable prefix from a chain config.
    ;;;
    ;;; ```scheme
    ;;; (coin-chain-address-hrp sigilcoin-testnet-chain) ; => "tsgl"
    ;;; ```
    (define (coin-chain-address-hrp chain)
      (: chain-config? -> string?)
      (let ((entry (assq 'hrp
                         (chain-config-extension chain 'address '()))))
        (if (not (and (pair? entry) (string? (cdr entry))))
            (error "coin-chain-address-hrp: chain publishes no address HRP"))
        (cdr entry)))

    (define (extensions min-spacing max-future-drift genesis params hrp
                        wallet-coinbase-maturity released-checkpoints)
      (list
        (cons 'address (list (cons 'hrp hrp)))
        (cons 'consensus
              (list (cons 'rules (coin-header-rules min-spacing
                                                     max-future-drift))
                    ;; Shared node passes durable validated parents after H1;
                    ;; trusted configured genesis supplies H1's parent body.
                    (cons 'block-rules
                          (coin-block-rules-for-genesis genesis))))
        (cons 'checkpoints
              (cons
                (cons 0
                      (block-header-hash
                        (block-header-field genesis)))
                released-checkpoints))
        (cons 'mining
              (list (cons 'rule 'proof-of-golf)
                    (cons 'irc-channel coin-irc-channel)))
        (cons 'policy
              (list (cons 'min-block-spacing min-spacing)
                    (cons 'target-block-spacing
                          (consensus-params-target-spacing params))
                    (cons 'retarget-interval
                          (consensus-params-retarget-interval params))
                    (cons 'pow-limit-bits
                          (consensus-params-pow-limit-bits params))
                    (cons 'max-future-drift max-future-drift)
                    (cons 'wallet-coinbase-maturity
                          wallet-coinbase-maturity)
                    (cons 'median-time-span coin-median-time-span)
                    (cons 'max-block-bytes coin-max-block-bytes)
                    (cons 'max-mempool-transaction-bytes
                          coin-max-block-bytes)
                    (cons 'max-mempool-bytes
                          (* 64 coin-max-block-bytes))
                    (cons 'max-mempool-count 1024)
                    (cons 'max-unsettled-headers 4096)
                    (cons 'verify-mempool-scripts? #t)
                    (cons 'max-solution-bytes coin-max-solution-bytes)
                    (cons 'max-graffiti-bytes coin-max-graffiti-bytes)
                    (cons 'max-supply coin-max-supply)
                    (cons 'max-coinbase-script-bytes
                          coin-max-coinbase-script-bytes)))))

    (define (config name network-id magic port seeds min-spacing
                    max-future-drift genesis params hrp
                    wallet-coinbase-maturity released-checkpoints)
      (let ((header (block-header-field genesis)))
        (chain-config name: name
                      network-id: network-id
                      magic: magic
                      default-port: port
                      seed-peers: seeds
                      protocol-version: 70015
                      services: 1
                      user-agent: "/sigilcoin-node:0.1.0/"
                      genesis-header: header
                      genesis-hash: (block-header-hash header)
                      consensus-params: params
                      extensions: (extensions
                                    min-spacing max-future-drift genesis params
                                    hrp wallet-coinbase-maturity
                                    released-checkpoints))))

    (define %main-genesis
      (coin-genesis-block
        coin-genesis-quote coin-genesis-time coin-main-pow-limit-bits))

    (define %testnet-genesis
      (coin-genesis-block
        coin-testnet-genesis-quote coin-testnet-genesis-time
        coin-testnet-pow-limit-bits))

    (define %regtest-genesis
      (coin-genesis-block
        coin-regtest-genesis-quote coin-regtest-genesis-time
        coin-regtest-pow-limit-bits))

    ;;; Main SigilCoin network.
    (define sigilcoin-main-chain
      (config "sigilcoin-main"
              "sigilcoin-main"
              #u8(#x53 #x47 #x4d #x33)
              19444
              '(("seed.sigilcoin.lol" . 19444))
              coin-min-block-spacing
              coin-max-future-drift
              %main-genesis
              sigilcoin-main-consensus-params
              "sgl"
              coin-main-wallet-coinbase-maturity
              (list
                (cons 1 coin-main-checkpoint-one-hash))))

    ;;; Public test network with canonical validation.
    (define sigilcoin-testnet-chain
      (config "sigilcoin-testnet"
              "sigilcoin-test"
              coin-testnet-network-magic
              19446
              '(("seed.testnet.sigilcoin.lol" . 19446))
              coin-testnet-min-block-spacing
              coin-testnet-max-future-drift
              %testnet-genesis
              sigilcoin-testnet-consensus-params
              "tsgl"
              1
              '()))

    ;;; Local development chain.
    (define sigilcoin-regtest-chain
      (config "sigilcoin-regtest"
              "sigilcoin-regtest"
              #u8(#x53 #x47 #x52 #x33)
              19445
              '()
              coin-regtest-min-block-spacing
              coin-max-future-drift
              %regtest-genesis
              sigilcoin-regtest-consensus-params
              "sgl"
              1
              '()))

    ;;; Return a SigilCoin chain config by canonical or short name.
    ;;;
    ;;; ```scheme
    ;;; (sigilcoin-chain-by-name "testnet") ; => sigilcoin-testnet-chain
    ;;; ```
    (define (sigilcoin-chain-by-name name)
      (: string? -> chain-config?)
      (cond ((or (string=? name "sigilcoin-main")
                 (string=? name "sigilcoin")
                 (string=? name "main")
                 (string=? name "mainnet"))
             sigilcoin-main-chain)
            ((or (string=? name "sigilcoin-testnet")
                 (string=? name "sigilcoin-test")
                 (string=? name "testnet"))
             sigilcoin-testnet-chain)
            ((or (string=? name "sigilcoin-regtest")
                 (string=? name "regtest"))
             sigilcoin-regtest-chain)
            (else
             (error (string-append
                      "sigilcoin-chain-by-name: unknown chain " name)))))))
