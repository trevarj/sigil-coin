;;; (sigil coin node body) — canonical block-body validation
;;;
;;; Deterministic body order: size/merkle/header, payload and codecs, cheap
;;; share shape/order/commit/dedup, cheap payout shape/value checks,
;;; breadth-first share source preparation, breadth-first signatures, producer
;;; PBE, share PBE, verified contributions, exact payouts, encoded solution
;;; length equality, then Bitcoin connection.

(define-library (sigil coin node body)
  (import (sigil math)
          (sigil bitcoin utils)
          (sigil bitcoin tx)
          (sigil bitcoin consensus)
          (sigil coin puzzle)
          (sigil coin consensus)
          (only (sigil coin consensus shares)
                coin-check-shares-cheap
                coin-prepare-shares
                coin-check-share-signatures
                coin-verify-prepared-shares
                coin-coop-context-derivation-count
                coin-coop-context-signature-count
                coin-coop-context-example-count)
          (sigil coin node rules))
  (export
    coin-parent-context
    coin-body-validation-stats
    coin-block-solution-length
    coin-connect-block
    coin-block-rules
    coin-block-rules-for-genesis)

  (begin

    (define (require-coin-ok who result)
      (if (coin-failed? result)
          (error (string-append who
                                ": "
                                (symbol->string (coin-result-reason result))
                                " ("
                                (coin-result-detail result)
                                ")")))
      (coin-result-value result))

    ;;; Build share-validation context from a validated parent block.
    (define (coin-parent-context parent-block)
      (: block? -> coin-coop-context?)
      (let* ((header (block-header-field parent-block))
             (payload (require-coin-ok
                        "coin-parent-context: coinbase"
                        (coin-block-coinbase-payload parent-block)))
             (complexity (require-coin-ok
                           "coin-parent-context: bits"
                           (coin-header-complexity header)))
             (commits (require-coin-ok
                        "coin-parent-context: commits"
                        (coin-commits-decode
                          (coin-coinbase-payload-commits payload))))
             (height (coin-coinbase-payload-height payload))
             (previous-hash (block-header-previous-block header)))
        (coin-coop-context
          parent-prev-hash: previous-hash
          puzzle-height: height
          complexity: complexity
          spec: (coin-node-puzzle previous-hash height complexity)
          commits: commits)))

    ;; Validate a producer solution and return its exact encoded byte length.
    (define (check-producer-solution previous-hash height complexity solution)
      (let* ((spec (coin-node-puzzle previous-hash height complexity))
             (checked (coin-check-solution spec solution)))
        (if (coin-failed? checked)
            checked
            (coin-ok (coin-solution-length solution)))))

    ;; Latest bounded validation counters for tests and diagnostics only.
    (define %last-validation-stats '(0 0 0))

    ;;; Latest `(share-derivations signatures share-PBE-evaluations)` tuple.
    ;;;
    ;;; Producer derivation is intentionally absent: it goes through the
    ;;; chain-wide puzzle cache and can legitimately cost either one cold
    ;;; derivation or zero on a hit. Cache tests pin that behavior directly;
    ;;; putting a hardcoded `1` here made this diagnostic claim work it did not
    ;;; observe.
    (define (coin-body-validation-stats)
      (: -> list?)
      %last-validation-stats)

    (define (record-validation-stats! context)
      (set! %last-validation-stats
            (list (if context
                      (coin-coop-context-derivation-count context)
                      0)
                  (if context
                      (coin-coop-context-signature-count context)
                      0)
                  (if context
                      (coin-coop-context-example-count context)
                      0))))

    (define (metadata-context-for parent-block header height)
      (cond
        ((= height 0) #f)
        ((not parent-block)
         (error "coin-block-solution-length: missing validated parent block"))
        ((not (equal? (block-header-hash (block-header-field parent-block))
                      (block-header-previous-block header)))
         (error "coin-block-solution-length: parent block does not match the header"))
        (else
          (let* ((parent-header (block-header-field parent-block))
                 (payload (require-coin-ok
                            "coin-parent-context: coinbase"
                            (coin-block-coinbase-payload parent-block)))
                 (parent-complexity
                   (require-coin-ok
                     "coin-parent-context: bits"
                     (coin-header-complexity parent-header)))
                 (commits
                   (require-coin-ok
                     "coin-parent-context: commits"
                     (coin-commits-decode
                       (coin-coinbase-payload-commits payload)))))
            (coin-coop-context
              parent-prev-hash: (block-header-previous-block parent-header)
              puzzle-height: (coin-coinbase-payload-height payload)
              complexity: parent-complexity
              spec: #f
              commits: commits)))))

    ;; Parse and run every cheap share check. Return
    ;; `(shares metadata-context payload)` without deriving a puzzle.
    (define (prepare-block-claims parent-block height b)
      (guard (e (#t (coin-error 'internal-error
                                "the cheap block claim check raised")))
        (let ((decoded (coin-block-coinbase-payload b)))
          (if (coin-failed? decoded)
              decoded
              (let* ((header (block-header-field b))
                     (payload (coin-result-value decoded))
                     (commits (coin-commits-decode
                                (coin-coinbase-payload-commits payload)))
                     (shares-result (coin-shares-decode
                                      (coin-coinbase-payload-shares payload))))
                (cond
                  ((not (= height (coin-coinbase-payload-height payload)))
                   (coin-error 'height-mismatch
                               "the coinbase height is not the block height"))
                  ((coin-failed? commits) commits)
                  ((coin-failed? shares-result) shares-result)
                  (else
                    (let* ((shares (coin-result-value shares-result))
                           (context
                             (metadata-context-for parent-block header height)))
                      (cond
                        ((and (pair? shares) (not context))
                         (coin-error 'shares-at-genesis
                                     "genesis carries no shares"))
                        ((and context
                              (not (= (coin-coop-context-puzzle-height context)
                                      (- height 1))))
                         (coin-error 'internal-error
                                     "co-op context is for the wrong height"))
                        ((null? shares)
                         (coin-ok (list shares context payload)))
                        (else
                          (let ((cheap
                                  (coin-check-shares-cheap
                                    context
                                    (coin-coinbase-payload-solution payload)
                                    shares)))
                            (if (coin-failed? cheap)
                                cheap
                                (coin-ok (list shares context payload))))))))))))))

    ;; Prepare sources, verify signatures, validate producer, then run share
    ;; examples and reuse verified reports for payout contributions. Return
    ;; `(solution-length shares contributions context payload)`.
    (define (finish-block-claims parent-block height complexity header prepared)
      (guard (e (#t (coin-error 'internal-error
                                "the expensive block claim check raised")))
        (let* ((shares (car prepared))
               (payload (list-ref prepared 2))
               (context (if (null? shares)
                            #f
                            (coin-parent-context parent-block)))
               (producer
                 (lambda ()
                   (check-producer-solution
                     (block-header-previous-block header)
                     height
                     complexity
                     (coin-coinbase-payload-solution payload)))))
          (if (null? shares)
              (let ((checked (producer)))
                (if (coin-failed? checked)
                    checked
                    (coin-ok (list (coin-result-value checked)
                                   shares '() context payload))))
              (let ((source-check (coin-prepare-shares context shares)))
                (record-validation-stats! context)
                (if (coin-failed? source-check)
                    source-check
                    (let ((signature-check
                            (coin-check-share-signatures context shares)))
                      (record-validation-stats! context)
                      (if (coin-failed? signature-check)
                          signature-check
                          ;; Producer PBE deliberately precedes share PBE.
                          (let ((producer-check (producer)))
                            (record-validation-stats! context)
                            (if (coin-failed? producer-check)
                                producer-check
                                (let ((share-check
                                        (coin-verify-prepared-shares
                                          context shares)))
                                  (record-validation-stats! context)
                                  (if (coin-failed? share-check)
                                      share-check
                                      (let* ((verified-shares
                                               (coin-result-value share-check))
                                             (contributions
                                               (map
                                                 (lambda (share)
                                                   (coin-share-quality
                                                     context share))
                                                 verified-shares)))
                                        (coin-ok
                                          (list
                                            (coin-result-value producer-check)
                                            verified-shares
                                            contributions
                                            context
                                            payload)))))))))))))))

    (define (check-block-claims parent-block height complexity b)
      (set! %last-validation-stats '(0 0 0))
      (let ((prepared (prepare-block-claims parent-block height b)))
        (if (coin-failed? prepared)
            prepared
            (finish-block-claims
              parent-block height complexity (block-header-field b)
              (coin-result-value prepared)))))

    ;;; Validate block claims and return the actual producer solution length.
    (define (coin-block-solution-length parent-block height complexity b)
      (: any? any? any? any? -> coin-result?)
      (let ((checked (check-block-claims parent-block height complexity b)))
        (if (coin-failed? checked)
            checked
            (coin-ok (car (coin-result-value checked))))))

    ;; Fee arithmetic before Bitcoin's mutating connector. This mirrors only
    ;; value flow; Bitcoin still owns structural, maturity and script checks.
    (define (outpoint=? a b)
      (and (= (outpoint-index a) (outpoint-index b))
           (or (equal? (outpoint-txid a) (outpoint-txid b))
               (equal? (outpoint-txid a)
                       (reverse-bytevector (outpoint-txid b))))))

    (define (member-outpoint? op xs)
      (let loop ((ys xs))
        (and (pair? ys)
             (or (outpoint=? op (car ys)) (loop (cdr ys))))))

    (define (local-output op outputs)
      (let loop ((xs outputs))
        (cond ((null? xs) #f)
              ((outpoint=? op (car (car xs))) (cdr (car xs)))
              (else (loop (cdr xs))))))

    (define (input-output utxos local op)
      (or (local-output op local)
          (let ((entry (utxo-set-lookup utxos op)))
            (and entry (utxo-entry-output entry)))))

    (define (transaction-input-value tx utxos local spent)
      (let loop ((inputs (transaction-inputs tx)) (total 0) (used spent))
        (if (null? inputs)
            (cons total used)
            (let* ((op (txin-previous-output (car inputs)))
                   (output (input-output utxos local op)))
              (if (or (member-outpoint? op used) (not output))
                  (error "coin-connect-block: missing or repeated input"))
              (loop (cdr inputs)
                    (+ total (txout-value output))
                    (cons op used))))))

    (define (add-local-outputs tx local)
      (let ((txid (transaction-txid tx)))
        (let loop ((outputs (transaction-outputs tx)) (index 0) (out local))
          (if (null? outputs)
              out
              (loop (cdr outputs)
                    (+ index 1)
                    (cons (cons (outpoint txid: txid index: index)
                                (car outputs))
                          out))))))

    (define (block-fees b utxos)
      (let loop ((txs (cdr (block-transactions b)))
                 (local '())
                 (spent '())
                 (fees 0))
        (if (null? txs)
            fees
            (let* ((input (transaction-input-value (car txs)
                                                   utxos local spent))
                   (fee (- (car input)
                           (transaction-output-value (car txs)))))
              (if (< fee 0)
                  (error "coin-connect-block: transaction overspends"))
              (loop (cdr txs)
                    (add-local-outputs (car txs) local)
                    (cdr input)
                    (+ fees fee))))))

    ;;; Validate a block with its explicit validated parent body.
    (define (coin-connect-block rules params height utxos b verify-scripts?
                                   parent-block)
      (: block-rules? consensus-params? integer? list? block? any? any? -> list?)
      (set! %last-validation-stats '(0 0 0))
      (require-coin-ok "coin-connect-block: block size"
                       (coin-validate-block-size b))
      (unless (block-merkle-root-valid? b)
        (error "coin-connect-block: invalid-merkle-root"))
      (let* ((header (block-header-field b)))
        (unless (= coin-header-version (block-header-version header))
          (error "coin-connect-block: wrong-version"))
        ;; Header acceptance binds complexity and lottery qualification to
        ;; chain history. Body validation proves the encoded length claim.
        (let* ((complexity (require-coin-ok
                             "coin-connect-block: bits"
                             (coin-header-complexity header)))
               (claimed-length
                 (require-coin-ok
                   "coin-connect-block: bits"
                   (coin-header-solution-length header))))
          (let* ((prepared-result
                   (prepare-block-claims parent-block height b))
                 (prepared
                   (require-coin-ok "coin-connect-block: claims"
                                    prepared-result))
                 (shares (car prepared))
                 (coinbase (car (block-transactions b)))
                 (carrier (and (pair? shares)
                               (coin-carrier-script parent-block)))
                 (subsidy ((block-rules-subsidy rules) height))
                 (fees (block-fees b utxos)))
            (require-coin-ok
              "coin-connect-block: cheap payout"
              (coin-check-payout-cheap
                coinbase subsidy fees shares carrier))
            (let* ((checked
                     (finish-block-claims
                       parent-block height complexity header prepared))
                   (value
                     (require-coin-ok "coin-connect-block: claims" checked))
                   (actual-length (car value))
                   (verified-shares (list-ref value 1))
                   (contributions (list-ref value 2)))
              (require-coin-ok
                "coin-connect-block: payout"
                (coin-check-payout
                  coinbase subsidy fees
                  verified-shares contributions carrier))
              (unless (= claimed-length actual-length)
                (error "coin-connect-block: solution-length-mismatch"))))))
      ((block-rules-connect bitcoin-block-rules)
       rules params height utxos b verify-scripts? parent-block))

    (define coin-block-rules
      (block-rules connect: coin-connect-block
                   subsidy: coin-block-reward
                   coinbase-maturity: 1
                   coinbase-script-bounds: coin-coinbase-script-bounds))

    ;;; Build rules that provide trusted configured genesis to block one.
    (define (coin-block-rules-for-genesis genesis)
      (: block? -> block-rules?)
      (block-rules
        connect: (lambda (rules params height utxos b verify-scripts?
                                parent-block)
                   (coin-connect-block
                     rules params height utxos b verify-scripts?
                     (if (and (= height 1) (not parent-block))
                         genesis
                         parent-block)))
        subsidy: coin-block-reward
        coinbase-maturity:
          (block-rules-coinbase-maturity coin-block-rules)
        coinbase-script-bounds: coin-coinbase-script-bounds))))
