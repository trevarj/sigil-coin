;;; (sigil coin node body) — canonical block-body validation
;;;
;;; Size and header fields are gated before any program runs. Producer and
;;; personalized share programs are then checked, reward outputs are checked
;;; against the exact 2/1/1 split, and only then does Bitcoin's connector
;;; mutate the UTXO set.

(define-library (sigil coin node body)
  (import (sigil math)
          (sigil bitcoin utils)
          (sigil bitcoin tx)
          (sigil bitcoin consensus)
          (sigil coin puzzle)
          (sigil coin consensus)
          (sigil coin node rules))
  (export
    coin-score-for-solution
    coin-parent-context
    coin-block-score
    coin-connect-block
    coin-block-rules
    coin-block-rules-for-genesis)

  (begin

    (define (require-coin-ok who result)
      (if (coin-failed? result)
          (error (string-append who
                                ": "
                                (symbol->string (coin-result-reason result))
                                " ("
                                (coin-result-detail result)
                                ")")))
      (coin-result-value result))

    ;;; Build share-validation context from a validated parent block.
    (define (coin-parent-context parent-block)
      (: block? -> coin-coop-context?)
      (let* ((header (block-header-field parent-block))
             (payload (require-coin-ok
                        "coin-parent-context: coinbase"
                        (coin-block-coinbase-payload parent-block)))
             (complexity (require-coin-ok
                           "coin-parent-context: bits"
                           (coin-header-complexity header)))
             (commits (require-coin-ok
                        "coin-parent-context: commits"
                        (coin-commits-decode
                          (coin-coinbase-payload-commits payload))))
             (height (coin-coinbase-payload-height payload))
             (previous-hash (block-header-previous-block header)))
        (coin-coop-context
          parent-prev-hash: previous-hash
          puzzle-height: height
          complexity: complexity
          spec: (coin-node-puzzle previous-hash height complexity)
          commits: commits)))

    ;;; Score a producer solution with aggregate personalized-share quality.
    (define (coin-score-for-solution previous-hash height complexity
                                        solution quality)
      (: bytevector? integer? integer? any? integer? -> coin-result?)
      (let* ((spec (coin-node-puzzle previous-hash height complexity))
             (checked (coin-check-solution spec solution)))
        (if (coin-failed? checked)
            checked
            (let ((report (coin-result-value checked)))
              (coin-ok
                (coin-score-encode
                  (coin-solution-length solution)
                  (puzzle-report-cells report)
                  (puzzle-report-steps report)
                  quality))))))

    (define (context-for parent-block header height)
      (cond
        ((= height 0) #f)
        ((not parent-block)
         (error "coin-block-score: missing validated parent block"))
        ((not (equal? (block-header-hash (block-header-field parent-block))
                      (block-header-previous-block header)))
         (error "coin-block-score: parent block does not match the header"))
        (else (coin-parent-context parent-block))))

    ;; Validate mining claims and return `(score shares context payload)`.
    (define (check-block-claims parent-block height complexity b)
      (guard (e (#t (coin-error 'internal-error "the block score check raised")))
        (let ((decoded (coin-block-coinbase-payload b)))
          (if (coin-failed? decoded)
              decoded
              (let* ((header (block-header-field b))
                     (payload (coin-result-value decoded))
                     (context (context-for parent-block header height)))
                (if (not (= height (coin-coinbase-payload-height payload)))
                    (coin-error 'height-mismatch
                                "the coinbase height is not the block height")
                    (let ((coop (coin-check-coop payload context)))
                      (if (coin-failed? coop)
                          coop
                          (let* ((shares (coin-result-value coop))
                                 (quality (if (null? shares)
                                              0
                                              (coin-shares-quality
                                                context shares)))
                                 (scored (coin-score-for-solution
                                           (block-header-previous-block header)
                                           height
                                           complexity
                                           (coin-coinbase-payload-solution
                                             payload)
                                           quality)))
                            (if (coin-failed? scored)
                                scored
                                (coin-ok (list (coin-result-value scored)
                                               shares
                                               context
                                               payload))))))))))))

    ;;; Recompute exact header score from producer and personalized shares.
    (define (coin-block-score parent-block height complexity b)
      (: any? any? any? any? -> coin-result?)
      (let ((checked (check-block-claims parent-block height complexity b)))
        (if (coin-failed? checked)
            checked
            (coin-ok (car (coin-result-value checked))))))

    ;; Fee arithmetic before Bitcoin's mutating connector. This mirrors only
    ;; value flow; Bitcoin still owns structural, maturity and script checks.
    (define (outpoint=? a b)
      (and (= (outpoint-index a) (outpoint-index b))
           (or (equal? (outpoint-txid a) (outpoint-txid b))
               (equal? (outpoint-txid a)
                       (reverse-bytevector (outpoint-txid b))))))

    (define (member-outpoint? op xs)
      (let loop ((ys xs))
        (and (pair? ys)
             (or (outpoint=? op (car ys)) (loop (cdr ys))))))

    (define (local-output op outputs)
      (let loop ((xs outputs))
        (cond ((null? xs) #f)
              ((outpoint=? op (car (car xs))) (cdr (car xs)))
              (else (loop (cdr xs))))))

    (define (input-output utxos local op)
      (or (local-output op local)
          (let ((entry (utxo-set-lookup utxos op)))
            (and entry (utxo-entry-output entry)))))

    (define (transaction-input-value tx utxos local spent)
      (let loop ((inputs (transaction-inputs tx)) (total 0) (used spent))
        (if (null? inputs)
            (cons total used)
            (let* ((op (txin-previous-output (car inputs)))
                   (output (input-output utxos local op)))
              (if (or (member-outpoint? op used) (not output))
                  (error "coin-connect-block: missing or repeated input"))
              (loop (cdr inputs)
                    (+ total (txout-value output))
                    (cons op used))))))

    (define (add-local-outputs tx local)
      (let ((txid (transaction-txid tx)))
        (let loop ((outputs (transaction-outputs tx)) (index 0) (out local))
          (if (null? outputs)
              out
              (loop (cdr outputs)
                    (+ index 1)
                    (cons (cons (outpoint txid: txid index: index)
                                (car outputs))
                          out))))))

    (define (block-fees b utxos)
      (let loop ((txs (cdr (block-transactions b)))
                 (local '())
                 (spent '())
                 (fees 0))
        (if (null? txs)
            fees
            (let* ((input (transaction-input-value (car txs)
                                                   utxos local spent))
                   (fee (- (car input)
                           (transaction-output-value (car txs)))))
              (if (< fee 0)
                  (error "coin-connect-block: transaction overspends"))
              (loop (cdr txs)
                    (add-local-outputs (car txs) local)
                    (cdr input)
                    (+ fees fee))))))

    ;;; Validate a block with its explicit validated parent body.
    (define (coin-connect-block rules params height utxos b verify-scripts?
                                   parent-block)
      (: block-rules? consensus-params? integer? list? block? any? any? -> list?)
      (require-coin-ok "coin-connect-block: block size"
                       (coin-validate-block-size b))
      (let* ((header (block-header-field b))
             (claimed (coin-header-score header)))
        (unless (= coin-header-version (block-header-version header))
          (error "coin-connect-block: wrong-version"))
        ;; Header acceptance binds this decoded value to chain-derived
        ;; retarget history before any body can reach this connector.
        (let* ((complexity (require-coin-ok
                             "coin-connect-block: bits"
                             (coin-header-complexity header)))
               (checked (check-block-claims parent-block height complexity b))
               (value (require-coin-ok "coin-connect-block: score" checked))
               (score (car value))
               (shares (cadr value))
               (coinbase (car (block-transactions b)))
               (carrier (and (pair? shares)
                             (coin-carrier-script parent-block)))
               (total (+ ((block-rules-subsidy rules) height)
                         (block-fees b utxos))))
          (require-coin-ok "coin-connect-block: score"
                           (coin-score-check claimed))
          (unless (= claimed score)
            (error "coin-connect-block: score-mismatch"))
          (require-coin-ok "coin-connect-block: split"
                           (coin-check-split coinbase total shares carrier))))
      ((block-rules-connect bitcoin-block-rules)
       rules params height utxos b verify-scripts? parent-block))

    (define coin-block-rules
      (block-rules connect: coin-connect-block
                   subsidy: coin-block-reward
                   coinbase-script-bounds: coin-coinbase-script-bounds))

    ;;; Build rules that provide trusted configured genesis to block one.
    (define (coin-block-rules-for-genesis genesis)
      (: block? -> block-rules?)
      (block-rules
        connect: (lambda (rules params height utxos b verify-scripts?
                                parent-block)
                   (coin-connect-block
                     rules params height utxos b verify-scripts?
                     (if (and (= height 1) (not parent-block))
                         genesis
                         parent-block)))
        subsidy: coin-block-reward
        coinbase-script-bounds: coin-coinbase-script-bounds))))
