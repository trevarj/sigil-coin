;;; (sigil coin node genesis) — the deterministic genesis builder
;;;
;;; Genesis is not mined: nobody competes for it, because there is no parent
;;; hash to derive a puzzle from until it exists. It is BUILT, from two
;;; inputs and nothing else — a graffiti quote and a timestamp — so anyone
;;; can rebuild the chain's first block and check it byte for byte against
;;; the constants a chain config carries.
;;;
;;; What is fixed rather than chosen:
;;;
;;;   * the SOLUTION is `puzzle-spec-solution` of the genesis puzzle, the one
;;;     `coin-puzzle-for` derives from the frozen `coin-genesis-seed`. Genesis
;;;     is therefore a real, verifiable SigilCoin block: it carries a solution
;;;     that `coin-verify-block-solution` accepts at height 0.
;;;   * the REWARD is nothing. `coin-block-reward` pays 0 at height 0, and the
;;;     single output is a 0-value `OP_RETURN`. There is no premine, and the
;;;     output is provably unspendable rather than merely unspent — no key
;;;     exists that could ever move it, so the emission schedule starts at
;;;     height 1 with an empty UTXO set.
;;;   * the HEADER fields SigilCoin freezes: version, `bits` and nonce all
;;;     come from `(sigil coin node rules)`, so genesis satisfies the same
;;;     `accept?` every later header does.
;;;
;;; Only the quote and the timestamp vary, which is what lets one builder
;;; serve mainnet and a local test chain.
;;;
;;; REGENERATING THE CONSTANTS is one call:
;;;
;;; ```scheme
;;; (coin-genesis-header-hex coin-genesis-quote coin-genesis-time)
;;; ; => the 160-character header hex to paste into the chain config
;;; ```
;;;
;;; The chain config stores that hex, and a test rebuilds genesis from the
;;; quote and asserts it reproduces the stored bytes, so the constants and
;;; the builder cannot drift apart.

(define-library (sigil coin node genesis)
  (import (sigil math)
          ;; `string->utf8` lives in (sigil io); the quote is text on the way
          ;; in and bytes everywhere after.
          (sigil io)
          (sigil bitcoin utils)
          (sigil bitcoin encoding)
          (sigil bitcoin tx)
          (sigil bitcoin consensus)
          (sigil coin puzzle generator)
          (sigil coin consensus)
          (sigil coin node rules))
  (export
    coin-genesis-solution
    coin-genesis-script-pubkey
    coin-genesis-coinbase
    coin-genesis-block
    coin-genesis-header
    coin-genesis-hash
    coin-genesis-header-hex)

  (begin

    (define %zero32 (make-bytevector 32 0))
    (define %coinbase-index #xffffffff)
    (define %sequence-final #xffffffff)

    ;; A bare `OP_RETURN`. Any script beginning with it fails immediately when
    ;; evaluated, so the output can never be spent by anyone, including us.
    (define %op-return #u8(#x6a))

    ;;; The genesis puzzle's solution, as the coinbase carries it.
    ;;;
    ;;; Derived, never written down: it is the generator's own solution to
    ;;; the puzzle `coin-genesis-seed` produces, so a change to the puzzle
    ;;; language or the generator changes genesis and is visible as a changed
    ;;; genesis hash rather than as a silent divergence.
    ;;;
    ;;; ```scheme
    ;;; (coin-ok? (coin-check-solution (coin-puzzle-for (make-bytevector 32 0) 0)
    ;;;                                coin-genesis-solution))
    ;;; ; => #t
    ;;; ```
    (define coin-genesis-solution
      (string->utf8 (puzzle-spec-solution (coin-puzzle-for %zero32 0))))

    ;;; The genesis output script: an unspendable `OP_RETURN`.
    ;;;
    ;;; ```scheme
    ;;; coin-genesis-script-pubkey ; => #u8(#x6a)
    ;;; ```
    (define coin-genesis-script-pubkey %op-return)

    ;;; Build the genesis coinbase transaction carrying `quote-text`.
    ;;;
    ;;; The scriptSig is the ordinary SigilCoin coinbase payload — height 0,
    ;;; the genesis solution, the quote as graffiti — so genesis is decoded
    ;;; by the same `coin-block-coinbase-payload` every other block is.
    ;;;
    ;;; ```scheme
    ;;; (coin-ok? (coin-coinbase-payload-decode
    ;;;             (txin-script-sig
    ;;;               (car (transaction-inputs (coin-genesis-coinbase "hi"))))))
    ;;; ; => #t
    ;;; ```
    (define (coin-genesis-coinbase quote-text)
      (: string? -> transaction?)
      (if (not (string? quote-text))
          (error "coin-genesis-coinbase: expected a quote string"))
      (transaction
        version: 1
        inputs: (list
                  (txin previous-output: (outpoint txid: %zero32
                                                   index: %coinbase-index)
                        script-sig: (coin-coinbase-payload-encode
                                      (coin-coinbase-payload
                                        height: 0
                                        solution: coin-genesis-solution
                                        graffiti: (string->utf8 quote-text)))
                        sequence: %sequence-final
                        witness: '()))
        ;; Zero premine: the only output pays nothing and cannot be spent.
        outputs: (list (txout value: (coin-block-reward 0)
                             script-pubkey: coin-genesis-script-pubkey))
        lock-time: 0))

    ;;; Build the whole genesis block from `quote-text` and `time`.
    ;;;
    ;;; ```scheme
    ;;; (block? (coin-genesis-block "hello" 1787788800)) ; => #t
    ;;; ```
    (define (coin-genesis-block quote-text time)
      (: string? integer? -> block?)
      (let* ((coinbase (coin-genesis-coinbase quote-text))
             (root (merkle-root (list (transaction-txid coinbase)))))
        (block header-field: (block-header version: coin-header-version
                                           previous-block: %zero32
                                           merkle-root: root
                                           time: time
                                           bits: coin-header-bits
                                           nonce: coin-header-nonce)
               transactions: (list coinbase))))

    ;;; The genesis header for `quote-text` and `time`.
    ;;;
    ;;; ```scheme
    ;;; (block-header-time (coin-genesis-header "hello" 1787788800))
    ;;; ; => 1787788800
    ;;; ```
    (define (coin-genesis-header quote-text time)
      (: string? integer? -> block-header?)
      (block-header-field (coin-genesis-block quote-text time)))

    ;;; The internal 32-byte genesis header hash for `quote-text` and `time`.
    ;;;
    ;;; ```scheme
    ;;; (bytevector-length (coin-genesis-hash "hello" 1787788800)) ; => 32
    ;;; ```
    (define (coin-genesis-hash quote-text time)
      (: string? integer? -> bytevector?)
      (block-header-hash (coin-genesis-header quote-text time)))

    ;;; The serialized genesis header as hex: the constant a chain config
    ;;; stores. This is the whole regeneration procedure.
    ;;;
    ;;; ```scheme
    ;;; (string-length (coin-genesis-header-hex "hello" 1787788800)) ; => 160
    ;;; ```
    (define (coin-genesis-header-hex quote-text time)
      (: string? integer? -> string?)
      (hex-encode
        (block-header-serialize (coin-genesis-header quote-text time))))))
