;;; (sigil coin node miner) — producer and co-op block builders

(define-library (sigil coin node miner)
  (import (sigil math)
          (sigil io)
          (sigil bitcoin utils)
          (sigil bitcoin tx)
          (sigil bitcoin consensus)
          (sigil coin puzzle generator)
          (sigil coin consensus)
          (sigil coin node rules)
          (sigil coin node body))
  (export
    coin-table-solution
    coin-mining-coinbase
    coin-mining-coinbase/coop
    coin-build-block
    coin-build-coop-block)

  (begin

    (define %zero32 (make-bytevector 32 0))
    (define %coinbase-index #xffffffff)
    (define %sequence-final #xffffffff)

    ;; Coerce miner text or bytes to wire bytes.
    (define (coin-mining-bytes who value)
      (cond ((bytevector? value) value)
            ((string? value) (string->utf8 value))
            (else
             (error (string-append who ": expected a string or bytevector")))))

    ;;; Return producer table solution for one canonical puzzle.
    (define (coin-table-solution previous-hash height complexity)
      (: bytevector? integer? integer? -> bytevector?)
      (coin-mining-bytes
        "coin-table-solution"
        (puzzle-spec-table-solution
          (coin-node-puzzle previous-hash height complexity))))

    (define (require-fees who fees)
      (unless (and (number? fees) (exact? fees) (integer? fees) (>= fees 0))
        (error (string-append who ": expected non-negative fees")))
      fees)

    (define (optional-argument rest index default)
      (let loop ((xs rest) (i index))
        (cond ((null? xs) default)
              ((= 0 i) (car xs))
              (else (loop (cdr xs) (- i 1))))))

    (define (outputs-for plan producer-script)
      (map (lambda (entry)
             (txout value: (car entry)
                    script-pubkey: (or (cdr entry) producer-script)))
           plan))

    ;;; Build canonical coinbase, including exact co-op payouts.
    (define (coin-mining-coinbase/coop height solution shares commitments
                                           graffiti producer-script
                                           carrier-script . maybe-fees)
      (: integer? any? list? list? any? bytevector? any? integer? ...
         -> transaction?)
      (if (not (bytevector? producer-script))
          (error "coin-mining-coinbase/coop: expected producer script"))
      (let* ((fees (require-fees "coin-mining-coinbase/coop"
                                 (optional-argument maybe-fees 0 0)))
             (value (+ (coin-block-reward height) fees))
             (plan (coin-split-plan value shares carrier-script)))
        (transaction
          version: 1
          inputs: (list
                    (txin previous-output: (outpoint txid: %zero32
                                                     index: %coinbase-index)
                          script-sig: (coin-coinbase-payload-encode
                                        (coin-coinbase-payload
                                          height: height
                                          solution: (coin-mining-bytes
                                                      "coin coinbase solution"
                                                      solution)
                                          shares: (coin-shares-encode shares)
                                          commits: (coin-commits-encode
                                                     commitments)
                                          graffiti: (coin-mining-bytes
                                                      "coin coinbase graffiti"
                                                      graffiti)))
                          sequence: %sequence-final
                          witness: '()))
          outputs: (outputs-for plan producer-script)
          lock-time: 0)))

    ;;; Build a producer-only coinbase. Optional argument is total fees.
    (define (coin-mining-coinbase height solution graffiti script-pubkey
                                     . maybe-fees)
      (: integer? any? any? bytevector? integer? ... -> transaction?)
      (coin-mining-coinbase/coop
        height solution '() '() graffiti script-pubkey #f
        (require-fees "coin-mining-coinbase"
                      (optional-argument maybe-fees 0 0))))

    (define (score-or-raise previous-hash height complexity solution quality)
      (let ((scored (coin-score-for-solution previous-hash height complexity
                                                solution quality)))
        (if (coin-failed? scored)
            (error (string-append
                     "coin-build-block: solution rejected ("
                     (symbol->string (coin-result-reason scored))
                     ")"))
            (coin-result-value scored))))

    (define (build parent-header height complexity solution shares commitments
                   graffiti producer-script carrier-script time txs fees
                   quality)
      (let* ((parent-hash (block-header-hash parent-header))
             (solution-bytes
               (coin-mining-bytes
                 "coin-build-block solution"
                 (or solution
                     (coin-table-solution parent-hash height complexity))))
             (score (score-or-raise parent-hash height complexity
                                    solution-bytes quality))
             (coinbase (coin-mining-coinbase/coop
                         height solution-bytes shares commitments graffiti
                         producer-script carrier-script fees))
             (transactions (cons coinbase txs)))
        (block header-field:
                 (block-header version: coin-header-version
                               previous-block: parent-hash
                               merkle-root: (merkle-root
                                              (map transaction-txid
                                                   transactions))
                               time: time
                               bits: (coin-bits-encode complexity)
                               nonce: score)
               transactions: transactions)))

    ;;; Build a producer-only block. Optional values are transactions, fees,
    ;;; then commitments for this height's future shares.
    (define (coin-build-block parent-header height complexity solution
                                 graffiti script-pubkey time
                                 . maybe-transactions)
      (: block-header? integer? integer? any? any? bytevector? integer? list?
         integer? list? ... -> block?)
      (if (not (block-header? parent-header))
          (error "coin-build-block: expected parent header"))
      (let ((txs (optional-argument maybe-transactions 0 '()))
            (fees (require-fees "coin-build-block"
                                (optional-argument maybe-transactions 1 0)))
            (commitments (optional-argument maybe-transactions 2 '())))
        (if (not (list? txs))
            (error "coin-build-block: expected transactions"))
        (if (not (list? commitments))
            (error "coin-build-block: expected commitments"))
        (build parent-header height complexity solution '() commitments
               graffiti script-pubkey #f time txs fees 0)))

    ;;; Build a co-op block revealing personalized shares committed by parent.
    ;;; Optional values are transactions, fees, then this block's commitments.
    (define (coin-build-coop-block parent-block height complexity solution
                                      shares graffiti producer-script time
                                      . maybe-transactions)
      (: block? integer? integer? any? list? any? bytevector? integer? list?
         integer? list? ... -> block?)
      (if (not (block? parent-block))
          (error "coin-build-coop-block: expected parent block"))
      (let* ((parent-header (block-header-field parent-block))
             (context (coin-parent-context parent-block))
             (txs (optional-argument maybe-transactions 0 '()))
             (fees (require-fees "coin-build-coop-block"
                                 (optional-argument maybe-transactions 1 0)))
             (commitments (optional-argument maybe-transactions 2 '()))
             (producer (coin-mining-bytes
                         "coin-build-coop-block solution"
                         (or solution
                             (coin-table-solution
                               (block-header-hash parent-header)
                               height complexity))))
             (payload (coin-coinbase-payload
                        height: height
                        solution: producer
                        shares: (coin-shares-encode shares)
                        commits: (coin-commits-encode commitments)
                        graffiti: (coin-mining-bytes
                                    "coin-build-coop-block graffiti"
                                    graffiti)))
             (checked (coin-check-coop payload context)))
        (if (coin-failed? checked)
            (error (string-append
                     "coin-build-coop-block: shares rejected ("
                     (symbol->string (coin-result-reason checked))
                     ")")))
        (if (not (list? txs))
            (error "coin-build-coop-block: expected transactions"))
        (if (not (list? commitments))
            (error "coin-build-coop-block: expected commitments"))
        (let* ((accepted (coin-result-value checked))
               (quality (coin-shares-quality context accepted))
               (carrier (coin-carrier-script parent-block)))
          (build parent-header height complexity producer accepted commitments
                 graffiti producer-script carrier time txs fees quality))))))
