;;; (sigil coin node miner) — producer and co-op block builders

(define-library (sigil coin node miner)
  (import (sigil math)
          (sigil io)
          (sigil crypto)
          (sigil bitcoin utils)
          (sigil bitcoin tx)
          (sigil bitcoin consensus)
          (sigil coin puzzle generator)
          (sigil coin consensus)
          (sigil coin node rules)
          (sigil coin node body))
  (export
    coin-par-solution
    coin-mining-coinbase
    coin-mining-coinbase/coop
    coin-mine-header
    coin-mine-block
    coin-build-block
    coin-build-coop-block)

  (begin

    (define %zero32 (make-bytevector 32 0))
    (define %coinbase-index #xffffffff)
    (define %sequence-final #xffffffff)

    (define (coin-mining-u32? value)
      (and (number? value) (exact? value) (integer? value)
           (<= 0 value #xffffffff)))

    ;; Coerce miner text or bytes to wire bytes.
    (define (coin-mining-bytes who value)
      (cond ((bytevector? value) value)
            ((string? value) (string->utf8 value))
            (else
             (error (string-append who ": expected a string or bytevector")))))

    ;;; Return the generated par-length witness for one canonical puzzle.
    (define (coin-par-solution previous-hash height complexity)
      (: bytevector? integer? integer? -> bytevector?)
      (coin-mining-bytes
        "coin-par-solution"
        (puzzle-spec-par-solution
          (coin-node-puzzle previous-hash height complexity))))

    (define (require-fees who fees)
      (unless (and (number? fees) (exact? fees) (integer? fees) (>= fees 0))
        (error (string-append who ": expected non-negative fees")))
      fees)

    (define (optional-argument rest index default)
      (let loop ((xs rest) (i index))
        (cond ((null? xs) default)
              ((= 0 i) (car xs))
              (else (loop (cdr xs) (- i 1))))))

    (define (outputs-for plan producer-script)
      (map (lambda (entry)
             (txout value: (car entry)
                    script-pubkey: (or (cdr entry) producer-script)))
           plan))

    ;;; Build canonical coinbase, including exact co-op payouts.
    (define (coin-mining-coinbase/coop height solution shares contributions
                                           commitments graffiti producer-script
                                           carrier-script . maybe-fees)
      (: integer? any? list? list? list? any? bytevector? any? integer? ...
         -> transaction?)
      (if (not (bytevector? producer-script))
          (error "coin-mining-coinbase/coop: expected producer script"))
      (let* ((fees (require-fees "coin-mining-coinbase/coop"
                                 (optional-argument maybe-fees 0 0)))
             (subsidy (coin-block-reward height))
             (plan (coin-payout-plan
                     subsidy fees shares contributions carrier-script)))
        (transaction
          version: 1
          inputs: (list
                    (txin previous-output: (outpoint txid: %zero32
                                                     index: %coinbase-index)
                          script-sig: (coin-coinbase-payload-encode
                                        (coin-coinbase-payload
                                          height: height
                                          solution: (coin-mining-bytes
                                                      "coin coinbase solution"
                                                      solution)
                                          shares: (coin-shares-encode shares)
                                          commits: (coin-commits-encode
                                                     commitments)
                                          graffiti: (coin-mining-bytes
                                                      "coin coinbase graffiti"
                                                      graffiti)))
                          sequence: %sequence-final
                          witness: '()))
          outputs: (outputs-for plan producer-script)
          lock-time: 0)))

    ;;; Build a producer-only coinbase. Optional argument is total fees.
    (define (coin-mining-coinbase height solution graffiti script-pubkey
                                     . maybe-fees)
      (: integer? any? any? bytevector? integer? ... -> transaction?)
      (coin-mining-coinbase/coop
        height solution '() '() '() graffiti script-pubkey #f
        (require-fees "coin-mining-coinbase"
                      (optional-argument maybe-fees 0 0))))

    (define (solution-shape-or-raise previous-hash height complexity solution)
      (let* ((spec (coin-node-puzzle previous-hash height complexity))
             (checked (coin-check-solution spec solution)))
        (if (coin-failed? checked)
            (error (string-append
                     "coin-build-block: solution rejected ("
                     (symbol->string (coin-result-reason checked))
                     ")"))
            (cons (coin-solution-length solution)
                  (puzzle-spec-par spec)))))

    (define (decoded-or-raise who result)
      (if (coin-failed? result)
          (error (string-append
                   who
                   ": "
                   (symbol->string (coin-result-reason result))))
          (coin-result-value result)))

    ;; Mutate only the nonce bytes in an already-finalized wire header.
    (define (write-nonce! wire nonce)
      (bytevector-u8-set! wire 76 (bitwise-and nonce #xff))
      (bytevector-u8-set! wire 77
        (bitwise-and (arithmetic-shift nonce -8) #xff))
      (bytevector-u8-set! wire 78
        (bitwise-and (arithmetic-shift nonce -16) #xff))
      (bytevector-u8-set! wire 79
        (bitwise-and (arithmetic-shift nonce -24) #xff)))

    (define (u256-le n)
      (let ((out (make-bytevector 32 0)))
        (do ((i 0 (+ i 1))
             (value n (quotient value 256)))
            ((= i 32) out)
          (bytevector-u8-set! out i (remainder value 256)))))

    (define (u256-le<=? left right)
      (let loop ((i 31))
        (cond ((< i 0) #t)
              ((< (bytevector-u8-ref left i)
                  (bytevector-u8-ref right i)) #t)
              ((> (bytevector-u8-ref left i)
                  (bytevector-u8-ref right i)) #f)
              (else (loop (- i 1))))))

    (define (coin-mining-target-bytes who header par)
      (if (not (block-header? header))
          (error (string-append who ": expected a block header")))
      (let ((length
              (decoded-or-raise
                who
                (coin-version-solution-length
                  (block-header-version header)))))
        (if (> length par)
            (error (string-append who ": solution length exceeds par")))
        (u256-le
          (coin-lottery-target (block-header-bits header) par length))))

    ;; Return the first qualifying nonce at or after `start`, or #f.
    (define (coin-search-header-nonce header target-bytes start)
      (let ((wire (block-header-serialize header))
            (winner #f))
        (do ((nonce start (+ nonce 1)))
            ((or winner (> nonce #xffffffff)) winner)
          (write-nonce! wire nonce)
          ;; ponytail: the crypto API returns digest bytevectors. The measured
          ;; launch rate includes this bounded GC; a native SHA256d predicate
          ;; would require target recalibration.
          (when
            (u256-le<=?
              (sha256-bytes (sha256-bytes wire))
              target-bytes)
            (set! winner nonce)))))

    ;;; Search the full uint32 nonce range for a qualifying finalized header.
    ;;;
    ;;; `header` must already carry its final merkle root, version claim and
    ;;; chain-required compact base target. Only the 80-byte header nonce
    ;;; changes, and the search always starts at zero.
    (define (coin-mine-header header par)
      (: block-header? integer? -> block-header?)
      (let* ((target-bytes
               (coin-mining-target-bytes "coin-mine-header" header par))
             (winner
               (coin-search-header-nonce header target-bytes 0)))
        (if winner
            (block-header header nonce: winner)
            (error "coin-mine-header: nonce range exhausted"))))

    ;;; Search a block's uint64 `(coinbase lock-time, header nonce)` cursor.
    ;;;
    ;;; Search starts at the cursor already carried by `prototype`. Nonce
    ;;; exhaustion increments the final coinbase's lock-time, recomputes the
    ;;; merkle root, and resets nonce to zero.
    ;;;
    ;;; ```scheme
    ;;; (coin-mine-block prototype par) ; => a qualifying complete block
    ;;; ```
    (define (coin-mine-block prototype par)
      (: block? integer? -> block?)
      (if (not (block? prototype))
          (error "coin-mine-block: expected a block"))
      (let* ((transactions (block-transactions prototype))
             (coinbase (coin-block-coinbase prototype)))
        (if (not coinbase)
            (error "coin-mine-block: expected a coinbase first transaction"))
        (if (not (= %sequence-final
                    (txin-sequence (car (transaction-inputs coinbase)))))
            (error "coin-mine-block: expected final coinbase sequence"))
        (if (not (coin-mining-u32? (transaction-lock-time coinbase)))
            (error "coin-mine-block: expected uint32 coinbase lock-time"))
        (if (not
              (coin-mining-u32?
                (block-header-nonce (block-header-field prototype))))
            (error "coin-mine-block: expected uint32 header nonce"))
        (let* ((prototype-header (block-header-field prototype))
               (txids (map transaction-txid transactions))
               (base-header
                 (block-header
                   prototype-header
                   merkle-root: (merkle-root txids)))
               (target-bytes
                 (coin-mining-target-bytes
                   "coin-mine-block" base-header par)))
          (let loop ((header base-header)
                     (txs transactions)
                     (start (block-header-nonce base-header))
                     (tail-txids (cdr txids)))
            (let* ((coinbase (car txs))
                   (winner
                     (coin-search-header-nonce
                       header target-bytes start)))
              (cond
                (winner
                 (block prototype
                        header-field: (block-header header nonce: winner)
                        transactions: txs))
                ((= #xffffffff (transaction-lock-time coinbase))
                 (error "coin-mine-block: search space exhausted"))
                (else
                  (let* ((next-coinbase
                           (transaction
                             coinbase
                             lock-time:
                               (+ 1 (transaction-lock-time coinbase))))
                         (next-transactions
                           (cons next-coinbase (cdr txs)))
                         (next-tail-txids tail-txids)
                         (next-header
                           (block-header
                             header
                             merkle-root:
                               (merkle-root
                                 (cons
                                   (transaction-txid next-coinbase)
                                   next-tail-txids))
                             nonce: 0)))
                    (loop next-header next-transactions 0
                          next-tail-txids)))))))))

    (define (build parent-header height complexity bits solution shares
                   contributions commitments graffiti producer-script
                   carrier-script time txs fees)
      (let* ((parent-hash (block-header-hash parent-header))
             (solution-bytes
               (coin-mining-bytes
                 "coin-build-block solution"
                 (or solution
                     (coin-par-solution parent-hash height complexity))))
             (shape (solution-shape-or-raise
                      parent-hash height complexity solution-bytes))
             (length (car shape))
             (par (cdr shape))
             (coinbase (coin-mining-coinbase/coop
                         height solution-bytes shares contributions commitments
                         graffiti producer-script carrier-script fees))
             (transactions (cons coinbase txs))
             (header
               (block-header
                 version: (coin-version-encode complexity length)
                 previous-block: parent-hash
                 merkle-root: (merkle-root (map transaction-txid transactions))
                 time: time
                 bits: bits
                 nonce: 0)))
        (coin-mine-block
          (block header-field: header transactions: transactions)
          par)))

    ;;; Build a producer-only block. Optional values are transactions, fees,
    ;;; then commitments for this height's future shares.
    (define (coin-build-block parent-header height complexity bits solution
                                 graffiti script-pubkey time
                                 . maybe-transactions)
      (: block-header? integer? integer? integer? any? any? bytevector? integer?
         list? integer? list? ... -> block?)
      (if (not (block-header? parent-header))
          (error "coin-build-block: expected parent header"))
      (let ((txs (optional-argument maybe-transactions 0 '()))
            (fees (require-fees "coin-build-block"
                                (optional-argument maybe-transactions 1 0)))
            (commitments (optional-argument maybe-transactions 2 '())))
        (if (not (list? txs))
            (error "coin-build-block: expected transactions"))
        (if (not (list? commitments))
            (error "coin-build-block: expected commitments"))
        (build parent-header height complexity bits solution '() '() commitments
               graffiti script-pubkey #f time txs fees)))

    ;;; Build a co-op block revealing personalized shares committed by parent.
    ;;; Optional values are transactions, fees, then this block's commitments.
    (define (coin-build-coop-block parent-block height complexity bits solution
                                      shares graffiti producer-script time
                                      . maybe-transactions)
      (: block? integer? integer? integer? any? list? any? bytevector? integer?
         list? integer? list? ... -> block?)
      (if (not (block? parent-block))
          (error "coin-build-coop-block: expected parent block"))
      (let* ((parent-header (block-header-field parent-block))
             (context (coin-parent-context parent-block))
             (txs (optional-argument maybe-transactions 0 '()))
             (fees (require-fees "coin-build-coop-block"
                                 (optional-argument maybe-transactions 1 0)))
             (commitments (optional-argument maybe-transactions 2 '()))
             (producer (coin-mining-bytes
                         "coin-build-coop-block solution"
                         (or solution
                             (coin-par-solution
                               (block-header-hash parent-header)
                               height complexity))))
             (payload (coin-coinbase-payload
                        height: height
                        solution: producer
                        shares: (coin-shares-encode shares)
                        commits: (coin-commits-encode commitments)
                        graffiti: (coin-mining-bytes
                                    "coin-build-coop-block graffiti"
                                    graffiti)))
             (checked (coin-check-coop payload context)))
        (if (coin-failed? checked)
            (error (string-append
                     "coin-build-coop-block: shares rejected ("
                     (symbol->string (coin-result-reason checked))
                     ")")))
        (if (not (list? txs))
            (error "coin-build-coop-block: expected transactions"))
        (if (not (list? commitments))
            (error "coin-build-coop-block: expected commitments"))
        (let* ((accepted (coin-result-value checked))
               ;; Payouts consume the reports cached by the one full
               ;; share-validation pass above.
               (contributions
                 (map (lambda (share)
                        (coin-share-quality context share))
                      accepted))
               (carrier (coin-carrier-script parent-block)))
          (build parent-header height complexity bits producer accepted
                 contributions commitments graffiti producer-script carrier
                 time txs fees))))))
