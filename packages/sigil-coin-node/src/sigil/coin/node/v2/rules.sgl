;;; (sigil coin node v2 rules) — v2 header acceptance and fork choice
;;;
;;; The v2 shape of `(sigil coin node rules)`. Same seam, same three
;;; procedures, three different meanings for the three header fields
;;; SigilCoin controls.
;;;
;;; ============================================================
;;; THE HEADER FIELDS
;;; ============================================================
;;;
;;;   `version`  pinned to 5. v1 pinned 4 because Bitcoin's connector reads
;;;              SigilCoin's buried deployment heights as version floors;
;;;              5 is the split marker on top of that floor.
;;;   `bits`     LIVE, and no longer inert. It carries the 12-bit complexity
;;;              parameter `C` as `0x207F0000 | C` (§5.2). The value stays at
;;;              or below `0x207fffff`, so any Bitcoin-side reader of the
;;;              seam still sees a max-target-ish compact number and no proof
;;;              of work is imposed anywhere.
;;;   `nonce`    the 32-bit composite score word `W` (§5.3), not a raw
;;;              solution length. Lower is better, and plain unsigned `<` on
;;;              `W` IS the composite order on `(L, MB, SB, 8-R)`.
;;;
;;; Both `bits` and `nonce` are claims a header makes about a body nobody
;;; may have yet, which is what keeps fork choice decidable from headers
;;; alone. `bits` is checked here, against a value derived from the parent
;;; chain; `W` is checked in `(sigil coin node v2 body)`, against the body it
;;; summarises. A lie in either is an invalid block, and the node marks the
;;; header and its descendants invalid permanently.
;;;
;;; ============================================================
;;; COMPLEXITY IS CHAIN-DERIVED, NEVER MINER-CHOSEN
;;; ============================================================
;;;
;;; `C(H)` comes from history (§9): `C(0) = 128`, `C(H) = C(H-1)` except at
;;; `H mod 16 = 0` with `H >= 16`, where it moves on the median relative
;;; margin between par and the achieved length over heights `H-16 .. H-1`.
;;; The early chain is not a partial window, it is no window: the first
;;; retarget is at height 16 over a full window that includes genesis.
;;;
;;; A header therefore does not get to pick its own puzzle by lying in
;;; `bits`: `accept?` derives `C` itself and requires byte equality
;;; (`complexity-mismatch`). Encoding `C` in the header at all is for
;;; headers-first sync, where a node ranking a flood of headers needs `C` to
;;; derive a puzzle and wants that in constant time.
;;;
;;; WHERE THE HISTORY COMES FROM. `sigil-bitcoin`'s `ingest-one-header`
;;; passes `db-chain-to-row`, which is the whole chain from genesis to the
;;; parent, oldest first; `validate-header-chain` passes a growing prefix of
;;; the same. So the candidate's height is the length of `previous-headers`,
;;; and the retarget window is its last 16 entries. That is the seam's
;;; contract, not an assumption about a caller: the window requirement grew
;;; from v1's 11 (median time past) to 16, and both are satisfied by the
;;; same full chain.
;;;
;;; ============================================================
;;; THE RANKING KEY
;;; ============================================================
;;;
;;; `chain-work` still returns one integer with two digits in it (§5.8):
;;;
;;;   saving(b) = 2^32 - W(b)          1 .. 2^32, 0 reserved for an illegal W
;;;   work      = accumulated * (2^32 + 1) + saving
;;;
;;; Lower `W` is a better block, so a larger saving is a better block, and
;;; the digits never collide because `saving <= 2^32 < coin-v2-rank-base`.
;;; `accumulated` is strictly increasing along any chain, so no chain ranks
;;; below its own ancestor. Height still outranks the packed number in
;;; `better-chain?`; the packed number only ever decides between siblings.
;;;
;;; THE BLOCK-HASH TIE-BREAK OF v1 IS GONE (§5.6). It was grindable through
;;; 400 bytes of graffiti, and ties are the normal case because the optimal
;;; solution is often unique — so in v1 a thief who copied a producer's
;;; solution could grind his way to the tip with certainty. In v2 an equal
;;; `W` never displaces an incumbent: first-seen wins, exactly as Bitcoin
;;; resolves equal-work siblings, and the next block settles it.
;;;
;;; ============================================================
;;; THE PUZZLE CACHE
;;; ============================================================
;;;
;;; Derivation is the single most expensive thing a validator does — up to
;;; 64 attempts of 20000 steps, ~7 s against a hostile draw — and every
;;; sibling at one height is judged against the SAME puzzle, as is every
;;; retarget that reads that height's par. The node therefore holds one
;;; bounded cache and both this module and `body` derive through it.
;;;
;;; CORRECTNESS-NEUTRAL BY CONSTRUCTION. `coin-v2-puzzle-cached` returns
;;; exactly what `coin-v2-puzzle-for` returns; derivation is pure in
;;; `(prev_hash, H, C)`, and the cache key is the seed, which is injective
;;; over that triple by §3.1's fixed-width preimage. A node that never hits
;;; the cache validates the same chain, slower. Eviction is therefore also
;;; correctness-neutral: a miss costs time, never a different answer.

(define-library (sigil coin node v2 rules)
  (import (sigil math)
          (sigil time)
          (sigil bitcoin consensus)
          (sigil coin puzzle examples)
          (sigil coin consensus)
          (sigil coin node v2 adapter))
  (export
    ;; Header fields
    coin-v2-header-version
    coin-v2-header-score
    coin-v2-header-score-ok?
    coin-v2-header-complexity

    ;; The puzzle cache
    coin-v2-node-puzzle-cache
    coin-v2-node-puzzle
    coin-v2-node-puzzle-cache-size

    ;; Chain-derived complexity
    coin-v2-header-height
    coin-v2-window-margins
    coin-v2-required-complexity

    ;; The ranking key
    coin-v2-rank-base
    coin-v2-score-saving
    coin-v2-rank-encode
    coin-v2-rank-accumulated
    coin-v2-rank-tip-saving
    coin-v2-chain-work
    coin-v2-better-chain?

    ;; Acceptance
    coin-v2-accept-header?
    coin-v2-header-rules)

  (begin

    ;; ============================================================
    ;; Frozen header fields
    ;; ============================================================

    ;;; The only block header version SigilCoin v2 accepts.
    ;;;
    ;;; Five, not four. v1's four was the floor Bitcoin's connector imposes
    ;;; through the buried deployment heights SigilCoin activates at height
    ;;; 0 (BIP34 wants 2, BIP66 3, BIP65 4); v2 adds one on top as the split
    ;;; marker, so a v1 header can never be read as a v2 one.
    (define coin-v2-header-version 5)

    ;;; The composite score word a header claims, read out of `nonce`.
    ;;;
    ;;; ```scheme
    ;;; (coin-v2-header-score header) ; => the 32-bit word W
    ;;; ```
    (define (coin-v2-header-score header)
      (: block-header? -> integer?)
      (block-header-nonce header))

    ;;; Whether a header's score word passes the field-range check: a 32-bit
    ;;; unsigned integer, low nibble zero, share field at most eight.
    ;;;
    ;;; This is a range check only. Whether the word describes the block it
    ;;; rides in is `score-mismatch`, decided by the body rules.
    ;;;
    ;;; ```scheme
    ;;; (coin-v2-header-score-ok? 1) ; => #f
    ;;; ```
    (define (coin-v2-header-score-ok? w)
      (: any? -> boolean?)
      (coin-ok? (coin-v2-score-check w)))

    ;;; The complexity a header's `bits` claims, as a `coin-result`.
    ;;;
    ;;; Total: rejection reasons are `malformed-header`, `bits-prefix`,
    ;;; `bits-reserved-nonzero` and `complexity-range`.
    ;;;
    ;;; ```scheme
    ;;; (coin-result-value (coin-v2-header-complexity header)) ; => 128
    ;;; ```
    (define (coin-v2-header-complexity header)
      (: any? -> coin-result?)
      (if (not (block-header? header))
          (coin-error 'malformed-header "expected a block header")
          (coin-v2-bits-decode (block-header-bits header))))

    ;; ============================================================
    ;; The puzzle cache
    ;; ============================================================

    ;;; The node's puzzle cache: one per process, bounded, and read by both
    ;;; the retarget signal and body validation.
    ;;;
    ;;; ponytail: one process-wide cache, because `connect` and `accept?` are
    ;;; both fixed seam signatures with nowhere to thread a handle through.
    ;;; Give the node a per-chain handle if one process ever serves two
    ;;; chains at once; it is correctness-neutral either way, since the key
    ;;; is the seed and the seed already separates chains.
    (define coin-v2-node-puzzle-cache (coin-v2-puzzle-cache-open))

    ;;; Number of puzzles the node currently holds.
    (define (coin-v2-node-puzzle-cache-size)
      (: -> integer?)
      (coin-v2-puzzle-cache-size coin-v2-node-puzzle-cache))

    ;;; The puzzle for a block, derived once per height and reused after.
    ;;;
    ;;; Indistinguishable from `coin-v2-puzzle-for` in its result; see the
    ;;; module header for why that is by construction rather than by care.
    ;;;
    ;;; ```scheme
    ;;; (equal? (pbe-spec-par (coin-v2-node-puzzle parent 1 128))
    ;;;         (pbe-spec-par (coin-v2-puzzle-for parent 1 128)))
    ;;; ; => #t
    ;;; ```
    (define (coin-v2-node-puzzle previous-hash height complexity)
      (: bytevector? integer? integer? -> pbe-spec?)
      (coin-v2-puzzle-cached coin-v2-node-puzzle-cache
                             previous-hash
                             height
                             complexity))

    ;; ============================================================
    ;; Chain-derived complexity
    ;; ============================================================

    (define (list-length xs)
      (let loop ((ys xs) (n 0)) (if (null? ys) n (loop (cdr ys) (+ n 1)))))

    (define (last-of xs)
      (let loop ((ys xs))
        (if (null? (cdr ys)) (car ys) (loop (cdr ys)))))

    (define (drop-n xs n)
      (let loop ((ys xs) (i n))
        (if (or (<= i 0) (null? ys)) ys (loop (cdr ys) (- i 1)))))

    ;; The complexity a stored header carries, or a raise. Every header in
    ;; `previous-headers` has already passed `accept?`, so an undecodable
    ;; `bits` there is a node bug rather than a bad block.
    (define (stored-complexity header)
      (let ((decoded (coin-v2-header-complexity header)))
        (if (coin-failed? decoded)
            (error "coin-v2-required-complexity: a stored header has illegal bits")
            (coin-result-value decoded))))

    ;; The accepted solution length a stored header commits to.
    (define (stored-length header)
      (let ((checked (coin-v2-score-check (coin-v2-header-score header))))
        (if (coin-failed? checked)
            (error "coin-v2-required-complexity: a stored header has an illegal score")
            (coin-v2-score-length (coin-result-value checked)))))

    ;;; The height of the header that would extend `previous-headers`.
    ;;;
    ;;; The seam hands over the whole chain from genesis, oldest first, so
    ;;; the height is the count: an empty history is genesis.
    ;;;
    ;;; ```scheme
    ;;; (coin-v2-header-height '())          ; => 0
    ;;; (coin-v2-header-height (list genesis)) ; => 1
    ;;; ```
    (define (coin-v2-header-height previous-headers)
      (: list? -> integer?)
      (if (not (list? previous-headers))
          (error "coin-v2-header-height: expected a header list"))
      (list-length previous-headers))

    ;;; The 16 margins of the retarget window ending at `height`, oldest
    ;;; first: one per height in `height-16 .. height-1`.
    ;;;
    ;;; `par_i` is derived — through the cache, so a synced node pays
    ;;; nothing it has not already paid — and `L_i` is read from header `i`'s
    ;;; own score word. Both are pure functions of the branch, which is why
    ;;; a reorg recomputes `C` from the new branch's own blocks.
    ;;;
    ;;; ```scheme
    ;;; (length (coin-v2-window-margins headers 16)) ; => 16
    ;;; ```
    (define (coin-v2-window-margins previous-headers height)
      (: list? integer? -> list?)
      (let ((available (list-length previous-headers)))
        ;; The history is indexed BY HEIGHT: entry `i` is the header at
        ;; height `i`, which is only true when it runs from genesis to the
        ;; parent and nowhere else. Requiring the exact length is what makes
        ;; that contract checkable rather than assumed.
        (if (or (< height coin-v2-retarget-window)
                (not (= available height)))
            (error "coin-v2-window-margins: the history is not the chain to this height"))
        (let loop ((xs (drop-n previous-headers
                               (- height coin-v2-retarget-window)))
                   (h (- height coin-v2-retarget-window))
                   (acc '()))
          (if (or (>= h height) (null? xs))
              (reverse acc)
              (let* ((header (car xs))
                     (complexity (stored-complexity header))
                     (spec (coin-v2-node-puzzle
                             (block-header-previous-block header)
                             h
                             complexity)))
                (loop (cdr xs)
                      (+ h 1)
                      (cons (coin-v2-margin (pbe-spec-par spec)
                                            (stored-length header))
                            acc)))))))

    ;;; The complexity a header at `height` MUST carry, derived from the
    ;;; parent chain.
    ;;;
    ;;; Genesis is the frozen `coin-v2-complexity-genesis`. Every other
    ;;; height inherits its parent's `C` except at a retarget height, where
    ;;; the full 16-block window decides. Raises when the history cannot
    ;;; support the derivation, which for the node seam means never.
    ;;;
    ;;; ```scheme
    ;;; (coin-v2-required-complexity '() 0)          ; => 128
    ;;; (coin-v2-required-complexity (list genesis) 1) ; => 128
    ;;; ```
    (define (coin-v2-required-complexity previous-headers height)
      (: list? integer? -> integer?)
      (if (= 0 height)
          coin-v2-complexity-genesis
          (let ((parent-complexity (stored-complexity
                                     (last-of previous-headers))))
            (coin-v2-complexity-for
              height
              parent-complexity
              (and (coin-v2-retarget-height? height)
                   (coin-v2-window-margins previous-headers height))))))

    ;; ============================================================
    ;; The ranking key
    ;; ============================================================

    ;;; Base of the two-digit ranking key: `2^32 + 1`.
    ;;;
    ;;; The low digit is a saving in 0..2^32, which needs a base of at least
    ;;; `2^32 + 1`, and that is exactly this.
    (define coin-v2-rank-base (+ coin-v2-max-score-word 1))

    ;;; Score of a block whose header claims `w`: lower `W` is larger.
    ;;;
    ;;; An illegal word scores 0, the reserved value, because no such block
    ;;; can be valid. `accept?` refuses to store a header carrying one.
    ;;;
    ;;; ```scheme
    ;;; (coin-v2-score-saving 0) ; => 4294967296
    ;;; (coin-v2-score-saving 1) ; => 0
    ;;; ```
    (define (coin-v2-score-saving w)
      (: any? -> integer?)
      (if (coin-v2-score-valid? w) (- coin-v2-max-score-word w) 0))

    ;;; Pack an accumulated total and a tip saving into the ranking key.
    (define (coin-v2-rank-encode accumulated tip-saving)
      (: integer? integer? -> integer?)
      (+ (* accumulated coin-v2-rank-base) tip-saving))

    ;;; The accumulated total inside a ranking key.
    (define (coin-v2-rank-accumulated work)
      (: integer? -> integer?)
      (quotient work coin-v2-rank-base))

    ;;; The tip's own saving inside a ranking key.
    (define (coin-v2-rank-tip-saving work)
      (: integer? -> integer?)
      (remainder work coin-v2-rank-base))

    ;;; Accumulated ranking key of the chain ending at `header`.
    ;;;
    ;;; `b` is the validated body when the node has one and `#f` during
    ;;; headers-first sync; it is accepted to satisfy the seam and
    ;;; deliberately IGNORED, because everything the rank reads is committed
    ;;; in the header. That is what makes the provisional value at header
    ;;; ingest and the settled value after body validation the same number,
    ;;; and it is what lets a better sibling outrank an incumbent before
    ;;; anyone has its body.
    ;;;
    ;;; ```scheme
    ;;; (coin-v2-rank-tip-saving (coin-v2-chain-work header #f 0))
    ;;; ; => 2^32 minus the word the header commits to
    ;;; ```
    (define (coin-v2-chain-work header b previous-work)
      (: any? any? integer? -> integer?)
      (let* ((saving (if (block-header? header)
                         (coin-v2-score-saving (coin-v2-header-score header))
                         0))
             ;; A header `accept?` would refuse still has to rank as
             ;; something; one is the least any legal block contributes.
             (contribution (if (= 0 saving) 1 saving)))
        (coin-v2-rank-encode (+ (coin-v2-rank-accumulated previous-work)
                                contribution)
                             saving)))

    ;;; Whether `candidate` strictly outranks `incumbent` as the chain tip.
    ;;;
    ;;; §5.7, in order: live beats settled, taller wins, lower `W` wins,
    ;;; otherwise the incumbent keeps the tip. There is no fourth rule — the
    ;;; hash tie-break is deleted from consensus — so equal-`W` siblings at
    ;;; one height are incomparable and tip selection is first-seen.
    ;;;
    ;;; That makes this a strict weak ordering rather than v1's strict total
    ;;; order: it is still irreflexive and asymmetric, and incomparability is
    ;;; still transitive, because two candidates are incomparable exactly
    ;;; when `(height, W)` is equal, and equality is an equivalence.
    ;;;
    ;;; SETTLED MEANS OUTGROWN. `extended?` is set by `sigil-bitcoin` as
    ;;; `height <` the tallest stored header height, so a height any taller
    ;;; header has grown past is settled on every branch. That hysteresis is
    ;;; unchanged from v1, and in v2 it is also what protects a revealed
    ;;; share: publishing a reveal for puzzle `P` requires a block at height
    ;;; `P+1`, which settles height `P` against a thief.
    ;;;
    ;;; ```scheme
    ;;; (coin-v2-better-chain? taller shorter) ; => #t
    ;;; ```
    (define (coin-v2-better-chain? candidate incumbent)
      (: chain-candidate? chain-candidate? -> boolean?)
      (let ((candidate-extended? (chain-candidate-extended? candidate))
            (incumbent-extended? (chain-candidate-extended? incumbent))
            (candidate-height (chain-candidate-height candidate))
            (incumbent-height (chain-candidate-height incumbent)))
        (cond
          ((and candidate-extended? (not incumbent-extended?)) #f)
          ((and incumbent-extended? (not candidate-extended?)) #t)
          ((> candidate-height incumbent-height) #t)
          ((< candidate-height incumbent-height) #f)
          ;; Same height: the better score word wins. A larger saving is a
          ;; lower `W`, and the header commits to it, so this is decidable
          ;; the moment both headers are stored.
          ((> (coin-v2-rank-tip-saving (chain-candidate-work candidate))
              (coin-v2-rank-tip-saving (chain-candidate-work incumbent)))
           #t)
          ;; Equal, or worse: the incumbent keeps the tip. First-seen.
          (else #f))))

    ;; ============================================================
    ;; Header acceptance
    ;; ============================================================

    (define (current-unix-second)
      (exact (floor (current-second))))

    ;;; Whether `header` may extend `previous-headers` under `min-spacing`.
    ;;;
    ;;; The order is cost. Version and the score word's field ranges are
    ;;; `O(1)`. The context check — linkage, spacing floor, median time past,
    ;;; future drift — is next, and it is what establishes that
    ;;; `previous-headers` really is this header's chain. Only then does the
    ;;; complexity derivation run, because at a retarget height it reads 16
    ;;; heights' worth of par and a header flood must not be able to force
    ;;; that work on an unlinked header.
    ;;;
    ;;; Total: any argument, however hostile, yields a boolean.
    ;;;
    ;;; ```scheme
    ;;; (coin-v2-accept-header? params (list genesis) header 72000)
    ;;; ```
    (define (coin-v2-accept-header? params previous-headers header min-spacing)
      (: any? list? any? integer? -> boolean?)
      (guard (e (#t #f))
        (and (block-header? header)
             (list? previous-headers)
             (= coin-v2-header-version (block-header-version header))
             ;; The word only has to be a legal word here. Whether it is a
             ;; TRUE claim is a body rule, checked by `coin-v2-connect-block`.
             (coin-v2-header-score-ok? (coin-v2-header-score header))
             (coin-ok? (coin-v2-validate-header-context previous-headers
                                                        header
                                                        (current-unix-second)
                                                        min-spacing))
             ;; `C` is derived from the parent chain and the header must
             ;; agree with it exactly.
             (coin-ok?
               (coin-v2-check-bits
                 (block-header-bits header)
                 (coin-v2-required-complexity
                   previous-headers
                   (coin-v2-header-height previous-headers)))))))

    ;;; Build the v2 `header-rules` record for a chain with `min-spacing`.
    ;;;
    ;;; ```scheme
    ;;; (header-rules? (coin-v2-header-rules 72000)) ; => #t
    ;;; ```
    (define (coin-v2-header-rules min-spacing)
      (: integer? -> header-rules?)
      (if (not (and (number? min-spacing) (exact? min-spacing)
                    (integer? min-spacing) (>= min-spacing 0)))
          (error "coin-v2-header-rules: expected a spacing floor in seconds"))
      (header-rules
        accept?: (lambda (params previous-headers header)
                   (coin-v2-accept-header? params
                                           previous-headers
                                           header
                                           min-spacing))
        chain-work: coin-v2-chain-work
        better-chain?: coin-v2-better-chain?))))
