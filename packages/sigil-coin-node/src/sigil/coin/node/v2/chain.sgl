;;; (sigil coin node v2 chain) — additive v2 node configurations
;;;
;;; Live `(sigil coin node chain)` remains v1. These configs exist only for
;;; v2 integration and tests until canonical switchover.

(define-library (sigil coin node v2 chain)
  (import (sigil bitcoin consensus)
          (sigil bitcoin node)
          (sigil coin consensus)
          (sigil coin node chain)
          (sigil coin node v2 adapter)
          (sigil coin node v2 rules)
          (sigil coin node v2 body)
          (sigil coin node v2 genesis))
  (export
    sigilcoin-v2-main-chain
    sigilcoin-v2-regtest-chain)

  (begin

    (define %main-genesis
      (coin-v2-genesis-block coin-genesis-quote coin-genesis-time))
    (define %regtest-genesis
      (coin-v2-genesis-block coin-regtest-genesis-quote
                             coin-regtest-genesis-time))

    (define (extensions min-spacing genesis)
      (list
        (cons 'consensus
              (list (cons 'rules (coin-v2-header-rules min-spacing))
                    ;; sigil-bitcoin supplies durable validated parents after
                    ;; H1; trusted configured genesis supplies H1 itself.
                    (cons 'block-rules
                          (coin-v2-block-rules-for-genesis genesis))))
        (cons 'policy
              (list (cons 'min-block-spacing min-spacing)
                    (cons 'max-block-bytes coin-v2-max-block-bytes)
                    (cons 'max-solution-bytes coin-v2-max-solution-bytes)
                    (cons 'max-graffiti-bytes coin-v2-max-graffiti-bytes)
                    (cons 'max-coinbase-script-bytes
                          coin-v2-max-coinbase-script-bytes)))))

    (define (config name magic port min-spacing genesis)
      (let ((header (block-header-field genesis)))
        (chain-config name: name
                      network-id: name
                      magic: magic
                      default-port: port
                      seed-peers: '()
                      protocol-version: 70015
                      services: 1
                      user-agent: "/sigilcoin-node-v2:0.1.0/"
                      genesis-header: header
                      genesis-hash: (block-header-hash header)
                      consensus-params: sigilcoin-consensus-params
                      extensions: (extensions min-spacing genesis))))

    ;;; Additive v2 mainnet-shaped chain. No seeds until Wave 3 activation.
    (define sigilcoin-v2-main-chain
      (config "sigilcoin-v2-main"
              #u8(#x8f #xd2 #xc0 #xa5)
              19544
              coin-min-block-spacing
              %main-genesis))

    ;;; Additive local chain used by v2 end-to-end node tests.
    (define sigilcoin-v2-regtest-chain
      (config "sigilcoin-v2-regtest"
              #u8(#xa5 #xc0 #xd2 #x8f)
              19545
              coin-regtest-min-block-spacing
              %regtest-genesis))))
