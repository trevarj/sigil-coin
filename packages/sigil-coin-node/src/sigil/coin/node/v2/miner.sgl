;;; (sigil coin node v2 miner) — producer and co-op block builders

(define-library (sigil coin node v2 miner)
  (import (sigil math)
          (sigil bitcoin utils)
          (sigil bitcoin tx)
          (sigil bitcoin consensus)
          (sigil coin puzzle examples)
          (sigil coin consensus)
          (sigil coin node miner)
          (sigil coin node v2 adapter)
          (sigil coin node v2 rules)
          (sigil coin node v2 body))
  (export
    coin-v2-table-solution
    coin-v2-mining-coinbase
    coin-v2-mining-coinbase/coop
    coin-v2-build-block
    coin-v2-build-coop-block)

  (begin

    (define %zero32 (make-bytevector 32 0))
    (define %coinbase-index #xffffffff)
    (define %sequence-final #xffffffff)

    ;;; Return producer table solution for one v2 puzzle.
    (define (coin-v2-table-solution previous-hash height complexity)
      (: bytevector? integer? integer? -> bytevector?)
      (coin-mining-bytes
        "coin-v2-table-solution"
        (pbe-spec-table-solution
          (coin-v2-node-puzzle previous-hash height complexity))))

    (define (require-fees who fees)
      (unless (and (number? fees) (exact? fees) (integer? fees) (>= fees 0))
        (error (string-append who ": expected non-negative fees")))
      fees)

    (define (optional-argument rest index default)
      (let loop ((xs rest) (i index))
        (cond ((null? xs) default)
              ((= 0 i) (car xs))
              (else (loop (cdr xs) (- i 1))))))

    (define (outputs-for plan producer-script)
      (map (lambda (entry)
             (txout value: (car entry)
                    script-pubkey: (or (cdr entry) producer-script)))
           plan))

    ;;; Build a canonical v2 coinbase, including exact co-op payouts.
    (define (coin-v2-mining-coinbase/coop height solution shares commitments
                                           graffiti producer-script
                                           carrier-script . maybe-fees)
      (: integer? any? list? list? any? bytevector? any? integer? ...
         -> transaction?)
      (if (not (bytevector? producer-script))
          (error "coin-v2-mining-coinbase/coop: expected producer script"))
      (let* ((fees (require-fees "coin-v2-mining-coinbase/coop"
                                 (optional-argument maybe-fees 0 0)))
             (value (+ (coin-block-reward height) fees))
             (plan (coin-v2-split-plan value shares carrier-script)))
        (transaction
          version: 1
          inputs: (list
                    (txin previous-output: (outpoint txid: %zero32
                                                     index: %coinbase-index)
                          script-sig: (coin-v2-coinbase-payload-encode
                                        (coin-v2-coinbase-payload
                                          height: height
                                          solution: (coin-mining-bytes
                                                      "coin-v2 coinbase solution"
                                                      solution)
                                          shares: (coin-v2-shares-encode shares)
                                          commits: (coin-v2-commits-encode
                                                     commitments)
                                          graffiti: (coin-mining-bytes
                                                      "coin-v2 coinbase graffiti"
                                                      graffiti)))
                          sequence: %sequence-final
                          witness: '()))
          outputs: (outputs-for plan producer-script)
          lock-time: 0)))

    ;;; Build a producer-only coinbase. Optional argument is total fees.
    (define (coin-v2-mining-coinbase height solution graffiti script-pubkey
                                     . maybe-fees)
      (: integer? any? any? bytevector? integer? ... -> transaction?)
      (coin-v2-mining-coinbase/coop
        height solution '() '() graffiti script-pubkey #f
        (require-fees "coin-v2-mining-coinbase"
                      (optional-argument maybe-fees 0 0))))

    (define (score-or-raise previous-hash height complexity solution quality)
      (let ((scored (coin-v2-score-for-solution previous-hash height complexity
                                                solution quality)))
        (if (coin-failed? scored)
            (error (string-append
                     "coin-v2-build-block: solution rejected ("
                     (symbol->string (coin-result-reason scored))
                     ")"))
            (coin-result-value scored))))

    (define (build parent-header height complexity solution shares commitments
                   graffiti producer-script carrier-script time txs fees
                   quality)
      (let* ((parent-hash (block-header-hash parent-header))
             (solution-bytes
               (coin-mining-bytes
                 "coin-v2-build-block solution"
                 (or solution
                     (coin-v2-table-solution parent-hash height complexity))))
             (score (score-or-raise parent-hash height complexity
                                    solution-bytes quality))
             (coinbase (coin-v2-mining-coinbase/coop
                         height solution-bytes shares commitments graffiti
                         producer-script carrier-script fees))
             (transactions (cons coinbase txs)))
        (block header-field:
                 (block-header version: coin-v2-header-version
                               previous-block: parent-hash
                               merkle-root: (merkle-root
                                              (map transaction-txid
                                                   transactions))
                               time: time
                               bits: (coin-v2-bits-encode complexity)
                               nonce: score)
               transactions: transactions)))

    ;;; Build a producer-only block. Optional values are transactions, fees,
    ;;; then commitments for this height's future shares.
    (define (coin-v2-build-block parent-header height complexity solution
                                 graffiti script-pubkey time
                                 . maybe-transactions)
      (: block-header? integer? integer? any? any? bytevector? integer? list?
         integer? list? ... -> block?)
      (if (not (block-header? parent-header))
          (error "coin-v2-build-block: expected parent header"))
      (let ((txs (optional-argument maybe-transactions 0 '()))
            (fees (require-fees "coin-v2-build-block"
                                (optional-argument maybe-transactions 1 0)))
            (commitments (optional-argument maybe-transactions 2 '())))
        (if (not (list? txs))
            (error "coin-v2-build-block: expected transactions"))
        (if (not (list? commitments))
            (error "coin-v2-build-block: expected commitments"))
        (build parent-header height complexity solution '() commitments
               graffiti script-pubkey #f time txs fees 0)))

    ;;; Build a co-op block revealing personalized shares committed by parent.
    ;;; Optional values are transactions, fees, then this block's commitments.
    (define (coin-v2-build-coop-block parent-block height complexity solution
                                      shares graffiti producer-script time
                                      . maybe-transactions)
      (: block? integer? integer? any? list? any? bytevector? integer? list?
         integer? list? ... -> block?)
      (if (not (block? parent-block))
          (error "coin-v2-build-coop-block: expected parent block"))
      (let* ((parent-header (block-header-field parent-block))
             (context (coin-v2-parent-context parent-block))
             (txs (optional-argument maybe-transactions 0 '()))
             (fees (require-fees "coin-v2-build-coop-block"
                                 (optional-argument maybe-transactions 1 0)))
             (commitments (optional-argument maybe-transactions 2 '()))
             (producer (coin-mining-bytes
                         "coin-v2-build-coop-block solution"
                         (or solution
                             (coin-v2-table-solution
                               (block-header-hash parent-header)
                               height complexity))))
             (payload (coin-v2-coinbase-payload
                        height: height
                        solution: producer
                        shares: (coin-v2-shares-encode shares)
                        commits: (coin-v2-commits-encode commitments)
                        graffiti: (coin-mining-bytes
                                    "coin-v2-build-coop-block graffiti"
                                    graffiti)))
             (checked (coin-v2-check-coop payload context)))
        (if (coin-failed? checked)
            (error (string-append
                     "coin-v2-build-coop-block: shares rejected ("
                     (symbol->string (coin-result-reason checked))
                     ")")))
        (if (not (list? txs))
            (error "coin-v2-build-coop-block: expected transactions"))
        (if (not (list? commitments))
            (error "coin-v2-build-coop-block: expected commitments"))
        (let* ((accepted (coin-result-value checked))
               (quality (coin-v2-shares-quality context accepted))
               (carrier (coin-v2-carrier-script parent-block)))
          (build parent-header height complexity producer accepted commitments
                 graffiti producer-script carrier time txs fees quality))))))
