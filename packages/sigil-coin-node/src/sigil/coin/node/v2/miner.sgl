;;; (sigil coin node v2 miner) — assembling a v2 SigilCoin block
;;;
;;; Still a BUILDER and still not a loop: there is no nonce to grind and, in
;;; v2, not even a target to hit. A miner writes a PROGRAM — a source that
;;; evaluates to a one-argument procedure reproducing all `k` published
;;; input/output pairs — and the block is finished the moment it is written.
;;;
;;; What changed from v1 is what the floor is. v1's always-legal solution was
;;; the quoted literal of the puzzle's target, which the survey found was the
;;; whole game 78.3% of the time. A v2 puzzle has no literal to quote,
;;; because the answer is a function, so the floor is the TABLE SOLUTION
;;; (§8.2): the `if`/`equal?` chain over the published pairs that the
;;; generator has already printed, parsed, constraint-checked and run before
;;; the puzzle could be published at all. `coin-v2-table-solution` hands it
;;; back, so a block can always be built and the chain cannot stall.
;;;
;;; Beating it is the game, and overfitting is self-punishing: the table is
;;; by construction the longest thing anybody would submit, so any structural
;;; program beats it on the primary ranking key.
;;;
;;; ```scheme
;;; ;; the floor: the table solution for this height's puzzle
;;; (coin-v2-build-block parent 1 128 #f "hi" payout time)
;;; ;; golfed: a shorter program reproducing the same pairs
;;; (coin-v2-build-block parent 1 128 "(lambda(x)(car x))" "hi" payout time)
;;; ```
;;;
;;; THE HEADER IS BUILT FROM THE BODY, NOT CHOSEN. `bits` is
;;; `0x207F0000 | C` for the complexity the caller derived from the parent
;;; chain, and `nonce` is the score word `coin-v2-score-for-solution`
;;; computes by actually running the solution — the same procedure body
;;; validation calls, so the header and the coinbase cannot disagree. A
;;; solution that does not solve the puzzle raises here rather than becoming
;;; a block the node would reject.
;;;
;;; The complexity is an argument rather than something derived here for the
;;; same reason the fee total is: it is a function of the parent chain, which
;;; block assembly has no handle on. `coin-v2-required-complexity` is what
;;; the caller uses, and passing a wrong one builds a block the node rejects
;;; — which is what makes this usable for negative tests.

(define-library (sigil coin node v2 miner)
  (import (sigil math)
          (sigil bitcoin utils)
          (sigil bitcoin tx)
          (sigil bitcoin consensus)
          (sigil coin puzzle examples)
          (sigil coin consensus)
          (sigil coin node miner)
          (sigil coin node v2 adapter)
          (sigil coin node v2 rules)
          (sigil coin node v2 body))
  (export
    coin-v2-table-solution
    coin-v2-mining-coinbase
    coin-v2-build-block)

  (begin

    (define %zero32 (make-bytevector 32 0))
    (define %coinbase-index #xffffffff)
    (define %sequence-final #xffffffff)

    ;;; The table solution for the puzzle at `height`: a miner's floor.
    ;;;
    ;;; Legal for every published puzzle by construction — §3.4 step 8 makes
    ;;; the generator build it, print it, parse it, constraint-check it and
    ;;; run it against all `k` pairs before accepting the puzzle. It is what
    ;;; you publish when you have not golfed anything.
    ;;;
    ;;; ```scheme
    ;;; (coin-ok? (coin-v2-check-solution
    ;;;             (coin-v2-puzzle-for parent 1 128)
    ;;;             (coin-v2-table-solution parent 1 128)))
    ;;; ; => #t
    ;;; ```
    (define (coin-v2-table-solution previous-hash height complexity)
      (: bytevector? integer? integer? -> bytevector?)
      (coin-mining-bytes
        "coin-v2-table-solution"
        (pbe-spec-table-solution
          (coin-v2-node-puzzle previous-hash height complexity))))

    (define (require-fees who fees)
      (unless (and (number? fees) (exact? fees) (integer? fees) (>= fees 0))
        (error (string-append who
                              ": expected a non-negative total of the fees"
                              " the block's transactions pay")))
      fees)

    (define (optional-argument rest index default)
      (let loop ((xs rest) (i index))
        (cond ((null? xs) default)
              ((= 0 i) (car xs))
              (else (loop (cdr xs) (- i 1))))))

    ;;; Build the coinbase transaction for a v2 SigilCoin block.
    ;;;
    ;;; The scriptSig is the canonical five-push payload with empty SHARES
    ;;; and COMMITS, which is what the co-op seam admits today; the LATER
    ;;; co-op task fills those two pushes and replaces the single output with
    ;;; §6.5's split.
    ;;;
    ;;; ```scheme
    ;;; (txout-value (car (transaction-outputs
    ;;;                     (coin-v2-mining-coinbase 1 "car" "" #u8(#x6a)))))
    ;;; ; => 100000000
    ;;; ```
    (define (coin-v2-mining-coinbase height solution graffiti script-pubkey
                                     . maybe-fees)
      (: integer? any? any? bytevector? integer? ... -> transaction?)
      (if (not (bytevector? script-pubkey))
          (error "coin-v2-mining-coinbase: expected a payout scriptPubKey"))
      (let ((fees (require-fees "coin-v2-mining-coinbase"
                                (optional-argument maybe-fees 0 0))))
        (transaction
          version: 1
          inputs: (list
                    (txin previous-output: (outpoint txid: %zero32
                                                     index: %coinbase-index)
                          script-sig: (coin-v2-coinbase-payload-encode
                                        (coin-v2-coinbase-payload
                                          height: height
                                          solution: (coin-mining-bytes
                                                      "coin-v2-mining-coinbase solution"
                                                      solution)
                                          shares: coin-v2-empty-shares
                                          commits: coin-v2-empty-commits
                                          graffiti: (coin-mining-bytes
                                                      "coin-v2-mining-coinbase graffiti"
                                                      graffiti)))
                          sequence: %sequence-final
                          witness: '()))
          outputs: (list (txout value: (+ (coin-block-reward height) fees)
                                script-pubkey: script-pubkey))
          lock-time: 0)))

    ;;; Build a v2 block extending `parent-header` at `height`.
    ;;;
    ;;; `solution` may be `#f`, which mines the table solution. Everything a
    ;;; node checks is set here: the five-push coinbase, the exact subsidy
    ;;; plus `fees`, the merkle root, `version`, `bits` from `complexity`,
    ;;; and `nonce` from the solution actually being mined.
    ;;;
    ;;; `transactions` and `fees` are optional and default to none.
    ;;;
    ;;; ```scheme
    ;;; (block? (coin-v2-build-block parent 1 128 #f "" #u8(#x6a) t)) ; => #t
    ;;; ```
    (define (coin-v2-build-block parent-header height complexity solution
                                 graffiti script-pubkey time
                                 . maybe-transactions)
      (: block-header? integer? integer? any? any? bytevector? integer? list?
         integer? ... -> block?)
      (if (not (block-header? parent-header))
          (error "coin-v2-build-block: expected a parent block header"))
      (if (not (list? (optional-argument maybe-transactions 0 '())))
          (error "coin-v2-build-block: expected a list of transactions"))
      (let* ((txs (optional-argument maybe-transactions 0 '()))
             (fees (require-fees "coin-v2-build-block"
                                 (optional-argument maybe-transactions 1 0)))
             (parent-hash (block-header-hash parent-header))
             (solution-bytes
               (coin-mining-bytes
                 "coin-v2-build-block solution"
                 (or solution
                     (coin-v2-table-solution parent-hash height complexity))))
             ;; The same procedure body validation calls, so the claim the
             ;; header makes is the one the coinbase can back.
             (scored (coin-v2-score-for-solution parent-hash
                                                 height
                                                 complexity
                                                 solution-bytes
                                                 0))
             (score (if (coin-failed? scored)
                        (error (string-append
                                 "coin-v2-build-block: the solution does not"
                                 " solve this height's puzzle ("
                                 (symbol->string (coin-result-reason scored))
                                 ")"))
                        (coin-result-value scored)))
             (coinbase (coin-v2-mining-coinbase height
                                                solution-bytes
                                                graffiti
                                                script-pubkey
                                                fees))
             (transactions (cons coinbase txs))
             (root (merkle-root (map transaction-txid transactions))))
        (block header-field:
                 (block-header version: coin-v2-header-version
                               previous-block: parent-hash
                               merkle-root: root
                               time: time
                               ;; The complexity commitment; derived from the
                               ;; parent chain by the caller, never chosen.
                               bits: (coin-v2-bits-encode complexity)
                               ;; The composite score word fork choice ranks
                               ;; by, computed from the body itself.
                               nonce: score)
               transactions: transactions)))))
