;;; Two SigilCoin nodes, two processes, one socket.
;;;
;;; The node suite drives one node through the entry points a peer would
;;; drive. This file puts the second node in its own OPERATING SYSTEM
;;; PROCESS and makes the two talk over loopback TCP: separate VMs, separate
;;; data directories, separate SQLite handles, no shared memory. That second
;;; node is the bundled `sigilcoin` operator binary, including secp256k1, so
;;; every command it runs is the one an operator runs, and every assertion
;;; about it is read back out of its own database afterwards.
;;;
;;; NOTHING HERE IS SIMULATED. Headers and block bodies both cross the wire
;;; through the node's own code on both sides: the peer's
;;; `node-sync-with-peer` asks, and this process's
;;; `node-serve-inbound-transport` answers — `getheaders` with headers and
;;; `getdata` with the bodies `sigil-bitcoin`'s own responder reads out of
;;; the serving node's `blocks` table. The receiving process requests,
;;; parses, stores, validates, reorganises and rejects with its own code,
;;; over the socket.
;;;
;;; Every wait is bounded — the accept, every envelope read, and each peer
;;; process's own connect and read timeouts — so a peer that stops talking
;;; fails a test with a message instead of hanging the suite.

(import (sigil test)
        (sigil fs)
        (sigil io)
        (sigil math)
        (sigil process)
        (sigil socket)
        (sigil sqlite)
        (sigil string)
        (sigil bitcoin utils)
        (sigil bitcoin primitives)
        (sigil bitcoin encoding)
        (sigil bitcoin keys)
        (sigil bitcoin script)
        (sigil bitcoin tx)
        (sigil bitcoin consensus)
        (sigil bitcoin p2p)
        (sigil bitcoin node)
        (sigil secp256k1)
        (sigil coin puzzle)
        (sigil coin puzzle generator)
        (sigil coin consensus)
        (only (sigil coin consensus shares)
              coin-check-share-solution/spec)
        (sigil coin node))

;; ============================================================
;; Bounds
;; ============================================================
;;
;; Ceilings, never delays: nothing here sleeps, and nothing waits without
;; one of these.

;; Longest wait for a peer process to open a connection.
(define %accept-timeout 30000)

;; Longest wait for a message from a connected peer. Generous on purpose: a
;; peer goes quiet for as long as it takes to ingest the headers it was just
;; sent, which is seconds for a retarget window. Hanging up would cost it the
;; whole block-download half of the pass.
(define %read-timeout 60000)

;; Envelopes the serving node handles on one connection. A whole sync round
;; is a handful, and one `getdata` is one of them however many bodies it
;; buys.
(define %serve-steps 512)

;; Transaction announcements accepted in one relay message.
(define %serve-max-tx 32)

;; Blocks a peer asks for at once, and the read budget it spends on the
;; replies. Kept equal: a peer that asked for more than it will read would
;; leave block messages unread in the socket.
(define %sync-batch "64")

;; Every external resource is registered immediately. Cleanup wraps the whole
;; harness, so failed assertions cannot leave children, sockets or data dirs.
(define %children '())
(define %listeners '())
(define %nodes '())
(define %dirs '())

;; ============================================================
;; Scripts and keys
;; ============================================================

;; `OP_RETURN "sg"`: unspendable, so blocks mined only for their height stay
;; out of every balance. The script the single-node fixtures mine to.
(define %elsewhere #u8(#x6a #x02 #x73 #x67))

;; `OP_TRUE`: a coinbase anyone can spend with an empty scriptSig.
;;
;; The spend test needs a mature output it can move WITHOUT a signature,
;; because secp256k1 is a native module and a workspace-wide run has none
;; bound — the same reason `sigil-coin-cli`'s suite gates its key tests. The
;; money still lands on a real `sgl1` P2WPKH address whose key the receiving
;; node holds on disk; only the input side of the transfer is keyless.
(define %anyone #u8(#x51))

;; The key the receiving node holds, and the address it pays out to. Fixed
;; so the address is checked in rather than derived at run time, which needs
;; secp256k1; `assert-address-matches-key` ties the two together whenever
;; the runtime does have it.
(define %peer-wallet-key
  "0101010101010101010101010101010101010101010101010101010101010101")
(define %peer-address "sgl1q0xcqpzrky6eff2g52qdye53xkk9jxkvrcgu8pc")
(define %recipient-address "sgl1qw508d6qejxtdg4y5r3zarvary0c5xw7kr43pwr")

;; Whether this runtime has the secp256k1 native module bound. Probed by
;; use, because referencing an unbound native raises.
(define %native-secp256k1?
  (guard (err (#t #f))
    (and (public-key? (private-key->public-key (make-bytevector 32 1))) #t)))

;; ============================================================
;; The peer process
;; ============================================================

;; Bundled operator binary carries secp256k1, unlike generic `sigil` runner.
;; Second process therefore verifies co-op signatures itself.
(define %peer-program
  (let loop ((candidates (list "build/dev/bin/sigilcoin"
                               "../../build/dev/bin/sigilcoin")))
    (cond ((null? candidates)
           (error "test-network: cannot find build/dev/bin/sigilcoin"))
          ((file-exists? (car candidates)) (car candidates))
          (else (loop (cdr candidates))))))

;;; Spawn a `sigilcoin` command as its own process, without waiting.
;;;
;;; ```scheme
;;; (spawn-peer '("status" "--regtest" "--data-dir" "/tmp/b"))
;;; ```
(define (spawn-peer args)
  (let ((p (apply process-spawn
                  %peer-program
                  die-with-parent: #t
                  args)))
    (unless p
      (error "test-network: could not spawn the peer process"))
    (set! %children (cons p %children))
    p))

;;; Everything a peer process printed, as a list of lines.
(define (peer-output p)
  (let loop ((lines '()))
    (let ((line (read-line (process-stdout p))))
      (if (eof-object? line)
          (reverse lines)
          (loop (cons line lines))))))

;;; Value a peer LAST printed for a `key: value` line, or `#f`.
;;;
;;; The sync commands print a status block per iteration and one more at the
;;; end, so the last occurrence is the state the peer finished in. The
;;; earlier ones are a pass in progress: a first pass that spends its whole
;;; budget on headers reports no blocks yet and is not a failure.
;;;
;;; ```scheme
;;; (peer-field lines "best-height") ; => "4"
;;; ```
(define (peer-field lines key)
  (let ((prefix (string-append key ": ")))
    (let loop ((xs lines) (found #f))
      (cond ((null? xs) found)
            ((string-starts-with? (car xs) prefix)
             (loop (cdr xs)
                   (string-trim (substring (car xs)
                                           (string-length prefix)
                                           (string-length (car xs))))))
            (else (loop (cdr xs) found))))))

;; The last line a failed peer printed is its `sigilcoin: <reason>`.
(define (peer-failure-reason lines)
  (if (null? lines)
      "no output"
      (car (reverse lines))))

;; ============================================================
;; The listening side
;; ============================================================

;; Loopback only, on a port this process binds the moment it picks it and
;; holds until the phase is over: nothing can take it in between, so a
;; second run of the suite, or a busy machine, cannot collide.
(define %port-base 19500)
(define %port-span 300)

;;; Bind a free loopback port, returning `(port . listener)`.
(define (open-endpoint)
  (let loop ((port (+ %port-base (modulo (process-id) %port-span)))
             (tries 0))
    (if (> tries 128)
        (error "test-network: no free loopback port in the test range")
        (let ((listener (guard (err (else #f))
                          (tcp-listen port 8 "127.0.0.1"))))
          (if listener
              (begin
                (set! %listeners (cons listener %listeners))
                (cons port listener))
              (loop (+ %port-base
                       (modulo (+ 1 (- port %port-base)) %port-span))
                    (+ tries 1)))))))

(define (endpoint-text port)
  (string-append "127.0.0.1:" (number->string port)))

;; SQLite rows come back keyed by column name; take either a string or a
;; symbol key, as the single-node fixtures do.
(define (row-value row key)
  (let ((entry (assoc key row)))
    (if entry
        (cdr entry)
        (let ((sym (assoc (string->symbol key) row)))
          (and sym (cdr sym))))))

;;; Serve one accepted peer with the node's own inbound handler.
(define (serve-peer n sock)
  ;; The peer hanging up is how every one of these connections ends — it
  ;; finishes its pass and closes, and the node's reader raises.
  (guard (err (else #f))
    (node-serve-inbound-transport
      n
      "127.0.0.1"
      0
      (lambda () (p2p-socket-read-envelope-timeout sock %read-timeout))
      (lambda (envelope) (p2p-socket-write-envelope sock envelope))
      (lambda () (socket-close sock))
      %serve-steps
      %serve-max-tx))
  (guard (err (else #f))
    (socket-close sock))
  #t)

;;; Serve `count` inbound connections and return how many were served.
;;;
;;; An accept that times out returns early with a smaller count, which every
;;; caller asserts on: it means the peer process never arrived.
(define (serve-connections n listener count)
  (let loop ((served 0))
    (if (>= served count)
        served
        (if (socket-ready? listener %accept-timeout)
            (let ((sock (tcp-accept listener)))
              (if sock
                  (begin (serve-peer n sock) (loop (+ served 1)))
                  (loop served)))
            served))))

;;; Sync a peer process against a node this process serves.
;;;
;;; The listener is bound before the peer is spawned, so there is no window
;;; in which the peer can find the port closed. Returns the peer's printed
;;; lines; a non-zero exit or a missed connection raises with the peer's own
;;; reason.
;;;
;;; ```scheme
;;; (sync-peer server listener port dir 2)
;;; ```
(define (sync-peer server listener port dir iterations)
  (let* ((child (spawn-peer (list "sync"
                                  "--regtest"
                                  "--data-dir" dir
                                  "--peer" (endpoint-text port)
                                  "--max-steps" %sync-batch
                                  "--max-blocks" %sync-batch
                                  "--iterations" (number->string iterations)
                                  "--connect-timeout" "5000"
                                  "--read-timeout" "30000")))
         (served (serve-connections server listener iterations))
         ;; Read after serving, not during: a sync prints a status block per
         ;; iteration, tens of lines, which the pipe holds comfortably.
         (lines (peer-output child))
         (status (process-wait child)))
    (unless (= iterations served)
      (error (string-append "test-network: the peer opened "
                            (number->string served)
                            " of "
                            (number->string iterations)
                            " connections: "
                            (peer-failure-reason lines))))
    (cons status lines)))

;; A sync that has to succeed.
(define (sync-peer-ok server listener port dir iterations)
  (let ((result (sync-peer server listener port dir iterations)))
    (unless (= 0 (car result))
      (error (string-append
               "test-network: `sigilcoin sync` failed: "
               (or (peer-field (cdr result) "sync-last-error")
                   (peer-failure-reason (cdr result))))))
    (cdr result)))

(define (header-sync-peer-ok server listener port dir)
  (let* ((child (spawn-peer
                  (list "header-sync" "--regtest" "--data-dir" dir
                        "--peer" (endpoint-text port)
                        "--max-steps" %sync-batch "--iterations" "1"
                        "--connect-timeout" "5000"
                        "--read-timeout" "30000")))
         (served (serve-connections server listener 1))
         (lines (peer-output child))
         (status (process-wait child)))
    (unless (= 1 served)
      (error "test-network: header-sync peer did not connect"))
    (unless (= 0 status)
      (error (string-append "test-network: header-sync failed: "
                            (peer-failure-reason lines))))
    lines))

;; ============================================================
;; Data directories
;; ============================================================

(define (fresh-dir)
  (let ((dir (make-temp-directory)))
    (unless dir
      (error "test-network: could not create a temp directory"))
    (set! %dirs (cons dir %dirs))
    dir))

;; `(sigil fs)` deletes one empty directory at a time, and a node directory
;; holds a database, its journals and a wallet key.
(define (remove-tree dir)
  (process-run "rm" "-rf" dir))

(define (cleanup)
  (for-each (lambda (p)
              (guard (err (else #f)) (process-kill! p))
              (guard (err (else #f)) (process-wait p)))
            %children)
  (for-each (lambda (s)
              (guard (err (else #f)) (socket-close s)))
            %listeners)
  (for-each (lambda (n)
              (guard (err (else #f)) (node-close n)))
            %nodes)
  (for-each remove-tree %dirs))

;; The wallet key a peer's data directory holds, planted rather than
;; generated so the address it pays to can be checked in.
(define (plant-wallet-key dir)
  (let ((path (string-append dir "/wallet.key")))
    (write-file-string path (string-append %peer-wallet-key "\n"))
    (process-run "chmod" "0600" path)
    path))

;; The scriptPubKey an `sgl1` address pays to. Bech32 only: deriving this
;; from an address needs no key, which is why the payment side of the spend
;; test works on a runtime with no secp256k1.
(define (address->script address)
  (let ((decoded (segwit-decode address)))
    (unless (and decoded (string=? "sgl" (car decoded)) (= 0 (cadr decoded)))
      (error "test-network: not a SigilCoin v0 address"))
    (script-p2wpkh (caddr decoded))))

;; The address `%peer-wallet-key` really produces, on a runtime that can
;; derive one. Nothing else in this file needs a key, so everywhere else is
;; native-free.
(define (assert-address-matches-key)
  (when %native-secp256k1?
    (assert-equal %peer-address
                  (segwit-encode
                    "sgl"
                    0
                    (hash160 (private-key->public-key
                               (hex-decode %peer-wallet-key)))))))

;; ============================================================
;; Nodes
;; ============================================================

(define (open-node dir)
  (let ((n (node-open sigilcoin-regtest-chain dir)))
    (set! %nodes (cons n %nodes))
    n))

(define (block-hash b)
  (block-header-hash (block-header-field b)))

(define (coin-next-block-time parent spacing)
  (+ (block-header-time parent) (max 1 spacing)))

(define (height-of n)
  (node-status-snapshot-best-height (node-status n)))

(define (validated-count n)
  (node-status-snapshot-validated-block-count (node-status n)))

(define (best-block-height n)
  (node-status-snapshot-best-block-height (node-status n)))

(define (best-block-hash n)
  (node-status-snapshot-best-block-hash (node-status n)))

(define (last-error n)
  (node-status-snapshot-sync-last-error (node-status n)))

(define (tip-is? n b)
  (string=? (hex-encode (block-hash b)) (best-block-hash n)))

;; Ingest, store, validate: the peer-driven path with the network taken out,
;; which is how this side of the wire produces blocks to serve.
(define (submit n b)
  (node-ingest-headers n (list (block-header-field b)))
  (node-store-block n b)
  (node-validate-blocks n))

(define (header-row->header row)
  (block-header-parse (hex-decode (row-value row "header_hex"))))

(define (stored-header n hash)
  (let ((rows (sqlite-query (node-db n)
                            "SELECT header_hex FROM headers WHERE hash = ?"
                            hash)))
    (and (not (null? rows)) (header-row->header (car rows)))))

;; Canonical validated history through active tip, oldest first.
(define (validated-headers n)
  (let loop ((height (best-block-height n))
             (header (if (= 0 (best-block-height n))
                         (chain-config-genesis-header (node-config n))
                         (stored-header n (best-block-hash n))))
             (out '()))
    (if (= height 0)
        (cons header out)
        (loop (- height 1)
              (stored-header n
                (hex-encode (block-header-previous-block header)))
              (cons header out)))))

(define (mine-blocks n count payout)
  (let loop ((i 0) (blocks '()))
    (if (>= i count)
        (reverse blocks)
        (let* ((headers (validated-headers n))
               (parent (car (reverse headers)))
               (height (length headers))
               (complexity (coin-required-complexity headers height))
               (b (coin-build-block
                    parent height complexity #f "two-node" payout
                    (coin-next-block-time parent
                                          coin-regtest-min-block-spacing))))
          (unless (= 1 (submit n b))
            (error (string-append "test-network: a block did not validate: "
                                  (last-error n))))
          (loop (+ i 1) (cons b blocks))))))

;;; A second node holding the same blocks, built by submitting them again.
;;;
;;; Copying a data directory would be quicker and would not be a snapshot:
;;; the database is open. Replaying the same block objects gives a node that
;;; validated every one of them itself.
(define (node-with-blocks dir blocks)
  (let ((n (open-node dir)))
    (for-each
      (lambda (b)
        (unless (= 1 (submit n b))
          (error (string-append "test-network: replaying a block failed: "
                                (last-error n)))))
      blocks)
    n))

(define (active-utxos n)
  (sqlite-query
    (node-db n)
    "SELECT height, value, coinbase, script_pubkey, created_by FROM utxos WHERE active = 1 ORDER BY height ASC"))

(define (utxo-total n)
  (let loop ((rows (active-utxos n)) (total 0))
    (if (null? rows)
        total
        (loop (cdr rows) (+ total (row-value (car rows) "value"))))))

(define (solo-coinbase-value height . maybe-fees)
  (+ (quotient (* 4 (coin-block-reward height)) 5)
     (if (null? maybe-fees) 0 (car maybe-fees))))

(define (solo-issued-supply height)
  (let loop ((h 1) (total 0))
    (if (> h height)
        total
        (loop (+ h 1) (+ total (solo-coinbase-value h))))))


(define (utxos-paying n script)
  (let loop ((rows (active-utxos n)) (out '()))
    (cond ((null? rows) (reverse out))
          ((string=? (hex-encode script) (row-value (car rows) "script_pubkey"))
           (loop (cdr rows) (cons (car rows) out)))
          (else (loop (cdr rows) out)))))

;; Three legal solutions to one puzzle, longest first. The shortest is the
;; generator's own; the others are the same program behind one and two
;; spaces, which the reader skips — a worse block by SigilCoin's only
;; measure, and legal by every other rule. Ranking blocks needs a ladder of
;; lengths for a fixed puzzle, and the generator publishes at most two.
(define (solution-ladder parent-hash height complexity)
  (let ((best (utf8->string
                (coin-table-solution parent-hash height complexity))))
    (list (string-append "  " best) (string-append " " best) best)))

(define (build-at parent height complexity solution graffiti payout)
  (coin-build-block parent
                    height
                    complexity
                    solution
                    graffiti
                    payout
                    (coin-next-block-time parent
                                          coin-regtest-min-block-spacing)))

;; ============================================================
;; Fresh sync from genesis
;; ============================================================

(test-group "sigilcoin two-node sync"
  (test "an empty peer process syncs a mined chain from genesis"
    (let* ((dir-a (fresh-dir))
           (dir-b (fresh-dir))
           (a (open-node dir-a))
           (blocks (mine-blocks a 16 %elsewhere))
           (at-16 (list-ref blocks 15))
           (complexity-16
             (coin-result-value
               (coin-bits-decode
                 (block-header-bits (block-header-field at-16)))))
           (endpoint (open-endpoint))
           (port (car endpoint))
           (listener (cdr endpoint)))
      (assert-equal 16 (height-of a))
      (assert-equal 16 (validated-count a))
      (assert-true (not (= coin-genesis-complexity complexity-16)))
      ;; The peer starts with nothing but the address of this node.
      (let ((lines (sync-peer-ok a listener port dir-b 2)))
        ;; What the peer itself reported, before anything is read back out
        ;; of its database.
        (assert-equal "16" (peer-field lines "best-height"))
        (assert-equal "16" (peer-field lines "validated-blocks"))
        (assert-equal (hex-encode (block-hash at-16))
                      (peer-field lines "best-block-hash"))
        (assert-equal "" (peer-field lines "sync-last-error")))
      (socket-close listener)
      (node-close a)
      ;; And the same chain read out of the peer's own database.
      (let ((b (open-node dir-b)))
        (assert-equal 16 (height-of b))
        (assert-equal 16 (best-block-height b))
        (assert-equal (hex-encode (block-hash at-16))
                      (best-block-hash b))
        ;; Bodies, not just headers: a full retarget window validated, and
        ;; every solo coinbase is present in the peer's own UTXO set.
        (assert-equal 16 (validated-count b))
        (assert-equal 16 (length (active-utxos b)))
        (assert-equal (solo-issued-supply 16) (utxo-total b))
        (assert-equal complexity-16
                      (coin-result-value
                        (coin-bits-decode
                          (block-header-bits
                            (list-ref (validated-headers b) 16)))))
        (assert-equal "" (last-error b))
        (node-close b))
      (remove-tree dir-a)
      (remove-tree dir-b))))

;; ============================================================
;; Propagating a newly mined block
;; ============================================================

(test-group "sigilcoin block propagation"
  (test "a block mined after the peer caught up reaches it too"
    (let* ((dir-a (fresh-dir))
           (dir-b (fresh-dir))
           (a (open-node dir-a))
           (blocks (mine-blocks a 2 %elsewhere))
           (endpoint (open-endpoint))
           (port (car endpoint))
           (listener (cdr endpoint)))
      ;; Both nodes on the same tip.
      (sync-peer-ok a listener port dir-b 1)
      (let ((b (open-node dir-b)))
        (assert-equal 2 (best-block-height b))
        (assert-true (tip-is? b (list-ref blocks 1)))
        (node-close b))
      ;; A new block is mined while the peer is idle, and reaches it on the
      ;; next ordinary sync — no headers, blocks or hashes handed over.
      (let ((next (car (mine-blocks a 1 %elsewhere))))
        (assert-equal 3 (best-block-height a))
        (let ((lines (sync-peer-ok a listener port dir-b 1)))
          (assert-equal "3" (peer-field lines "best-block-height"))
          (assert-equal (hex-encode (block-hash next))
                        (peer-field lines "best-block-hash")))
        (socket-close listener)
        (node-close a)
        (let ((b (open-node dir-b)))
          (assert-equal 3 (best-block-height b))
          (assert-true (tip-is? b next))
          (assert-equal 3 (validated-count b))
          (assert-equal (solo-issued-supply 3) (utxo-total b))
          (node-close b)))
      (remove-tree dir-a)
      (remove-tree dir-b))))

;; ============================================================
;; Composite quality over the network
;; ============================================================

(define %genesis-block
  (coin-genesis-block coin-regtest-genesis-quote coin-regtest-genesis-time))
(define %genesis-header (block-header-field %genesis-block))

;; A personalized source can broaden only its exact reserved-string branch.
;; Tasks with ordinary string inputs have no fixture candidate.
(define %generated-anchor-predicate "(equal? x\"@\")")
(define %semantic-anchor-predicate "(string? x)")

(define (ordinary-inputs-non-string? spec)
  (let loop ((pairs (puzzle-spec-examples spec)))
    (cond
      ((null? pairs) #f)
      ((null? (cdr pairs))
       (let ((anchor (car pairs)))
         (and (string? (car anchor))
              (string=? puzzle-anchor-input (car anchor))
              (puzzle-anchor-output? (cdr anchor)))))
      ((string? (car (car pairs))) #f)
      (else (loop (cdr pairs))))))

(define (semantic-share-source spec)
  (let ((source (puzzle-spec-hidden-source spec)))
    (and (ordinary-inputs-non-string? spec)
         (= 1 (string-count source %generated-anchor-predicate))
         (let* ((candidate
                  (string-replace source %generated-anchor-predicate
                                  %semantic-anchor-predicate))
                (checked
                  (coin-check-share-solution/spec spec candidate)))
           (and (< (string-length candidate) (puzzle-spec-par spec))
                (coin-ok? checked)
                candidate)))))

(define (bytes<? a b)
  (let loop ((i 0))
    (cond ((>= i (bytevector-length a)) #f)
          ((< (bytevector-u8-ref a i) (bytevector-u8-ref b i)) #t)
          ((> (bytevector-u8-ref a i) (bytevector-u8-ref b i)) #f)
          (else (loop (+ i 1))))))

(define (sort-bytes xs key)
  (let loop ((rest xs) (out '()))
    (if (null? rest)
        out
        (loop (cdr rest)
              (let insert ((ys out))
                (cond ((null? ys) (list (car rest)))
                      ((bytes<? (key (car rest)) (key (car ys)))
                       (cons (car rest) ys))
                      (else (cons (car ys) (insert (cdr ys))))))))))

(define (signed-share secret-byte source context)
  (let* ((secret (make-bytevector 32 secret-byte))
         (pubkey (secp256k1-pubkey-create secret))
         (bytes (string->utf8 source))
         (preimage (coin-share-preimage
                     (coin-coop-context-parent-prev-hash context)
                     (coin-coop-context-puzzle-height context)
                     (coin-coop-context-complexity context)
                     bytes
                     pubkey)))
    (coin-share pubkey: pubkey
                signature: (secp256k1-ecdsa-sign secret preimage)
                blind: (make-bytevector 32 101)
                solution: bytes)))

(define (generated-share secret-byte context)
  (let* ((secret (make-bytevector 32 secret-byte))
         (pubkey (secp256k1-pubkey-create secret))
         (spec (coin-share-puzzle context pubkey))
         (source (semantic-share-source spec)))
    (and source (signed-share secret-byte source context))))

(define (generated-shares count context)
  (let loop ((secret-byte 1) (out '()))
    (cond
      ((= count (length out)) (sort-bytes out coin-share-pubkey))
      ((> secret-byte 255)
       (error "test-network: fewer than eight semantic share candidates"))
      (else
        (let ((candidate (generated-share secret-byte context)))
          (loop (+ secret-byte 1)
                (if (and candidate
                         (not (member (coin-share-solution candidate)
                                      (map coin-share-solution out))))
                    (cons candidate out)
                    out)))))))

(define (block-from-coinbase parent height complexity score coinbase)
  (block header-field:
           (block-header version: coin-header-version
                         previous-block: (block-header-hash parent)
                         merkle-root: (merkle-root
                                        (list (transaction-txid coinbase)))
                         time: (coin-next-block-time
                                 parent coin-regtest-min-block-spacing)
                         bits: (coin-bits-encode complexity)
                         nonce: score)
         transactions: (list coinbase)))

(define (block-with-coinbase b coinbase)
  (let* ((txs (cons coinbase (cdr (block-transactions b))))
         (header (block-header
                   (block-header-field b)
                   merkle-root: (merkle-root (map transaction-txid txs)))))
    (block header-field: header transactions: txs)))

;; Five raw pushes let hostile wire tests carry SHARES bytes the canonical
;; encoder correctly refuses to create.
(define (raw-coinbase-script height solution shares commits graffiti)
  (script-append (script-push-data (script-number-encode height))
                 (script-push-data solution)
                 (script-push-data shares)
                 (script-push-data commits)
                 (script-push-data graffiti)))

(define (malformed-shares-block b)
  (let* ((payload (coin-result-value (coin-block-coinbase-payload b)))
         (coinbase (car (block-transactions b)))
         (input (car (transaction-inputs coinbase)))
         (script (raw-coinbase-script
                   (coin-coinbase-payload-height payload)
                   (coin-coinbase-payload-solution payload)
                   #u8()
                   (coin-coinbase-payload-commits payload)
                   (coin-coinbase-payload-graffiti payload)))
         (bad-coinbase
           (transaction coinbase
                        inputs: (list (txin input script-sig: script)))))
    (block-with-coinbase b bad-coinbase)))

;; Offer an unvalidated block through a real listener and require the peer
;; process to download, persist and reject it independently.
(define (assert-peer-rejects server bad dir expected-height reason)
  (let* ((endpoint (open-endpoint))
         (port (car endpoint))
         (listener (cdr endpoint))
         (result (sync-peer server listener port dir 1)))
    (assert-true (not (= 0 (car result))))
    (assert-equal (number->string expected-height)
                  (peer-field (cdr result) "best-block-height"))
    (socket-close listener))
  (let* ((peer (open-node dir))
         (rows (sqlite-query
                 (node-db peer)
                 "SELECT status, validated, last_error FROM blocks WHERE hash = ?"
                 (hex-encode (block-hash bad)))))
    (assert-equal 1 (length rows))
    (assert-equal "invalid" (row-value (car rows) "status"))
    (assert-equal 0 (row-value (car rows) "validated"))
    (assert-true (string-contains? (row-value (car rows) "last_error")
                                   reason))
    (node-close peer)))

(when %native-secp256k1?
  (test-group "sigilcoin Q-neutral copy-and-attach fork choice"
    (test "valid attached shares cannot replace first-seen or settled producer"
      (let* ((dir (fresh-dir))
             (validation-dir (fresh-dir))
             ;; Derive an attacker share for H1, then rebuild H1 carrying its
             ;; commitment. The share context deliberately excludes H1's hash.
             (prototype
               (coin-build-block
                 %genesis-header 1 coin-genesis-complexity #f "prototype"
                 %elsewhere (+ coin-regtest-genesis-time 1)))
             (share
               (car (generated-shares 1 (coin-parent-context prototype))))
             (commitment
               (coin-share-commitment (coin-parent-context prototype) share))
             (parent
               (coin-build-block
                 %genesis-header 1 coin-genesis-complexity #f "commit"
                 %elsewhere (+ coin-regtest-genesis-time 1)
                 '() 0 (list commitment)))
             (parent-header (block-header-field parent))
             (height 2)
             (solution
               (coin-table-solution
                 (block-header-hash parent-header)
                 height
                 coin-genesis-complexity))
             (arrival
               (+ (block-header-time parent-header)
                  coin-regtest-min-block-spacing))
             (original
               (coin-build-block
                 parent-header height coin-genesis-complexity solution
                 "original solver" %elsewhere arrival))
             (copy-before-child
               (coin-build-coop-block
                 parent height coin-genesis-complexity solution (list share)
                 "copy before child" %anyone arrival))
             (child
               (coin-build-block
                 (block-header-field original)
                 (+ height 1)
                 coin-genesis-complexity
                 #f
                 "settling child"
                 %elsewhere
                 (+ arrival coin-regtest-min-block-spacing)))
             (copy-after-child
               (coin-build-coop-block
                 parent height coin-genesis-complexity solution (list share)
                 "copy after child" %anyone arrival))
             (original-word
               (block-header-nonce (block-header-field original)))
             (copy-word
               (block-header-nonce (block-header-field copy-before-child)))
             (original-score (coin-score-decode original-word))
             (copy-score (coin-score-decode copy-word))
             (n (open-node dir))
             (validation-node (open-node validation-dir)))
        ;; The copy is a genuinely valid cooperative block, not a synthetic
        ;; score claim. A separate node selects and fully validates it.
        (assert-equal 1 (submit validation-node parent))
        (assert-equal 1 (submit validation-node copy-before-child))
        (assert-true (tip-is? validation-node copy-before-child))
        (node-close validation-node)

        ;; Producer work is byte-for-byte the same. Only authenticated Q and
        ;; therefore raw W differ.
        (assert-equal (coin-score-length original-score)
                      (coin-score-length copy-score))
        (assert-equal (coin-score-memory original-score)
                      (coin-score-memory copy-score))
        (assert-equal (coin-score-steps original-score)
                      (coin-score-steps copy-score))
        (assert-equal 0 (coin-score-quality original-score))
        (assert-true (> (coin-score-quality copy-score) 0))
        (assert-true (not (= original-word copy-word)))
        (assert-equal
          copy-word
          (coin-result-value
            (coin-block-score parent height coin-genesis-complexity
                              copy-before-child)))
        (assert-equal (coin-score-rank-word original-word)
                      (coin-score-rank-word copy-word))
        (assert-equal (coin-score-saving original-word)
                      (coin-score-saving copy-word))
        (assert-equal 0 (coin-score-compare original-word copy-word))

        ;; First-seen retains H2. The losing copy body is downloaded but is
        ;; not revalidated onto the active chain.
        (assert-equal 1 (submit n parent))
        (assert-equal 1 (submit n original))
        (assert-true (tip-is? n original))
        (assert-equal 0 (submit n copy-before-child))
        (assert-true (tip-is? n original))

        ;; A real H3 child settles the original. A distinct later copy of H2
        ;; remains unable to roll the active chain back.
        (assert-equal 1 (submit n child))
        (assert-true (tip-is? n child))
        (assert-equal 0 (submit n copy-after-child))
        (assert-true (tip-is? n child))
        (assert-equal 3 (validated-count n))
        (assert-equal
          (block-hash original)
          (block-header-hash (list-ref (validated-headers n) height)))
        (node-close n)))))

;; One canonical commit/reveal fixture shared by network acceptance tests.
(define %coop-prototype
  (coin-build-block %genesis-header 1 coin-genesis-complexity #f
                    "prototype" %anyone
                    (+ coin-regtest-genesis-time 1)))
(define %coop-context (coin-parent-context %coop-prototype))
(define %coop-shares
  (if %native-secp256k1?
      (generated-shares 2 %coop-context)
      '()))
(define %coop-commits
  (sort-bytes
    (map (lambda (share) (coin-share-commitment %coop-context share))
         %coop-shares)
    (lambda (x) x)))
(define %coop-parent
  (coin-build-block %genesis-header 1 coin-genesis-complexity #f
                    "commit" %anyone
                    (+ coin-regtest-genesis-time 1)
                    '() 0 %coop-commits))
(define %coop-child
  (and %native-secp256k1?
       (coin-build-coop-block
         %coop-parent 2 coin-genesis-complexity #f %coop-shares
         "reveal" %elsewhere (+ coin-regtest-genesis-time 2))))

(when %native-secp256k1?
  (test-group "sigilcoin co-op over two processes"
    (test "durable commit parent pays two shares and carrier after TCP sync"
      (let* ((dir-a (fresh-dir))
             (dir-b (fresh-dir))
             (a (open-node dir-a)))
        (assert-equal 1 (submit a %coop-parent))
        ;; Discard process state before H+1. Parent body, commitments and
        ;; carrier script must be recovered from SQLite.
        (node-close a)
        (set! a (open-node dir-a))
        (assert-equal 1 (submit a %coop-child))
        (let* ((coinbase (car (block-transactions %coop-child)))
               (outputs (transaction-outputs coinbase))
               (subsidy (coin-block-reward 2))
               ;; Contributions are pure previews here: this test is not the
               ;; validator and must not depend on its verified-share cache.
               (contributions
                 (map (lambda (share)
                        (let ((preview
                                (coin-check-share-solution
                                  %coop-context share)))
                          (assert-true (coin-ok? preview))
                          (list-ref (coin-result-value preview) 2)))
                      %coop-shares))
               (quality (coin-quality contributions))
               (plan (coin-payout-plan
                       subsidy 0 %coop-shares contributions %anyone))
               (expected-values (map car plan))
               (carrier-value (car (reverse expected-values))))
          (assert-equal 4 (length outputs))
          (assert-equal expected-values (map txout-value outputs))
          (assert-equal subsidy (transaction-output-value coinbase))
          (assert-equal 2 quality)
          (assert-equal quality
                        (coin-score-quality
                          (coin-score-decode
                            (block-header-nonce
                              (block-header-field %coop-child)))))
          (let* ((endpoint (open-endpoint))
                 (port (car endpoint))
                 (listener (cdr endpoint))
                 (lines (sync-peer-ok a listener port dir-b 1)))
            (assert-equal "2" (peer-field lines "validated-blocks"))
            (socket-close listener))
          (node-close a)
          ;; Read body and UTXOs from peer database. Recomputing Q from its
          ;; decoded wire body proves independent validation, not copied state.
          (let* ((b (open-node dir-b))
                 (row (car (sqlite-query
                             (node-db b)
                             "SELECT block_hex FROM blocks WHERE height = 2 AND validated = 1")))
                 (received (block-parse
                             (hex-decode (row-value row "block_hex"))))
                 (payload (coin-result-value
                            (coin-block-coinbase-payload received)))
                 (decoded (coin-result-value
                            (coin-shares-decode
                              (coin-coinbase-payload-shares payload)))))
            (assert-true (tip-is? b %coop-child))
            (assert-equal
              quality
              (coin-quality
                (map (lambda (share)
                       (let ((preview
                               (coin-check-share-solution
                                 (coin-parent-context %coop-parent) share)))
                         (assert-true (coin-ok? preview))
                         (list-ref (coin-result-value preview) 2)))
                     decoded)))
            (let share-loop ((shares %coop-shares)
                             (values (cdr expected-values)))
              (unless (null? shares)
                (let ((paid (utxos-paying
                              b (coin-share-script
                                  (coin-share-pubkey (car shares))))))
                  (assert-equal 1 (length paid))
                  (assert-equal (car values)
                                (row-value (car paid) "value")))
                (share-loop (cdr shares) (cdr values))))
            (let ((carrier (utxos-paying b %anyone)))
              (assert-equal 2 (length carrier))
              (assert-equal
                (+ (quotient (* 4 (coin-block-reward 1)) 5)
                   carrier-value)
                (let loop ((xs carrier) (sum 0))
                  (if (null? xs) sum
                      (loop (cdr xs)
                            (+ sum (row-value (car xs) "value")))))))
            (assert-equal (+ (solo-coinbase-value 1) subsidy)
                          (utxo-total b))
            (node-close b)))
        (remove-tree dir-a)
        (remove-tree dir-b))))

  (test-group "sigilcoin hostile co-op blocks over TCP"
    (test "malformed SHARES codec is rejected by peer"
      (let* ((server-dir (fresh-dir))
             (peer-dir (fresh-dir))
             (server (open-node server-dir))
             (bad (malformed-shares-block %coop-child)))
        (assert-equal 1 (submit server %coop-parent))
        (assert-equal 1
                      (node-ingest-headers
                        server (list (block-header-field bad))))
        (node-store-block server bad)
        (assert-peer-rejects server bad peer-dir 0 "shares-malformed")
        (node-close server)))

    (test "wrong aggregate Q is rejected by peer"
      (let* ((server-dir (fresh-dir))
             (peer-dir (fresh-dir))
             (server (open-node server-dir))
             (score (coin-score-decode
                      (block-header-nonce
                        (block-header-field %coop-child))))
             (bad (block %coop-child
                         header-field:
                           (block-header
                             (block-header-field %coop-child)
                             nonce: (coin-score-pack
                                      (coin-score-length score)
                                      (coin-score-memory score)
                                      (coin-score-steps score)
                                      0)))))
        (assert-equal 1 (submit server %coop-parent))
        (assert-equal 1
                      (node-ingest-headers
                        server (list (block-header-field bad))))
        (node-store-block server bad)
        (assert-peer-rejects server bad peer-dir 0 "score-mismatch")
        (node-close server)))

    (test "replayed committed share is rejected by peer"
      (let* ((server-dir (fresh-dir))
             (peer-dir (fresh-dir))
             (server (open-node server-dir))
             (parent-header (block-header-field %coop-child))
             (solution (coin-table-solution
                         (block-header-hash parent-header)
                         3 coin-genesis-complexity))
             (score (coin-result-value
                      (coin-score-for-solution
                        (block-header-hash parent-header)
                        3 coin-genesis-complexity solution 0)))
             (coinbase (coin-mining-coinbase/coop
                         3 solution (list (car %coop-shares)) (list 1) '()
                         "replay" %elsewhere
                         (coin-carrier-script %coop-child) 0))
             (bad (block-from-coinbase parent-header 3
                                       coin-genesis-complexity
                                       score coinbase)))
        (assert-equal 1 (submit server %coop-parent))
        (assert-equal 1 (submit server %coop-child))
        (assert-equal 1
                      (node-ingest-headers
                        server (list (block-header-field bad))))
        (node-store-block server bad)
        (assert-peer-rejects server bad peer-dir 0 "share")
        (node-close server)))))

(test-group "sigilcoin Q-neutral header fork choice"
  (test "different authenticated Q claims keep the first-seen header"
    (let* ((dir-a (fresh-dir))
           (dir-b (fresh-dir))
           (a (open-node dir-a))
           (base (car (mine-blocks a 1 %elsewhere)))
           (parent (block-header-field base))
           (incumbent-q (coin-quality '(1 1 1 1 1 1 1 1)))
           (challenger-q (coin-quality '(4 4 4)))
           (incumbent
             (block-header
               version: coin-header-version
               previous-block: (block-header-hash parent)
               merkle-root: (make-bytevector 32 8)
               time: (coin-next-block-time
                       parent coin-regtest-min-block-spacing)
               bits: coin-genesis-bits
               nonce: (coin-score-pack 40 50 51 incumbent-q)))
           (challenger
             (block-header
               incumbent
               merkle-root: (make-bytevector 32 12)
               nonce: (coin-score-pack 40 50 51 challenger-q)))
           (incumbent-word (block-header-nonce incumbent))
           (challenger-word (block-header-nonce challenger)))
      (assert-equal 8 incumbent-q)
      (assert-equal 12 challenger-q)
      (assert-true (not (= incumbent-word challenger-word)))
      (assert-equal (coin-score-rank-word incumbent-word)
                    (coin-score-rank-word challenger-word))
      (assert-equal (coin-score-saving incumbent-word)
                    (coin-score-saving challenger-word))
      (assert-equal 0
                    (coin-score-compare incumbent-word challenger-word))

      ;; Give the node a validated parent before two bodyless sibling claims.
      (let* ((endpoint (open-endpoint))
             (port (car endpoint))
             (listener (cdr endpoint)))
        (sync-peer-ok a listener port dir-b 1)
        (socket-close listener))
      (assert-equal 1 (node-ingest-headers a (list incumbent)))
      (assert-equal (hex-encode (block-header-hash incumbent))
                    (node-status-snapshot-best-hash (node-status a)))
      (assert-equal 1 (node-ingest-headers a (list challenger)))
      (assert-equal (hex-encode (block-header-hash incumbent))
                    (node-status-snapshot-best-hash (node-status a)))

      ;; Header-only propagation exercises persisted rank without inventing
      ;; cooperative bodies for these synthetic Q values.
      (let* ((endpoint (open-endpoint))
             (port (car endpoint))
             (listener (cdr endpoint)))
        (header-sync-peer-ok a listener port dir-b)
        (socket-close listener))
      (node-close a)
      (let ((b (open-node dir-b)))
        (assert-equal (hex-encode (block-header-hash incumbent))
                      (node-status-snapshot-best-hash (node-status b)))
        (assert-equal 1 (best-block-height b))
        (assert-true (tip-is? b base))
        (node-close b)))))

;; ============================================================
;; Spending across nodes
;; ============================================================
;;
;; A SigilCoin coinbase matures after one block: H1 cannot be spent at age
;; zero, and its reward is eligible in H2. The full retarget-window sync is
;; exercised independently above.

(when %native-secp256k1?
  (test-group "sigilcoin wallet spend across nodes"
    (test "wallet transaction spends the H1 reward in an H2 co-op block"
      (let* ((dir-a (fresh-dir))
             (dir-b (fresh-dir))
             (wallet-script (address->script %peer-address))
             (recipient-script (address->script %recipient-address)))
        (plant-wallet-key dir-a)
        (assert-address-matches-key)
        (let* ((a (open-node dir-a))
               (blocks (mine-blocks a 1 wallet-script)))
          (assert-equal 1 (height-of a))
          (let* ((funding (car (block-transactions (car blocks))))
                 (funding-value (solo-coinbase-value 1))
                 (secret (make-bytevector 32 1))
                 (amount 25000000)
                 (fee 1000)
                 (unsigned
                   (transaction
                     version: 2
                     inputs: (list
                               (txin previous-output:
                                       (outpoint txid: (transaction-txid funding)
                                                 index: 0)
                                     script-sig: #u8()
                                     sequence: #xffffffff
                                     witness: '()))
                     outputs: (list
                                (txout value: amount
                                       script-pubkey: recipient-script)
                                (txout value: (- funding-value amount fee)
                                       script-pubkey: wallet-script))
                     lock-time: 0))
                 ;; Same P2WPKH signer used by SigilCoin's one-key wallet.
                 (transfer (transaction-sign-p2wpkh-input
                             unsigned 0 funding-value secret))
                 (history (validated-headers a))
                 (complexity (coin-required-complexity history 2))
                 (parent (car blocks))
                 ;; Empty share set still exercises canonical co-op builder
                 ;; path and transaction/fee accounting.
                 (payment (coin-build-coop-block
                            parent 2 complexity #f '() "wallet payment"
                            wallet-script
                            (coin-next-block-time
                              (block-header-field parent)
                              coin-regtest-min-block-spacing)
                            (list transfer) fee)))
            (assert-equal "available"
                          (node-mempool-entry-status
                            (node-store-transaction a transfer "wallet")))
            (assert-true (pair? (txin-witness
                                  (car (transaction-inputs transfer)))))
            (assert-equal 1 (submit a payment))
            (assert-equal 2 (length (block-transactions payment)))
            (let* ((endpoint (open-endpoint))
                   (port (car endpoint))
                   (listener (cdr endpoint))
                   (lines (sync-peer-ok a listener port dir-b 2)))
              (assert-equal "2" (peer-field lines "best-block-height"))
              (assert-equal "2" (peer-field lines "validated-blocks"))
              (socket-close listener))
            (node-close a)
            (let* ((b (open-node dir-b))
                   (paid (utxos-paying b recipient-script)))
              (assert-true (tip-is? b payment))
              (assert-equal 1 (length paid))
              (assert-equal 25000000 (row-value (car paid) "value"))
              (assert-equal 0 (row-value (car paid) "coinbase"))
              (assert-equal 2 (row-value (car paid) "height"))
              (let* ((block-row (car (sqlite-query
                                       (node-db b)
                                       "SELECT block_hex FROM blocks WHERE height = 2 AND validated = 1")))
                     (received (block-parse
                                 (hex-decode
                                   (row-value block-row "block_hex")))))
                (assert-equal (transaction-txid transfer)
                              (transaction-txid
                                (list-ref (block-transactions received) 1))))
              ;; Spent H1 leaves; recipient, change, and H2 coinbase enter.
              ;; The fee returns through the H2 coinbase without changing
              ;; issued supply.
              (assert-equal 3 (length (active-utxos b)))
              (assert-equal (solo-issued-supply 2) (utxo-total b))
              (assert-equal "" (last-error b))
              (node-close b))))
        (remove-tree dir-a)
        (remove-tree dir-b)))))

;; Keep the same H1-to-H2 boundary covered when the generic test runtime lacks
;; secp256k1; the bundled operator path above upgrades it to a signed transfer.
(when (not %native-secp256k1?)
  (test-group "sigilcoin spend across nodes"
    (test "the H1 reward spent in H2 reaches the peer's UTXO set"
      (let* ((dir-a (fresh-dir))
             (dir-b (fresh-dir))
             (a (open-node dir-a))
             (blocks (mine-blocks a 1 %anyone))
             (funding (car (block-transactions (car blocks))))
             (to-script (address->script %peer-address))
             (parent (node-best-header a))
             (transfer
               (transaction
                 version: 2
                 inputs: (list
                           (txin previous-output:
                                   (outpoint txid: (transaction-txid funding)
                                             index: 0)
                                 script-sig: #u8()
                                 sequence: #xffffffff
                                 witness: '()))
                 outputs: (list
                            (txout value: (solo-coinbase-value 1)
                                   script-pubkey: to-script))
                 lock-time: 0))
             (history (validated-headers a))
             (complexity (coin-required-complexity history 2))
             (payment (coin-build-block
                        parent 2 complexity #f "payment" %anyone
                        (coin-next-block-time
                          parent coin-regtest-min-block-spacing)
                        (list transfer) 0)))
        (assert-equal 1 (height-of a))
        (assert-equal 1 (submit a payment))
        (assert-equal 2 (length (block-transactions payment)))
        (let* ((endpoint (open-endpoint))
               (port (car endpoint))
               (listener (cdr endpoint))
               (lines (sync-peer-ok a listener port dir-b 2)))
          (assert-equal "2" (peer-field lines "best-block-height"))
          (assert-equal "2" (peer-field lines "validated-blocks"))
          (socket-close listener))
        (node-close a)
        (let* ((b (open-node dir-b))
               (paid (utxos-paying b to-script)))
          (assert-true (tip-is? b payment))
          (assert-equal 1 (length paid))
          (assert-equal (solo-coinbase-value 1)
                        (row-value (car paid) "value"))
          (assert-equal 2 (row-value (car paid) "height"))
          (assert-equal 2 (length (active-utxos b)))
          (assert-equal (solo-issued-supply 2) (utxo-total b))
          (node-close b))
        (remove-tree dir-a)
        (remove-tree dir-b)))))

;; ============================================================
;; Maturity-one reorg recovery
;; ============================================================

(test-group "sigilcoin maturity-one reorg recovery"
  (test "orphaning H1 and its H2 spend rejects the restored transaction"
    (let* ((active-dir (fresh-dir))
           (fork-dir (fresh-dir))
           (n (open-node active-dir))
           (original-h1 (car (mine-blocks n 1 %anyone)))
           (funding (car (block-transactions original-h1)))
           (funding-value (solo-coinbase-value 1))
           (transfer
             (transaction
               version: 2
               inputs: (list
                         (txin
                           previous-output:
                             (outpoint txid: (transaction-txid funding)
                                       index: 0)
                           script-sig: #u8()
                           sequence: #xffffffff
                           witness: '()))
               outputs: (list
                          (txout value: funding-value
                                 script-pubkey: %anyone))
               lock-time: 0))
           (history (validated-headers n))
           (original-h2
             (coin-build-block
               (block-header-field original-h1)
               2
               (coin-required-complexity history 2)
               #f
               "maturity-one spend"
               %anyone
               (coin-next-block-time
                 (block-header-field original-h1)
                 coin-regtest-min-block-spacing)
               (list transfer)
               0)))
      (assert-equal 1
                    (block-rules-coinbase-maturity
                      (chain-config-block-rules (node-config n))))
      (assert-equal
        "available"
        (node-mempool-entry-status
          (node-store-transaction n transfer "wallet")))
      (assert-equal 1 (submit n original-h2))
      (let* ((fork-node (open-node fork-dir))
             (fork (mine-blocks fork-node 3 %elsewhere)))
        (node-close fork-node)
        (assert-equal
          3
          (node-ingest-headers
            n (map block-header-field fork)))
        (for-each (lambda (b) (node-store-block n b)) fork)
        (assert-equal 3 (node-validate-blocks n))
        (assert-true (tip-is? n (list-ref fork 2)))
        (assert-equal 0 (length (utxos-paying n %anyone)))
        (let ((row
                (car
                  (sqlite-query
                    (node-db n)
                    "SELECT status, last_error FROM mempool WHERE txid = ?"
                    (hex-encode (transaction-txid transfer))))))
          (assert-equal "rejected" (row-value row "status"))
          (assert-equal "missing-input" (row-value row "last_error")))
        (assert-equal (solo-issued-supply 3) (utxo-total n)))
      (node-close n)
      (remove-tree active-dir)
      (remove-tree fork-dir))))

;; ============================================================
;; Reorganising onto a shorter solution
;; ============================================================

(test-group "sigilcoin reorganisation between nodes"
  (test "a shorter solution takes the tip on both nodes, and a late one does not"
    ;; The competing sibling comes from an independent miner, matching a real
    ;; partition. Shared-node coverage additionally pins the locator rule: a
    ;; losing sibling known to the responder is not a common ancestor merely
    ;; because it has the same height as one on the selected chain.
    (let* ((dir-a (fresh-dir))
           (dir-b (fresh-dir))
           (dir-c (fresh-dir))
           (dir-d (fresh-dir))
           (a (open-node dir-a))
           (blocks (mine-blocks a 2 %elsewhere))
           (parent (block-header-field (list-ref blocks 1)))
           (complexity coin-genesis-complexity)
           (ladder (solution-ladder (block-header-hash parent) 3 complexity))
           (long (build-at parent 3 complexity (car ladder) "par" %elsewhere))
           (shorter (build-at parent 3 complexity (cadr ladder) "golfed" %elsewhere))
           (equal (build-at parent 3 complexity (cadr ladder) "equal" %elsewhere))
           (shortest (build-at parent 3 complexity (caddr ladder) "late" %elsewhere)))
      ;; Composite score orders better programs and leaves exact ties
      ;; incomparable, independent of block hash or graffiti.
      (assert-true (> (block-header-nonce (block-header-field long))
                      (block-header-nonce (block-header-field shorter))))
      (assert-equal (block-header-nonce (block-header-field shorter))
                    (block-header-nonce (block-header-field equal)))
      (assert-true (> (block-header-nonce (block-header-field shorter))
                      (block-header-nonce (block-header-field shortest))))
      (assert-equal 1 (submit a long))
      (assert-true (tip-is? a long))
      ;; The peer takes the longer solution from the node that mined it.
      (let* ((endpoint (open-endpoint))
             (port (car endpoint))
             (listener (cdr endpoint)))
        (sync-peer-ok a listener port dir-b 1)
        (socket-close listener))
      (node-close a)
      (let ((b (open-node dir-b)))
        (assert-equal 3 (best-block-height b))
        (assert-true (tip-is? b long))
        (node-close b))
      ;; The competing miner: the same first two blocks, and a shorter
      ;; solution at height 3.
      (let ((c (node-with-blocks dir-c blocks)))
        (assert-equal 1 (submit c shorter))
        (assert-true (tip-is? c shorter))
        (let* ((endpoint (open-endpoint))
               (port (car endpoint))
               (listener (cdr endpoint)))
          ;; The peer, sitting on the longer solution, reorganises onto the
          ;; shorter one over the wire.
          (let ((lines (sync-peer-ok c listener port dir-b 1)))
            (assert-equal "3" (peer-field lines "best-block-height"))
            (assert-equal (hex-encode (block-hash shorter))
                          (peer-field lines "best-block-hash")))
          (let ((b (open-node dir-b)))
            (assert-true (tip-is? b shorter))
            (assert-equal 3 (best-block-height b))
            ;; Both nodes agree on the tip, and it is a reorganisation
            ;; rather than a second chain: the displaced block's coinbase is
            ;; gone from the peer's own UTXO set.
            (assert-equal (best-block-hash c) (best-block-hash b))
            (assert-equal 3 (length (active-utxos b)))
            (assert-equal (list (hex-encode (block-hash (list-ref blocks 0)))
                                (hex-encode (block-hash (list-ref blocks 1)))
                                (hex-encode (block-hash shorter)))
                          (map (lambda (r) (row-value r "created_by"))
                               (active-utxos b)))
            (assert-equal (solo-issued-supply 3) (utxo-total b))
            (node-close b))
          ;; Equal-score sibling is first-seen: it cannot replace `shorter`
          ;; locally or over TCP, regardless of its different block hash.
          (let ((d (node-with-blocks dir-d blocks)))
            (assert-equal 1 (submit d equal))
            (assert-equal 0 (submit c equal))
            (let* ((endpoint-d (open-endpoint))
                   (port-d (car endpoint-d))
                   (listener-d (cdr endpoint-d)))
              (sync-peer-ok d listener-d port-d dir-b 1)
              (socket-close listener-d))
            (let ((b (open-node dir-b)))
              (assert-true (tip-is? b shorter))
              (node-close b))
            ;; Keep this node for the post-settlement better sibling.
            (assert-equal 1 (submit d shortest))
            (node-close d))
          ;; A child settles height 3 on both nodes.
          (let ((child (car (mine-blocks c 1 %elsewhere))))
            (assert-equal 4 (best-block-height c))
            (let ((lines (sync-peer-ok c listener port dir-b 1)))
              (assert-equal "4" (peer-field lines "best-block-height"))
              (assert-equal (hex-encode (block-hash child))
                            (peer-field lines "best-block-hash")))
            (socket-close listener)
            ;; The best solution of the three, arriving after the height was
            ;; settled. The node that has the child refuses it outright.
            (assert-equal 0 (submit c shortest))
            (assert-equal 4 (best-block-height c))
            (assert-true (tip-is? c child))
            (node-close c)
            ;; Peer refuses it over wire, offered by node whose tip is the
            ;; late better sibling.
            (let ((d (open-node dir-d)))
              (assert-true (tip-is? d shortest))
              (let* ((endpoint-d (open-endpoint))
                     (port-d (car endpoint-d))
                     (listener-d (cdr endpoint-d)))
                (let ((lines (sync-peer-ok d listener-d port-d dir-b 1)))
                  (assert-equal "4" (peer-field lines "best-block-height"))
                  (assert-equal (hex-encode (block-hash child))
                                (peer-field lines "best-block-hash")))
                (socket-close listener-d))
              (node-close d))
            (let ((b (open-node dir-b)))
              (assert-equal 4 (best-block-height b))
              (assert-true (tip-is? b child))
              (assert-equal 4 (validated-count b))
              (assert-equal 4 (length (active-utxos b)))
              (assert-equal (solo-issued-supply 4) (utxo-total b))
              (node-close b)))))
      (remove-tree dir-a)
      (remove-tree dir-b)
      (remove-tree dir-c)
      (remove-tree dir-d))))

;; ============================================================
;; Bodyless best-header liveness
;; ============================================================

(define (request-blocks-from-silent-peer n)
  (node-download-blocks n
                        (lambda () (error "silent peer"))
                        (lambda (envelope) #t)
                        0
                        8))

(test-group "sigilcoin bodyless header"
  (test "give-up releases best-header slot and late body restores reorg"
    (let* ((dir (fresh-dir))
           (n (open-node dir))
           (blocks (mine-blocks n 2 %elsewhere))
           (parent (block-header-field (list-ref blocks 1)))
           (complexity coin-genesis-complexity)
           (ladder (solution-ladder (block-header-hash parent) 3 complexity))
           (incumbent (build-at parent 3 complexity (car ladder)
                                "incumbent" %elsewhere))
           (late (build-at parent 3 complexity (caddr ladder)
                           "late-body" %elsewhere))
           (late-hash (hex-encode (block-hash late))))
      (assert-equal 1 (submit n incumbent))
      (assert-equal 1
                    (node-ingest-headers n (list (block-header-field late))))
      (assert-equal late-hash
                    (node-status-snapshot-best-hash (node-status n)))
      (request-blocks-from-silent-peer n)
      (assert-equal late-hash
                    (node-status-snapshot-best-hash (node-status n)))
      (let loop ((attempts 1))
        (cond ((not (string=? late-hash
                              (node-status-snapshot-best-hash
                                (node-status n))))
               (assert-true (> attempts 1)))
              ((> attempts 32)
               (error "bodyless header never released best-header slot"))
              (else
               (request-blocks-from-silent-peer n)
               (loop (+ attempts 1)))))
      (assert-true (tip-is? n incumbent))
      ;; Give-up deprioritises, never invalidates. Late body remains eligible
      ;; and performs same honest reorganisation it would have on time.
      (node-store-block n late)
      (assert-equal 1 (node-validate-blocks n))
      (assert-true (tip-is? n late))
      (assert-equal 3 (validated-count n))
      (node-close n))))

;; ============================================================
;; Rotating generated constraints
;; ============================================================

(define %generator-module (find-module '(sigil coin puzzle generator)))
(define %constraints-module (find-module '(sigil coin puzzle constraints)))
(define puzzle-constraint-for*
  (module-ref %generator-module 'puzzle-constraint-for))
(define puzzle-spec-hidden-source*
  (module-ref %generator-module 'puzzle-spec-hidden-source))
(define puzzle-spec-constraint*
  (module-ref %generator-module 'puzzle-spec-constraint))
(define puzzle-constraint-name*
  (module-ref %constraints-module 'puzzle-constraint-name))

(define (complexity-for-constraint ci)
  (let loop ((complexity (if (memv ci '(0 1 3 5)) 256 1024)))
    (cond ((> complexity coin-complexity-max)
           (error "test-network: no complexity draws requested constraint"))
          ((= ci (puzzle-constraint-for*
                   (coin-puzzle-seed
                     (block-header-hash %genesis-header) 1 complexity)
                   1 complexity))
           complexity)
          (else (loop (+ complexity 1))))))

(test-group "sigilcoin rotating constraints"
  (test "all eight constraints generate and representative bodies validate"
    (for-each
      (lambda (ci)
        (let* ((complexity (complexity-for-constraint ci))
               (spec (coin-puzzle-for
                       (block-header-hash %genesis-header) 1 complexity))
               (b (coin-build-block
                    %genesis-header 1 complexity
                    (puzzle-spec-hidden-source* spec)
                    (symbol->string (puzzle-constraint-name* ci))
                    %elsewhere (+ coin-regtest-genesis-time 1)))
               (score (coin-block-score %genesis-block 1 complexity b)))
          (assert-equal ci (puzzle-spec-constraint* spec))
          (assert-true (coin-ok? score))
          (assert-equal (block-header-nonce (block-header-field b))
                        (coin-result-value score))))
      '(0 1 2 3 4 5 6 7))))

;; ============================================================
;; An invalid block from a peer
;; ============================================================

(test-group "sigilcoin invalid block from a peer"
  (test "a block that lies about its solution is refused and does not stick"
    (let* ((dir-a (fresh-dir))
           (dir-b (fresh-dir))
           (dir-bad (fresh-dir))
           (a (open-node dir-a))
           (blocks (mine-blocks a 3 %elsewhere))
           (honest-tip (list-ref blocks 2))
           (parent (block-header-field honest-tip))
           (honest (build-at parent
                             4
                             coin-genesis-complexity
                             #f
                             "lie"
                             %elsewhere))
           (header (block-header-field honest))
           ;; The same block under the best claim a header can make: one
           ;; byte of solution, which outranks every honest sibling. The
           ;; coinbase says otherwise, so it is a claim the body cannot
           ;; back.
           (liar (block header-field:
                          (block-header version: (block-header-version header)
                                        previous-block:
                                          (block-header-previous-block header)
                                        merkle-root:
                                          (block-header-merkle-root header)
                                        time: (block-header-time header)
                                        bits: (block-header-bits header)
                                        nonce: (coin-score-pack 1 0 0 15))
                        transactions: (block-transactions honest))))
      (assert-true (> (coin-score-length
                        (coin-score-decode
                          (block-header-nonce (block-header-field honest))))
                      (coin-score-length
                        (coin-score-decode
                          (block-header-nonce (block-header-field liar))))))
      ;; The peer starts on the honest chain.
      (let* ((endpoint (open-endpoint))
             (port (car endpoint))
             (listener (cdr endpoint)))
        (sync-peer-ok a listener port dir-b 1)
        (socket-close listener))
      (node-close a)
      ;; The dishonest node holds the same honest chain and one block more.
      ;; It never validates that block itself — the header is legal on its
      ;; own, which is all it takes to offer it, and checking the body is
      ;; the receiving node's job.
      (let ((bad (node-with-blocks dir-bad blocks)))
        (assert-equal 1 (node-ingest-headers bad
                                             (list (block-header-field liar))))
        (node-store-block bad liar)
        (assert-true (tip-is? bad honest-tip))
        (let* ((endpoint (open-endpoint))
               (port (car endpoint))
               (listener (cdr endpoint))
               (result (sync-peer bad listener port dir-b 1)))
          ;; The peer does not call that pass a success, and does not move:
          ;; the block came down and it still has three.
          (assert-true (not (= 0 (car result))))
          (assert-equal "3" (peer-field (cdr result) "best-block-height"))
          (assert-equal "3" (peer-field (cdr result) "validated-blocks"))
          (socket-close listener))
        (node-close bad))
      ;; The honest chain the peer already had is untouched: same tip, same
      ;; count, same coins.
      (let ((b (open-node dir-b)))
        (assert-equal 3 (best-block-height b))
        (assert-true (tip-is? b honest-tip))
        (assert-equal 3 (validated-count b))
        (assert-equal 3 (length (active-utxos b)))
        (assert-equal (solo-issued-supply 3) (utxo-total b))
        ;; And the peer's own record of the refusal names the rule that
        ;; fired, on the block it downloaded and then threw away.
        (let ((row (car (sqlite-query
                          (node-db b)
                          "SELECT status, validated, last_error FROM blocks WHERE hash = ?"
                          (hex-encode (block-hash liar))))))
          (assert-equal "invalid" (row-value row "status"))
          (assert-equal 0 (row-value row "validated"))
          (assert-true (string-contains? (row-value row "last_error")
                                         "score-mismatch")))
        ;; The lie is permanent: the header is marked invalid, so the branch
        ;; cannot be retried into the peer.
        (assert-equal 0
                      (row-value (car (sqlite-query
                                        (node-db b)
                                        "SELECT valid FROM headers WHERE hash = ?"
                                        (hex-encode (block-hash liar))))
                                 "valid"))
        (node-close b))
      ;; Not poisoned for later either: the next honest block still lands.
      (let* ((a (open-node dir-a))
             (next (car (mine-blocks a 1 %elsewhere)))
             (endpoint (open-endpoint))
             (port (car endpoint))
             (listener (cdr endpoint)))
        (let ((lines (sync-peer-ok a listener port dir-b 1)))
          (assert-equal "4" (peer-field lines "best-block-height"))
          (assert-equal (hex-encode (block-hash next))
                        (peer-field lines "best-block-hash")))
        (socket-close listener)
        (node-close a))
      (let ((b (open-node dir-b)))
        (assert-equal 4 (best-block-height b))
        (assert-equal 4 (validated-count b))
        (node-close b))
      (remove-tree dir-a)
      (remove-tree dir-b)
      (remove-tree dir-bad))))

(dynamic-wind
  (lambda () #t)
  (lambda () (run-tests))
  cleanup)
