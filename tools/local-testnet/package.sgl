;;; Fixtures for the four-role local regtest pool drill.

(package
  name: "sigil-coin-local-testnet"
  version: "0.1.0"
  sigil: "0.20"
  entry: '(sigil coin local-testnet)
  bundle-name: "sigil-coin-local-testnet"

  configs: (list
    (config name: 'dev output-dir: "build/dev" bundle?: #t))

  dependencies: (list
    (from-git url: "codeberg:sigil/sigil-crypto" version: "^0.16.1")
    (from-git url: "codeberg:sigil/sigil-json" version: "^0.16.0")
    (from-git url: "codeberg:sigil/sigil-http" version: "^0.18.5")
    (from-path dir: "../.." package: "sigil-coin-cli")
    (from-path dir: "../.." package: "sigil-coin-explorer")
    (from-path dir: "../.." package: "sigil-coin-node")
    (from-path dir: "../.." package: "sigil-coin-consensus")
    (from-path dir: "../.." package: "sigil-coin-puzzle")
    (from-path dir: "../../../sigil-bitcoin" package: "sigil-bitcoin-utils")
    (from-path dir: "../../../sigil-bitcoin" package: "sigil-bitcoin-encoding")
    (from-path dir: "../../../sigil-bitcoin" package: "sigil-bitcoin-primitives")
    (from-path dir: "../../../sigil-bitcoin" package: "sigil-bitcoin-tx")
    (from-path dir: "../../../sigil-bitcoin" package: "sigil-bitcoin-consensus")
    (from-path dir: "../../../sigil-bitcoin" package: "sigil-bitcoin-p2p")
    (from-path dir: "../../../sigil-bitcoin" package: "sigil-bitcoin-node")
    (from-git url: "codeberg:sigil/sigil-sqlite" version: "^0.16.0"))

  tasks: (list
    (task
      name: 'build
      steps: (list
        (compile-sigil-modules sources: "src/**/*.sgl")))))
