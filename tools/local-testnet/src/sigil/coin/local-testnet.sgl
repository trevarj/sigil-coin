;;; (sigil coin local-testnet) — test-solution fixture for the local drill

(define-library (sigil coin local-testnet)
  (import (sigil io)
          (sigil process)
          (sigil string)
          (sigil bitcoin node)
          (sigil coin puzzle generator)
          (sigil coin consensus)
          (only (sigil coin consensus shares)
                coin-check-share-solution/spec)
          (sigil coin node)
          (sigil coin cli mine)
          (sigil coin cli wallet))
  (export main)

  (begin
    (define (application-args raw)
      (let loop ((xs raw))
        (cond ((null? xs) raw)
              ((string=? (car xs) "--") (cdr xs))
              (else (loop (cdr xs))))))

    (define (field alist key)
      (cdr (assq key alist)))

    (define %generated-anchor-predicate "(equal? x\"@\")")
    (define %semantic-anchor-predicate "(string? x)")

    ;; The final personalized pair is the reserved string anchor. Broadening
    ;; its predicate is safe only when every ordinary input is non-string.
    (define (ordinary-inputs-non-string? spec)
      (let loop ((pairs (puzzle-spec-examples spec)))
        (cond
          ((null? pairs) #f)
          ((null? (cdr pairs))
           (let ((anchor (car pairs)))
             (and (string? (car anchor))
                  (string=? puzzle-anchor-input (car anchor))
                  (puzzle-anchor-output? (cdr anchor)))))
          ((string? (car (car pairs))) #f)
          (else (loop (cdr pairs))))))

    (define (semantic-share-source spec)
      (let ((source (puzzle-spec-hidden-source spec)))
        (and (ordinary-inputs-non-string? spec)
             (= 1 (string-count source %generated-anchor-predicate))
             (let* ((candidate
                      (string-replace source %generated-anchor-predicate
                                      %semantic-anchor-predicate))
                    (checked
                      (coin-check-share-solution/spec spec candidate)))
               (and (< (string-length candidate) (puzzle-spec-par spec))
                    (coin-ok? checked)
                    candidate)))))

    ;; This fixture only supplies a test solution because the CLI has no
    ;; solver. Commit aggregation, reveal aggregation, mining and submission
    ;; remain canonical CLI operations.
    (define (solve-share data-dir)
      (let* ((key (wallet-key data-dir))
             (pubkey (wallet-public-key key))
             (n (node-open sigilcoin-regtest-chain data-dir))
             (context (coin-puzzle-context
                        n (list "--regtest" "--data-dir" data-dir)))
             (coop (coin-coop-context
                     parent-prev-hash: (field context 'parent-hash)
                     puzzle-height: (field context 'height)
                     complexity: (field context 'complexity)
                     spec: (field context 'spec)
                     commits: '()))
             (spec (coin-share-puzzle coop pubkey))
             (solution (semantic-share-source spec)))
        (node-close n)
        (when (not solution)
          (error (string-append
                   "local-testnet: personalized task has no verified "
                   "non-string semantic share candidate; hidden="
                   (puzzle-spec-hidden-source spec)
                   " par=" (number->string (puzzle-spec-par spec)))))
        (println "~a" solution)))

    (define (main)
      (let ((args (application-args (cdr (command-line)))))
        (if (and (= 2 (length args))
                 (string=? (car args) "solve-share"))
            (solve-share (cadr args))
            (error "usage: sigil-coin-local-testnet solve-share DATA_DIR"))))))
