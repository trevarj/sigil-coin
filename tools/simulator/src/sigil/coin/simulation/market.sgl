;;; (sigil coin simulation market) — deterministic actor and fee model
;;;
;;; This is a bounded, bodyless policy experiment, not production execution,
;;; equilibrium, or a network simulator. Declared synthetic par and producer
;;; lengths determine golf scores; identities, exact-slot timestamps, and
;;; arrivals are modeled separately. Child observations do not make a branch
;;; irreversible, and accounting follows the selected modeled blocks.

(define-library (sigil coin simulation market)
  (import (sigil math)
          (sigil list)
          (sigil string)
          (sigil json)
          (sigil coin consensus)
          (sigil coin simulation fork))
  (export coin-run-market-simulation)

  (begin

    (define %height-count 12)
    (define %sentinel-height 13)
    (define %start-clock 1800000000)
    (define %slot-spacing 3600)
    (define %max-future-drift 0)
    (define %modeled-block-overhead 1400)
    (define %transaction-byte-cap
      (- coin-max-block-bytes %modeled-block-overhead))
    (define %synthetic-par 256)
    (define %ordinary-producer-length 256)
    (define %strong-producer-length 248)

    (define %producer-actors
      '("fair-eager" "fair-fee-waiting" "strong-golfer"
        "future-dater" "urgent-censor"))
    (define %user-actors
      '("steady" "urgent-high-fee" "bursty" "low-zero-fee-spam"))

    (define (need condition message)
      (if (not condition)
          (error (string-append "market simulation: " message))))

    (define (sum values)
      (let loop ((xs values) (total 0))
        (if (null? xs) total (loop (cdr xs) (+ total (car xs))))))

    (define (count-if pred values)
      (let loop ((xs values) (count 0))
        (if (null? xs)
            count
            (loop (cdr xs) (if (pred (car xs)) (+ count 1) count)))))

    (define (maximum-or-zero values)
      (if (null? values) 0 (car (reverse (list-sort < values)))))

    (define (mean-or-zero values)
      (if (null? values) 0 (quotient (sum values) (length values))))

    (define (ref record key)
      (cdr (assq key record)))

    (define (last-of values)
      (if (null? (cdr values))
          (car values)
          (last-of (cdr values))))

    ;; Transactions are deterministic byte/fee envelopes. Selection mirrors
    ;; arrival-order first-fit; no fee priority or wire-size claim is added.
    (define (transaction-envelope id actor arrival bytes fee)
      `((id . ,id)
        (actor . ,actor)
        (arrival . ,arrival)
        (bytes . ,bytes)
        (fee . ,fee)))

    (define (tx-id tx) (ref tx 'id))
    (define (tx-actor tx) (ref tx 'actor))
    (define (tx-arrival tx) (ref tx 'arrival))
    (define (tx-bytes tx) (ref tx 'bytes))
    (define (tx-fee tx) (ref tx 'fee))

    (define (round-transactions height round-start)
      (let ((steady
              (list (transaction-envelope
                      (format "steady-~a" height)
                      "steady"
                      (+ round-start 500)
                      800
                      800)))
            (urgent
              (list (transaction-envelope
                      (format "urgent-~a" height)
                      "urgent-high-fee"
                      (+ round-start 3000 (* 100 (modulo height 3)))
                      700
                      6000)))
            (bursty
              (if (= 0 (modulo height 3))
                  (let loop ((offsets '(900 1800 2700 3400))
                             (index 1)
                             (out '()))
                    (if (null? offsets)
                        (reverse out)
                        (loop (cdr offsets)
                              (+ index 1)
                              (cons (transaction-envelope
                                      (format "burst-~a-~a" height index)
                                      "bursty"
                                      (+ round-start (car offsets))
                                      1500
                                      1200)
                                    out))))
                  '()))
            (spam
              (let loop ((offsets '(100 700 1300)) (index 1) (out '()))
                (if (null? offsets)
                    (reverse out)
                    (loop (cdr offsets)
                          (+ index 1)
                          (cons (transaction-envelope
                                  (format "spam-~a-~a" height index)
                                  "low-zero-fee-spam"
                                  (+ round-start (car offsets))
                                  3600
                                  (if (= 0 (modulo (+ height index) 2)) 0 50))
                                out))))))
        (append steady urgent bursty spam)))

    (define (tx-before? a b)
      (or (< (tx-arrival a) (tx-arrival b))
          (and (= (tx-arrival a) (tx-arrival b))
               (string<? (tx-id a) (tx-id b)))))

    (define (sort-transactions transactions)
      (list-sort tx-before? transactions))

    ;; Return `(arrived future)` at one candidate's deterministic clock.
    (define (split-arrived transactions clock)
      (let loop ((xs transactions) (arrived '()) (future '()))
        (if (null? xs)
            (list (reverse arrived) (reverse future))
            (if (<= (tx-arrival (car xs)) clock)
                (loop (cdr xs) (cons (car xs) arrived) future)
                (loop (cdr xs) arrived (cons (car xs) future))))))

    ;; Return `(selected carryover censored)`. Only the urgent-censor actor
    ;; omits urgent transactions; the future-dater has ordinary policy.
    (define (select-transactions transactions producer)
      (let loop ((xs transactions) (used 0)
                 (selected '()) (carryover '()) (censored '()))
        (if (null? xs)
            (list (reverse selected) (reverse carryover) (reverse censored))
            (let* ((tx (car xs))
                   (censor?
                     (and (string=? producer "urgent-censor")
                          (string=? (tx-actor tx) "urgent-high-fee"))))
              (cond
                (censor?
                 (loop (cdr xs) used selected (cons tx carryover)
                       (cons tx censored)))
                ((<= (+ used (tx-bytes tx)) %transaction-byte-cap)
                 (loop (cdr xs) (+ used (tx-bytes tx))
                       (cons tx selected) carryover censored))
                (else
                  (loop (cdr xs) used selected (cons tx carryover)
                        censored)))))))


    (define (fee-wait-delay height)
      (if (= 0 (modulo height 4)) 750 500))

    (define (strong-delay height)
      (cond ((= 1 (modulo height 4)) 200)
            ((= 2 (modulo height 4)) 800)
            ((= 3 (modulo height 4)) 450)
            (else 900)))

    (define (adversary-delay height)
      (cond ((= 1 (modulo height 3)) 350)
            ((= 2 (modulo height 3)) 700)
            (else 500)))

    (define (candidate-id height actor)
      (format "height-~a/~a" height actor))

    ;; These fixed model inputs are not measurements of any source program.
    (define (producer-length actor)
      (if (string=? actor "strong-golfer")
          %strong-producer-length
          %ordinary-producer-length))

    (define (producer-savings actor)
      (coin-golf-savings %synthetic-par (producer-length actor)))

    (define (producer-score actor)
      (coin-golf-score %synthetic-par (producer-length actor)))

    (define (legal-candidate parent-id parent-score height timestamp actor delay)
      (let ((arrival (+ timestamp delay)))
        (need (= timestamp (+ %start-clock (* height %slot-spacing)))
              "candidate timestamp was not its exact slot")
        (need (<= timestamp (+ arrival %max-future-drift))
              "a modeled legal candidate failed pacing")
        (coin-fork-candidate
          actor height arrival (candidate-id height actor) parent-id
          (+ parent-score (producer-score actor)))))

    (define (round-candidates parent-id parent-score height timestamp)
      (list
        (legal-candidate parent-id parent-score height timestamp "fair-eager" 0)
        (legal-candidate parent-id parent-score height timestamp
                         "fair-fee-waiting" (fee-wait-delay height))
        (legal-candidate parent-id parent-score height timestamp
                         "strong-golfer" (strong-delay height))
        (legal-candidate parent-id parent-score height timestamp
                         "future-dater" (adversary-delay height))
        (legal-candidate parent-id parent-score height timestamp
                         "urgent-censor" (adversary-delay height))))


    (define (candidate-clock candidate)
      (coin-fork-candidate-arrival candidate))

    (define (candidate-actor candidate)
      (coin-fork-candidate-actor candidate))

    (define (candidate-before? candidate clock)
      (< (candidate-clock candidate) clock))

    (define (candidate-outcomes height trace)
      (map
        (lambda (entry)
          ;; These comparisons describe quality only, never fork selection.
          (list (list-ref entry 1)
                (cond
                  ((eq? (list-ref entry 4) 'incumbent) 'incumbent)
                  ((= (list-ref entry 7) (list-ref entry 8)) 'score-tie)
                  ((< (list-ref entry 7) (list-ref entry 8)) 'lower-score)
                  (else 'higher-score))
                height))
        (filter (lambda (entry) (eq? 'sibling (list-ref entry 3))) trace)))

    (define (outcome-count observations outcome)
      (count-if (lambda (entry) (eq? outcome (cadr entry))) observations))

    ;; Market row indexes are explicit because summaries consume generated rows.
    (define %row-winner 1)
    (define %row-savings 10)
    (define %row-block-score 11)
    (define %row-chain-score 12)
    (define %row-future-rejections 14)
    (define %row-higher-score 15)
    (define %row-score-ties 16)
    (define %row-lower-score 17)
    (define %row-child-observed 18)
    (define %row-tip-score 25)
    (define %row-after-child 26)
    (define %row-utilization 30)
    (define %row-fees 31)
    (define %row-subsidy 32)
    (define %row-producer 33)
    (define %row-total-coinbase 34)
    (define %row-minted-subsidy 35)
    (define %row-unminted 36)
    (define %row-censorship 37)

    (define %market-header
      '(height winner round_start_clock candidate_timestamp publish_clock
        publish_offset selection_rule parent_chain_score synthetic_par_bytes
        producer_length_bytes golf_savings block_score chain_score
        sibling_observations_before_child future_drift_rejections
        higher_score_replacements score_tie_observations lower_score_observations
        child_observed observed_child_actor observed_child_height
        observed_child_arrival_clock observed_child_chain_score
        selected_tip_actor selected_tip_height selected_tip_chain_score
        sibling_observations_after_child mempool_before transactions_included
        transaction_bytes block_utilization_permille fees scheduled_subsidy
        producer_payout total_coinbase minted_subsidy unminted_subsidy
        censorship_observations winner_censorship_observations
        latency_mean_seconds latency_max_seconds mempool_after pending_arrivals))

    ;; Rows account for selected root blocks. Immediate children are bounded
    ;; lookahead observations, not a prerequisite for rewards or finality.
    (define %run
      (let ((genesis-id "height-0/genesis"))
        (let loop ((height 1)
                   (parent-id genesis-id)
                   (parent-score 0)
                   (parent-time %start-clock)
                   (round-start %start-clock)
                   (mempool '())
                   (pending '())
                   (all-transactions '())
                   (confirmed '())
                   (rows '())
                   (candidate-observations '())
                   (censorship-observations '())
                   (child-observations '()))
          (if (> height %height-count)
              (list
                (reverse rows)
                all-transactions
                confirmed
                mempool
                pending
                candidate-observations
                censorship-observations
                child-observations)
              (let* ((timestamp (+ parent-time %slot-spacing))
                     ;; The future-dater publishes its exact-slot timestamp
                     ;; too early, then submits an ordinary legal candidate.
                     (future-rejected?
                       (> timestamp
                          (+ round-start 60 %max-future-drift)))
                     (candidates
                       (round-candidates
                         parent-id parent-score height timestamp))
                     ;; A child of the branch selected before the next slot is
                     ;; observed there. Height 13 is a lookahead-only sentinel.
                     (child-clock (+ timestamp %slot-spacing))
                     (before-child
                       (filter
                         (lambda (candidate)
                           (candidate-before? candidate child-clock))
                         candidates))
                     (pre-fork (coin-run-fork-observer before-child))
                     (child-parent (ref pre-fork 'selected))
                     (child-actor
                       (if (= height %height-count)
                           "sentinel-child"
                           "fair-eager"))
                     (child
                       (legal-candidate
                         (coin-fork-candidate-id child-parent)
                         (coin-fork-candidate-chain-score child-parent)
                         (+ height 1) child-clock child-actor 0))
                     (fork
                       (coin-run-fork-observer
                         (append candidates (list child))))
                     (winner (ref fork 'selected))
                     (tip (ref fork 'tip))
                     (observations
                       (candidate-outcomes height (ref fork 'trace)))
                     (publish-clock (candidate-clock winner))
                     (savings (producer-savings (candidate-actor winner)))
                     (block-score (producer-score (candidate-actor winner)))
                     (chain-score (coin-fork-candidate-chain-score winner))
                     (new-transactions
                       (round-transactions height round-start))
                     (all-pending
                       (sort-transactions (append pending new-transactions)))
                     (winner-split (split-arrived all-pending publish-clock))
                     (available
                       (sort-transactions (append mempool (car winner-split))))
                     (future (cadr winner-split))
                     (selection
                       (select-transactions available (candidate-actor winner)))
                     (selected-transactions (list-ref selection 0))
                     (carryover (list-ref selection 1))
                     (winner-censored (list-ref selection 2))
                     ;; Observe the censor's policy even though equal-height
                     ;; later candidates cannot displace the incumbent.
                     (censor-candidate
                       (car (filter
                              (lambda (candidate)
                                (string=? "urgent-censor"
                                          (candidate-actor candidate)))
                              candidates)))
                     (censor-split
                       (split-arrived all-pending
                                      (candidate-clock censor-candidate)))
                     (censor-available
                       (sort-transactions
                         (append mempool (car censor-split))))
                     (censor-selection
                       (select-transactions censor-available "urgent-censor"))
                     (censored (list-ref censor-selection 2))
                     (transaction-bytes
                       (sum (map tx-bytes selected-transactions)))
                     (fees (sum (map tx-fee selected-transactions)))
                     (subsidy (coin-block-reward height))
                     (payout-plan
                       (coin-payout-plan subsidy fees '() '() #f))
                     (producer-payout (car (car payout-plan)))
                     (total-coinbase producer-payout)
                     (minted-subsidy (- total-coinbase fees))
                     (unminted-subsidy (- subsidy minted-subsidy))
                     (latencies
                       (map (lambda (tx)
                              (- publish-clock (tx-arrival tx)))
                            selected-transactions))
                     (row
                       (list
                         height
                         (candidate-actor winner)
                         round-start
                         timestamp
                         publish-clock
                         (- publish-clock round-start)
                         "strictly-taller-height"
                         parent-score
                         %synthetic-par
                         (producer-length (candidate-actor winner))
                         savings
                         block-score
                         chain-score
                         (length before-child)
                         (if future-rejected? 1 0)
                         0 ; score-caused replacements are impossible
                         (outcome-count observations 'score-tie)
                         (outcome-count observations 'lower-score)
                         (ref fork 'child-observed?)
                         child-actor
                         (+ height 1)
                         child-clock
                         (coin-fork-candidate-chain-score child)
                         (candidate-actor tip)
                         (coin-fork-candidate-height tip)
                         (coin-fork-candidate-chain-score tip)
                         (- (length candidates) (length before-child))
                         (length available)
                         (length selected-transactions)
                         transaction-bytes
                         (quotient
                           (* (+ %modeled-block-overhead transaction-bytes) 1000)
                           coin-max-block-bytes)
                         fees
                         subsidy
                         producer-payout
                         total-coinbase
                         minted-subsidy
                         unminted-subsidy
                         (length censored)
                         (length winner-censored)
                         (mean-or-zero latencies)
                         (maximum-or-zero latencies)
                         (length carryover)
                         (length future))))
                (need future-rejected?
                      "future-dater attempt was not rejected")
                (need (= chain-score (+ parent-score block-score))
                      "selected block did not add its golf score linearly")
                (need (= block-score (+ 1 savings))
                      "selected block score disagreed with golf savings")
                (need (and (>= savings 0) (<= savings coin-golf-max-savings))
                      "selected block savings exceeded the consensus cap")
                (need (>= (coin-fork-candidate-chain-score tip) chain-score)
                      "selected tip scored below its root")
                (for-each
                  (lambda (candidate)
                    (need (>= (coin-fork-candidate-height tip)
                              (coin-fork-candidate-height candidate))
                          "observer missed a taller candidate"))
                  (append candidates (list child)))
                (need (equal? (coin-fork-candidate-id winner)
                              (coin-fork-candidate-id child-parent))
                      "equal-height sibling displaced the incumbent")
                (need (equal?
                        (coin-fork-candidate-parent-id child)
                        (coin-fork-candidate-id child-parent))
                      "market child did not name its observed parent")
                (need (<= (+ %modeled-block-overhead transaction-bytes)
                          coin-max-block-bytes)
                      "modeled block exceeded canonical byte cap")
                (need (= producer-payout
                         (+ (quotient (* 4 subsidy) 5) fees))
                      "solo market payout did not use production plan")
                (need (= subsidy (+ minted-subsidy unminted-subsidy))
                      "selected block subsidy accounting was not conserved")
                (for-each
                  (lambda (latency)
                    (need (>= latency 0) "negative confirmation latency"))
                  latencies)
                (loop
                  (+ height 1)
                  (coin-fork-candidate-id winner)
                  chain-score
                  timestamp
                  publish-clock
                  carryover
                  future
                  (append all-transactions new-transactions)
                  (append confirmed
                          (map (lambda (tx) (cons tx publish-clock))
                               selected-transactions))
                  (cons row rows)
                  (append candidate-observations observations)
                  (append censorship-observations censored)
                  (append child-observations
                          (list (list height (+ height 1) child-clock
                                      child-actor)))))))))

    (define %market-rows (list-ref %run 0))
    (define %all-transactions (list-ref %run 1))
    (define %confirmed (list-ref %run 2))
    (define %final-mempool (list-ref %run 3))
    (define %pending (list-ref %run 4))
    (define %candidate-observations (list-ref %run 5))
    (define %censorship-observations (list-ref %run 6))
    (define %child-observations (list-ref %run 7))
    (define %outstanding (append %final-mempool %pending))

    (define (confirmed-actor entry) (tx-actor (car entry)))
    (define (confirmation-latency entry)
      (- (cdr entry) (tx-arrival (car entry))))

    (define (producer-summary actor)
      (let ((actor-rows
              (filter (lambda (row)
                        (string=? actor (list-ref row %row-winner)))
                      %market-rows))
            (observations
              (filter (lambda (entry)
                        (string=? actor (car entry)))
                      %candidate-observations)))
        `((actor . ,actor)
          (archetype .
            ,(cond
               ((string=? actor "fair-eager") "fair eager")
               ((string=? actor "fair-fee-waiting") "fair fee-waiting")
               ((string=? actor "strong-golfer") "strong golfer")
               ((string=? actor "future-dater") "future dater")
               (else "urgent-transaction censor")))
          (candidates . ,(length observations))
          (wins . ,(length actor-rows))
          (synthetic_par_bytes . ,%synthetic-par)
          (producer_length_bytes . ,(producer-length actor))
          (golf_savings_per_block . ,(producer-savings actor))
          (block_score . ,(producer-score actor))
          (selected_golf_savings .
            ,(sum (map (lambda (row) (list-ref row %row-savings)) actor-rows)))
          (selected_block_score .
            ,(sum (map (lambda (row) (list-ref row %row-block-score))
                       actor-rows)))
          (higher_score_replacements . 0)
          (score_tie_observations . ,(outcome-count observations 'score-tie))
          (lower_score_observations . ,(outcome-count observations 'lower-score))
          (future_drift_rejections .
            ,(if (string=? actor "future-dater") %height-count 0))
          (fees_collected .
            ,(sum (map (lambda (row) (list-ref row %row-fees)) actor-rows)))
          (scheduled_subsidy .
            ,(sum (map (lambda (row) (list-ref row %row-subsidy)) actor-rows)))
          (producer_payout .
            ,(sum (map (lambda (row) (list-ref row %row-producer)) actor-rows)))
          (total_coinbase .
            ,(sum (map (lambda (row) (list-ref row %row-total-coinbase))
                       actor-rows)))
          (minted_subsidy .
            ,(sum (map (lambda (row) (list-ref row %row-minted-subsidy))
                       actor-rows)))
          (unminted_subsidy .
            ,(sum (map (lambda (row) (list-ref row %row-unminted)) actor-rows)))
          (censorship_observations .
            ,(if (string=? actor "urgent-censor")
                 (length %censorship-observations)
                 0)))))

    (define (user-summary actor)
      (let* ((generated
               (filter (lambda (tx) (string=? actor (tx-actor tx)))
                       %all-transactions))
             (confirmed
               (filter (lambda (entry)
                         (string=? actor (confirmed-actor entry)))
                       %confirmed))
             (outstanding
               (filter (lambda (tx) (string=? actor (tx-actor tx)))
                       %outstanding))
             (latencies (map confirmation-latency confirmed)))
        `((actor . ,actor)
          (archetype .
            ,(cond
               ((string=? actor "steady") "steady")
               ((string=? actor "urgent-high-fee") "urgent high-fee")
               ((string=? actor "bursty") "bursty")
               (else "low/zero-fee spam")))
          (generated . ,(length generated))
          (confirmed . ,(length confirmed))
          (outstanding . ,(length outstanding))
          (fees_paid . ,(sum (map (lambda (entry) (tx-fee (car entry)))
                                  confirmed)))
          (latency_mean_seconds . ,(mean-or-zero latencies))
          (latency_max_seconds . ,(maximum-or-zero latencies))
          (censorship_observations .
            ,(count-if (lambda (tx) (string=? actor (tx-actor tx)))
                       %censorship-observations)))))

    (define %all-latencies (map confirmation-latency %confirmed))
    (define %total-generated-fees (sum (map tx-fee %all-transactions)))
    (define %confirmed-fees
      (sum (map (lambda (entry) (tx-fee (car entry))) %confirmed)))
    (define %outstanding-fees (sum (map tx-fee %outstanding)))
    (define %censorship-count (length %censorship-observations))
    (define %total-golf-savings
      (sum (map (lambda (row) (list-ref row %row-savings)) %market-rows)))
    (define %total-block-score
      (sum (map (lambda (row) (list-ref row %row-block-score)) %market-rows)))
    (define %final-chain-score
      (list-ref (last-of %market-rows) %row-chain-score))
    (define %final-tip-score
      (list-ref (last-of %market-rows) %row-tip-score))
    (define %child-observed-heights
      (count-if (lambda (row) (list-ref row %row-child-observed)) %market-rows))

    ;; Observable score, pacing, and accounting invariants for these declared
    ;; model inputs. No transaction or reward is made irreversible by a child.
    (need (= 76 (length %all-transactions))
          "deterministic transaction count drifted")
    (need (= (* %height-count (length %producer-actors))
             (length %candidate-observations))
          "deterministic candidate count drifted")
    (need (< %strong-producer-length %ordinary-producer-length)
          "strong golfer did not offer a shorter producer")
    (need (> (producer-score "strong-golfer") (producer-score "fair-eager"))
          "shorter producer did not improve the modeled block score")
    (need (= %height-count
             (count-if
               (lambda (row)
                 (string=? "fair-eager" (list-ref row %row-winner)))
               %market-rows))
          "equal-height candidate displaced the earlier incumbent")
    (need (= %final-chain-score %total-block-score)
          "cumulative chain score was not the sum of selected block scores")
    (need (= %total-block-score (+ %height-count %total-golf-savings))
          "selected block scores were not linear in golf savings")
    (need (= %height-count (length %child-observations))
          "not every modeled height observed an explicit child")
    (need (= %sentinel-height
             (cadr (last-of %child-observations)))
          "last lookahead observation was not the height-thirteen sentinel")
    (need (= %height-count
             (sum (map (lambda (row)
                         (list-ref row %row-future-rejections))
                       %market-rows)))
          "future-dater rejection count drifted")
    (need (> %censorship-count 0)
          "urgent-censor attack produced no observations")
    (need (= (length %all-transactions)
             (+ (length %confirmed) (length %outstanding)))
          "transaction-count conservation failed")
    (need (= %total-generated-fees
             (+ %confirmed-fees %outstanding-fees))
          "fee conservation failed")

    (define %aggregate
      `((heights_produced . ,%height-count)
        (sentinel_height . ,%sentinel-height)
        (child_observations . ,(length %child-observations))
        (child_observed_heights . ,%child-observed-heights)
        (golf_savings . ,%total-golf-savings)
        (golf_savings_per_block . ,(quotient %total-golf-savings %height-count))
        (block_score . ,%total-block-score)
        (chain_score . ,%final-chain-score)
        (selected_tip_chain_score . ,%final-tip-score)
        (transactions_generated . ,(length %all-transactions))
        (transactions_confirmed . ,(length %confirmed))
        (transactions_outstanding . ,(length %outstanding))
        (fees_generated . ,%total-generated-fees)
        (fees_confirmed . ,%confirmed-fees)
        (fees_outstanding . ,%outstanding-fees)
        (scheduled_subsidy .
          ,(sum (map (lambda (row) (list-ref row %row-subsidy))
                     %market-rows)))
        (producer_payout .
          ,(sum (map (lambda (row) (list-ref row %row-producer))
                     %market-rows)))
        (total_coinbase .
          ,(sum (map (lambda (row) (list-ref row %row-total-coinbase))
                     %market-rows)))
        (minted_subsidy .
          ,(sum (map (lambda (row) (list-ref row %row-minted-subsidy))
                     %market-rows)))
        (unminted_subsidy .
          ,(sum (map (lambda (row) (list-ref row %row-unminted))
                     %market-rows)))
        (future_drift_rejections .
          ,(sum (map (lambda (row) (list-ref row %row-future-rejections))
                     %market-rows)))
        (higher_score_replacements .
          ,(sum (map (lambda (row) (list-ref row %row-higher-score))
                     %market-rows)))
        (score_tie_observations .
          ,(sum (map (lambda (row) (list-ref row %row-score-ties))
                     %market-rows)))
        (lower_score_observations .
          ,(sum (map (lambda (row) (list-ref row %row-lower-score))
                     %market-rows)))
        (sibling_observations_after_child .
          ,(sum (map (lambda (row) (list-ref row %row-after-child))
                     %market-rows)))
        (censorship_observations . ,%censorship-count)
        (latency_mean_seconds . ,(mean-or-zero %all-latencies))
        (latency_max_seconds . ,(maximum-or-zero %all-latencies))
        (utilization_mean_permille .
          ,(mean-or-zero
             (map (lambda (row) (list-ref row %row-utilization))
                  %market-rows)))
        (mempool_final . ,(length %final-mempool))
        (pending_arrivals_final . ,(length %pending))))

    (define %results
      `((parameters .
          ((heights_produced . ,%height-count)
           (sentinel_height . ,%sentinel-height)
           (start_clock . ,%start-clock)
           (exact_slot_seconds . ,%slot-spacing)
           (max_future_drift_seconds . ,%max-future-drift)
           (synthetic_par_bytes . ,%synthetic-par)
           (ordinary_producer_length_bytes . ,%ordinary-producer-length)
           (strong_producer_length_bytes . ,%strong-producer-length)
           (golf_max_savings . ,coin-golf-max-savings)
           (genesis_chain_score . 0)
           (canonical_max_block_bytes . ,coin-max-block-bytes)
           (modeled_block_overhead_bytes . ,%modeled-block-overhead)
           (transaction_byte_cap . ,%transaction-byte-cap)))
        (modeled_assumptions .
          ,(list->array
             '("transaction envelopes use modeled bytes and fees, not wire serialization"
               "arrival-order first-fit mirrors current CLI selection; no fee priority is added"
               "candidate identities and exact-slot timestamps are synthetic; no block header or program body is constructed or executed"
               "par and producer lengths are fixed model inputs, not measured source lengths"
               "ordinary producers are at par; the strong golfer offers an eight-byte shorter producer"
               "each candidate adds coin-golf-score(par, producer length) to its parent chain score"
               "only a strictly taller branch replaces the incumbent; equal height keeps it regardless of golf score"
               "score comparison fields report quality only; score-caused replacement counters remain zero"
               "an immediate child may extend any observed sibling and is not irreversible finality"
               "the height-13 sentinel is a lookahead child, not an additional accounted market block"
               "transaction confirmations and rewards are provisional selected-block accounting within this bounded model"
               "fees affect payouts and availability policy, not fork selection"
               "timestamps are exact slots; independent arrivals cannot precede their timestamp with zero future drift"
               "future-dater publishes an exact-slot timestamp too early, then legally, and never censors"
               "urgent-censor uses legal timestamps and never future-dates")))
        (aggregate . ,%aggregate)
        (producers . ,(list->array (map producer-summary %producer-actors)))
        (users . ,(list->array (map user-summary %user-actors)))
        (scope . "bodyless deterministic bounded height-choice, golf-quality, and fee model; checkpoint validity is assumed; not production execution, equilibrium, profitability, or a network simulator")))

    (define %summary
      (string-append
        (format "Market observer: ~a modeled heights plus height-~a sentinel; ~a child observations / ~a selected branches with a child.\n"
                %height-count %sentinel-height (length %child-observations)
                %child-observed-heights)
        (format "Market golf: declared par ~a bytes, ordinary/strong lengths ~a/~a; ~a selected savings, root/tip chain score ~a/~a.\n"
                %synthetic-par %ordinary-producer-length %strong-producer-length
                %total-golf-savings %final-chain-score %final-tip-score)
        (format "Market transactions: ~a generated / ~a confirmed; final outstanding ~a.\n"
                (length %all-transactions)
                (length %confirmed)
                (length %outstanding))
        (format "Market fees: ~a confirmed, ~a outstanding; mean/max latency ~a/~a seconds.\n"
                %confirmed-fees
                %outstanding-fees
                (mean-or-zero %all-latencies)
                (maximum-or-zero %all-latencies))
        (format "Distinct attacks: ~a future-time rejections; ~a urgent-censorship observations.\n"
                %height-count %censorship-count)
        "Rewards account for selected modeled blocks; child observations are not finality or a reward gate.\n"
        "Market scope: bodyless deterministic inputs, not measured producer sources, production execution, equilibrium, or a network simulation.\n"))

    ;;; Run and return the deterministic actor/fee market experiment.
    (define (coin-run-market-simulation)
      (: -> list?)
      `((header . ,%market-header)
        (rows . ,%market-rows)
        (results . ,%results)
        (summary . ,%summary)))))
