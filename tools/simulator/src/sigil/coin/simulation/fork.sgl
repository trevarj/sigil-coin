;;; (sigil coin simulation fork) — bounded longest-height observer
;;;
;;; This bodyless helper observes valid sibling blocks and their immediate
;;; children in `(arrival, actor)` order. Only a strictly taller branch
;;; replaces the incumbent; equal height keeps it regardless of golf score.
;;; Checkpoint validity is a prerequisite, not modeled by this helper.

(define-library (sigil coin simulation fork)
  (import (sigil math)
          (sigil list)
          (sigil string))
  (export
    coin-fork-candidate
    coin-fork-candidate-actor
    coin-fork-candidate-height
    coin-fork-candidate-arrival
    coin-fork-candidate-id
    coin-fork-candidate-parent-id
    coin-fork-candidate-chain-score
    coin-run-fork-observer)

  (begin

    ;; No peer, topology, or synthetic proof state is kept behind this record.
    (define (coin-fork-candidate actor height arrival id parent-id chain-score)
      (: string? integer? integer? any? any? integer? -> list?)
      (if (not (string? actor))
          (error "coin-fork-candidate: expected an actor string"))
      (if (not (and (number? height) (exact? height) (integer? height)
                    (>= height 0)))
          (error "coin-fork-candidate: expected a non-negative height"))
      (if (not (and (number? arrival) (exact? arrival) (integer? arrival)
                    (>= arrival 0)))
          (error "coin-fork-candidate: expected a non-negative arrival"))
      (if (not (and (number? chain-score) (exact? chain-score)
                    (integer? chain-score) (>= chain-score 0)))
          (error "coin-fork-candidate: expected a non-negative chain score"))
      (list actor height arrival id parent-id chain-score))

    (define (coin-fork-candidate-actor candidate)
      (list-ref candidate 0))

    (define (coin-fork-candidate-height candidate)
      (list-ref candidate 1))

    (define (coin-fork-candidate-arrival candidate)
      (list-ref candidate 2))

    (define (coin-fork-candidate-id candidate)
      (list-ref candidate 3))

    (define (coin-fork-candidate-parent-id candidate)
      (list-ref candidate 4))

    (define (coin-fork-candidate-chain-score candidate)
      (list-ref candidate 5))

    ;; Arrival order is observer state. Actor is only the deterministic tie
    ;; breaker for simultaneous observations.
    (define (observation-before? a b)
      (or (< (coin-fork-candidate-arrival a)
             (coin-fork-candidate-arrival b))
          (and (= (coin-fork-candidate-arrival a)
                  (coin-fork-candidate-arrival b))
               (string<? (coin-fork-candidate-actor a)
                         (coin-fork-candidate-actor b)))))

    (define (trace-row candidate event outcome incumbent tip height)
      (list (coin-fork-candidate-arrival candidate)
            (coin-fork-candidate-actor candidate)
            (coin-fork-candidate-height candidate)
            event
            outcome
            (coin-fork-candidate-actor incumbent)
            (= (coin-fork-candidate-height tip) (+ height 1))
            (coin-fork-candidate-chain-score candidate)
            (coin-fork-candidate-chain-score tip)))

    ;; `selected` is the root sibling of `tip`. A child must name an already
    ;; observed sibling and increase its score. `child-observed?` describes
    ;; only the selected branch, not an irreversible state transition.
    (define (coin-run-fork-observer candidates)
      (: list? -> list?)
      (if (not (and (list? candidates) (pair? candidates)))
          (error "coin-run-fork-observer: expected candidates"))
      (let* ((ordered (list-sort observation-before? candidates))
             (first (car ordered))
             (height (coin-fork-candidate-height first))
             (parent-id (coin-fork-candidate-parent-id first)))
        (let loop ((rest ordered)
                   (observed '())
                   (selected #f)
                   (tip #f)
                   (trace '()))
          (if (null? rest)
              (let ((child
                      (and (= (coin-fork-candidate-height tip) (+ height 1))
                           tip)))
                `((height . ,height)
                  (selected . ,selected)
                  (tip . ,tip)
                  (child . ,child)
                  (child-observed? . ,(and child #t))
                  (trace . ,(reverse trace))))
              (let* ((candidate (car rest))
                     (id (coin-fork-candidate-id candidate))
                     (candidate-height (coin-fork-candidate-height candidate))
                     (score (coin-fork-candidate-chain-score candidate))
                     (duplicate (assoc id observed))
                     (canonical (if duplicate (cdr duplicate) candidate)))
                (if (and duplicate
                         (not (and
                                (= candidate-height
                                   (coin-fork-candidate-height canonical))
                                (equal?
                                  (coin-fork-candidate-parent-id candidate)
                                  (coin-fork-candidate-parent-id canonical))
                                (= score
                                   (coin-fork-candidate-chain-score canonical)))))
                    (error "coin-run-fork-observer: conflicting candidate identity"))
                (let* ((sibling? (= candidate-height height))
                       (root
                         (cond
                           (sibling?
                            (if (not (equal?
                                       parent-id
                                       (coin-fork-candidate-parent-id candidate)))
                                (error "coin-run-fork-observer: siblings have different parents"))
                            canonical)
                           ((= candidate-height (+ height 1))
                            (let ((parent
                                    (assoc
                                      (coin-fork-candidate-parent-id candidate)
                                      observed)))
                              (if (not (and parent
                                            (= height
                                               (coin-fork-candidate-height
                                                 (cdr parent)))))
                                  (error "coin-run-fork-observer: child parent is not an observed sibling"))
                              (if (<= score
                                      (coin-fork-candidate-chain-score
                                        (cdr parent)))
                                  (error "coin-run-fork-observer: child score did not increase"))
                              (cdr parent)))
                           (else
                             (error "coin-run-fork-observer: candidate height is outside fork"))))
                       (outcome
                         (cond
                           ((not tip) 'incumbent)
                           ((> candidate-height (coin-fork-candidate-height tip))
                            'taller-chain)
                           ((= candidate-height (coin-fork-candidate-height tip))
                            'height-tie)
                           (else 'shorter-chain)))
                       (replace?
                         (or (not tip) (eq? outcome 'taller-chain)))
                       (next-selected (if replace? root selected))
                       (next-tip (if replace? canonical tip)))
                  (loop
                    (cdr rest)
                    (if duplicate observed (cons (cons id candidate) observed))
                    next-selected
                    next-tip
                    (cons (trace-row candidate
                                     (if sibling? 'sibling 'child)
                                     outcome next-selected next-tip height)
                          trace))))))))))
